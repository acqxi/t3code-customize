def run(args, cwd=None, env=None, log=None, check=True, capture=False):
    # Output goes to the log, so nothing may wait for an answer the user cannot see.
    result = subprocess.run(command_args(args, env), cwd=cwd, env=env, text=capture,
                            encoding='utf-8' if capture else None, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE if capture else log,
                            stderr=log if not capture else None)
    if check and result.returncode:
        raise Stop(f'Command failed ({result.returncode}): {" ".join(map(str, args))}' + (f'\nLog: {log.name}' if log else ''))
    return result.stdout if capture else result


def git(*args, check=True, capture=True, log=None):
    env = {**os.environ, **GIT_ENV}
    return run(['git', '-c', f'core.hooksPath={os.devnull}', '-c', 'core.longpaths=true',
                '-c', 'core.autocrlf=false', *args], cwd=SOURCE, env=env, check=check, capture=capture, log=log)


def sha256(path):
    digest = hashlib.sha256()
    with Path(path).open('rb') as source:
        for chunk in iter(lambda: source.read(1 << 20), b''):
            digest.update(chunk)
    return digest.hexdigest()


def load(path, default=None):
    return json.loads(path.read_text()) if path.exists() else default


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.new')
    temporary.write_text(json.dumps(value, indent=2) + '\n')
    os.replace(temporary, path)


# One patch set per supported T3 Code release: patches/<version>/ holds the
# patches, base.txt (the upstream commit they apply to) and checks.json. Only the
# newest set lives in the tree; older ones stay frozen in tags named
# patches-<version>, and are read from those tags when an install needs them.
PATCH_SET = None
ARCHIVE_TAG = 'patches-'


def archived_sets():
    """Older releases' sets, extracted from their tags into the cache."""
    listed = subprocess.run(['git', 'tag', '--list', ARCHIVE_TAG + '*'], cwd=REPO,
                            capture_output=True, text=True)
    if listed.returncode:
        return []
    found = []
    for tag in listed.stdout.split():
        version = tag[len(ARCHIVE_TAG):]
        commit = subprocess.run(['git', 'rev-parse', tag + '^{commit}'], cwd=REPO,
                                capture_output=True, text=True).stdout.strip()
        folder = CACHE / 'patch-sets' / version
        if (folder / '.tag').exists() and (folder / '.tag').read_text().strip() == commit:
            found.append(folder)
            continue
        archive = subprocess.run(['git', 'archive', '--format=tar', commit, f'patches/{version}'], cwd=REPO,
                                 capture_output=True)
        if archive.returncode:
            continue
        shutil.rmtree(folder, ignore_errors=True)
        folder.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(dir=folder.parent) as scratch:
            with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as bundle:
                if hasattr(tarfile, 'data_filter'):
                    bundle.extractall(scratch, filter='data')
                else:
                    bundle.extractall(scratch)
            shutil.move(str(Path(scratch) / 'patches' / version), folder)
        (folder / '.tag').write_text(commit + '\n')
        found.append(folder)
    return [folder for folder in found if (folder / 'base.txt').exists()]


def patch_sets():
    root = REPO / 'patches'
    if (root / 'base.txt').exists():
        return [root]
    current = [d for d in root.iterdir() if (d / 'base.txt').exists()]
    names = {d.name for d in current}
    older = [d for d in archived_sets() if d.name not in names]
    return sorted(current + older, key=version_key)


def patch_dir():
    return PATCH_SET or patch_sets()[-1]


def patches():
    return sorted(patch_dir().glob('*.patch'))


def patch_base():
    return (patch_dir() / 'base.txt').read_text().strip()


def checks_file():
    own = patch_dir() / 'checks.json'
    return own if own.exists() else REPO / 'checks.json'


def is_ancestor(older, newer):
    return git('merge-base', '--is-ancestor', older, newer, check=False, capture=False).returncode == 0


def choose_patch_set(target):
    """The set made for this commit, else the closest older one to port from; None if all are newer."""
    candidates = []
    for folder in patch_sets():
        base = (folder / 'base.txt').read_text().strip()
        if base == target:
            return folder
        if is_ancestor(base, target):
            candidates.append((int(git('rev-list', '--count', f'{base}..{target}').strip()), folder))
    return min(candidates, key=lambda item: item[0])[1] if candidates else None


def recipe_hash():
    digest = hashlib.sha256()
    for path in patches() + [patch_dir() / 'base.txt', checks_file(),
                             REPO / NAME, REPO / 'platform_support.py']:
        digest.update(path.name.encode() + path.read_bytes())
    return digest.hexdigest()[:12]


def interactive():
    return sys.stdin.isatty() and sys.stdout.isatty()


def extract_tar(archive, destination):
    with tarfile.open(archive) as bundle:
        if hasattr(tarfile, 'data_filter'):
            bundle.extractall(destination, filter='data')
        else:
            bundle.extractall(destination)


