def _saved_config():
    try:
        return json.loads((CONFIG / 'config.json').read_text())
    except (OSError, ValueError):
        return {}


def wsl_windows_folders(config=None, refresh=False):
    """The Windows user's folders as seen from WSL, remembered in the config."""
    config = _saved_config() if config is None else config
    if not refresh and config.get('windows', {}).get('LOCALAPPDATA'):
        return config['windows']
    folders = wsl.windows_folders()
    CONFIG.mkdir(parents=True, exist_ok=True)
    (CONFIG / 'config.json').write_text(json.dumps({**_saved_config(), 'windows': folders}, indent=2))
    return folders


def detect_windows_target(config=None):
    """In WSL, build for the Windows T3 Code when asked to or when it is the only T3 Code installed."""
    if SYSTEM != 'linux' or not wsl.is_wsl():
        return False
    config = _saved_config() if config is None else config
    if config.get('target') in ('windows', 'linux'):
        return config['target'] == 'windows'
    saved = config.get('app') or config.get('appimage') or ''
    if saved:
        return not saved.endswith('.AppImage')
    from platform_support import app_candidates
    if app_candidates(HOME, 'linux'):
        return False
    if not wsl.interop_enabled():
        # Without interop the Windows install cannot even be looked for; say how to fix it.
        raise Stop(wsl.INTEROP_FIX)
    try:
        local = Path(wsl_windows_folders(config)['LOCALAPPDATA'])
    except wsl.WslError:
        return False
    return any(path.exists() for path in app_candidates(HOME, 'win32', {'LOCALAPPDATA': str(local)}))


