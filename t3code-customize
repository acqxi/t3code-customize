class Archive:
    def __init__(self, path):
        self.file = Path(path).open('rb')
        _, header_size, _, json_size = struct.unpack('<4I', self.file.read(16))
        self.offset = 8 + header_size
        self.tree = json.loads(self.file.read(json_size))
        self.entries = dict(self.walk(self.tree))

    @staticmethod
    def walk(tree, prefix=''):
        for name, entry in tree.get('files', {}).items():
            if 'files' in entry:
                yield from Archive.walk(entry, prefix + name + '/')
            else:
                yield prefix + name, entry

    def read(self, key):
        entry = self.entries[key]
        self.file.seek(self.offset + int(entry['offset']))
        data = self.file.read(entry['size'])
        if len(data) != entry['size']:
            raise ValueError('Truncated archive entry: ' + key)
        return data

    def scripts(self, prefix):
        for key, entry in self.entries.items():
            if key.startswith(prefix) and key.endswith(('.js', '.mjs', '.cjs')) and not entry.get('unpacked') and 'link' not in entry:
                yield key, self.read(key)

    def close(self):
        self.file.close()


def read_public_config(archive):
    """Upstream's public cloud config from the stock web bundle, by name."""
    found = {}
    for _, data in archive.scripts('apps/server/dist/client/'):
        for name in PUBLIC_CONFIG:
            if name in found:
                continue
            match = re.search(re.escape(name).encode() + rb':\s*([`"\'])([^`"\'\\\n]{1,200})\1', data)
            if match:
                found[name] = match.group(2).decode()
        if len(found) == len(PUBLIC_CONFIG):
            break
    return {PUBLIC_CONFIG[name]: value for name, value in found.items()}


def overlay(stock_path, output, build, config, prefixes=None):
    """Write stock_path with the server and desktop bundles replaced by build's, then verify it."""
    stock = Archive(stock_path)
    try:
        tree = copy.deepcopy(stock.tree)

        def node(path):
            current = tree
            for part in path.split('/'):
                current = current['files'][part]
            return current

        prefixes = prefixes or ('apps/server/dist', 'apps/desktop/dist-electron')
        for prefix in prefixes:
            node(prefix)['files'] = {}
        overlays = {}
        for prefix in prefixes:
            source = build / prefix
            for path in sorted(source.rglob('*')):
                if path.is_symlink():
                    raise Stop('Unexpected symlink in the build output: ' + str(path))
                if not path.is_file():
                    continue
                relative = path.relative_to(source).as_posix()
                current = node(prefix)
                parts = relative.split('/')
                for part in parts[:-1]:
                    current = current['files'].setdefault(part, {'files': {}})
                data = path.read_bytes()
                block = 4194304
                current['files'][parts[-1]] = {'size': len(data), 'integrity': {
                    'algorithm': 'SHA256', 'hash': hashlib.sha256(data).hexdigest(), 'blockSize': block,
                    'blocks': [hashlib.sha256(data[i:i + block]).hexdigest() for i in range(0, len(data), block)]}}
                overlays[prefix + '/' + relative] = path
        for required in ('apps/server/dist/bin.mjs', 'apps/server/dist/client/index.html',
                         'apps/desktop/dist-electron/main.cjs'):
            if any(required.startswith(prefix + '/') for prefix in prefixes) and required not in overlays:
                raise Stop('The build did not produce ' + required)
        records, cursor = [], 0
        for key, entry in Archive.walk(tree):
            if 'link' in entry or entry.get('unpacked'):
                continue
            entry['offset'] = str(cursor)
            cursor += entry['size']
            records.append(key)
        encoded = json.dumps(tree, separators=(',', ':'), ensure_ascii=False).encode()
        padded = encoded + b'\0' * ((-len(encoded)) % 4)
        header = struct.pack('<II', 4 + len(padded), len(encoded)) + padded
        with output.open('wb') as target:
            target.write(struct.pack('<II', 4, len(header)))
            target.write(header)
            for key in records:
                target.write(overlays[key].read_bytes() if key in overlays else stock.read(key))
        patched = Archive(output)
        try:
            for key, path in overlays.items():
                if patched.read(key) != path.read_bytes():
                    raise Stop('Archive verification failed for ' + key)
            for key, entry in stock.entries.items():
                if any(key.startswith(prefix + '/') for prefix in prefixes):
                    continue
                same = (entry == patched.entries.get(key) if entry.get('unpacked') or 'link' in entry
                        else key in patched.entries and stock.read(key) == patched.read(key))
                if not same:
                    raise Stop('Archive verification failed for stock entry ' + key)
            check_bundles(stock, patched, config, prefixes)
        finally:
            patched.close()
    finally:
        stock.close()


class Folder:
    """A build output folder, read like an Archive."""

    def __init__(self, root):
        self.root = Path(root)

    def scripts(self, prefix):
        for path in sorted((self.root / prefix).rglob('*')):
            if path.is_file() and path.suffix in ('.js', '.mjs', '.cjs'):
                yield path.relative_to(self.root).as_posix(), path.read_bytes()


def check_bundles(stock, patched, config, prefixes):
    """The rebuilt bundles carry the patches and the same T3 Connect config as stock."""
    for prefix, marker in MARKERS:
        if (any(prefix.startswith(p + '/') for p in prefixes) and
                not any(marker in data for _, data in patched.scripts(prefix))):
            raise Stop(f'The rebuilt bundle under {prefix} is missing the stats bar.')
    # Connect needs the same public config as stock in every bundle that carries it.
    for prefix in ('apps/server/dist/client/', 'apps/server/dist/', 'apps/desktop/dist-electron/'):
        if not any(prefix.startswith(p + '/') for p in prefixes):
            continue
        def contents(archive):
            return b''.join(data for key, data in archive.scripts(prefix)
                            if prefix.endswith('client/') or '/client/' not in key)
        stock_data, patched_data = contents(stock), contents(patched)
        for key, value in config.items():
            if value.encode() in stock_data and value.encode() not in patched_data:
                raise Stop(f'The rebuilt bundle under {prefix} is missing T3 Connect config ({key}).')


def assemble_mac(app, output, build, config):
    """Write the rebuilt bundles and the loader to output, then verify them against stock."""
    if (app.resources / 'server.asar').is_file():
        raise Stop('This T3 Code keeps its server in a separate archive, which the macOS loader does not support yet.')
    prefixes = ('apps/server/dist', 'apps/desktop/dist-electron')
    overlay = output / 'overlay'
    for prefix in prefixes:
        for path in (build / prefix).rglob('*'):
            if path.is_symlink():
                raise Stop('Unexpected symlink in the build output: ' + str(path))
        shutil.copytree(build / prefix, overlay / prefix)
    for required in ('apps/server/dist/bin.mjs', 'apps/server/dist/client/index.html',
                     'apps/desktop/dist-electron/boot.cjs', 'apps/desktop/dist-electron/main.cjs'):
        if not (overlay / required).is_file():
            raise Stop('The build did not produce ' + required)
    for name in ('inject.cjs', 'connect.mjs'):
        shutil.copy2(REPO / 'macos' / name, output / name)
    stock = Archive(app.resources / 'app.asar')
    try:
        # The app loads boot.cjs before the customization exists, so it must stay as shipped.
        if stock.read('apps/desktop/dist-electron/boot.cjs') != (overlay / 'apps/desktop/dist-electron/boot.cjs').read_bytes():
            raise Stop('The rebuilt boot.cjs differs from your app; the customization cannot load into it.')
        check_bundles(stock, Folder(overlay), config, prefixes)
    finally:
        stock.close()


def electron_fuses(app):
    """Electron's fuse wire from the app's framework binary, e.g. {'EnableNodeCliInspectArguments': '1'}."""
    names = ['RunAsNode', 'EnableCookieEncryption', 'EnableNodeOptionsEnvironmentVariable',
             'EnableNodeCliInspectArguments', 'EnableEmbeddedAsarIntegrityValidation', 'OnlyLoadAppFromAsar',
             'LoadBrowserProcessSpecificV8Snapshot', 'GrantFileProtocolExtraPrivileges']
    data = (app / 'Contents/Frameworks/Electron Framework.framework/Electron Framework').read_bytes()
    start = data.find(b'dL7pKGdnNz796PbbjQWNKmHXBZaB9tsX')
    if start < 0:
        return {}
    start += 32
    wire = data[start + 2:start + 2 + data[start + 1]].decode('ascii', 'replace')
    return dict(zip(names, wire))


# --- Tools --------------------------------------------------------------------------

def node_major(node):
    try:
        out = subprocess.run([node, '-p', 'process.versions.node'], capture_output=True, text=True, check=True).stdout
        return int(out.split('.')[0])
    except (OSError, subprocess.CalledProcessError, ValueError):
        return 0


def node_version(node):
    try:
        return subprocess.run([node, '-p', 'process.versions.node'], capture_output=True, text=True,
                              check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return ''


def required_node(commit):
    """The exact Node a commit pins in engines.node (its single executable embeds that Node), if any."""
    try:
        engines = json.loads(git('show', commit + ':package.json')).get('engines', {}).get('node', '')
    except (subprocess.CalledProcessError, ValueError):
        return None
    return engines if re.fullmatch(r'\d+\.\d+\.\d+', engines or '') else None


def ensure_node(log, exact=None):
    """Use the system Node if it fits, else a private copy from nodejs.org.

    exact is the version upstream pins: its tests use that Node's APIs, and the WSL
    runtime is a single executable that embeds it.
    """
    system = shutil.which('node')
    if system and (node_version(system) == exact if exact else node_major(system) >= 24):
        return None
    target, extension = node_target()
    prefix = f'v{exact}' if exact else 'v24.'
    private = sorted((CACHE / 'node').glob(f'node-{prefix}{"" if exact else "*"}-{target}'), key=version_key)
    executable = 'node.exe' if SYSTEM == 'win32' else 'node'
    if private and (node_version(str(node_bin(private[-1]) / executable)) == exact if exact else
                    node_major(str(node_bin(private[-1]) / executable)) >= 24):
        return node_bin(private[-1])
    step(f'Downloading Node {exact or 24} (one time, private to this tool)...')
    with urllib.request.urlopen('https://nodejs.org/dist/index.json', timeout=30) as response:
        releases = json.load(response)
    # nodejs.org lists the Windows zips as win-*-zip and the macOS builds as osx-*-tar.
    release_target = {'win32': target + '-zip', 'darwin': target.replace('darwin-', 'osx-') + '-tar'}.get(SYSTEM, target)
    version = next((r['version'] for r in releases if (r['version'] == prefix if exact else r['version'].startswith(prefix))
                    and release_target in r['files']), None)
    if version is None:
        raise Stop(f'Node {exact} is not published for {target}.')
    name = f'node-{version}-{target}'
    base = f'https://nodejs.org/dist/{version}/'
    with urllib.request.urlopen(base + 'SHASUMS256.txt', timeout=30) as response:
        sums = dict(reversed(line.split()) for line in response.read().decode().splitlines() if line.strip())
    folder = CACHE / 'node'
    folder.mkdir(parents=True, exist_ok=True)
    archive = folder / (name + extension)
    urllib.request.urlretrieve(base + archive.name, archive)
    if sha256(archive) != sums.get(archive.name):
        archive.unlink()
        raise Stop('The Node download did not match its published checksum.')
    if extension == '.zip':
        with zipfile.ZipFile(archive) as bundle:
            for entry in bundle.namelist():
                destination = (folder / entry).resolve()
                if not destination.is_relative_to(folder.resolve()):
                    raise Stop('Unsafe path in the Node archive.')
            bundle.extractall(folder)
    else:
        extract_tar(archive, folder)
    archive.unlink()
    return node_bin(folder / name)


def build_env(node_bin):
    env = os.environ.copy()
    paths = [str(SOURCE / 'node_modules/.bin')] + ([str(node_bin)] if node_bin else [])
    env['PATH'] = os.pathsep.join(paths + [env.get('PATH', '')])
    # Corepack otherwise asks before fetching the pnpm version the source pins.
    env['COREPACK_ENABLE_DOWNLOAD_PROMPT'] = '0'
    # ELECTRON_RUN_AS_NODE leaks in when this runs from a terminal inside T3 Code.
    for key in ('T3CODE_DESKTOP_DEV', 'VITE_HTTP_URL', 'VITE_WS_URL', 'NODE_ENV', 'ELECTRON_RUN_AS_NODE'):
        env.pop(key, None)
    # Nothing from the user's shell may stand in for upstream config.
    for key in list(env):
        if key.startswith(('T3CODE_', 'VITE_', 'EXPO_PUBLIC_')):
            env.pop(key)
    return env


def pnpm(env):
    if shutil.which('pnpm', path=env['PATH']):
        return ['pnpm']
    manager = json.loads((SOURCE / 'package.json').read_text()).get('packageManager', 'pnpm')
    return ['npx', '--yes', manager.split('+')[0]]


# --- Source checkout ----------------------------------------------------------------

def rebase_in_progress():
    gitdir = Path(git('rev-parse', '--absolute-git-dir').strip())
    return (gitdir / 'rebase-merge').exists() or (gitdir / 'rebase-apply').exists()


def has_commit(ref):
    return git('cat-file', '-e', ref + '^{commit}', check=False, capture=False).returncode == 0


def ensure_commit(commit, version, log):
    if not (SOURCE / '.git').exists():
        step('Downloading T3 Code source history (one time)...')
        shutil.rmtree(SOURCE, ignore_errors=True)
        SOURCE.parent.mkdir(parents=True, exist_ok=True)
        run(['git', '-c', 'core.longpaths=true', '-c', 'core.autocrlf=false',
             'clone', '--filter=blob:none', '--no-checkout', UPSTREAM, str(SOURCE)], log=log)
    if not has_commit(commit):
        git('fetch', '--quiet', 'origin', capture=False, log=log, check=False)
        if version and not has_commit(commit):
            git('fetch', '--quiet', 'origin', 'tag', 'v' + version, capture=False, log=log, check=False)
    if not has_commit(commit):
        raise Stop(f'Upstream commit {commit} is not on GitHub yet. Try again in a little while.')
    return git('rev-parse', commit + '^{commit}').strip()


def prepare(target, log, resume=False):
    """Leave SOURCE with the patches as commits on top of target."""
    base = patch_base()
    if not resume:
        if rebase_in_progress():
            # Start over from the repo's patches; a fresh build never continues an old port.
            git('am', '--abort', check=False, capture=False, log=log)
            git('rebase', '--abort', check=False, capture=False, log=log)
        git('checkout', '--quiet', '--force', '--detach', base, capture=False, log=log)
        # Keep node_modules so dependency installs stay fast between builds.
        git('clean', '-ffdxq', '-e', 'node_modules', capture=False, log=log)
        if git('am', '--quiet', '--committer-date-is-author-date', *map(str, patches()), check=False, capture=False, log=log).returncode:
            git('am', '--abort', check=False, capture=False, log=log)
            raise Stop(f'The patches do not apply to their own base {base[:12]}. Check git status in {REPO}.')
        if base != target:
            git('rebase', '--quiet', '--onto', target, base, check=False, capture=False, log=log)
    if rebase_in_progress():
        conflicted = git('diff', '--name-only', '--diff-filter=U').split()
        raise NeedsFix('The patches conflict with this nightly in:\n' + '\n'.join('  ' + f for f in conflicted))
    if git('status', '--porcelain', '--untracked-files=no').strip():
        raise NeedsFix('The source checkout has uncommitted changes in ' + str(SOURCE) + '.')
    if git('merge-base', '--is-ancestor', target, 'HEAD', check=False, capture=False).returncode:
        raise NeedsFix('The patch commits are not on top of the nightly commit ' + target[:12] + '.')


def install_dependencies(env, log):
    first = not (SOURCE / 'node_modules').exists()
    step('Installing build dependencies' + (' (one time, a few minutes)...' if first else '...'))
    # Only JavaScript is rebuilt; native parts come from your own app, so no install scripts run.
    run([*pnpm(env), 'install', *PNPM_INSTALL], cwd=SOURCE, env=env, log=log)


def checks(env, log):
    spec = json.loads(checks_file().read_text())
    missing = [t for t in spec['tests'] if not (SOURCE / t).exists()]
    if missing:
        raise NeedsFix(f'Test files listed in {checks_file()} no longer exist (moved upstream?):\n' + '\n'.join('  ' + t for t in missing))
    step('Testing the patches...')
    steps = [(['vp', 'test', 'run', *spec['tests']], SOURCE, 'The patch tests failed.')]
    steps += [(typecheck_command(p), SOURCE / p, f'Typecheck failed in {p}.') for p in spec['typecheck']]
    for args, cwd, message in steps:
        if run(args, cwd=cwd, env=env, log=log, check=False).returncode:
            raise NeedsFix(message + ' Command: ' + ' '.join(args) + ' (in ' + str(cwd) + ')')


def typecheck_command(package):
    """The package's own typecheck script, else effect-tsgo, else tsc."""
    script = json.loads((SOURCE / package / 'package.json').read_text()).get('scripts', {}).get('typecheck', '')
    args = shlex.split(script)
    if args and re.fullmatch(r'[A-Za-z0-9._-]+', args[0]) and not any(c in script for c in '&|;$`<>'):
        return args
    if (SOURCE / 'node_modules/.bin/effect-tsgo').exists():
        return ['effect-tsgo', 'tsrs', '--noEmit']
    return ['tsc', '--noEmit', '-p', 'tsconfig.json']


def build_bundles(env, version, stock_root, config, log, runtime=False):
    step('Building T3 Code...')
    # GITHUB_REPOSITORY points release-notes links at upstream, as in official builds.
    env = dict(env, APP_VERSION=version, TMPDIR=str(CACHE / 'tmp'), GITHUB_REPOSITORY='pingdotgg/t3code', **config)
    Path(env['TMPDIR']).mkdir(parents=True, exist_ok=True)
    packages = [SOURCE / 'apps' / app / 'package.json' for app in ('web', 'server', 'desktop')]
    # The desktop build regenerates this tracked file; put the committed copy back afterwards.
    generated = [SOURCE / 'apps/desktop/src/preview/AnnotationStyles.generated.ts']
    originals = {path: path.read_bytes() for path in packages + generated if path.exists()}
    try:
        for path in packages:
            package = json.loads(originals[path])
            package['version'] = version
            path.write_text(json.dumps(package, indent=2) + '\n')
        run(['vp', 'build'], cwd=SOURCE / 'apps/web', env=env, log=log)
        run(['node', 'scripts/cli.ts', 'build'], cwd=SOURCE / 'apps/server', env=env, log=log)
        brand = 'nightly' if 'nightly' in version else 'production'
        run(['node', 'scripts/apply-web-brand-assets.ts', brand, 'apps/server/dist/client'], cwd=SOURCE, env=env, log=log)
        if runtime:
            # The WSL runtime's server is a Node single executable built from the same bundle.
            step('Building the WSL runtime...')
            shutil.rmtree(SOURCE / 'apps/server/dist-exe', ignore_errors=True)
            run(['node', 'scripts/cli.ts', 'build-exe'], cwd=SOURCE / 'apps/server', env=env, log=log)
        # Reuse the native helper from your own app instead of compiling it. A Windows target
        # never carries the Linux helper, as in upstream's CI bundle job (build:bundle).
        arch = host_arch()
        helper = SOURCE / f'native/browser-secret/build/{arch}/t3-browser-secret'
        stock_helper = stock_root.resources / 'browser-secret/t3-browser-secret'
        if stock_helper.exists():
            helper.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(stock_helper, helper)
            os.utime(helper, None)
        if not WINDOWS_FROM_WSL:
            run(['node', 'scripts/build-browser-secret.mjs'], cwd=SOURCE / 'apps/desktop', env=env, log=log)
        run(['node', 'scripts/build-preview-annotation-css.mjs'], cwd=SOURCE / 'apps/desktop', env=env, log=log)
        run(['vp', 'pack'], cwd=SOURCE / 'apps/desktop', env=env, log=log)
    finally:
        for path, original in originals.items():
            path.write_bytes(original)


# --- Porting help -------------------------------------------------------------------

def available_agents():
    return [name for name in AGENTS if shutil.which(name)]


def choose_agent(requested):
    """The agent to port the patches with, asking first when run by a person."""
    if requested:
        if not shutil.which(requested):
            raise Stop(f'{requested} is not installed.')
        return requested
    agents = available_agents()
    if not agents or not interactive():
        return None
    name = agents[0]
    say()
    say(f'This nightly changed code the patches touch. {AGENT_NAMES[name]} can port them for you')
    say(f'(usually 10 to 30 minutes). It runs with full permissions, only inside {SOURCE}.')
    answer = input(f'Let {AGENT_NAMES[name]} fix it now? [Y/n] ').strip().lower()
    return name if answer in ('', 'y', 'yes') else None


def agent_fix(agent, problem, target, version, log):
    prompt = (f'Follow {REPO}/AGENTS.md to port the T3 Code customization patches.\n\n'
              f'Source checkout: {SOURCE}\nNightly: {version} at commit {target}\n'
              f'Patch repo: {REPO}\n\nThe build stopped with:\n\n{problem}\n\n'
              f'When the checks pass, stop. Do not run the build yourself; {NAME} continues it.\n')
    step(f'{AGENT_NAMES[agent]} is porting the patches. Transcript: {log.name}')
    log.write('\n--- agent prompt ---\n' + prompt + '\n')
    log.flush()
    result = subprocess.run(command_args(AGENTS[agent]), cwd=SOURCE, input=prompt,
                            text=True, encoding='utf-8', stdout=log, stderr=log)
    if result.returncode:
        say(f'{AGENT_NAMES[agent]} exited with {result.returncode}; checking what it left.')


def older_than_patches(target):
    """Older than every patch set: nothing here can be ported back to it."""
    return choose_patch_set(target) is None


def stuck_message(problem, target):
    if older_than_patches(target):
        return (f'{problem}\n\nYour T3 Code is older than these patches. Update T3 Code, then run {NAME} again.\n'
                'Your current T3 Code is untouched.')
    return (f'{problem}\n\nThis nightly changed code the patches touch. Any of these works:\n'
            f'  - wait for the repo to catch up, then run {NAME} again\n'
            f'  - let an agent port them now: {NAME} --fix claude  (or --fix codex)\n'
            f'  - or ask your coding agent to follow {REPO}/AGENTS.md\n'
            'Your current T3 Code is untouched and still opens normally.')


# --- Commands -----------------------------------------------------------------------

def pull_latest():
    """Fast-forward this repo to the latest patches, keeping any local port in a backup."""
    if not (REPO / '.git').exists():
        return
    status = subprocess.run(['git', 'status', '--porcelain', '--', 'patches'],
                            cwd=REPO, capture_output=True, text=True).stdout
    before = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=REPO, capture_output=True, text=True).stdout
    if subprocess.run(['git', 'fetch', '--quiet', '--tags'], cwd=REPO, stderr=subprocess.DEVNULL).returncode:
        say('Could not check for newer patches (offline?). Using the ones you have.')
        return
    behind = subprocess.run(['git', 'rev-list', '--count', 'HEAD..@{u}'], cwd=REPO, capture_output=True, text=True).stdout.strip()
    if behind in ('', '0'):
        return
    if status.strip():
        backup = DATA / ('patches.bak-' + time.strftime('%Y%m%d-%H%M%S'))
        shutil.copytree(REPO / 'patches', backup)
        subprocess.run(['git', 'checkout', '--quiet', '--', 'patches'], cwd=REPO, check=True)
        say(f'Newer patches are available; your local port was saved to {backup}.')
    if subprocess.run(['git', 'merge', '--ff-only', '--quiet', '@{u}'], cwd=REPO).returncode:
        raise Stop(f'Could not update {REPO} to the latest patches. Run git status there.')
    after = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=REPO, capture_output=True, text=True).stdout
    if after != before:
        step('Got the latest patches.')
        # The script itself may have changed; continue with the new one.
        os.execv(sys.executable, [sys.executable, str(REPO / NAME), *sys.argv[1:], '--no-pull'])


def install_launcher(app):
    write_cli(BIN, REPO, sys.executable)
    if SYSTEM == 'win32':
        write_windows_shortcut(DESKTOP, REPO, sys.executable, run)
    elif WINDOWS_FROM_WSL:
        install_windows_launcher(load(STATE, {}))
    elif MAC:
        install_mac_launcher(app)
    else:
        install_linux_launcher()
    if str(BIN.parent) not in os.environ.get('PATH', '').split(os.pathsep):
        say(f'Note: {BIN.parent} is not on your PATH. Add it to run {NAME} from anywhere.')


def install_mac_launcher(app):
    """A small app in ~/Applications that runs `launch`, so it shows up in Spotlight and Launchpad."""
    contents = MAC_LAUNCHER / 'Contents'
    (contents / 'MacOS').mkdir(parents=True, exist_ok=True)
    (contents / 'Resources').mkdir(exist_ok=True)
    with (contents / 'Info.plist').open('wb') as plist:
        plistlib.dump({
            'CFBundleName': LAUNCHER_NAME, 'CFBundleDisplayName': LAUNCHER_NAME,
            'CFBundleIdentifier': 'io.github.btsouth.t3code-customize', 'CFBundleExecutable': 'launch',
            'CFBundleIconFile': 'icon', 'CFBundlePackageType': 'APPL', 'CFBundleVersion': '1',
            # The launcher exits once T3 Code is up; keep it out of the Dock.
            'LSUIElement': True,
        }, plist)
    script = contents / 'MacOS/launch'
    logs = CACHE / 'logs'
    # Apps opened from Finder do not see the shell's environment; keep the folders this build used.
    exports = ''.join(f'export {key}="{os.environ[key]}"\n' for key in ('XDG_DATA_HOME', 'XDG_CACHE_HOME', 'XDG_CONFIG_HOME')
                      if os.environ.get(key))
    script.write_text(f'#!/bin/sh\n{exports}mkdir -p "{logs}"\n'
                      f'exec "{sys.executable}" "{REPO / NAME}" launch >>"{logs}/launch.log" 2>&1\n')
    script.chmod(0o755)
    icon = app.resources / 'icon.icns'
    if icon.exists():
        shutil.copy2(icon, contents / 'Resources/icon.icns')
    os.utime(MAC_LAUNCHER, None)


def install_linux_launcher():
    DESKTOP.parent.mkdir(parents=True, exist_ok=True)
    DESKTOP.write_text('\n'.join([
        '[Desktop Entry]', 'Type=Application', f'Name={LAUNCHER_NAME}',
        'Comment=T3 Code with a stats bar under the composer',
        f'Exec="{BIN}" launch %U', f'Icon={DATA / "icon.png"}', 'Terminal=false',
        'StartupWMClass=com.t3tools.T3Code', 'Categories=Development;', '']))
    if shutil.which('update-desktop-database'):
        subprocess.run(['update-desktop-database', str(DESKTOP.parent)], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def overlay_app(app, job, config, reads=None):
    """reads: where to read the stock archives (a Linux staging copy when building for Windows from WSL)."""
    reads = reads or app.resources
    desktop = app.resources / 'app.asar'
    server = app.resources / 'server.asar'
    archives = ([(desktop, ('apps/desktop/dist-electron',)), (server, ('apps/server/dist',))]
                if server.is_file() else [(desktop, ('apps/server/dist', 'apps/desktop/dist-electron'))])
    for path, prefixes in archives:
        output = job / (path.name + '.new')
        overlay(reads / path.name, output, SOURCE, config, prefixes)
        if WINDOWS_FROM_WSL:
            wsl.windows_copy_file(output, path)
            if wsl.windows_sha256(path) != sha256(output):
                raise Stop('Copying ' + path.name + ' into the Windows app failed verification.')
            output.unlink()
        else:
            os.replace(output, path)


def contains(path, marker):
    """Whether a large file contains marker, read in chunks."""
    tail = b''
    with Path(path).open('rb') as source:
        for chunk in iter(lambda: source.read(1 << 22), b''):
            if marker in tail + chunk:
                return True
            tail = chunk[-len(marker):]
    return False


def stage_stock_resources(app, job):
    """Copy the archives the build reads onto the Linux filesystem, by Windows (fast both ways)."""
    stage = job / 'stock-resources'
    stage.mkdir(parents=True, exist_ok=True)
    for name in ('app.asar', 'server.asar', wsl.WSL_RUNTIME_ARCHIVE):
        if (app.resources / name).is_file():
            wsl.windows_copy_file(app.resources / name, stage / name)
            if sha256(stage / name) != wsl.windows_sha256(app.resources / name):
                raise Stop(f'Staging {name} from the Windows app failed verification.')
    return stage


def assemble_wsl_runtime(app, job, version, log, reads=None):
    """Replace the copied app's WSL runtime archive with one carrying the patched server and client."""
    archive = app.resources / wsl.WSL_RUNTIME_ARCHIVE
    if not archive.is_file():
        return None
    stock_archive = (reads or app.resources) / wsl.WSL_RUNTIME_ARCHIVE
    executable = SOURCE / 'apps/server/dist-exe/t3'
    client = SOURCE / 'apps/server/dist/client'
    if not executable.is_file():
        raise Stop('The build did not produce the WSL runtime executable apps/server/dist-exe/t3.')
    reported = run([str(executable), '--version'], log=log, capture=True).strip()
    if reported != f't3 v{version}':
        raise Stop(f'The rebuilt WSL runtime reports {reported!r}, expected t3 v{version}.')
    for marker in (b'claude_observed', b'claude_stream', b'codex_stream', b'acp_stream'):
        if not contains(executable, marker):
            raise Stop('The rebuilt WSL runtime server is missing the stats patches.')
    if not any(contains(p, b'statsForNerdsShowPerReply') for p in (client / 'assets').glob('*.js')):
        raise Stop('The rebuilt WSL runtime web client is missing the stats bar.')
    staged = job / 'wsl-runtime.tar.gz'
    stem, digest = wsl.rebuild_runtime_archive(stock_archive, staged, executable, client)
    expected = f't3-{version}-linux-{host_arch()}'
    if stem != expected:
        raise Stop(f'The WSL runtime archive holds {stem}, expected {expected}.')
    (wsl.windows_copy_file if WINDOWS_FROM_WSL else shutil.copyfile)(staged, archive)
    if (wsl.windows_sha256(archive) if WINDOWS_FROM_WSL else wsl.file_digest(archive)) != digest:
        raise Stop('Copying the WSL runtime archive into the app failed verification.')
    wsl.write_runtime_hash(app.resources / wsl.WSL_RUNTIME_HASH, digest)
    staged.unlink()
    say(f'    WSL runtime sha256-{digest[:12]}')
    return digest


def fingerprint(app):
    """The installed app's fingerprint, including the WSL runtime it ships."""
    records = app.fingerprint()
    sidecar = app.resources / wsl.WSL_RUNTIME_HASH
    if app.system == 'win32' and sidecar.is_file():
        records.append({'path': str(sidecar), 'sha256': sidecar.read_text().strip()})
    return records


def stock_files(app):
    """Files whose change means the installed T3 Code was updated."""
    files = [app.executable, *sorted(app.resources.glob('*.asar'))]
    sidecar = app.resources / wsl.WSL_RUNTIME_HASH
    return files + ([sidecar] if sidecar.is_file() else [])


def install_windows_launcher(state):
    app = installed_app()
    build = Path(state['build']) if state.get('build') else None
    exe = InstalledApp.inspect(build, 'win32').executable if build and build.exists() else None
    wsl.write_launcher(DATA, app.executable, exe, stock_files(app))
    wsl.write_shortcut(DESKTOP, DATA, exe or app.executable)


def current_executable(state):
    if state.get('build'):
        root = Path(state['build'])
        if SYSTEM == 'linux' and not WINDOWS_FROM_WSL:
            return root / 'AppRun'
        if MAC:
            return root / 'inject.cjs'
        if WINDOWS_FROM_WSL and root.exists():
            return InstalledApp.inspect(root, APP_SYSTEM).executable
        if root.exists():
            return InstalledApp.inspect(root, SYSTEM).executable
    return CURRENT / 'AppRun' if SYSTEM == 'linux' and not WINDOWS_FROM_WSL else DATA / 'missing-build'


def cmd_build(args):
    try:
        build(args)
    finally:
        # A failed or interrupted Windows build must not leave a copy of the app on the Windows drive.
        if WINDOWS_FROM_WSL and (DATA / 'work').is_dir():
            for leftover in (DATA / 'work').iterdir():
                wsl.windows_remove_tree(leftover)


def build(args):
    started = time.time()
    if not shutil.which('git'):
        raise Stop('git is required. Install it and run again.')
    if not args.no_pull and not args.resume:
        pull_latest()
    app = installed_app(args.app)
    if args.app:
        save(CONFIG / 'config.json', {**load(CONFIG / 'config.json', {}), 'app': str(app.path)})
    say('T3 Code: ' + str(app.path))
    if MAC and electron_fuses(app.path).get('EnableNodeCliInspectArguments') != '1':
        raise Stop('This T3 Code no longer lets a launcher hook into its startup, so the customization cannot load\n'
                   'into the signed app. Your current T3 Code is untouched.')
    stock_fingerprint = fingerprint(app)
    state = load(STATE, {})
    recipe = recipe_hash()
    if (not args.force and not args.resume and state.get('stock') == stock_fingerprint
            and state.get('recipe') == recipe and current_executable(state).exists()):
        install_launcher(app)
        say(f'\nAlready up to date. Open "{LAUNCHER_NAME}" from your app launcher.')
        return
    DATA.mkdir(parents=True, exist_ok=True)
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    job = CACHE / 'work' / time.strftime('%Y%m%d-%H%M%S')
    job.mkdir(parents=True)
    # The Windows app copy is assembled on the Windows drive, where it is finally moved and run.
    app_job = DATA / 'work' / job.name if WINDOWS_FROM_WSL else job
    app_job.mkdir(parents=True, exist_ok=True)
    with (logs / (job.name + '.log')).open('w', encoding='utf-8') as log:
        say('Log: ' + log.name)
        step('Reading your T3 Code...')
        # On macOS the signed app is read in place and never copied or changed.
        stock_root = app if MAC else app.copy_to(app_job, run, log)
        # Reading the Windows drive through /mnt/c is slow; read Linux copies of its archives instead.
        reads = stage_stock_resources(stock_root, job) if WINDOWS_FROM_WSL else stock_root.resources
        archive = Archive(reads / 'app.asar')
        try:
            metadata = json.loads(archive.read('package.json'))
        finally:
            archive.close()
        server = reads / 'server.asar'
        archive = Archive(server if server.is_file() else reads / 'app.asar')
        try:
            config = read_public_config(archive)
        finally:
            archive.close()
        version, commit = metadata['version'], metadata.get('t3codeCommitHash', '')
        if not re.fullmatch(r'[0-9a-f]{7,40}', commit):
            raise Stop('This application does not record its source commit, so it cannot be rebuilt exactly.')
        channel = 'Nightly' if 'nightly' in version else 'Release'
        say(f'    {channel} {version}, upstream commit {commit[:12]}')
        runtime = (stock_root.resources / wsl.WSL_RUNTIME_ARCHIVE).is_file() and app.system == 'win32'
        if runtime and (SYSTEM != 'linux' or host_arch() != 'x64'):
            # Upstream builds the WSL runtime on Linux; a Windows host cannot make the Linux executable.
            say('    Note: the WSL runtime stays stock on this host. Run the tool inside WSL to patch it too.')
            runtime = False
        if len(config) != len(PUBLIC_CONFIG):
            say('    Note: could not read T3 Connect config from your app; sign-in may not work in this build.')
        target = ensure_commit(commit, version, log)
        global PATCH_SET
        PATCH_SET = choose_patch_set(target)
        if PATCH_SET is None:
            raise Stop(f'T3 Code {version} is older than every patch set in {REPO / "patches"}. '
                       f'Update T3 Code, then run {NAME} again. Your current T3 Code is untouched.')
        if patch_base() != target:
            say(f'    No patch set for {version} yet; porting the {PATCH_SET.name} set.')
        node_bin = ensure_node(log, required_node(target))
        env = build_env(node_bin)
        step('Applying the patches...')
        attempts = 2
        resume = ported = args.resume
        agent = None
        while True:
            try:
                prepare(target, log, resume=resume)
                install_dependencies(env, log)
                if not args.skip_checks:
                    checks(env, log)
                break
            except NeedsFix as problem:
                if older_than_patches(target):
                    raise Stop(stuck_message(problem, target))
                say(str(problem))
                agent = agent or choose_agent(args.fix)
                if not agent or attempts == 0:
                    raise NeedsFix(stuck_message(problem, target))
                attempts -= 1
                agent_fix(agent, str(problem), target, version, log)
                resume = ported = True
        head = git('rev-parse', 'HEAD').strip()
        build_bundles(env, version, stock_root, config, log, runtime=runtime)
        if git('rev-parse', 'HEAD').strip() != head:
            raise Stop('The source checkout changed during the build.')
        step('Assembling and verifying your customized app...')
        runtime_digest = None
        if MAC:
            assembled = job / 'build'
            assemble_mac(app, assembled, SOURCE, config)
        else:
            overlay_app(stock_root, job, config, reads)
            runtime_digest = assemble_wsl_runtime(stock_root, job, version, log, reads) if runtime else None
            finalize_copy(stock_root, run, log)
            assembled = stock_root.path
        if fingerprint(app) != stock_fingerprint:
            raise Stop('The installed T3 Code changed during the build. Run again for its new version.')
        if ported:
            export_patches(target, version)
        build_dir = DATA / 'builds' / f'{version}-{recipe_hash()}-{job.name}'
        build_dir.mkdir(parents=True)
        destination = build_dir / assembled.name
        shutil.move(str(assembled), destination)
        save(STATE, {'stock': stock_fingerprint, 'version': version, 'commit': target, 'recipe': recipe_hash(),
                     'build': str(destination), 'connect': len(config) == len(PUBLIC_CONFIG),
                     **({'wslRuntime': 'sha256-' + runtime_digest} if not MAC and runtime_digest else {}),
                     'builtAt': time.strftime('%Y-%m-%dT%H:%M:%S')})
        icon = destination / 't3code.png'
        if icon.exists():
            shutil.copy2(icon, DATA / 'icon.png')
        prune()
    shutil.rmtree(job, ignore_errors=True)
    if app_job != job:
        wsl.windows_remove_tree(app_job)
    install_launcher(app)
    minutes = max(1, round((time.time() - started) / 60))
    say(f'\nDone in {minutes} min: T3 Code {version} with the stats bar.')
    if ported:
        say(f'The ported patches were saved to {REPO / "patches" / version}.')
    if DISABLED.exists():
        say(f'Customization is switched off. Run {NAME} on to use it.')
    else:
        say(f'Quit T3 Code fully, then open "{LAUNCHER_NAME}" from your app launcher.')
        say('First time? Turn on Settings > Appearance > Stats for nerds.')


def export_patches(target, version):
    """Keep a port as this release's own patch set; the set it came from stays for older installs."""
    global PATCH_SET
    source_checks = checks_file()
    out = REPO / 'patches' / version
    out.mkdir(parents=True, exist_ok=True)
    for path in out.glob('*.patch'):
        path.unlink()
    git('format-patch', '--quiet', '--no-signature', '--zero-commit', '-o', str(out), target + '..HEAD', capture=False)
    (out / 'base.txt').write_text(target + '\n')
    if source_checks != out / 'checks.json':
        shutil.copy2(source_checks, out / 'checks.json')
    PATCH_SET = out


def prune(keep=3):
    """Drop old builds, keeping the newest few so a running instance never loses its files."""
    state = load(STATE, {})
    current = Path(state['build']).parent if state.get('build') else CURRENT.resolve()
    builds = sorted((DATA / 'builds').iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
    for old in builds[keep:]:
        # A Windows process holds its files open; never delete a build that is still running.
        if old.resolve() != current and not (WINDOWS_FROM_WSL and wsl.windows_processes_from(old)):
            (wsl.windows_remove_tree if WINDOWS_FROM_WSL else lambda p: shutil.rmtree(p, ignore_errors=True))(old)


def cmd_verify(args):
    """Apply each patch set to its base and run its checks. No installed app needed."""
    global PATCH_SET
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    sets = patch_sets()
    if args.patch_set != 'all':
        sets = [folder for folder in sets if folder.name == args.patch_set]
        if not sets:
            raise Stop(f'No patch set named {args.patch_set}. Sets: ' + ', '.join(f.name for f in patch_sets()))
    for folder in sets:
        PATCH_SET = folder
        base = patch_base()
        with (logs / ('verify-' + folder.name + '-' + time.strftime('%Y%m%d-%H%M%S') + '.log')).open('w', encoding='utf-8') as log:
            say(f'Patch set {folder.name}. Log: ' + log.name)
            target = ensure_commit(base, None, log)
            env = build_env(ensure_node(log, required_node(target)))
            prepare(target, log)
            install_dependencies(env, log)
            checks(env, log)
        say(f'Patch set {folder.name} applies and passes its checks on {base[:12]}.')


def stock_target(app):
    """What launching stock means: the app bundle on macOS, its executable elsewhere."""
    return app.path if MAC else app.executable


def launch_target():
    """Use the customized build only while it matches the installed application."""
    app = installed_app()
    state = load(STATE, {})
    built = current_executable(state)
    if DISABLED.exists() or not built.exists():
        return stock_target(app), None
    if state.get('stock') != fingerprint(app):
        return stock_target(app), f'T3 Code was updated. Run {NAME} in a terminal to bring the stats bar back.'
    # On macOS the target is the build folder holding the loader and the overlay.
    return (built.parent if MAC else built).resolve(), None


def notify(title, message):
    say(message)
    if MAC:
        script = f'display notification {json.dumps(message)} with title {json.dumps(title)}'
        subprocess.run(['osascript', '-e', script], check=False)
    elif shutil.which('notify-send'):
        subprocess.run(['notify-send', '-a', 'T3 Code', title, message], check=False)


def mac_running():
    script = f'application id "{MAC_BUNDLE_ID}" is running'
    return subprocess.run(['osascript', '-e', script], capture_output=True, text=True).stdout.strip() == 'true'


def free_port():
    with socket.socket() as probe:
        probe.bind(('127.0.0.1', 0))
        return probe.getsockname()[1]


def launch_mac(app, target, rest):
    rest = [arg for arg in rest if not arg.startswith('-psn_')]
    if mac_running():
        # A running T3 Code keeps what it started with; this only brings it forward.
        subprocess.run(['open', str(app.path)], check=False)
        return
    if target == app.path:
        os.execvp('open', ['open', str(app.path), *(['--args', *rest] if rest else [])])
    # T3 Code waits at its first line until connect.mjs has loaded the build into it.
    port = free_port()
    subprocess.run(['open', str(app.path), '--args', f'--inspect-brk=127.0.0.1:{port}', *rest], check=True)
    result = subprocess.run([str(app.executable), str(target / 'connect.mjs'), str(port),
                             str(target / 'inject.cjs'), str(target / 'overlay')],
                            env={**os.environ, 'ELECTRON_RUN_AS_NODE': '1'}, capture_output=True, text=True)
    if result.returncode:
        notify('Opened stock T3 Code', (result.stderr.strip().splitlines() or ['The customization did not load.'])[-1])
    else:
        say(f'Opened T3 Code with the customization from {target}.')


def cmd_launch(args):
    if WINDOWS_FROM_WSL:
        # The launcher script decides, exactly as the Start menu shortcut does.
        rest = args.rest[1:] if args.rest[:1] == ['--'] else args.rest
        if not (DATA / 'launch.ps1').exists():
            raise Stop(f'No launcher yet. Run {NAME} first.')
        subprocess.Popen([wsl.powershell(), '-NoProfile', '-ExecutionPolicy', 'Bypass', '-File',
                          wsl.to_windows_path(DATA / 'launch.ps1'), *rest], cwd='/mnt/c',
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        say(f'Opening {LAUNCHER_NAME}...')
        return
    app = installed_app()
    target, notice = launch_target()
    if notice:
        notify('Opening stock T3 Code', notice)
    rest = args.rest[1:] if args.rest[:1] == ['--'] else args.rest
    if MAC:
        return launch_mac(app, target, rest)
    env = os.environ.copy()
    for key in ('ELECTRON_RUN_AS_NODE', 'ELECTRON_NO_ASAR', 'NODE_OPTIONS'):
        env.pop(key, None)
    if target != app.executable and SYSTEM == 'linux':
        # Run the extracted copy as if it were the AppImage, so T3's own updater still updates the real file.
        env['APPIMAGE'] = str(app.path)
        env['APPDIR'] = str(target.parent)
    elif target != app.executable:
        env['T3CODE_DISABLE_AUTO_UPDATE'] = 'true'
    if SYSTEM == 'win32':
        # DETACHED_PROCESS only exists on Windows builds of Python.
        subprocess.Popen([str(target), *rest], env=env, creationflags=getattr(subprocess, 'DETACHED_PROCESS', 0x8))
    else:
        os.execve(str(target), [str(target), *rest], env)


def cmd_status(args):
    app = installed_app()
    state = load(STATE, {})
    target, notice = launch_target()
    say('Installed T3 Code:  ' + str(app.path))
    say('Customized build:   ' + (f"{state['version']} (built {state['builtAt']})" if state else 'none yet'))
    say('Switched:           ' + ('off' if DISABLED.exists() else 'on'))
    say('Next launch opens:  ' + ('customized build' if target != stock_target(app) else 'stock T3 Code'))
    if WINDOWS_FROM_WSL:
        say('WSL runtime:        ' + (state.get('wslRuntime') or 'stock'))
        say('Launcher:           ' + str(DESKTOP))
    if notice:
        say(notice)


def runtime_processes(home=None):
    """WSL runtime folders that running T3 backends execute from, by runtime id."""
    parent = str((home or HOME) / '.t3/wsl-runtime') + '/'
    found = {}
    for cmdline in Path('/proc').glob('[0-9]*/cmdline'):
        try:
            args = cmdline.read_bytes().split(b'\0')
        except OSError:
            continue
        if args and args[0].decode(errors='replace').startswith(parent):
            runtime = args[0].decode(errors='replace')[len(parent):].split('/')[0]
            found.setdefault(runtime, []).append(cmdline.parent.name)
    return found


def turn_summary(turn):
    """One line of a provider turn's stats: timing and usage only, never message content."""
    perf, usage = turn.get('performance') or {}, turn.get('turnTokenUsage') or {}
    tokens, gen_ms = perf.get('generationTokens') or {}, perf.get('generationMs')
    rate = (f"{tokens['value'] / gen_ms * 1000:.0f} tok/s ({tokens['basis']})"
            if tokens and gen_ms and gen_ms >= 1000 else 'n/a')
    tools = perf.get('tools') or {}
    def ms(key):
        return f'{perf[key] / 1000:.1f}s' if isinstance(perf.get(key), (int, float)) else '—'
    return (f"{turn.get('status')}: TTFT {ms('firstTokenMs')} ({perf.get('firstTokenKind', '—')}), TTFA {ms('firstAnswerMs')}, "
            f"avg {rate}, tools {tools.get('count', '—')} / {ms_text(tools.get('wallMs'))}, turn {ms('turnMs')}, "
            f"out {usage.get('outputTokens', '—')}, cached {usage.get('cachedInputTokens', '—')}/{usage.get('inputTokens', '—')}"
            + (' [partial]' if perf.get('partial') else '') + ('' if perf else ' [no stream timing]'))


def ms_text(value):
    return f'{value / 1000:.1f}s' if isinstance(value, (int, float)) else '—'


def cmd_check(args):
    """Read-only: the running runtime, T3 data counts and the latest turn stats per provider."""
    import sqlite3
    state = load(STATE, {})
    ours = state.get('wslRuntime')
    say('Customized build:  ' + (f"{state['version']} (built {state['builtAt']})" if state else 'none'))
    say('Its WSL runtime:   ' + (ours or 'stock'))
    running = runtime_processes()
    for runtime, pids in sorted(running.items()):
        label = 'customized' if runtime == ours else 'stock or other build'
        say(f'Running runtime:   {runtime[:19]}… ({label}, {len(pids)} process(es))')
    if not running:
        say('Running runtime:   none in this distro')
    if WINDOWS_FROM_WSL:
        app = installed_app()
        builds = [p for p in wsl.windows_processes_from(DATA / 'builds')]
        stock = [p for p in wsl.windows_processes_from(app.path)]
        say('Windows desktop:   ' + ('customized' if builds else 'stock' if stock else 'not running'))
    database = HOME / '.t3/userdata/statev2.sqlite'
    if not database.exists():
        say('No T3 state database at ' + str(database))
        return
    db = sqlite3.connect(f'file:{database}?mode=ro', uri=True)
    try:
        counts = {name: db.execute(f'SELECT count(*) FROM {table}').fetchone()[0] for name, table in
                  (('projects', 'projection_projects'), ('threads', 'orchestration_v2_projection_threads'))}
        say(f"Your data:         {counts['projects']} projects, {counts['threads']} threads")
        latest = {}
        for (payload,) in db.execute('SELECT payload_json FROM orchestration_v2_projection_provider_turns ORDER BY rowid DESC LIMIT 2000'):
            turn = json.loads(payload)
            match = re.match(r'provider-turn:provider:([^:]+):', turn.get('id', ''))
            provider = match.group(1) if match else 'other'
            if provider not in latest and turn.get('status') != 'running':
                latest[provider] = turn
    finally:
        db.close()
    say('\nLatest finished turn per provider:')
    for provider, turn in sorted(latest.items()):
        say(f'  {provider:12} {turn_summary(turn)}')


def cmd_on(args):
    DISABLED.unlink(missing_ok=True)
    say('Customization on. Quit T3 Code fully and reopen it' +
        (f' from "{LAUNCHER_NAME}".' if WINDOWS_FROM_WSL else '.'))


def cmd_off(args):
    DATA.mkdir(parents=True, exist_ok=True)
    DISABLED.touch()
    say('Stock T3 Code on the next launch. Quit it fully and reopen it.')


def remove_customized_runtime(state):
    """Drop the customized WSL runtime cache unless a running backend still uses it."""
    runtime = state.get('wslRuntime')
    if not runtime or not re.fullmatch(r'sha256-[0-9a-f]{64}', runtime):
        return
    root = HOME / '.t3/wsl-runtime' / runtime
    if not root.is_dir():
        return
    needle = (str(root) + '/').encode()
    for cmdline in Path('/proc').glob('[0-9]*/cmdline'):
        try:
            if needle in cmdline.read_bytes():
                say(f'Kept {root}: a running T3 backend uses it. T3 removes it later on its own.')
                return
        except OSError:
            continue
    shutil.rmtree(root, ignore_errors=True)


def cmd_uninstall(args):
    if WINDOWS_FROM_WSL:
        running = wsl.windows_processes_from(DATA)
        if running:
            raise Stop('The customized T3 Code is running. Quit it fully, then uninstall again.')
        remove_customized_runtime(load(STATE, {}))
    BIN.unlink(missing_ok=True)
    DESKTOP.unlink(missing_ok=True)
    if MAC:
        shutil.rmtree(MAC_LAUNCHER, ignore_errors=True)
    for folder in (DATA, CACHE, CONFIG):
        if folder.exists():
            wsl.windows_remove_tree(folder) if WINDOWS_FROM_WSL and folder == DATA else shutil.rmtree(folder)
    tail = '' if DATA in REPO.parents else f' You can delete {REPO} too.'
    say('Removed t3code-customize, its launcher, builds and caches. Your T3 Code and its data are untouched.' + tail)
    if WINDOWS_FROM_WSL:
        # A WSL host bridge link is an ordinary T3 link; it outlives the customization until revoked.
        say('A WSL host bridge link, if you made one, stays in T3 until you revoke it: `t3 environment unlink '
            '<windows-environment-id>` in WSL, or Settings > Sharing & access on Windows.')


def main():
    parser = argparse.ArgumentParser(prog=NAME, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog='With no command, it updates the patches and builds for your installed T3 Code.')
    sub = parser.add_subparsers(dest='command')

    def build_options(p):
        p.add_argument('--app', '--appimage', dest='app',
                       help='installed AppImage, macOS T3 Code (Nightly).app or Windows executable (remembered)')
        p.add_argument('--fix', choices=sorted(AGENTS), help='if a nightly breaks the patches, let this agent port them without asking')
        p.add_argument('--resume', action='store_true', help='continue from the source checkout as you or your agent left it')
        p.add_argument('--skip-checks', action='store_true', help='skip the patch tests and typechecks')
        p.add_argument('--force', action='store_true', help='rebuild even if nothing changed')
        p.add_argument('--no-pull', action='store_true', help='do not fetch newer patches first')
        p.add_argument('--target', choices=('windows', 'linux'),
                       help='in WSL: build for the Windows T3 Code (and its WSL runtime) or a Linux AppImage (remembered)')

    build_options(sub.add_parser('build', help='update the patches and build (the default)'))
    launch = sub.add_parser('launch', help='open the customized build if it matches your T3 Code, else stock')
    launch.add_argument('rest', nargs=argparse.REMAINDER)
    sub.add_parser('status', help='show what the next launch opens')
    sub.add_parser('check', help='read-only: which runtime runs, your data counts and the latest stats per provider')
    sub.add_parser('on', help='use the customized build')
    sub.add_parser('off', help='go back to stock T3 Code')
    verify = sub.add_parser('verify', help='apply each patch set to its base and run its checks (for CI)')
    verify.add_argument('--patch-set', default='all', help='one release, such as 0.1.13, or all (default)')
    sub.add_parser('uninstall', help='remove the launcher, builds and caches')
    argv = sys.argv[1:]
    if not argv or argv[0].startswith('-') and argv[0] not in ('-h', '--help'):
        argv = ['build', *argv]
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return
    target = getattr(args, 'target', None)
    if target:
        CONFIG.mkdir(parents=True, exist_ok=True)
        save(CONFIG / 'config.json', {**load(CONFIG / 'config.json', {}), 'target': target})
    configure(target == 'windows' if target else detect_windows_target())
    handler = globals()['cmd_' + args.command]
    if args.command in ('launch', 'status', 'on', 'off', 'check'):
        return handler(args)
    CACHE.mkdir(parents=True, exist_ok=True)
    # Keep the coordination file outside the removable installation. On Windows
    # a locked file cannot be deleted, and deleting it on POSIX breaks exclusion.
    with build_lock(LOCK):
        handler(args)


if __name__ == '__main__':
    try:
        main()
    except (Stop, PlatformError, OSError, wsl.WslError) as stop:
        print(f'\n{stop}', file=sys.stderr)
        sys.exit(3 if isinstance(stop, NeedsFix) else 1)
    except KeyboardInterrupt:
        print('\nStopped. Your T3 Code is untouched.', file=sys.stderr)
        sys.exit(130)
