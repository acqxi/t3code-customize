+import type {
+  ModelSelection,
+  OrchestrationV2ProviderTurn,
+  OrchestrationV2ThreadProjection,
+  OrchestrationV2TurnPerformance,
+  ProviderTurnId,
+} from "@t3tools/contracts";
+import { formatDuration } from "@t3tools/shared/orchestrationTiming";
+import * as DateTime from "effect/DateTime";
+
+import {
+  deriveResponseRate,
+  deriveTurnCachePercentage,
+  deriveTurnElapsedMs,
+  formatCachePercentage,
+} from "./ComposerStats.logic";
+
+/** Average tokens/s needs at least this much streaming; shorter replies arrive in network bursts. */
+export const MIN_EXACT_GENERATION_MS = 1000;
+
+/**
+ * Stats for nerds turn metrics. Ids are persisted in `statsForNerdsHiddenMetrics`, so they never
+ * change meaning. Definitions: docs/performance-metrics.md in t3code-customize.
+ */
+export const TURN_PERFORMANCE_METRIC_IDS = [
+  "ttft",
+  "ttfa",
+  "liveTps",
+  "avgTps",
+  "peakTps",
+  "inputTokens",
+  "outputTokens",
+  "reasoningTokens",
+  "cachedTokens",
+  "cacheHitRate",
+  "context",
+  "toolTime",
+  "turnTime",
+  "provider",
+  "model",
+  "reasoningEffort",
+  "speedMode",
+] as const;
+export type TurnPerformanceMetricId = (typeof TURN_PERFORMANCE_METRIC_IDS)[number];
+
+export type MetricPrecision = "exact" | "estimated" | "unavailable";
+
+export interface TurnPerformanceMetric {
+  readonly id: TurnPerformanceMetricId;
+  readonly precision: MetricPrecision;
+  readonly value: number | string | null;
+  /** Formatted value with unit, without the precision marker. Empty when unavailable. */
+  readonly text: string;
+  /** What the UI prints: plain, `≈`-prefixed, or `—`. */
+  readonly display: string;
+  /** Tooltip: how the value was measured, or why it is unavailable. */
+  readonly reason: string;
+  /** Measured from incomplete data (interrupt, missed events, open tool calls). */
+  readonly partial: boolean;
+  /** A different measurement shown under its own label (legacy response throughput). */
+  readonly variant?: "legacyResponseRate";
+}
+
+export const ESTIMATE_PREFIX = "≈";
+export const UNAVAILABLE_TEXT = "—";
+
+/** Everything the rows are derived from, scoped to one provider turn of one thread. */
+export interface TurnPerformanceSource {
+  readonly turn: OrchestrationV2ProviderTurn;
+  /** The provider thread's driver kind (claudeAgent, codex, …). */
+  readonly driver: string | undefined;
+  /** Display name used in "unavailable" tooltips. */
+  readonly providerName: string;
+  /** What the run requested; null when unknown. */
+  readonly modelSelection: ModelSelection | null;
+}
+
+export interface TurnPerformanceInput extends TurnPerformanceSource {
+  /** Context occupancy to show for this turn; null when not reported. */
+  readonly context: {
+    readonly usedTokens: number;
+    readonly maxTokens?: number | null | undefined;
+  } | null;
+  /** Client-side live rate from {@link createLiveRateSampler}; only used while the turn runs. */
+  readonly liveTokensPerSecond: number | null;
+  readonly nowMs: number;
+}
+
+export function isTurnRunning(turn: Pick<OrchestrationV2ProviderTurn, "status">): boolean {
+  return turn.status === "running" || turn.status === "pending";
+}
+
+export function isTurnSettled(turn: Pick<OrchestrationV2ProviderTurn, "status">): boolean {
+  return !isTurnRunning(turn);
+}
+
+function finite(value: number | undefined | null): value is number {
+  return typeof value === "number" && Number.isFinite(value);
+}
+
+export function formatMs(ms: number): string {
+  if (ms < 1_000) return `${Math.max(0, Math.round(ms))} ms`;
+  if (ms < 60_000) return `${(Math.round(ms / 100) / 10).toFixed(1)} s`;
+  return formatDuration(ms);
+}
+
+export function formatTokensPerSecond(rate: number): string {
+  const digits = rate < 10 ? 1 : 0;
+  return `${rate.toLocaleString("en-US", { maximumFractionDigits: digits, minimumFractionDigits: digits })} tok/s`;
+}
+
+export function formatTokenCount(value: number): string {
+  return value.toLocaleString("en-US");
+}
+
+function displayOf(precision: MetricPrecision, text: string): string {
+  return precision === "unavailable"
+    ? UNAVAILABLE_TEXT
+    : precision === "estimated"
+      ? `${ESTIMATE_PREFIX}${text}`
+      : text;
+}
+
+function metric(
+  id: TurnPerformanceMetricId,
+  precision: MetricPrecision,
+  value: number | string | null,
+  text: string,
+  reason: string,
+  partial = false,
+  variant?: TurnPerformanceMetric["variant"],
+): TurnPerformanceMetric {
+  return {
+    id,
+    precision,
+    value: precision === "unavailable" ? null : value,
+    text: precision === "unavailable" ? "" : text,
+    display: displayOf(precision, text),
+    reason,
+    partial,
+    ...(variant === undefined ? {} : { variant }),
+  };
+}
+
+function unavailable(id: TurnPerformanceMetricId, reason: string): TurnPerformanceMetric {
+  return metric(id, "unavailable", null, "", reason);
+}
+
+function noStreamTiming(providerName: string): string {
+  return `${providerName} does not expose stream timing for this turn.`;
+}
+
+const FIRST_TOKEN_KIND_LABEL: Record<
+  NonNullable<OrchestrationV2TurnPerformance["firstTokenKind"]>,
+  string
+> = {
+  reasoning: "reasoning",
+  text: "answer",
+  tool_input: "tool arguments",
+};
+
+const GENERATION_BASIS_REASON: Record<
+  NonNullable<OrchestrationV2TurnPerformance["generationTokens"]>["basis"],
+  string
+> = {
+  provider_exact: "provider-counted output tokens for exactly these generation windows",
+  provider_total: "the provider's exact turn output total spread over the measured windows",
+  estimated: "streamed characters ÷ 4 (from characters)",
+};
+
+function partialNote(performance: OrchestrationV2TurnPerformance): string {
+  return performance.partial ? " Partial: some events were missed or cut short." : "";
+}
+
+function deriveTtft(
+  performance: OrchestrationV2TurnPerformance | undefined,
+  running: boolean,
+  providerName: string,
+): TurnPerformanceMetric {
+  if (performance === undefined) return unavailable("ttft", noStreamTiming(providerName));
+  if (!finite(performance.firstTokenMs)) {
+    return unavailable(
+      "ttft",
+      running
+        ? "Waiting for the first generated token."
+        : `${providerName} streamed no generated token on this turn.`,
+    );
+  }
+  const kind = performance.firstTokenKind
+    ? ` First token: ${FIRST_TOKEN_KIND_LABEL[performance.firstTokenKind]}.`
+    : "";
+  return metric(
+    "ttft",
+    "exact",
+    performance.firstTokenMs,
+    formatMs(performance.firstTokenMs),
+    `Request sent to the first generated token, timed on the T3 server.${kind}${partialNote(performance)}`,
+    performance.partial,
+  );
+}
+
+function deriveTtfa(
+  performance: OrchestrationV2TurnPerformance | undefined,
+  running: boolean,
+  providerName: string,
+): TurnPerformanceMetric {
+  if (performance === undefined) return unavailable("ttfa", noStreamTiming(providerName));
+  if (!finite(performance.firstAnswerMs)) {
+    return unavailable(
+      "ttfa",
+      running ? "Waiting for the first answer text." : "This turn produced no answer text.",
+    );
+  }
+  return metric(
+    "ttfa",
+    "exact",
+    performance.firstAnswerMs,
+    formatMs(performance.firstAnswerMs),
+    `Request sent to the first visible answer text; reasoning does not count.${partialNote(performance)}`,
+    performance.partial,
+  );
+}
+
+/**
+ * Average generation speed: generation tokens over the sum of active generation windows.
+ * Turn duration is never a denominator.
+ */
+export function deriveAverageTps(
+  turn: OrchestrationV2ProviderTurn,
+  providerName: string,
+): TurnPerformanceMetric {
+  const performance = turn.performance;
+  const tokens = performance?.generationTokens;
+  const generationMs = performance?.generationMs;
+  if (
+    performance !== undefined &&
+    tokens !== undefined &&
+    finite(generationMs) &&
+    generationMs > 0 &&
+    Number.isSafeInteger(tokens.value) &&
+    tokens.value >= 0
+  ) {
+    const rate = tokens.value / (generationMs / 1000);
+    const windows =
+      performance.generationWindows === undefined
+        ? ""
+        : ` across ${performance.generationWindows} window${performance.generationWindows === 1 ? "" : "s"}`;
+    // Under a second of streaming, network delivery bursts, not the model, set the measured time.
+    if (generationMs < MIN_EXACT_GENERATION_MS) {
+      return unavailable(
+        "avgTps",
+        `Only ${formatMs(generationMs)} of streaming: too short to time. Output arrives in network bursts, so a rate here would read far too high.`,
+      );
+    }
+    return metric(
+      "avgTps",
+      tokens.basis === "provider_exact" ? "exact" : "estimated",
+      rate,
+      formatTokensPerSecond(rate),
+      `${formatTokenCount(tokens.value)} tokens over ${formatMs(generationMs)} of active generation${windows}: ${GENERATION_BASIS_REASON[tokens.basis]}. Tools, approvals and time before the first token are excluded.${partialNote(performance)}`,
+      performance.partial,
+    );
+  }
+  if (performance === undefined) {
+    const legacy = deriveResponseRate(turn);
+    if (legacy !== null) {
+      const estimated = turn.responseThroughput?.basis === "codex_active_windows_estimate";
+      return metric(
+        "avgTps",
+        estimated ? "estimated" : "exact",
+        legacy,
+        formatTokensPerSecond(legacy),
+        estimated
+          ? "Response rate (older measurement): Codex-reported turn output tokens divided by estimated response-active time."
+          : "Response rate (older measurement): Claude-reported output tokens divided by observed response start-to-stop time, including network and server-side waits.",
+        turn.responseThroughput?.partial ?? false,
+        "legacyResponseRate",
+      );
+    }
+    return unavailable("avgTps", noStreamTiming(providerName));
+  }
+  return unavailable(
+    "avgTps",
+    isTurnRunning(turn)
+      ? "Available once a generation window closes."
+      : "No generation window with a token count was measured on this turn.",
+  );
+}
+
+function derivePeakTps(
+  performance: OrchestrationV2TurnPerformance | undefined,
+  providerName: string,
+): TurnPerformanceMetric {
+  if (performance === undefined) return unavailable("peakTps", noStreamTiming(providerName));
+  const peak = performance.peakTokensPerSecond;
+  if (peak === undefined || !finite(peak.value)) {
+    return unavailable(
+      "peakTps",
+      "Needs at least 2 s of continuous generation; shorter bursts never produce a peak.",
+    );
+  }
+  return metric(
+    "peakTps",
+    "estimated",
+    peak.value,
+    formatTokensPerSecond(peak.value),
+    `Highest rate over any ${peak.windowMs} ms sliding window (${peak.basis === "calibrated_estimate" ? "calibrated to the exact output count" : "from streamed characters"}).${partialNote(performance)}`,
+    performance.partial,
+  );
+}
+
+function deriveLiveTps(
+  running: boolean,
+  rate: number | null,
+  providerName: string,
+): TurnPerformanceMetric | null {
+  if (!running) return null;
+  if (rate === null || !finite(rate)) {
+    return unavailable(
+      "liveTps",
+      `Measuring: needs streamed answer or reasoning text from ${providerName}.`,
+    );
+  }
+  return metric(
+    "liveTps",
+    "estimated",
+    rate,
+    formatTokensPerSecond(rate),
+    "Rate over the last 2 seconds from streamed answer and reasoning characters (≈ 4 characters per token).",
+  );
+}
+
+function deriveTokenMetrics(
+  turn: OrchestrationV2ProviderTurn,
+  driver: string | undefined,
+  providerName: string,
+): ReadonlyArray<TurnPerformanceMetric> {
+  const usage = turn.turnTokenUsage;
+  const available = usage !== undefined && usage.usageStatus !== "unavailable" ? usage : undefined;
+  const partial = available?.usageStatus === "partial";
+  const reportNote = partial ? " Partial report: covers only what the provider reported." : "";
+  const notReported = (what: string) =>
+    isTurnRunning(turn) && usage === undefined
+      ? `${providerName} reports ${what} when the turn ends.`
+      : `${providerName} did not report ${what} for this turn.`;
+  const count = (
+    id: TurnPerformanceMetricId,
+    value: number | undefined,
+    what: string,
+    reason: string,
+  ) =>
+    finite(value)
+      ? metric(id, "exact", value, formatTokenCount(value), `${reason}${reportNote}`, partial)
+      : unavailable(id, notReported(what));
+
+  const reasoning =
+    driver === "claudeAgent" && !finite(available?.reasoningTokens)
+      ? unavailable(
+          "reasoningTokens",
+          `${providerName} folds reasoning into output tokens and does not report it separately.`,
+        )
+      : count(
+          "reasoningTokens",
+          available?.reasoningTokens,
+          "reasoning tokens",
+          "Provider-reported reasoning tokens for the main agent (part of output).",
+        );
+
+  const cachePercentage = deriveTurnCachePercentage(available);
+  const cacheHitRate =
+    cachePercentage === null || available === undefined
+      ? unavailable(
+          "cacheHitRate",
+          available?.inputTokens === 0
+            ? "No input tokens on this turn."
+            : notReported("cached input tokens"),
+        )
+      : metric(
+          "cacheHitRate",
+          "exact",
+          cachePercentage,
+          formatCachePercentage(cachePercentage),
+          `Cached input ÷ total input: ${formatTokenCount(available.cachedInputTokens ?? 0)} of ${formatTokenCount(available.inputTokens ?? 0)} tokens. Input already includes cache reads and writes.${reportNote}`,
+          partial,
+        );
+
+  return [
+    count(
+      "inputTokens",
+      available?.inputTokens,
+      "input tokens",
+      `Provider-reported main-agent input, including cache reads${finite(available?.cacheCreationTokens) ? ` and ${formatTokenCount(available.cacheCreationTokens)} cache-write tokens` : " and writes"}.`,
+    ),
+    count(
+      "outputTokens",
+      available?.outputTokens,
+      "output tokens",
+      "Provider-reported main-agent output, including reasoning and tool arguments.",
+    ),
+    reasoning,
+    count(
+      "cachedTokens",
+      available?.cachedInputTokens,
+      "cached input tokens",
+      "Provider-reported input served from the prompt cache.",
+    ),
+    cacheHitRate,
+  ];
+}
+
+function deriveContext(
+  context: TurnPerformanceInput["context"],
+  providerName: string,
+): TurnPerformanceMetric {
+  if (context === null || !finite(context.usedTokens)) {
+    return unavailable("context", `${providerName} has not reported context occupancy.`);
+  }
+  const max = finite(context.maxTokens) && context.maxTokens > 0 ? context.maxTokens : null;
+  const percent = max === null ? null : (context.usedTokens / max) * 100;
+  const text =
+    max === null
+      ? `${formatTokenCount(context.usedTokens)} tokens`
+      : `${Math.round(percent ?? 0)}% (${formatTokenCount(context.usedTokens)} / ${formatTokenCount(max)})`;
+  return metric(
+    "context",
+    "exact",
+    percent ?? context.usedTokens,
+    text,
+    max === null
+      ? "Provider-reported context usage; the window size was not reported."
+      : "Provider-reported context usage and window size.",
+  );
+}
+
+function deriveToolTime(
+  performance: OrchestrationV2TurnPerformance | undefined,
+  providerName: string,
+): TurnPerformanceMetric {
+  if (performance === undefined) return unavailable("toolTime", noStreamTiming(providerName));
+  const tools = performance.tools;
+  if (tools.count === 0) {
+    return metric("toolTime", "exact", 0, "0 s", "No tool calls on this turn.");
+  }
+  const open = tools.open > 0 ? ` ${tools.open} still open when measured (partial).` : "";
+  return metric(
+    "toolTime",
+    "exact",
+    tools.wallMs,
+    formatMs(tools.wallMs),
+    `Wall-clock time waiting on ${tools.count} tool call${tools.count === 1 ? "" : "s"}; overlapping calls are merged. Longest call: ${formatMs(tools.longestMs)}.${open}`,
+    tools.open > 0,
+  );
+}
+
+function deriveTurnTime(turn: OrchestrationV2ProviderTurn, nowMs: number): TurnPerformanceMetric {
+  const performance = turn.performance;
+  const running = isTurnRunning(turn);
+  if (!running && performance !== undefined && finite(performance.turnMs)) {
+    return metric(
+      "turnTime",
+      "exact",
+      performance.turnMs,
+      formatMs(performance.turnMs),
+      `Request sent to the turn's end, including tools and waits.${partialNote(performance)}`,
+      performance.partial,
+    );
+  }
+  if (running && performance !== undefined) {
+    const sentMs = DateTime.toEpochMillis(performance.requestSentAt);
+    if (Number.isFinite(sentMs) && nowMs >= sentMs) {
+      return metric(
+        "turnTime",
+        "exact",
+        nowMs - sentMs,
+        formatMs(nowMs - sentMs),
+        "Elapsed since the request was sent; the turn is still running.",
+      );
+    }
+  }
+  const elapsed = deriveTurnElapsedMs(
+    { ...turn, status: running ? "running" : turn.status },
+    nowMs,
+  );
+  if (elapsed === null) {
+    return unavailable(
+      "turnTime",
+      running ? "The turn has not started yet." : "The turn's start or end time is missing.",
+    );
+  }
+  return metric(
+    "turnTime",
+    "exact",
+    elapsed,
+    formatMs(elapsed),
+    running
+      ? "Elapsed since the turn started; the turn is still running."
+      : "Turn start to end as recorded by T3, including tools and waits.",
+  );
+}
+
+const EFFORT_OPTION_IDS = ["effort", "reasoningEffort", "thinking", "variant"] as const;
+
+function optionValue(selection: ModelSelection | null, id: string): string | boolean | undefined {
+  return selection?.options?.find((option) => option.id === id)?.value;
+}
+
+export function deriveReasoningEffort(selection: ModelSelection | null): string | null {
+  for (const id of EFFORT_OPTION_IDS) {
+    const value = optionValue(selection, id);
+    if (typeof value === "string" && value.trim() !== "") return value;
+  }
+  return null;
+}
+
+/** Claude fast mode, or Codex service tier (`priority` = fast). */
+export function deriveSpeedMode(
+  selection: ModelSelection | null,
+  driver: string | undefined,
+): string | null {
+  const fastMode = optionValue(selection, "fastMode");
+  if (fastMode === true) return "Fast";
+  if (fastMode === false) return "Standard";
+  const tier = optionValue(selection, "serviceTier");
+  if (typeof tier === "string" && tier.trim() !== "") {
+    if (tier === "priority" || tier === "fast") return "Fast";
+    if (tier === "default" || tier === "standard" || tier === "auto") return "Standard";
+    return tier.charAt(0).toUpperCase() + tier.slice(1);
+  }
+  // Both default to standard speed when nothing is selected.
+  return driver === "claudeAgent" || driver === "codex" ? "Standard" : null;
+}
+
+function deriveSelectionMetrics(
+  source: TurnPerformanceSource,
+): ReadonlyArray<TurnPerformanceMetric> {
+  const { turn, modelSelection, providerName, driver } = source;
+  const requested = modelSelection?.model ?? null;
+  const reported = turn.model ?? null;
+  const model =
+    requested === null && reported === null
+      ? unavailable("model", `${providerName} did not report a model for this turn.`)
+      : requested !== null && reported !== null && requested !== reported
+        ? metric(
+            "model",
+            "exact",
+            reported,
+            `${requested} → ${reported}`,
+            `Requested ${requested}; ${providerName} reported running ${reported}.`,
+          )
+        : metric(
+            "model",
+            "exact",
+            (reported ?? requested)!,
+            (reported ?? requested)!,
+            reported !== null
+              ? `Model ${providerName} reported running this turn.`
+              : "Model requested for this turn.",
+          );
+  const effort = deriveReasoningEffort(modelSelection);
+  const speed = deriveSpeedMode(modelSelection, driver);
+  return [
+    providerName.trim() === ""
+      ? unavailable("provider", "The provider for this turn is unknown.")
+      : metric("provider", "exact", providerName, providerName, "Provider that ran this turn."),
+    model,
+    effort === null
+      ? unavailable(
+          "reasoningEffort",
+          `No reasoning effort was selected for ${providerName} on this turn.`,
+        )
+      : metric("reasoningEffort", "exact", effort, effort, "Reasoning effort requested."),
+    speed === null
+      ? unavailable("speedMode", `${providerName} has no speed mode setting.`)
+      : metric(
+          "speedMode",
+          "exact",
+          speed,
+          speed,
+          driver === "codex" ? "Codex service tier requested." : "Speed mode requested.",
+        ),
+  ];
+}
+
+/** Every metric for one turn, in catalog order. Live tokens/s is left out once the turn ends. */
+export function deriveTurnPerformanceMetrics(
+  input: TurnPerformanceInput,
+): ReadonlyArray<TurnPerformanceMetric> {
+  const { turn, providerName } = input;
+  const performance = turn.performance;
+  const running = isTurnRunning(turn);
+  const live = deriveLiveTps(running, input.liveTokensPerSecond, providerName);
+  const byId = new Map<TurnPerformanceMetricId, TurnPerformanceMetric>();
+  for (const row of [
+    deriveTtft(performance, running, providerName),
+    deriveTtfa(performance, running, providerName),
+    ...(live === null ? [] : [live]),
+    deriveAverageTps(turn, providerName),
+    derivePeakTps(performance, providerName),
+    ...deriveTokenMetrics(turn, input.driver, providerName),
+    deriveContext(input.context, providerName),
+    deriveToolTime(performance, providerName),
+    deriveTurnTime(turn, input.nowMs),
+    ...deriveSelectionMetrics(input),
+  ]) {
+    byId.set(row.id, row);
+  }
+  return TURN_PERFORMANCE_METRIC_IDS.flatMap((id) => {
+    const row = byId.get(id);
+    return row === undefined ? [] : [row];
+  });
+}
+
+export function hiddenMetricSet(
+  hidden: ReadonlyArray<string> | undefined,
+): ReadonlySet<TurnPerformanceMetricId> {
+  const known = new Set<string>(TURN_PERFORMANCE_METRIC_IDS);
+  return new Set((hidden ?? []).filter((id): id is TurnPerformanceMetricId => known.has(id)));
+}
+
+export function filterVisibleMetrics(
+  rows: ReadonlyArray<TurnPerformanceMetric>,
+  hidden: ReadonlySet<string>,
+): ReadonlyArray<TurnPerformanceMetric> {
+  return rows.filter((row) => !hidden.has(row.id));
+}
+
+/** Picks rows by id in the given order, skipping hidden and (optionally) unavailable ones. */
+export function pickInlineMetrics(
+  rows: ReadonlyArray<TurnPerformanceMetric>,
+  ids: ReadonlyArray<TurnPerformanceMetricId>,
+  options: { readonly includeUnavailable?: boolean } = {},
+): ReadonlyArray<TurnPerformanceMetric> {
+  return ids.flatMap((id) => {
+    const row = rows.find((candidate) => candidate.id === id);
+    return row === undefined || (row.precision === "unavailable" && !options.includeUnavailable)
+      ? []
+      : [row];
+  });
+}
+
+/** Writes one metric's switch into the hidden list, keeping unknown ids other builds may own. */
+export function toggleHiddenMetric(
+  hidden: ReadonlyArray<string>,
+  id: TurnPerformanceMetricId,
+  visible: boolean,
+): ReadonlyArray<string> {
+  const without = hidden.filter((candidate) => candidate !== id);
+  return visible ? without : [...without, id];
+}
+
+type ProjectionForSource = Pick<
+  OrchestrationV2ThreadProjection,
+  "runs" | "attempts" | "nodes" | "providerThreads"
+>;
+
+/** Driver and requested model for a turn, from its own run; never from another thread or turn. */
+export function resolveTurnPerformanceSource(
+  projection: ProjectionForSource,
+  turn: OrchestrationV2ProviderTurn,
+  providerNameOf: (providerInstanceId: string | undefined) => string,
+): TurnPerformanceSource {
+  const providerThread = projection.providerThreads.find(
+    (candidate) => candidate.id === turn.providerThreadId,
+  );
+  const attempt =
+    turn.runAttemptId === null
+      ? undefined
+      : projection.attempts.find((candidate) => candidate.id === turn.runAttemptId);
+  const runId = attempt?.runId ?? projection.nodes.find((node) => node.id === turn.nodeId)?.runId;
+  const run =
+    runId === undefined || runId === null
+      ? undefined
+      : projection.runs.find((candidate) => candidate.id === runId);
+  return {
+    turn,
+    driver: providerThread?.driver ?? turn.nativeTurnRef?.driver,
+    providerName: providerNameOf(providerThread?.providerInstanceId ?? run?.providerInstanceId),
+    modelSelection: run?.modelSelection ?? null,
+  };
+}
+
+/** The composer's current (running) turn and the turn that completed before it. */
+export function selectComposerPerformanceTurns(turns: ReadonlyArray<OrchestrationV2ProviderTurn>): {
+  readonly current: OrchestrationV2ProviderTurn | null;
+  readonly previous: OrchestrationV2ProviderTurn | null;
+} {
+  const latest = turns.at(-1) ?? null;
+  const current = latest !== null && isTurnRunning(latest) ? latest : null;
+  const previous =
+    turns.findLast(
+      (turn) => turn.id !== current?.id && isTurnSettled(turn) && turn.startedAt !== null,
+    ) ?? null;
+  return { current, previous };
+}
+
+/** Streamed answer and reasoning characters of one provider turn's main-agent items. */
+export function countTurnStreamedChars(
+  items: ReadonlyArray<
+    | {
+        readonly type: string;
+        readonly providerTurnId: ProviderTurnId | null;
+        readonly text?: unknown;
+      }
+    | { readonly type: string; readonly providerTurnId: ProviderTurnId | null }
+  >,
+  providerTurnId: ProviderTurnId,
+): number {
+  let chars = 0;
+  for (const item of items) {
+    if (
+      item.providerTurnId === providerTurnId &&
+      (item.type === "assistant_message" || item.type === "reasoning") &&
+      "text" in item &&
+      typeof item.text === "string"
+    ) {
+      chars += item.text.length;
+    }
+  }
+  return chars;
+}
+
+export const LIVE_RATE_WINDOW_MS = 2_000;
+export const CHARS_PER_TOKEN = 4;
+/** Below this span a rate would come from a single burst. */
+const MIN_SPAN_MS = 500;
+
+export interface LiveRateSampler {
+  /** Records the turn's total streamed characters at `nowMs` and returns tokens/s over the window. */
+  sample(key: string, chars: number, nowMs: number): number | null;
+  reset(): void;
+}
+
+/** Key a live sample by thread and provider turn, so one turn never feeds another's rate. */
+export function liveRateKey(threadKey: string, providerTurnId: string): string {
+  return `${threadKey}\u0000${providerTurnId}`;
+}
+
+/**
+ * Client-side live tokens/s: growth of streamed answer and reasoning characters over the last
+ * 2 seconds, converted at ≈ 4 characters per token. Always an estimate.
+ */
+export function createLiveRateSampler(windowMs = LIVE_RATE_WINDOW_MS): LiveRateSampler {
+  let currentKey: string | null = null;
+  let samples: Array<{ readonly t: number; readonly chars: number }> = [];
+  return {
+    reset() {
+      currentKey = null;
+      samples = [];
+    },
+    sample(key, chars, nowMs) {
+      const last = samples.at(-1);
+      if (
+        key !== currentKey ||
+        !Number.isFinite(chars) ||
+        (last !== undefined && (chars < last.chars || nowMs < last.t))
+      ) {
+        // A new turn, or text replaced by a shorter version: start over.
+        currentKey = key;
+        samples = [];
+      }
+      samples.push({ t: nowMs, chars });
+      // The newest sample at or before the window start is the baseline: the text held that
+      // length until the next sample arrived.
+      const start = nowMs - windowMs;
+      let baseIndex = 0;
+      for (const [index, sample] of samples.entries()) {
+        if (sample.t <= start) baseIndex = index;
+      }
+      samples = samples.slice(baseIndex);
+      const baseline = samples[0]!;
+      const from = baseline.t < start ? { t: start, chars: baseline.chars } : baseline;
+      const spanMs = nowMs - from.t;
+      if (spanMs < MIN_SPAN_MS) return null;
+      const growth = chars - from.chars;
+      return growth / CHARS_PER_TOKEN / (spanMs / 1000);
+    },
+  };
+}
