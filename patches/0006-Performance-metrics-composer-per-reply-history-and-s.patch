+    label: msg("Time to first token"),
+    short: msg("TTFT"),
+    description: msg("Request sent to the first generated token, including reasoning."),
+  },
+  ttfa: {
+    label: msg("Time to first answer"),
+    short: msg("TTFA"),
+    description: msg("Request sent to the first visible answer text."),
+  },
+  liveTps: {
+    label: msg("Live tokens/s"),
+    short: msg("live"),
+    description: msg("Estimated rate over the last 2 seconds while a turn runs."),
+  },
+  avgTps: {
+    label: msg("Average tokens/s"),
+    short: msg("avg"),
+    description: msg("Generation tokens over active generation time, never over turn duration."),
+  },
+  peakTps: {
+    label: msg("Peak tokens/s"),
+    short: msg("peak"),
+    description: msg("Highest estimated rate over a 2 second window."),
+  },
+  inputTokens: {
+    label: msg("Input tokens"),
+    short: msg("in"),
+    description: msg("Provider-reported input, including cache reads and writes."),
+  },
+  outputTokens: {
+    label: msg("Output tokens"),
+    short: msg("out"),
+    description: msg("Provider-reported output, including reasoning."),
+  },
+  reasoningTokens: {
+    label: msg("Reasoning tokens"),
+    short: msg("reasoning"),
+    description: msg("Provider-reported reasoning tokens, when reported separately."),
+  },
+  cachedTokens: {
+    label: msg("Cached tokens"),
+    short: msg("cached in"),
+    description: msg("Input served from the prompt cache."),
+  },
+  cacheHitRate: {
+    label: msg("Cache hit rate"),
+    short: msg("cached"),
+    description: msg("Cached input divided by total input."),
+  },
+  context: {
+    label: msg("Context usage"),
+    short: msg("context"),
+    description: msg("Context occupancy and window size."),
+  },
+  toolTime: {
+    label: msg("Tool time"),
+    short: msg("tools"),
+    description: msg("Wall-clock time waiting on tools, with overlaps merged."),
