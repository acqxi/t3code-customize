@@ -0,0 +1,455 @@
+import type { ProviderTurnId, ScopedThreadRef, ThreadId } from "@t3tools/contracts";
+import { useMessages } from "gt-react";
+import { createContext, Fragment, use, useEffect, useRef, useState, type ReactNode } from "react";
+
+import { readThreadStreamedTurnItems } from "../../state/entities";
+import { Popover, PopoverPopup, PopoverTrigger } from "../ui/popover";
+import { Tooltip, TooltipPopup, TooltipTrigger } from "../ui/tooltip";
+import { composerFloatingLayerProps } from "./composerEventScope";
+import {
+  LEGACY_RESPONSE_RATE_LABEL,
+  TURN_PERFORMANCE_METRIC_LABELS,
+} from "./TurnPerformance.catalog";
+import {
+  countTurnStreamedChars,
+  createLiveRateSampler,
+  deriveTurnPerformanceMetrics,
+  filterVisibleMetrics,
+  isTurnRunning,
+  liveRateKey,
+  pickInlineMetrics,
+  type TurnPerformanceInput,
+  type TurnPerformanceMetric,
+  type TurnPerformanceMetricId,
+  type TurnPerformanceSource,
+} from "./TurnPerformance.logic";
+
+const LIVE_SAMPLE_MS = 500;
+
+/** Ticks while `active`, so running turns show elapsed time. */
+function useNow(active: boolean, intervalMs: number): number {
+  const [now, setNow] = useState(Date.now);
+  useEffect(() => {
+    if (!active) return;
+    setNow(Date.now());
+    const timer = window.setInterval(() => setNow(Date.now()), intervalMs);
+    return () => window.clearInterval(timer);
+  }, [active, intervalMs]);
+  return now;
+}
+
+/**
+ * Live tokens/s for one running provider turn of one thread. Samples that turn's streamed answer
+ * and reasoning text; a different thread or turn starts a fresh sampler.
+ */
+function useLiveTokensPerSecond(
+  threadRef: ScopedThreadRef | null,
+  providerTurnId: ProviderTurnId | null,
+): number | null {
+  const [rate, setRate] = useState<{ key: string; value: number | null } | null>(null);
+  const samplerRef = useRef(createLiveRateSampler());
+  const environmentId = threadRef?.environmentId ?? null;
+  const threadId = threadRef?.threadId ?? null;
+  const key =
+    environmentId === null || threadId === null || providerTurnId === null
+      ? null
+      : liveRateKey(`${environmentId}\u0000${threadId}`, providerTurnId);
+  // Restarts only when the thread or turn changes, not when the ref object is rebuilt.
+  useEffect(() => {
+    const sampler = samplerRef.current;
+    sampler.reset();
+    if (environmentId === null || threadId === null || providerTurnId === null || key === null)
+      return;
+    const ref: ScopedThreadRef = { environmentId, threadId };
+    const sample = () => {
+      const chars = countTurnStreamedChars(readThreadStreamedTurnItems(ref), providerTurnId);
+      setRate({ key, value: sampler.sample(key, chars, performance.now()) });
+    };
+    sample();
+    const timer = window.setInterval(sample, LIVE_SAMPLE_MS);
+    return () => {
+      window.clearInterval(timer);
+      sampler.reset();
+    };
+  }, [key, environmentId, threadId, providerTurnId]);
+  return rate !== null && rate.key === key ? rate.value : null;
+}
+
+function useMetricLabel() {
+  const m = useMessages();
+  return (metric: TurnPerformanceMetric, form: "label" | "short") =>
+    metric.variant === "legacyResponseRate"
+      ? m(LEGACY_RESPONSE_RATE_LABEL)
+      : m(TURN_PERFORMANCE_METRIC_LABELS[metric.id][form]);
+}
+
+/** Metrics whose short label reads before the value ("TTFT 820 ms"); the rest read after. */
+const LABEL_FIRST = new Set<TurnPerformanceMetricId>(["ttft", "ttfa", "model"]);
+/** Self-describing values that need no label inline. */
+const NO_INLINE_LABEL = new Set<TurnPerformanceMetricId>([
+  "turnTime",
+  "provider",
+  "reasoningEffort",
+  "speedMode",
+]);
+
+function InlineMetric({ metric }: { metric: TurnPerformanceMetric }) {
+  const labelOf = useMetricLabel();
+  const label = NO_INLINE_LABEL.has(metric.id) ? null : labelOf(metric, "short");
+  const value = (
+    <span
+      data-precision={metric.precision}
+      className={metric.precision === "estimated" ? "text-foreground/70" : "text-foreground/80"}
+    >
+      {metric.display}
+    </span>
+  );
+  return (
+    <span className="inline-flex items-baseline gap-1 whitespace-nowrap">
+      {label !== null && LABEL_FIRST.has(metric.id) && (
+        <span className="text-muted-foreground/70">{label}</span>
+      )}
+      {value}
+      {label !== null && !LABEL_FIRST.has(metric.id) && (
+        <span className="text-muted-foreground/70">{label}</span>
+      )}
+    </span>
+  );
+}
+
+function InlineMetrics({ metrics }: { metrics: ReadonlyArray<TurnPerformanceMetric> }) {
+  return metrics.map((metric, index) => (
+    <Fragment key={metric.id}>
+      {index > 0 && (
+        <span aria-hidden="true" className="text-muted-foreground/40">
+          ·
+        </span>
+      )}
+      <InlineMetric metric={metric} />
+    </Fragment>
+  ));
+}
+
+/** Every visible metric of one turn, each value with how it was measured on hover. */
+export function TurnPerformanceBreakdown({
+  title,
+  subtitle,
+  metrics,
+}: {
+  title: string;
+  subtitle?: string;
+  metrics: ReadonlyArray<TurnPerformanceMetric>;
+}) {
+  const labelOf = useMetricLabel();
+  return (
+    <div className="flex flex-col gap-3 text-xs">
+      <div className="flex items-baseline justify-between gap-4">
+        <h3 className="font-medium">{title}</h3>
+        {subtitle && <span className="truncate text-muted-foreground">{subtitle}</span>}
+      </div>
+      <dl className="space-y-1.5">
+        {metrics.map((metric) => (
+          <div
+            key={metric.id}
+            data-metric={metric.id}
+            className="flex items-baseline justify-between gap-4"
+          >
+            <dt className="text-muted-foreground">{labelOf(metric, "label")}</dt>
+            <dd className="min-w-0 text-right tabular-nums">
+              <Tooltip>
+                <TooltipTrigger
+                  render={
+                    <span
+                      tabIndex={0}
+                      data-precision={metric.precision}
+                      className={`rounded-sm -outline-offset-2 ${metric.precision === "unavailable" ? "text-muted-foreground" : ""}`}
+                    />
+                  }
+                >
+                  {metric.display}
+                  {metric.partial && metric.precision !== "unavailable" && (
+                    <span className="ms-1 text-muted-foreground">partial</span>
+                  )}
+                </TooltipTrigger>
+                <TooltipPopup {...composerFloatingLayerProps} className="max-w-72">
+                  {metric.reason}
+                </TooltipPopup>
+              </Tooltip>
+            </dd>
+          </div>
+        ))}
+      </dl>
+      <p className="text-muted-foreground">
+        Plain values are exact, ≈ marks an estimate, — means the provider does not expose it. Hover
+        a value for how it was measured. Times are taken on the T3 server.
+      </p>
+    </div>
+  );
+}
+
+function TurnPerformanceSummary({
+  label,
+  live,
+  metrics,
+  inline,
+  title,
+  subtitle,
+  ariaLabel,
+}: {
+  label: ReactNode;
+  live: boolean;
+  metrics: ReadonlyArray<TurnPerformanceMetric>;
+  inline: ReadonlyArray<TurnPerformanceMetric>;
+  title: string;
+  subtitle: string;
+  ariaLabel: string;
+}) {
+  return (
+    <Popover>
+      <PopoverTrigger
+        openOnHover
+        delay={150}
+        closeDelay={150}
+        render={
+          <button
+            type="button"
+            aria-label={ariaLabel}
+            className="inline-flex min-w-0 flex-wrap items-baseline gap-x-1.5 rounded-sm text-left -outline-offset-2"
+          />
+        }
+      >
+        <span className="inline-flex items-center gap-1 text-muted-foreground/70">
+          {live && (
+            <span aria-hidden="true" className="size-1.5 animate-pulse rounded-full bg-success" />
+          )}
+          {label}
+        </span>
+        <InlineMetrics metrics={inline} />
+      </PopoverTrigger>
+      <PopoverPopup {...composerFloatingLayerProps} side="top" align="start" width="md">
+        <TurnPerformanceBreakdown title={title} subtitle={subtitle} metrics={metrics} />
+      </PopoverPopup>
+    </Popover>
+  );
+}
+
+const CURRENT_INLINE: ReadonlyArray<TurnPerformanceMetricId> = [
+  "turnTime",
+  "liveTps",
+  "ttft",
+  "ttfa",
+];
+const PREVIOUS_INLINE: ReadonlyArray<TurnPerformanceMetricId> = [
+  "avgTps",
+  "peakTps",
+  "ttft",
+  "ttfa",
+  "cacheHitRate",
+  "outputTokens",
+  "turnTime",
+];
+const REPLY_INLINE: ReadonlyArray<TurnPerformanceMetricId> = [
+  "avgTps",
+  "ttft",
+  "ttfa",
+  "outputTokens",
+  "cacheHitRate",
+  "toolTime",
+  "turnTime",
+];
+
+function contextOf(source: TurnPerformanceSource): TurnPerformanceInput["context"] {
+  const usage = source.turn.tokenUsage;
+  return usage === undefined ? null : { usedTokens: usage.usedTokens, maxTokens: usage.maxTokens };
+}
+
+function CurrentTurnSummary({
+  threadRef,
+  source,
+  hidden,
+}: {
+  threadRef: ScopedThreadRef | null;
+  source: TurnPerformanceSource;
+  hidden: ReadonlySet<string>;
+}) {
+  const running = isTurnRunning(source.turn);
+  const now = useNow(running, 1000);
+  const liveRate = useLiveTokensPerSecond(running ? threadRef : null, source.turn.id);
+  const metrics = filterVisibleMetrics(
+    deriveTurnPerformanceMetrics({
+      ...source,
+      context: contextOf(source),
+      liveTokensPerSecond: liveRate,
+      nowMs: now,
+    }),
+    hidden,
+  );
+  const inline = pickInlineMetrics(metrics, CURRENT_INLINE);
+  return (
+    <TurnPerformanceSummary
+      label="Now"
+      live={running}
+      metrics={metrics}
+      inline={inline}
+      title="Current turn"
+      subtitle={source.providerName}
+      ariaLabel="Current turn performance details"
+    />
+  );
+}
+
+function PreviousTurnSummary({
+  source,
+  hidden,
+}: {
+  source: TurnPerformanceSource;
+  hidden: ReadonlySet<string>;
+}) {
+  const metrics = filterVisibleMetrics(
+    deriveTurnPerformanceMetrics({
+      ...source,
+      context: contextOf(source),
+      liveTokensPerSecond: null,
+      nowMs: Date.now(),
+    }),
+    hidden,
+  );
+  const inline = pickInlineMetrics(metrics, PREVIOUS_INLINE);
+  if (inline.length === 0 && metrics.length === 0) return null;
+  return (
+    <TurnPerformanceSummary
+      label="Last"
+      live={false}
+      metrics={metrics}
+      inline={inline}
+      title={`Previous turn · ${source.turn.status}`}
+      subtitle={source.providerName}
+      ariaLabel="Previous turn performance details"
+    />
+  );
+}
+
+/** Under the composer: the running turn (live) and the last completed turn of this thread. */
+export function ComposerTurnPerformance({
+  threadRef,
+  current,
+  previous,
+  hiddenMetrics,
+}: {
+  threadRef: ScopedThreadRef | null;
+  current: TurnPerformanceSource | null;
+  previous: TurnPerformanceSource | null;
+  hiddenMetrics: ReadonlySet<string>;
+}) {
+  if (current === null && previous === null) return null;
+  const threadKey = threadRef === null ? "" : `${threadRef.environmentId}:${threadRef.threadId}`;
+  return (
+    <div
+      data-composer-turn-performance="true"
+      aria-label="Turn performance"
+      className="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 pt-1 text-2xs leading-4 text-muted-foreground tabular-nums"
+    >
+      {current !== null && (
+        <CurrentTurnSummary
+          key={`${threadKey}:${current.turn.id}`}
+          threadRef={threadRef}
+          source={current}
+          hidden={hiddenMetrics}
+        />
+      )}
+      {previous !== null && (
+        <span className="ms-auto inline-flex min-w-0">
+          <PreviousTurnSummary
+            key={`${threadKey}:${previous.turn.id}`}
+            source={previous}
+            hidden={hiddenMetrics}
+          />
+        </span>
+      )}
+    </div>
+  );
+}
+
+export interface TurnPerformanceTimelineValue {
+  readonly threadId: ThreadId;
+  /** This thread's own provider turns; items from other threads never resolve. */
+  readonly sources: ReadonlyMap<ProviderTurnId, TurnPerformanceSource>;
+  readonly hiddenMetrics: ReadonlySet<string>;
+}
+
+export const TurnPerformanceTimelineCtx = createContext<TurnPerformanceTimelineValue | null>(null);
+
+/** One line under an assistant reply: the provider turn that produced it, kept as history. */
+export function ReplyTurnPerformance({
+  sourceThreadId,
+  providerTurnId,
+}: {
+  sourceThreadId: ThreadId | undefined;
+  providerTurnId: ProviderTurnId | null | undefined;
+}) {
+  const ctx = use(TurnPerformanceTimelineCtx);
+  if (
+    ctx === null ||
+    providerTurnId == null ||
+    sourceThreadId === undefined ||
+    sourceThreadId !== ctx.threadId
+  )
+    return null;
+  const source = ctx.sources.get(providerTurnId);
+  if (source === undefined || isTurnRunning(source.turn)) return null;
+  return <ReplyTurnPerformanceLine source={source} hidden={ctx.hiddenMetrics} />;
+}
+
+function ReplyTurnPerformanceLine({
+  source,
+  hidden,
+}: {
+  source: TurnPerformanceSource;
+  hidden: ReadonlySet<string>;
+}) {
+  const metrics = filterVisibleMetrics(
+    deriveTurnPerformanceMetrics({
+      ...source,
+      context: contextOf(source),
+      liveTokensPerSecond: null,
+      nowMs: Date.now(),
+    }),
+    hidden,
+  );
+  const inline = pickInlineMetrics(metrics, REPLY_INLINE);
+  if (metrics.length === 0) return null;
+  return (
+    <div
+      data-reply-turn-performance={source.turn.id}
+      className="mt-1 flex min-w-0 overflow-hidden text-2xs leading-4 text-muted-foreground tabular-nums"
+    >
+      <Popover>
+        <PopoverTrigger
+          openOnHover
+          delay={150}
+          closeDelay={150}
+          render={
+            <button
+              type="button"
+              aria-label="Turn performance details"
+              className="inline-flex min-w-0 items-baseline gap-x-1.5 truncate rounded-sm text-left -outline-offset-2"
+            />
+          }
+        >
+          {inline.length > 0 ? (
+            <InlineMetrics metrics={inline} />
+          ) : (
+            <span className="text-muted-foreground/70">Stats</span>
+          )}
+        </PopoverTrigger>
+        <PopoverPopup side="top" align="start" width="md">
+          <TurnPerformanceBreakdown
+            title={`Turn ${source.turn.ordinal} · ${source.turn.status}`}
+            subtitle={source.providerName}
+            metrics={metrics}
+          />
+        </PopoverPopup>
+      </Popover>
+    </div>
+  );
+}
