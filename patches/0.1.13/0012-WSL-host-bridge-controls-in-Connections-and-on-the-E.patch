@@ -0,0 +1,133 @@
+import type { DesktopHostBridgeSetInput, DesktopHostBridgeState } from "@t3tools/contracts";
+import { EnvironmentId } from "@t3tools/contracts";
+import * as Cause from "effect/Cause";
+import * as Result from "effect/Result";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vite-plus/test";
+
+const mint = vi.fn();
+const runCommand = vi.fn();
+
+vi.mock("./peerPairingCode", () => ({ mintPairingCodeOn: (...args: unknown[]) => mint(...args) }));
+vi.mock("./peerLinks", () => ({ peerLinkEnvironment: { link: "link", unlink: "unlink" } }));
+vi.mock("../rpc/atomRegistry", () => ({ appAtomRegistry: {} }));
+vi.mock("@t3tools/client-runtime/state/runtime", () => ({
+  runAtomCommand: (...args: unknown[]) => runCommand(...args),
+  squashAtomCommandFailure: (result: { readonly cause: Cause.Cause<unknown> }) =>
+    Cause.squash(result.cause),
+}));
+
+const { pairHostBridge, dismissHostBridgePairing } = await import("./hostBridge");
+
+const wslId = EnvironmentId.make("env-wsl");
+const base: DesktopHostBridgeState = {
+  enabled: false,
+  phase: "disabled",
+  detail: null,
+  urls: ["http://127.0.0.1:13773", "http://127.0.0.1:13774"],
+  url: null,
+  windowsEnvironmentId: null,
+  windowsLabel: null,
+  windowsPort: 3773,
+  pairedEnvironmentId: null,
+  wslInstanceId: "wsl:TestDistro",
+  wslDistro: "TestDistro",
+  wslRuntimeId: "sha256-abc",
+  wslNetworking: "nat",
+  helperPid: null,
+  restarts: 0,
+  nextRetryAt: null,
+  lastError: null,
+  streams: { open: 0, total: 0, refused: 0 },
+  since: "2026-01-01T00:00:00.000Z",
+};
+const listening: DesktopHostBridgeState = {
+  ...base,
+  enabled: true,
+  phase: "running",
+  url: "http://127.0.0.1:13773",
+  windowsEnvironmentId: "env-windows",
+  windowsLabel: "Same Name",
+  helperPid: 42,
+};
+
+/** A Desktop whose helper listens once it was turned on, or never when `stuck`. */
+function fakeDesktop(stuck?: DesktopHostBridgeState) {
+  let state = base;
+  const sets: Array<DesktopHostBridgeSetInput> = [];
+  const desktop = {
+    getHostBridgeState: vi.fn(async () => state),
+    setHostBridge: vi.fn(async (input: DesktopHostBridgeSetInput) => {
+      sets.push(input);
+      state = stuck ?? (input.enabled ? listening : { ...base, lastError: input.failure ?? null });
+      if (input.failure !== undefined) state = { ...state, lastError: input.failure };
+      return state;
+    }),
+  };
+  vi.stubGlobal("window", { desktopBridge: desktop });
+  return { desktop, sets };
+}
+
+beforeEach(() => {
+  mint.mockReset();
+  runCommand.mockReset();
+  dismissHostBridgePairing();
+});
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.useRealTimers();
+});
+
+describe("pairHostBridge", () => {
+  it("turns the bridge on first, waits for the helper, then mints and links", async () => {
+    const { sets } = fakeDesktop();
+    mint.mockResolvedValue(Result.succeed("CODE-1"));
+    runCommand.mockResolvedValue({ _tag: "Success", value: { label: "Same Name" } });
+    expect(await pairHostBridge({ wslEnvironmentId: wslId, access: "approval-required" })).toBe(
+      true,
+    );
+    expect(sets[0]).toEqual({ enabled: true, failure: null });
+    // The code is minted on the Windows environment the helper reaches, and only after it listens.
+    expect(mint).toHaveBeenCalledWith("env-windows", "approval-required");
+    const [, , link] = runCommand.mock.calls[0]!;
+    expect(link).toEqual({
+      environmentId: wslId,
+      input: {
+        url: "http://127.0.0.1:13773",
+        alternateUrls: ["http://127.0.0.1:13774"],
+        pairingCode: "CODE-1",
+        access: "approval-required",
+        expectedEnvironmentId: "env-windows",
+        expectedLabel: "Same Name",
+        sameHostBridge: true,
+      },
+    });
+    expect(sets.at(-1)).toEqual({ enabled: true, environmentId: "env-windows", failure: null });
+  });
+
+  it("gives up on a helper that never listens, says why, and records it as the last error", async () => {
+    vi.useFakeTimers();
+    const { sets } = fakeDesktop({ ...base, enabled: true, phase: "waiting-wsl" });
+    const pairing = pairHostBridge({ wslEnvironmentId: wslId, access: "approval-required" });
+    await vi.advanceTimersByTimeAsync(61_000);
+    expect(await pairing).toBe(false);
+    expect(mint).not.toHaveBeenCalled();
+    expect(sets.at(-1)).toMatchObject({
+      enabled: true,
+      failure: "starting-helper: wsl-not-running",
+    });
+  });
+
+  it("names Linked environments being off when the link is refused for it", async () => {
+    const { sets } = fakeDesktop();
+    mint.mockResolvedValue(Result.succeed("CODE-2"));
+    runCommand.mockResolvedValue({
+      _tag: "Failure",
+      cause: Cause.fail({ reason: "disabled", message: "Linked environments is off." }),
+    });
+    expect(await pairHostBridge({ wslEnvironmentId: wslId, access: "auto" })).toBe(false);
+    expect(sets.at(-1)).toEqual({
+      enabled: true,
+      failure: "linking: Linked environments is off.",
+    });
+  });
+});
diff --git a/apps/web/src/state/hostBridge.ts b/apps/web/src/state/hostBridge.ts
