index 0000000000..7d753d140d
--- /dev/null
+++ b/apps/web/src/state/hostBridge.ts
@@ -0,0 +1,278 @@
+import { linkRequestFailureMessage } from "@t3tools/client-runtime/link-request";
+import { runAtomCommand, squashAtomCommandFailure } from "@t3tools/client-runtime/state/runtime";
+import type {
+  AuthMcpClientAccess,
+  DesktopBridge,
+  DesktopHostBridgeSetInput,
+  DesktopHostBridgeState,
+  EnvironmentId,
+} from "@t3tools/contracts";
+import * as Result from "effect/Result";
+import { useSyncExternalStore } from "react";
+
+import {
+  helperWaitFailure,
+  linkFailure,
+  type HostBridgeFailure,
+  type HostBridgePairing,
+  type HostBridgePairingStep,
+} from "../components/settings/LocalHostBridge.logic";
+import { m } from "../i18n/messages";
+import { appAtomRegistry } from "../rpc/atomRegistry";
+import { peerLinkEnvironment } from "./peerLinks";
+import { mintPairingCodeOn } from "./peerPairingCode";
+
+type HostBridgeDesktop = Required<Pick<DesktopBridge, "getHostBridgeState" | "setHostBridge">>;
+
+const POLL_MS = 2_000;
+const FAST_POLL_MS = 500;
+/** How long Enable waits for the helper in WSL to listen; a cold WSL start takes a while. */
+const HELPER_START_TIMEOUT_MS = 60_000;
+
+export function hostBridgeDesktop(): HostBridgeDesktop | null {
+  if (typeof window === "undefined") return null;
+  const bridge = window.desktopBridge;
+  if (bridge?.getHostBridgeState === undefined || bridge.setHostBridge === undefined) return null;
+  return { getHostBridgeState: bridge.getHostBridgeState, setHostBridge: bridge.setHostBridge };
+}
+
+interface Snapshot {
+  readonly desktop: DesktopHostBridgeState | null;
+  readonly pairing: HostBridgePairing | null;
+}
+
+let snapshot: Snapshot = { desktop: null, pairing: null };
+const listeners = new Set<() => void>();
+let timer: ReturnType<typeof setInterval> | undefined;
+
+const publish = (next: Partial<Snapshot>) => {
+  snapshot = { ...snapshot, ...next };
+  for (const listener of listeners) listener();
+};
+
+const read = async (desktop: HostBridgeDesktop) => {
+  try {
+    const state = await desktop.getHostBridgeState();
+    publish({ desktop: state });
+    return state;
+  } catch {
+    return snapshot.desktop;
+  }
+};
+
+/** One poll of the Desktop for every view that shows the bridge, while any of them is open. */
+const subscribe = (listener: () => void) => {
+  listeners.add(listener);
+  const desktop = hostBridgeDesktop();
+  if (listeners.size === 1 && desktop !== null) {
+    void read(desktop);
+    timer = setInterval(() => void read(desktop), POLL_MS);
+  }
+  return () => {
+    listeners.delete(listener);
+    if (listeners.size === 0 && timer !== undefined) {
+      clearInterval(timer);
+      timer = undefined;
+    }
+  };
+};
+
+const getSnapshot = () => snapshot;
+
+/** The Desktop's bridge state and any pairing in progress, shared by the card and the map. */
+export function useHostBridgeSnapshot(): Snapshot {
+  return useSyncExternalStore(subscribe, getSnapshot, getSnapshot);
+}
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+const now = () => Date.now();
+
+const setStep = (step: HostBridgePairingStep, extra: Partial<HostBridgePairing> = {}) => {
+  const current = snapshot.pairing;
+  publish({
+    pairing: {
+      status: "running",
+      step,
+      startedAt: current?.status === "running" ? current.startedAt : now(),
+      stepStartedAt: now(),
+      failure: null,
+      listeningUrl: current?.status === "running" ? current.listeningUrl : null,
+      ...extra,
+    },
+  });
+};
+
+export interface PairInput {
+  readonly wslEnvironmentId: EnvironmentId;
+  readonly access: AuthMcpClientAccess;
+  /** Forget this earlier bridge link first: the user confirmed a new Windows identity. */
+  readonly replacing?: EnvironmentId;
+}
+
+/**
+ * Turns the bridge on and links WSL to this computer's Windows backend through it. The user's
+ * click is the approval; each step shows, and a failure says why and lands in Last error.
+ */
+export async function pairHostBridge(input: PairInput): Promise<boolean> {
+  const desktop = hostBridgeDesktop();
+  if (desktop === null || snapshot.pairing?.status === "running") return false;
+  let step: HostBridgePairingStep = "enabling";
+  const fail = async (failure: HostBridgeFailure) => {
+    publish({
+      pairing: {
+        status: "failed",
+        step,
+        startedAt: snapshot.pairing?.startedAt ?? now(),
+        stepStartedAt: snapshot.pairing?.stepStartedAt ?? now(),
+        failure,
+        listeningUrl: snapshot.pairing?.listeningUrl ?? null,
+      },
+    });
+    const state = await desktop
+      .setHostBridge({
+        enabled: true,
+        failure: `${step}: ${failure.detail ?? failure.code}`,
+      })
+      .catch(() => null);
+    if (state !== null) publish({ desktop: state });
+    return false;
+  };
+  try {
+    setStep("enabling");
+    if (input.replacing !== undefined) {
+      await runAtomCommand(
+        appAtomRegistry,
+        peerLinkEnvironment.unlink,
+        { environmentId: input.wslEnvironmentId, input: { environmentId: input.replacing } },
+        { reportFailure: false },
+      );
+    }
+    publish({
+      desktop: await desktop.setHostBridge({
+        enabled: true,
+        failure: null,
+        ...(input.replacing === undefined ? {} : { environmentId: null }),
+      }),
+    });
+
+    step = "starting-helper";
+    setStep(step);
+    const deadline = now() + HELPER_START_TIMEOUT_MS;
+    let ready: DesktopHostBridgeState | null = null;
+    while (now() < deadline) {
+      const state = await read(desktop);
+      if (state !== null && state.url !== null && state.windowsEnvironmentId !== null) {
+        ready = state;
+        break;
+      }
+      if (state?.phase === "unsupported" || state?.phase === "identity-mismatch") {
+        return await fail(helperWaitFailure(state));
+      }
+      await sleep(FAST_POLL_MS);
+    }
+    if (ready === null || ready.windowsEnvironmentId === null) {
+      return await fail(helperWaitFailure(snapshot.desktop));
+    }
+    const windowsId = ready.windowsEnvironmentId as EnvironmentId;
+
+    step = "minting";
+    setStep(step, { listeningUrl: ready.url });
+    const code = await mintPairingCodeOn(windowsId, input.access);
+    if (Result.isFailure(code)) {
+      return await fail({
+        code: "mint-failed",
+        detail: linkRequestFailureMessage(code.failure, m),
+      });
+    }
+
+    step = "linking";
+    setStep(step);
+    const [url, ...alternateUrls] = ready.urls;
+    if (url === undefined) return await fail({ code: "helper-failed", detail: null });
+    const linked = await runAtomCommand(
+      appAtomRegistry,
+      peerLinkEnvironment.link,
+      {
+        environmentId: input.wslEnvironmentId,
+        input: {
+          url,
+          ...(alternateUrls.length > 0 ? { alternateUrls } : {}),
+          pairingCode: code.success,
+          access: input.access,
+          expectedEnvironmentId: windowsId,
+          ...(ready.windowsLabel === null ? {} : { expectedLabel: ready.windowsLabel }),
+          sameHostBridge: true,
+        },
+      },
+      // The failure cause holds the request, and with it the pairing code.
+      { reportFailure: false, reportDefect: false },
+    );
+    if (linked._tag !== "Success") {
+      return await fail(linkFailure(squashAtomCommandFailure(linked)));
+    }
+
+    publish({
+      desktop: await desktop.setHostBridge({
+        enabled: true,
+        environmentId: windowsId,
+        failure: null,
+      }),
+    });
+    step = "linked";
+    publish({
+      pairing: {
+        status: "done",
+        step,
+        startedAt: snapshot.pairing?.startedAt ?? now(),
+        stepStartedAt: now(),
+        failure: null,
+        listeningUrl: ready.url,
+      },
+    });
+    return true;
+  } catch (cause) {
+    return await fail({ code: "desktop-failed", detail: errorText(cause) });
+  }
+}
+
+/** Clears a finished or failed pairing from view. */
+export function dismissHostBridgePairing(): void {
+  if (snapshot.pairing?.status !== "running") publish({ pairing: null });
+}
+
+export async function setHostBridge(input: DesktopHostBridgeSetInput): Promise<void> {
+  const desktop = hostBridgeDesktop();
+  if (desktop === null) return;
+  publish({ desktop: await desktop.setHostBridge(input) });
+}
+
+/** Ends the link on both sides and turns the bridge off; nothing pairs it again on its own. */
+export async function revokeHostBridge(input: {
+  readonly wslEnvironmentId: EnvironmentId;
+  readonly linkedEnvironmentId: EnvironmentId | null;
+}): Promise<string | null> {
+  if (input.linkedEnvironmentId !== null) {
+    const result = await runAtomCommand(
+      appAtomRegistry,
+      peerLinkEnvironment.unlink,
+      {
+        environmentId: input.wslEnvironmentId,
+        input: { environmentId: input.linkedEnvironmentId },
+      },
+      { reportFailure: false },
+    );
+    if (result._tag !== "Success") return errorText(squashAtomCommandFailure(result));
+  }
+  await setHostBridge({ enabled: false, environmentId: null });
+  publish({ pairing: null });
+  return null;
+}
+
+function errorText(cause: unknown): string {
+  if (cause instanceof Error) return cause.message;
+  if (typeof cause === "object" && cause !== null && "message" in cause) {
+    return String((cause as { readonly message: unknown }).message);
+  }
+  return String(cause);
+}
