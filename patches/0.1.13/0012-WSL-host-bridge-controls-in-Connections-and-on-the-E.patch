+    bridge: Partial<Parameters<typeof buildFleetGraph>[0]["hostBridge"] & object> = {},
+  ) =>
+    buildFleetGraph({
+      clientLabel: "This device",
+      environments: [
+        environment("wsl", wslLinks, { label: "Same Name" }),
+        environment("windows", [], { label: "Same Name" }),
+      ],
