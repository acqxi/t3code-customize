@@ -0,0 +1,218 @@
+import {
+  type DesktopHostBridgeState,
+  EnvironmentId,
+  type PeerLinkSummary,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  bridgePorts,
+  helperWaitFailure,
+  hostBridgeBlocker,
+  linkFailure,
+  localHostBridgeView,
+  pairingProgress,
+} from "./LocalHostBridge.logic";
+
+const now = DateTime.makeUnsafe("2026-01-10T00:00:00.000Z");
+const windowsId = EnvironmentId.make("env-windows");
+const wslId = EnvironmentId.make("env-wsl");
+const urls = ["http://127.0.0.1:13773", "http://127.0.0.1:13774", "http://127.0.0.1:13775"];
+
+const desktop: DesktopHostBridgeState = {
+  enabled: true,
+  phase: "running",
+  detail: null,
+  urls,
+  url: urls[0]!,
+  windowsEnvironmentId: windowsId,
+  windowsLabel: "Same Name",
+  windowsPort: 3773,
+  pairedEnvironmentId: windowsId,
+  wslInstanceId: "wsl:TestDistro",
+  wslDistro: "TestDistro",
+  wslRuntimeId: "sha256-abc",
+  wslNetworking: "nat",
+  helperPid: 42,
+  restarts: 0,
+  nextRetryAt: null,
+  lastError: null,
+  streams: { open: 0, total: 3, refused: 0 },
+  since: "2026-01-09T00:00:00.000Z",
+};
+
+const link = (overrides: Partial<PeerLinkSummary> = {}): PeerLinkSummary => ({
+  environmentId: windowsId,
+  // Both environments share a hostname: only the ID and the bridge addresses count.
+  label: "Same Name",
+  urls,
+  access: "approval-required",
+  linkedAt: DateTime.makeUnsafe("2026-01-01T00:00:00.000Z"),
+  expiresAt: DateTime.makeUnsafe("2026-02-01T00:00:00.000Z"),
+  lastReachedAt: null,
+  lastError: null,
+  status: "reachable",
+  ...overrides,
+});
+
+const viewOf = (
+  input: Partial<Parameters<typeof localHostBridgeView>[0]> = {},
+): ReturnType<typeof localHostBridgeView> =>
+  localHostBridgeView({
+    desktop,
+    wslEnvironmentId: wslId,
+    wslSupportsBridge: true,
+    links: [link()],
+    now,
+    ...input,
+  });
+
+describe("localHostBridgeView", () => {
+  it("is connected only when the WSL backend's native link answers", () => {
+    expect(viewOf().status).toBe("connected");
+    expect(viewOf().link?.environmentId).toBe(windowsId);
+  });
+
+  it("asks for pairing when no native link exists, even with the helper up", () => {
+    expect(viewOf({ links: [] })).toMatchObject({
+      status: "pairing-required",
+      pairingReason: "unlinked",
+    });
+  });
+
+  it("asks for pairing again once the link expired, never pairing on its own", () => {
+    expect(viewOf({ links: [link({ status: "expired" })] })).toMatchObject({
+      status: "pairing-required",
+      pairingReason: "expired",
+    });
+  });
+
+  it("reports a link the Windows side revoked as permission denied", () => {
+    expect(
+      viewOf({
+        links: [
+          link({
+            lastError:
+              "The linked environment no longer accepts this link. It may have been revoked there; link it again.",
+          }),
+        ],
+      }).status,
+    ).toBe("permission-denied");
+    expect(viewOf({ links: [link({ lastError: "timed out" })] }).status).toBe("recovering");
+    expect(viewOf({ links: [link({ status: "unreachable" })] }).status).toBe("recovering");
+  });
+
+  it("never counts a link to the same name elsewhere, or at other addresses, as the bridge", () => {
+    const elsewhere = link({
+      environmentId: EnvironmentId.make("env-other-machine"),
+      urls: ["https://other.example.ts.net"],
+    });
+    const directToWindows = link({ urls: ["https://windows.example.ts.net"] });
+    expect(viewOf({ links: [elsewhere, directToWindows] })).toMatchObject({
+      status: "pairing-required",
+      link: null,
+      staleLink: null,
+    });
+  });
+
+  it("flags a bridge link to an earlier Windows environment as an identity mismatch", () => {
+    const old = link({ environmentId: EnvironmentId.make("env-windows-before") });
+    expect(viewOf({ links: [old] })).toMatchObject({
+      status: "identity-mismatch",
+      staleLink: { environmentId: "env-windows-before" },
+    });
+    expect(viewOf({ desktop: { ...desktop, phase: "identity-mismatch" } }).status).toBe(
+      "identity-mismatch",
+    );
+  });
+
+  it("follows the Desktop helper while it waits, starts or recovers", () => {
+    expect(viewOf({ desktop: { ...desktop, enabled: false, phase: "disabled" } }).status).toBe(
+      "disabled",
+    );
+    expect(viewOf({ desktop: { ...desktop, phase: "waiting-windows" } }).status).toBe(
+      "waiting-windows",
+    );
+    expect(viewOf({ desktop: { ...desktop, phase: "waiting-wsl" } }).status).toBe("waiting-wsl");
+    expect(viewOf({ desktop: { ...desktop, phase: "starting" } }).status).toBe("starting");
+    expect(viewOf({ desktop: { ...desktop, phase: "recovering" } }).status).toBe("recovering");
+  });
+
+  it("waits for both identities and the link list before deciding", () => {
+    expect(viewOf({ links: null }).status).toBe("discovering");
+    expect(viewOf({ wslEnvironmentId: null }).status).toBe("discovering");
+    expect(viewOf({ desktop: { ...desktop, windowsEnvironmentId: null } }).status).toBe(
+      "discovering",
+    );
+  });
+
+  it("says when the Desktop or the WSL runtime has no bridge", () => {
+    expect(viewOf({ desktop: null }).status).toBe("unsupported");
+    expect(viewOf({ wslSupportsBridge: false }).status).toBe("unsupported");
+  });
+});
+
+describe("bridgePorts", () => {
+  it("reads the ports from the Desktop's addresses", () => {
+    expect(bridgePorts(desktop)).toEqual([13773, 13774, 13775]);
+  });
+});
+
+describe("pairing failures", () => {
+  it("says why the helper never listened, by what the Desktop last saw", () => {
+    expect(helperWaitFailure({ ...desktop, phase: "waiting-windows", url: null })).toMatchObject({
+      code: "windows-not-ready",
+    });
+    expect(helperWaitFailure({ ...desktop, phase: "waiting-wsl", url: null }).code).toBe(
+      "wsl-not-running",
+    );
