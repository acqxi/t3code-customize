@@ -0,0 +1,28 @@
+import { isWindowsPlatform } from "~/lib/utils";
+import { hostBridgeDesktop } from "~/state/hostBridge";
+import { HostBridgeControls, useHostBridgeModel } from "./HostBridgeControls";
+import { SettingsSection } from "./settingsLayout";
+import { useSearchableSetting } from "./settingsSearch";
+
+/**
+ * The WSL host bridge in Connections, for the list view and search; the Environments map shows
+ * the same controls on the bridge's link and on both machines.
+ */
+export function LocalHostBridgeSettings() {
+  if (hostBridgeDesktop() === null || !isWindowsPlatform(navigator.platform)) return null;
+  return <LocalHostBridgeCard />;
+}
+
+function LocalHostBridgeCard() {
+  const searchableSetting = useSearchableSetting();
+  const search = searchableSetting("local-host-bridge");
+  const model = useHostBridgeModel();
+  if (model.desktop === null) return null;
+  return (
+    <SettingsSection id={search.id} title={search.title}>
+      <div className="px-4 py-3 sm:px-5">
+        <HostBridgeControls model={model} />
+      </div>
+    </SettingsSection>
+  );
+}
