diff --git a/apps/web/src/components/settings/LocalHostBridge.logic.ts b/apps/web/src/components/settings/LocalHostBridge.logic.ts
new file mode 100644
index 0000000000..a9616030a8
--- /dev/null
+++ b/apps/web/src/components/settings/LocalHostBridge.logic.ts
@@ -0,0 +1,238 @@
+import type { DesktopHostBridgeState, EnvironmentId, PeerLinkSummary } from "@t3tools/contracts";
+import { peerLinkHealth } from "@t3tools/client-runtime/state/peerLinks";
+import { isHostBridgeUrl } from "@t3tools/shared/hostBridgeMux";
+import type * as DateTime from "effect/DateTime";
+
+export type LocalHostBridgeStatus =
+  | "unsupported"
+  | "disabled"
+  | "discovering"
+  | "waiting-windows"
+  | "waiting-wsl"
+  | "starting"
+  | "pairing-required"
+  | "connected"
+  | "recovering"
+  | "permission-denied"
+  | "identity-mismatch";
+
+export interface LocalHostBridgeView {
+  readonly status: LocalHostBridgeStatus;
+  /** The native link from WSL to this machine's Windows backend through the bridge, if any. */
+  readonly link: PeerLinkSummary | null;
+  /** A bridge link to a Windows environment that is no longer the one this Desktop runs. */
+  readonly staleLink: PeerLinkSummary | null;
+  /** Why pairing is needed: never linked, or the link ran out. */
+  readonly pairingReason: "unlinked" | "expired" | null;
+  readonly detail: string | null;
+  /** The WSL backend runs a server without the bridge's link path, such as a stock runtime. */
+  readonly runtimeLacksBridge: boolean;
+}
+
+/** What PeerMcpClient records when the peer refuses the link's token: revoked or ended there. */
+const REJECTED_LINK = "no longer accepts this link";
+
+const urlsAreBridge = (link: PeerLinkSummary, ports: ReadonlyArray<number>) =>
+  link.urls.length > 0 && link.urls.every((url) => isHostBridgeUrl(url, ports));
+
+export const bridgePorts = (state: DesktopHostBridgeState): ReadonlyArray<number> =>
+  state.urls.flatMap((url) => {
+    const port = Number(URL.parse(url)?.port);
+    return Number.isInteger(port) && port > 0 ? [port] : [];
+  });
+
+/**
+ * The card's state, from the Desktop's helper and the WSL backend's own link
+ * list. A port that answers is never enough: Connected needs the native link.
+ */
+export function localHostBridgeView(input: {
+  readonly desktop: DesktopHostBridgeState | null;
+  readonly wslEnvironmentId: EnvironmentId | null;
+  /** Whether the WSL backend's server can link through the bridge; null while unknown. */
+  readonly wslSupportsBridge: boolean | null;
+  /** The WSL backend's links; null while loading. */
+  readonly links: ReadonlyArray<PeerLinkSummary> | null;
+  readonly now: DateTime.Utc;
+}): LocalHostBridgeView {
+  const view = (
+    status: LocalHostBridgeStatus,
+    rest: Partial<Omit<LocalHostBridgeView, "status">> = {},
+  ): LocalHostBridgeView => ({
+    status,
+    link: null,
+    staleLink: null,
+    pairingReason: null,
+    detail: null,
+    runtimeLacksBridge: false,
+    ...rest,
+  });
+  const { desktop } = input;
+  if (desktop === null) return view("unsupported");
+  const ports = bridgePorts(desktop);
+  const windowsId = desktop.windowsEnvironmentId;
+  const link =
+    windowsId === null || input.links === null
+      ? null
+      : (input.links.find(
+          (candidate) => candidate.environmentId === windowsId && urlsAreBridge(candidate, ports),
+        ) ?? null);
+  const staleLink =
+    input.links === null
+      ? null
+      : (input.links.find(
+          (candidate) =>
+            urlsAreBridge(candidate, ports) &&
+            (windowsId === null
+              ? desktop.pairedEnvironmentId !== null &&
+                candidate.environmentId !== desktop.pairedEnvironmentId
+              : candidate.environmentId !== windowsId),
+        ) ?? null);
+  const known = { link, staleLink, detail: desktop.detail };
+  if (!desktop.enabled) return view("disabled", known);
+  switch (desktop.phase) {
+    case "disabled":
+    case "unsupported":
+    case "waiting-windows":
+    case "waiting-wsl":
+    case "identity-mismatch":
+      return view(desktop.phase, known);
+    default:
+      break;
+  }
+  if (input.wslSupportsBridge === false) {
+    return view("unsupported", { ...known, detail: null, runtimeLacksBridge: true });
+  }
+  if (input.wslEnvironmentId === null || windowsId === null || input.links === null) {
+    return view("discovering", known);
+  }
+  if (link === null) {
+    return staleLink !== null
+      ? view("identity-mismatch", known)
+      : view("pairing-required", { ...known, pairingReason: "unlinked" });
+  }
+  if (desktop.phase === "starting") return view("starting", known);
+  if (desktop.phase === "recovering") return view("recovering", known);
+  const health = peerLinkHealth(link, input.now);
+  switch (health.kind) {
+    case "expired":
+      return view("pairing-required", { ...known, pairingReason: "expired" });
+    case "failing":
+      return health.detail.includes(REJECTED_LINK)
+        ? view("permission-denied", { ...known, detail: health.detail })
+        : view("recovering", { ...known, detail: health.detail });
+    case "unreachable":
+      return view("recovering", { ...known, detail: health.detail });
+    case "reachable":
+      return view("connected", known);
+  }
+}
+
+/** The steps Enable and pair goes through, in order. */
+export const HOST_BRIDGE_PAIRING_STEPS = [
+  "enabling",
+  "starting-helper",
+  "minting",
+  "linking",
+  "linked",
+] as const;
+export type HostBridgePairingStep = (typeof HOST_BRIDGE_PAIRING_STEPS)[number];
+
+/** Why a step failed, as a code the view words with its next step; `detail` is the raw cause. */
+export type HostBridgeFailureCode =
+  | "windows-not-ready"
+  | "wsl-not-running"
+  | "helper-failed"
+  | "unsupported"
+  | "identity-mismatch"
+  | "mint-failed"
+  | "links-off"
+  | "bridge-not-windows"
+  | "bridge-unreachable"
+  | "link-refused"
+  | "link-failed"
+  | "desktop-failed";
+
+export interface HostBridgeFailure {
+  readonly code: HostBridgeFailureCode;
+  readonly detail: string | null;
+}
+
+export interface HostBridgePairing {
+  readonly status: "running" | "failed" | "done";
+  readonly step: HostBridgePairingStep;
+  readonly startedAt: number;
+  readonly stepStartedAt: number;
+  readonly failure: HostBridgeFailure | null;
+  /** Where the helper listens, once it does. */
+  readonly listeningUrl: string | null;
+}
+
+/** How far along a pairing is, 0 to 1, for its progress bar. */
+export const pairingProgress = (pairing: HostBridgePairing): number =>
+  pairing.status === "done"
+    ? 1
+    : HOST_BRIDGE_PAIRING_STEPS.indexOf(pairing.step) / (HOST_BRIDGE_PAIRING_STEPS.length - 1);
+
+/** Why the helper never listened, from what the Desktop last reported. */
+export function helperWaitFailure(state: DesktopHostBridgeState | null): HostBridgeFailure {
+  const detail = state?.lastError ?? state?.detail ?? null;
+  switch (state?.phase) {
+    case "waiting-windows":
+      return { code: "windows-not-ready", detail };
+    case "waiting-wsl":
+      return { code: "wsl-not-running", detail };
+    case "unsupported":
+      return { code: "unsupported", detail };
+    case "identity-mismatch":
+      return { code: "identity-mismatch", detail };
+    default:
+      return { code: "helper-failed", detail };
+  }
+}
+
+/** Why linking through the bridge failed, from the WSL backend's PeerLinkError. */
+export function linkFailure(error: unknown): HostBridgeFailure {
+  const field = (name: string) =>
+    typeof error === "object" && error !== null && name in error
+      ? (error as Record<string, unknown>)[name]
+      : undefined;
+  const message = field("message");
+  const detail = typeof message === "string" ? message : error === undefined ? null : String(error);
+  switch (field("reason")) {
+    case "disabled":
+      return { code: "links-off", detail };
+    case "unreachable":
+      return {
+        code: field("answeredAs") === undefined ? "bridge-unreachable" : "bridge-not-windows",
+        detail,
+      };
+    case "pairing_rejected":
+      return { code: "link-refused", detail };
+    default:
+      return { code: "link-failed", detail };
+  }
+}
+
+/** What has to change before Enable and pair can work, checked before anything starts. */
+export type HostBridgeBlocker =
+  | "no-wsl-backend"
+  | "wsl-disconnected"
+  | "wsl-links-off"
+  | "windows-links-off"
+  | "runtime-lacks-bridge";
+
+export function hostBridgeBlocker(input: {
+  readonly wslKnown: boolean;
+  readonly wslConnected: boolean;
+  readonly wslOffersLinks: boolean;
+  readonly windowsOffersLinks: boolean;
+  /** Null while the WSL backend's config is not loaded yet. */
+  readonly wslSupportsBridge: boolean | null;
+}): HostBridgeBlocker | null {
+  if (!input.wslKnown) return "no-wsl-backend";
+  if (!input.wslConnected) return "wsl-disconnected";
+  if (input.wslSupportsBridge === false) return "runtime-lacks-bridge";
+  if (!input.wslOffersLinks) return "wsl-links-off";
+  if (!input.windowsOffersLinks) return "windows-links-off";
+  return null;
+}
