+        sourceEnvironmentId: id("wsl"),
+        targetEnvironmentId: id("windows"),
+        tone: "linked",
+        status: "connected",
+        pairing: null,
+        isBridgeLink,
+        pendingLink: null,
+        ...bridge,
+      },
+      now,
+    });
+  const bridgeEdge = (graph: ReturnType<typeof graphWith>) =>
+    graph.edges.filter(isLinkEdge).find((edge) => edge.hostBridge !== undefined);
+
+  it("draws the native bridge link as its own kind of link, with its state", () => {
+    const graph = graphWith([bridgeLink("windows")]);
+    expect(bridgeEdge(graph)).toMatchObject({
+      from: node("wsl"),
+      to: node("windows"),
+      hostBridge: { tone: "linked", status: "connected", pending: false },
+    });
+    expect(fleetSummary(graph).links).toBe(1);
+  });
+
+  it("leaves links elsewhere, even to the same name, as ordinary links", () => {
+    const graph = graphWith([link("windows"), link("elsewhere")]);
+    expect(bridgeEdge(graph)).toBeUndefined();
+    expect(graph.edges.filter(isLinkEdge)).toHaveLength(2);
+  });
+
+  it("stands a pending line for the bridge while it starts or pairs, and never counts it", () => {
+    const graph = graphWith([], {
+      tone: "progress",
+      status: "starting",
+      pairing: "running",
+      pendingLink: bridgeLink("windows"),
+    });
+    const edge = bridgeEdge(graph)!;
+    expect(edge.hostBridge).toEqual({
+      tone: "progress",
+      status: "starting",
+      pending: true,
+      pairing: "running",
+    });
+    expect(fleetSummary(graph).links).toBe(0);
+    expect(fleetLinkBackOffered(graph, edge)).toBe(false);
+  });
+
+  it("shows a bridge link to an earlier Windows identity as paused", () => {
+    const graph = graphWith([bridgeLink("windows-before")], {
+      tone: "paused",
+      status: "identity-mismatch",
+      pendingLink: bridgeLink("windows"),
+    });
+    const stale = graph.edges.filter(isLinkEdge).find((edge) => edge.to === node("windows-before"));
+    expect(stale?.hostBridge).toMatchObject({ tone: "paused", status: "identity-mismatch" });
+    // Until the user confirms, a pending line stands for the bridge to the current one.
+    expect(
+      graph.edges.filter(isLinkEdge).find((edge) => edge.to === node("windows"))?.hostBridge,
+    ).toMatchObject({ pending: true });
+  });
+
+  it("never draws the bridge as half of a two-way link", () => {
+    const graph = buildFleetGraph({
+      clientLabel: "This device",
+      environments: [
+        environment("wsl", [bridgeLink("windows")]),
+        environment("windows", [link("wsl")]),
+      ],
+      hostBridge: {
+        sourceEnvironmentId: id("wsl"),
+        targetEnvironmentId: id("windows"),
+        tone: "linked",
+        status: "connected",
+        pairing: null,
+        isBridgeLink,
+        pendingLink: null,
+      },
+      now,
+    });
+    expect(fleetTwoWayLinks(graph).size).toBe(0);
+  });
+});
