+import { offersLinkedEnvironments } from "@t3tools/client-runtime/link-request";
+import {
+  AuthMcpClientAccess,
+  type DesktopHostBridgeState,
+  type EnvironmentId,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import { useGT, useMessages } from "gt-react";
+import { CheckIcon, CircleAlertIcon, LoaderCircleIcon } from "lucide-react";
+import { useEffect, useState } from "react";
+
+import { requestConfirmDialog } from "~/confirmDialog";
+import { desktopLocalBackendId } from "~/connection/desktopLocal";
+import { useLiveRefresh } from "~/hooks/useLiveRefresh";
+import { useNowMinute } from "~/hooks/useNowMinute";
+import { cn } from "~/lib/utils";
+import { useEnvironments, type EnvironmentPresentation } from "~/state/environments";
+import {
+  dismissHostBridgePairing,
+  pairHostBridge,
+  revokeHostBridge,
+  setHostBridge,
+  useHostBridgeSnapshot,
+} from "~/state/hostBridge";
+import { peerLinkEnvironment } from "~/state/peerLinks";
+import { useEnvironmentQuery } from "~/state/query";
+import { accessConfig } from "../auth/ConnectAgentSurface";
+import { Button } from "../ui/button";
+import { Select, SelectItem, SelectPopup, SelectTrigger, SelectValue } from "../ui/select";
+import { toastManager } from "../ui/toast";
+import {
+  HOST_BRIDGE_PAIRING_STEPS,
+  hostBridgeBlocker,
+  localHostBridgeView,
+  pairingProgress,
+  type HostBridgeBlocker,
+  type HostBridgeFailureCode,
+  type HostBridgePairing,
+  type HostBridgePairingStep,
+  type LocalHostBridgeStatus,
+} from "./LocalHostBridge.logic";
+
+const LINKS_REFRESH_MS = 15_000;
+const NONE = "-";
+
+type GT = ReturnType<typeof useGT>;
+
+const isLocalBackend = (environment: EnvironmentPresentation, wsl: boolean) => {
+  const id = desktopLocalBackendId(environment.entry.target);
+  return wsl ? id?.startsWith("wsl:") === true : id === "primary";
+};
+
+/** Everything the card and the map show about the bridge, from one Desktop poll and one link list. */
+export function useHostBridgeModel() {
+  const { desktop, pairing } = useHostBridgeSnapshot();
+  const { environments } = useEnvironments();
+  const wsl = environments.find((environment) => isLocalBackend(environment, true)) ?? null;
+  const windows = environments.find((environment) => isLocalBackend(environment, false)) ?? null;
+  const wslId = wsl?.environmentId ?? null;
+  const links = useEnvironmentQuery(
+    wslId === null ? null : peerLinkEnvironment.list({ environmentId: wslId, input: {} }),
+  );
+  // Listing asks the Windows backend through the bridge, so it runs only while a view shows it.
+  useLiveRefresh(
+    () => {
+      if (!links.isPending) links.refresh();
+    },
+    {
+      key: `host-bridge:${wslId ?? "none"}`,
+      intervalMs: LINKS_REFRESH_MS,
+      refreshOnShow: true,
+    },
+  );
+  const nowMinute = useNowMinute();
+  const wslConfig = wsl?.serverConfig ?? null;
+  const wslSupportsBridge =
+    wslConfig === null ? null : wslConfig.environment.capabilities.hostBridgeLinks === true;
+  const view = localHostBridgeView({
+    desktop,
+    wslEnvironmentId: wslId,
+    wslSupportsBridge,
+    links: links.data?.links ?? null,
+    now: DateTime.makeUnsafe(nowMinute),
+  });
+  const blocker = hostBridgeBlocker({
+    wslKnown: wsl !== null,
+    wslConnected: wsl?.connection.phase === "connected",
+    wslOffersLinks: offersLinkedEnvironments(wslConfig),
+    windowsOffersLinks: offersLinkedEnvironments(windows?.serverConfig ?? null),
+    wslSupportsBridge,
+  });
+  return { desktop, pairing, view, wsl, windows, blocker };
+}
+
+export type HostBridgeModel = ReturnType<typeof useHostBridgeModel>;
+
+export function hostBridgeStatusLabel(status: LocalHostBridgeStatus, gt: GT): string {
+  switch (status) {
+    case "unsupported":
+      return gt("Not available");
+    case "disabled":
+      return gt("Disabled");
+    case "discovering":
+      return gt("Discovering");
+    case "waiting-windows":
+      return gt("Waiting for Windows backend");
+    case "waiting-wsl":
+      return gt("Waiting for WSL backend");
+    case "starting":
+      return gt("Bridge starting");
+    case "pairing-required":
+      return gt("Pairing required");
+    case "connected":
+      return gt("Connected");
+    case "recovering":
+      return gt("Recovering");
+    case "permission-denied":
+      return gt("Permission denied");
+    case "identity-mismatch":
+      return gt("Identity mismatch");
+  }
+}
+
+/** The bridge's state as the map's edge shows it: in progress, linked, paused or in trouble. */
+export function hostBridgeTone(status: LocalHostBridgeStatus, pairing: HostBridgePairing | null) {
+  if (pairing?.status === "running") return "progress" as const;
+  if (pairing?.status === "failed") return "error" as const;
+  switch (status) {
+    case "connected":
+      return "linked" as const;
+    case "identity-mismatch":
+      return "paused" as const;
+    case "permission-denied":
+      return "error" as const;
+    case "disabled":
+    case "unsupported":
+      return "off" as const;
+    default:
+      return "progress" as const;
+  }
+}
+
+function stepLabel(step: HostBridgePairingStep, gt: GT, listeningUrl: string | null): string {
+  switch (step) {
+    case "enabling":
+      return gt("Turning on the bridge");
+    case "starting-helper":
+      return gt("Starting the bridge helper in WSL");
+    case "minting":
+      return listeningUrl === null
+        ? gt("Getting a pairing code from Windows")
+        : gt("Helper listening on {url}. Getting a pairing code from Windows", {
+            url: listeningUrl,
+          });
+    case "linking":
+      return gt("Checking Windows' identity through the bridge and pairing");
+    case "linked":
+      return gt("Linked");
+  }
+}
+
+function failureText(code: HostBridgeFailureCode, gt: GT) {
+  switch (code) {
+    case "windows-not-ready":
+      return {
+        reason: gt("The Windows backend did not become ready."),
+        next: gt("Wait until Windows shows as connected, then try again."),
+      };
+    case "wsl-not-running":
+      return {
+        reason: gt("The WSL backend is not running."),
+        next: gt("Turn on the WSL backend and wait for it to start, then try again."),
+      };
+    case "helper-failed":
+      return {
+        reason: gt("The bridge helper did not start listening in WSL."),
+        next: gt("See the last error below. If it repeats, restart T3 Code."),
+      };
+    case "unsupported":
+      return {
+        reason: gt("This setup cannot run the bridge."),
+        next: gt("It needs T3 Code for Windows with its WSL backend turned on."),
+      };
+    case "identity-mismatch":
+      return {
+        reason: gt("The Windows backend answers as a different environment than the one paired."),
+        next: gt("Review the change, then pair again."),
+      };
+    case "mint-failed":
+      return {
+        reason: gt("Windows did not give a pairing code."),
+        next: gt("Check that this app may manage access on Windows, then try again."),
+      };
+    case "links-off":
+      return {
+        reason: gt("Linked environments is off."),
+        next: gt("Turn it on in Settings > Labs for both Windows and WSL, then try again."),
+      };
+    case "bridge-not-windows":
+      return {
+        reason: gt("Something else answered on the bridge's port, not this Windows backend."),
+        next: gt("Nothing was sent to it. Close what uses that port, or restart T3 Code."),
+      };
+    case "bridge-unreachable":
+      return {
+        reason: gt("WSL could not reach Windows through the bridge."),
+        next: gt("See the last error below, then try again."),
+      };
+    case "link-refused":
+      return {
+        reason: gt("Windows refused the pairing."),
+        next: gt("Try again; a fresh code is made each time."),
+      };
+    case "link-failed":
+    case "desktop-failed":
+      return {
+        reason: gt("Linking failed."),
+        next: gt("See the details below, then try again."),
+      };
+  }
+}
+
+function blockerText(blocker: HostBridgeBlocker, gt: GT): string {
+  switch (blocker) {
+    case "no-wsl-backend":
+      return gt("Turn on the WSL backend in Settings > Connections first.");
+    case "wsl-disconnected":
+      return gt("Waiting for this app to connect to the WSL backend.");
+    case "wsl-links-off":
+      return gt("Turn on Linked environments in Settings > Labs for the WSL backend first.");
+    case "windows-links-off":
+      return gt("Turn on Linked environments in Settings > Labs for Windows first.");
+    case "runtime-lacks-bridge":
+      return gt(
+        "The WSL backend runs a T3 Code runtime without the host bridge. Rebuild the customized app.",
+      );
+  }
+}
+
+/** Seconds since `since`, ticking once a second while shown. */
+function useElapsed(since: number | null): number {
+  const [now, setNow] = useState(() => Date.now());
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- a one-second timer that ticks the elapsed time of a running pairing.
+  useEffect(() => {
+    if (since === null) return;
+    const timer = window.setInterval(() => setNow(Date.now()), 1_000);
+    return () => window.clearInterval(timer);
+  }, [since]);
+  return since === null ? 0 : Math.max(0, Math.round((now - since) / 1_000));
+}
+
+const formatElapsed = (seconds: number) =>
+  seconds < 60 ? `${seconds}s` : `${Math.floor(seconds / 60)}m ${seconds % 60}s`;
+
+function PairingProgress({ pairing }: { readonly pairing: HostBridgePairing }) {
+  const gt = useGT();
+  const elapsed = useElapsed(pairing.status === "running" ? pairing.startedAt : null);
+  const current = HOST_BRIDGE_PAIRING_STEPS.indexOf(pairing.step);
+  const failure = pairing.failure === null ? null : failureText(pairing.failure.code, gt);
+  return (
+    <div className="space-y-2 rounded-md border border-border/70 bg-muted/30 p-2.5 text-xs">
+      <div className="flex items-center justify-between gap-3">
+        <span className="font-medium">
+          {pairing.status === "running"
+            ? gt("Pairing…")
+            : pairing.status === "done"
+              ? gt("Linked")
+              : gt("Pairing failed")}
+        </span>
+        {pairing.status === "running" ? (
+          <span className="tabular-nums text-muted-foreground">{formatElapsed(elapsed)}</span>
+        ) : (
+          <button
+            type="button"
+            className="text-muted-foreground hover:text-foreground"
+            onClick={dismissHostBridgePairing}
+          >
+            {gt("Dismiss")}
+          </button>
+        )}
+      </div>
+      <div
+        role="progressbar"
+        aria-valuemin={0}
+        aria-valuemax={100}
+        aria-valuenow={Math.round(pairingProgress(pairing) * 100)}
+        className="h-1 overflow-hidden rounded-full bg-border"
+      >
+        <div
+          className={cn(
+            "h-full rounded-full transition-[width] duration-300",
+            pairing.status === "failed" ? "bg-destructive" : "bg-primary",
+          )}
+          style={{ width: `${Math.max(6, pairingProgress(pairing) * 100)}%` }}
+        />
+      </div>
+      <ol className="space-y-1">
+        {HOST_BRIDGE_PAIRING_STEPS.map((step, index) => {
+          const done = index < current || pairing.status === "done";
+          const active = index === current && pairing.status !== "done";
+          return (
+            <li
+              key={step}
+              className={cn(
+                "flex items-center gap-1.5",
+                !done && !active && "text-muted-foreground/60",
+              )}
+            >
+              {done ? (
+                <CheckIcon aria-hidden className="size-3 text-success" />
+              ) : active && pairing.status === "failed" ? (
+                <CircleAlertIcon aria-hidden className="size-3 text-destructive" />
+              ) : active ? (
+                <LoaderCircleIcon aria-hidden className="size-3 animate-spin" />
+              ) : (
+                <span aria-hidden className="inline-block size-3" />
+              )}
+              {stepLabel(step, gt, step === "minting" ? pairing.listeningUrl : null)}
+            </li>
+          );
+        })}
+      </ol>
+      {failure !== null ? (
+        <div className="space-y-0.5 text-destructive">
+          <p className="font-medium">{failure.reason}</p>
+          <p className="text-foreground">{failure.next}</p>
+          {pairing.failure?.detail ? (
+            <p className="break-words text-muted-foreground">{pairing.failure.detail}</p>
+          ) : null}
+        </div>
+      ) : null}
+    </div>
+  );
+}
+
+function AccessSelect({
+  value,
+  onChange,
+  disabled,
+}: {
+  readonly value: AuthMcpClientAccess;
+  readonly onChange: (access: AuthMcpClientAccess) => void;
+  readonly disabled: boolean;
+}) {
+  const gt = useGT();
+  const m = useMessages();
+  const selected = accessConfig[value];
+  return (
+    <Select
+      value={value}
+      disabled={disabled}
+      onValueChange={(next) => {
+        if (next !== null) onChange(next as AuthMcpClientAccess);
+      }}
+    >
+      <SelectTrigger
+        size="sm"
+        className="w-auto min-w-36"
+        aria-label={gt("Access for WSL agents on Windows")}
+      >
+        <SelectValue>
+          <span className="flex items-center gap-1.5">
+            <selected.icon aria-hidden className="size-3.5" />
+            {m(selected.label)}
+          </span>
+        </SelectValue>
+      </SelectTrigger>
+      <SelectPopup alignItemWithTrigger={false}>
+        {AuthMcpClientAccess.literals.map((option) => {
+          const { label, description, icon: Icon } = accessConfig[option];
+          return (
+            <SelectItem key={option} value={option} hideIndicator>
+              <span className="grid min-w-0 max-w-72 gap-0.5 py-0.5">
+                <span className="inline-flex items-center gap-1.5 font-medium text-foreground">
+                  <Icon aria-hidden className="size-3.5 shrink-0 text-muted-foreground" />
+                  {m(label)}
+                </span>
+                <span className="text-xs leading-4 text-muted-foreground">{m(description)}</span>
+              </span>
+            </SelectItem>
+          );
+        })}
+      </SelectPopup>
+    </Select>
+  );
+}
+
+function StatusDot({ tone }: { readonly tone: ReturnType<typeof hostBridgeTone> }) {
+  const color =
+    tone === "linked"
+      ? "bg-success"
+      : tone === "error" || tone === "paused"
+        ? "bg-destructive"
+        : tone === "off"
+          ? "bg-muted-foreground/40"
+          : "bg-warning";
+  return <span aria-hidden className={`inline-block size-2 shrink-0 rounded-full ${color}`} />;
+}
+
+function statusDescription(
+  model: HostBridgeModel,
+  gt: GT,
+  names: { readonly wsl: string; readonly windows: string },
+): string {
+  const { view, desktop } = model;
+  switch (view.status) {
+    case "connected":
+      return gt(
+        "Agents in {wsl} can delegate work that needs Windows to {windows}, through T3's own linked environments.",
+        names,
+      );
+    case "disabled":
+      return view.link === null
+        ? gt(
+            "Lets agents in {wsl} hand work that needs Windows, such as a browser or PowerShell, to {windows} on this computer. Nothing leaves this computer.",
+            names,
+          )
+        : gt("The link to {windows} is kept; enabling the bridge needs no pairing.", names);
+    case "pairing-required":
+      return view.pairingReason === "expired"
+        ? gt("The link expired after a month unused. Pair again to keep using it.")
+        : gt("The bridge is up, but {wsl} is not linked to {windows} yet.", names);
+    case "permission-denied":
+      return gt(
+        "{windows} no longer accepts this link: it was revoked there. It is not paired again until you pair it.",
+        names,
+      );
+    case "identity-mismatch":
+      return gt(
+        "The Windows backend answers as a different environment than the one paired. The bridge is paused until you confirm.",
+      );
+    case "unsupported":
+      return view.runtimeLacksBridge
+        ? gt(
+            "The WSL backend runs a T3 Code runtime without the host bridge. Rebuild the customized app.",
+          )
+        : (desktop?.detail ?? gt("Needs T3 Code for Windows with its WSL backend turned on."));
+    default:
+      return view.detail ?? desktop?.detail ?? desktop?.lastError ?? "";
+  }
+}
+
+/**
+ * Status, progress, actions, access and diagnostics of the WSL host bridge. The card in
+ * Connections and the Environments map's details both show this.
+ */
+export function HostBridgeControls({ model }: { readonly model: HostBridgeModel }) {
+  const gt = useGT();
+  const { desktop, pairing, view, wsl, windows, blocker } = model;
+  const [accessChoice, setAccess] = useState<AuthMcpClientAccess | null>(null);
+  const [busy, setBusy] = useState(false);
+  if (desktop === null) return null;
+  const access = accessChoice ?? view.link?.access ?? "approval-required";
+  const names = {
+    wsl: wsl?.label ?? gt("WSL"),
+    windows: desktop.windowsLabel ?? windows?.label ?? gt("Windows"),
+  };
+  const wslId: EnvironmentId | null = wsl?.environmentId ?? null;
+  const pairingRunning = pairing?.status === "running";
+  const locked = busy || pairingRunning;
+  const tone = hostBridgeTone(view.status, pairing);
+
+  const run = async (task: () => Promise<void>) => {
+    if (busy) return;
+    setBusy(true);
+    try {
+      await task();
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const pair = async (replacing?: EnvironmentId) => {
+    if (wslId === null) return;
+    const confirmed = await requestConfirmDialog(
+      replacing === undefined
+        ? gt(
+            "Link {wsl} to {windows} on this computer? Agents in WSL can then start work on Windows, up to the access you picked. Windows keeps its own sign-ins, sandbox and approvals.",
+            names,
+          )
+        : gt(
+            "The Windows backend now answers as a different environment than the one this bridge was paired with. Forget the old link and pair with {windows}?",
+            names,
+          ),
+    );
+    if (confirmed !== true) return;
+    const linked = await pairHostBridge({
+      wslEnvironmentId: wslId,
+      access,
+      ...(replacing === undefined ? {} : { replacing }),
+    });
+    if (linked) {
+      setAccess(null);
+      toastManager.add({
+        type: "success",
+        title: gt("{wsl} can now delegate work to {windows}", names),
+      });
+    }
+  };
+
+  const revoke = async () => {
+    const target = view.link ?? view.staleLink;
+    const confirmed = await requestConfirmDialog(
+      gt(
+        "Revoke the link from {wsl} to {windows}? Agents in WSL can no longer start work on Windows, and the bridge turns off. It is not paired again until you pair it.",
+        { wsl: names.wsl, windows: target?.label ?? names.windows },
+      ),
+      { variant: "destructive" },
+    );
+    if (confirmed !== true || wslId === null) return;
+    await run(async () => {
+      const failed = await revokeHostBridge({
+        wslEnvironmentId: wslId,
+        linkedEnvironmentId: target?.environmentId ?? null,
+      });
+      if (failed !== null) {
+        toastManager.add({
+          type: "error",
+          title: gt("Could not revoke the link"),
+          description: failed,
+        });
+      }
+    });
+  };
+
+  const primary = (() => {
+    if (pairingRunning || view.status === "unsupported") return null;
+    if (blocker !== null && view.link === null) return null;
+    switch (view.status) {
+      case "disabled":
+        return view.link === null ? (
+          <Button size="xs" disabled={locked} onClick={() => void pair()}>
+            {gt("Enable and pair")}
+          </Button>
+        ) : (
+          <Button
+            size="xs"
+            disabled={locked}
+            onClick={() => void run(() => setHostBridge({ enabled: true }))}
+          >
+            {gt("Enable")}
+          </Button>
+        );
+      case "pairing-required":
+      case "permission-denied":
+        return (
+          <Button size="xs" disabled={locked} onClick={() => void pair()}>
+            {view.pairingReason === "unlinked" ? gt("Pair") : gt("Pair again")}
+          </Button>
+        );
+      case "identity-mismatch":
+        return (
+          <Button
+            size="xs"
+            disabled={locked}
+            onClick={() => void pair(view.staleLink?.environmentId)}
+          >
+            {gt("Review and pair")}
+          </Button>
+        );
+      default:
+        return null;
+    }
+  })();
+
+  return (
+    <div className="space-y-2.5 text-xs">
+      <div className="flex items-start justify-between gap-3">
+        <div className="min-w-0 flex-1 space-y-0.5">
+          <p className="flex items-center gap-2 text-sm font-medium">
+            <StatusDot tone={tone} />
+            {pairingRunning ? gt("Pairing…") : hostBridgeStatusLabel(view.status, gt)}
+          </p>
+          <p className="text-muted-foreground">
+            {blocker !== null && view.link === null && view.status !== "unsupported"
+              ? blockerText(blocker, gt)
+              : statusDescription(model, gt, names)}
+          </p>
+        </div>
+        <div className="flex shrink-0 flex-wrap items-center justify-end gap-1.5">
+          {primary}
+          {desktop.enabled && !pairingRunning ? (
+            <Button
+              size="xs"
+              variant="outline"
+              disabled={locked}
+              onClick={() => void run(() => setHostBridge({ enabled: false }))}
+            >
+              {gt("Disable")}
+            </Button>
+          ) : null}
+          {(view.link !== null || view.staleLink !== null) && !pairingRunning ? (
+            <Button
+              size="xs"
+              variant="destructive-outline"
+              disabled={locked}
+              onClick={() => void revoke()}
+            >
+              {gt("Revoke")}
+            </Button>
+          ) : null}
+        </div>
+      </div>
+      {pairing !== null ? <PairingProgress pairing={pairing} /> : null}
+      {view.status !== "unsupported" ? (
+        <div className="flex flex-wrap items-center justify-between gap-2">
+          <span className="text-muted-foreground">
+            {view.link !== null && view.link.access !== access
+              ? gt("Changing it pairs again at the new level.")
+              : gt("Access for WSL agents on Windows")}
+          </span>
+          <div className="flex items-center gap-1.5">
+            <AccessSelect value={access} onChange={setAccess} disabled={locked} />
+            {view.link !== null && view.link.access !== access ? (
+              <Button size="xs" variant="outline" disabled={locked} onClick={() => void pair()}>
+                {gt("Apply")}
+              </Button>
+            ) : null}
+          </div>
+        </div>
+      ) : null}
+      <Diagnostics state={desktop} linkUrls={view.link?.urls ?? null} />
+    </div>
+  );
+}
+
+function Diagnostics({
+  state,
+  linkUrls,
+}: {
+  readonly state: DesktopHostBridgeState;
+  readonly linkUrls: ReadonlyArray<string> | null;
+}) {
+  const gt = useGT();
+  const rows: Array<readonly [string, string]> = [
+    [gt("Helper"), state.phase],
+    [gt("Listening on (WSL loopback)"), state.url ?? NONE],
+    [gt("Link addresses"), (linkUrls ?? state.urls).join(", ")],
+    [
+      gt("Windows environment"),
+      state.windowsEnvironmentId === null
+        ? NONE
+        : `${state.windowsLabel ?? ""} ${state.windowsEnvironmentId}`.trim(),
+    ],
+    [
+      gt("Windows backend port (Windows loopback)"),
+      state.windowsPort === null ? NONE : String(state.windowsPort),
+    ],
+    [gt("WSL distro"), state.wslDistro ?? NONE],
+    [gt("WSL runtime"), state.wslRuntimeId ?? NONE],
+    [gt("WSL networking"), state.wslNetworking ?? NONE],
+    [gt("Helper process"), state.helperPid === null ? NONE : String(state.helperPid)],
+    [gt("Restarts"), String(state.restarts)],
+    [
+      gt("Streams open / total / refused"),
+      `${state.streams.open} / ${state.streams.total} / ${state.streams.refused}`,
+    ],
+    [gt("Next retry"), state.nextRetryAt ?? NONE],
+    [gt("Last error"), state.lastError ?? NONE],
+    [gt("Since"), state.since],
+  ];
+  return (
+    <details className="group">
+      <summary className="cursor-pointer select-none text-muted-foreground hover:text-foreground">
+        {gt("Diagnostics")}
+      </summary>
+      <dl className="mt-2 grid max-w-xl grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1">
+        {rows.map(([label, value]) => (
+          <div key={label} className="contents">
+            <dt className="whitespace-nowrap text-muted-foreground">{label}</dt>
+            <dd className="min-w-0 break-all font-mono">{value}</dd>
+          </div>
+        ))}
+      </dl>
+    </details>
+  );
+}
+
+/**
+ * The bridge's controls in the Environments map: on its link, and on the WSL and Windows
+ * machines of this computer. Nothing shows for other machines or without the bridge.
+ */
+export function HostBridgePanel({
+  environment,
+}: {
+  /** The machine whose details show it; absent for the bridge's own link. */
+  readonly environment?: EnvironmentPresentation;
+}) {
+  const gt = useGT();
+  const model = useHostBridgeModel();
+  if (model.desktop === null || model.view.status === "unsupported") return null;
+  if (
+    environment !== undefined &&
+    environment.environmentId !== model.wsl?.environmentId &&
+    environment.environmentId !== model.windows?.environmentId
+  ) {
+    return null;
+  }
+  return (
+    <section className="space-y-1.5">
+      <h3 className="text-xs font-medium text-host-bridge">
+        {gt("Host bridge on this computer")}
+      </h3>
+      <HostBridgeControls model={model} />
+    </section>
+  );
+}
diff --git a/apps/web/src/components/settings/LocalHostBridge.logic.test.ts b/apps/web/src/components/settings/LocalHostBridge.logic.test.ts
