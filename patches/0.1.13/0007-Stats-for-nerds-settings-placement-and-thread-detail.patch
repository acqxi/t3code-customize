+export interface ThreadDetailsPerformanceInput {
+  readonly threadRef: ScopedThreadRef | null;
+  readonly current: TurnPerformanceSource | null;
+  readonly previous: TurnPerformanceSource | null;
+  readonly hiddenMetrics: ReadonlySet<string>;
+}
+
+/** Thread details: the running turn, else the last completed one, one metric per row. */
+export function ThreadDetailsTurnPerformance({
+  threadRef,
+  current,
+  previous,
+  hiddenMetrics,
+}: ThreadDetailsPerformanceInput) {
+  const source = current ?? previous;
+  if (source === null) return null;
+  const threadKey = threadRef === null ? "" : `${threadRef.environmentId}:${threadRef.threadId}`;
+  return (
+    <ThreadDetailsTurnPerformanceRows
+      key={`${threadKey}:${source.turn.id}`}
+      threadRef={threadRef}
+      source={source}
+      hidden={hiddenMetrics}
+    />
+  );
+}
+
+function ThreadDetailsTurnPerformanceRows({
+  threadRef,
+  source,
+  hidden,
+}: {
+  threadRef: ScopedThreadRef | null;
+  source: TurnPerformanceSource;
+  hidden: ReadonlySet<string>;
+}) {
+  const gt = useGT();
+  const running = isTurnRunning(source.turn);
+  const metrics = useTurnMetrics(threadRef, source, hidden);
+  return (
+    <ThreadDetailsSection
+      headingId="thread-details-performance-heading"
+      title={gt("Turn performance")}
+      showHeading={false}
+    >
+      <div data-thread-details-performance={source.turn.id} className="space-y-1.5 px-2.5">
+        <p className="text-2xs text-muted-foreground">
+          {running ? gt("Current turn") : gt("Last turn", { $context: "previous agent turn" })}
+        </p>
+        <TurnPerformanceGrid source={source} metrics={metrics} live={running} />
+      </div>
+    </ThreadDetailsSection>
+  );
+}
+
 export interface TurnPerformanceTimelineValue {
   readonly threadId: ThreadId;
   /** This thread's own provider turns; items from other threads never resolve. */
diff --git a/apps/web/src/components/chat/statsForNerdsPlacement.test.ts b/apps/web/src/components/chat/statsForNerdsPlacement.test.ts
new file mode 100644
index 0000000000..831319fcf9
--- /dev/null
+++ b/apps/web/src/components/chat/statsForNerdsPlacement.test.ts
@@ -0,0 +1,72 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  isDefaultStatsForNerdsPlacements,
+  resetStatsForNerdsPlacements,
+  resolveStatsForNerdsPlacements,
+  setStatsForNerdsPlacement,
+} from "./statsForNerdsPlacement";
+import { resolveThreadDetailsVisibility } from "./threadDetailsItems";
+
+const defaults = { statsForNerdsShowPerReply: true, statsForNerdsShowInComposer: true };
+const base = { ...defaults, threadDetailsItems: {}, threadDetailsUsageEnabled: false };
+
+describe("stats for nerds placements", () => {
+  it("reads the two switches and the thread details item", () => {
+    expect(resolveStatsForNerdsPlacements(base)).toEqual({
+      perReply: true,
+      composer: true,
+      threadDetails: false,
+    });
+    expect(
+      resolveStatsForNerdsPlacements({
+        ...base,
+        statsForNerdsShowInComposer: false,
+        threadDetailsItems: { performance: true },
+      }),
+    ).toEqual({ perReply: true, composer: false, threadDetails: true });
+  });
+
+  it("writes each place to its own setting", () => {
+    expect(setStatsForNerdsPlacement(base, "perReply", false)).toEqual({
+      statsForNerdsShowPerReply: false,
+    });
+    expect(setStatsForNerdsPlacement(base, "composer", false)).toEqual({
+      statsForNerdsShowInComposer: false,
+    });
+    const shown = setStatsForNerdsPlacement(
+      { ...base, threadDetailsItems: { servers: false } },
+      "threadDetails",
+      true,
+    );
+    expect(shown).toEqual({ threadDetailsItems: { servers: false, performance: true } });
+  });
+
+  it("is the thread details card's own item, so the card menu and the placement agree", () => {
+    const patch = setStatsForNerdsPlacement(base, "threadDetails", true);
+    const next = { ...base, ...patch };
+    expect(resolveThreadDetailsVisibility(next).performance).toBe(true);
+    expect(resolveStatsForNerdsPlacements(next).threadDetails).toBe(true);
+    // Back to the default stores nothing.
+    expect(setStatsForNerdsPlacement(next, "threadDetails", false)).toEqual({
+      threadDetailsItems: {},
+    });
+  });
+
+  it("resets every place and keeps other thread details choices", () => {
+    const changed = {
+      statsForNerdsShowPerReply: false,
+      statsForNerdsShowInComposer: false,
+      threadDetailsItems: { performance: true, servers: false },
+      threadDetailsUsageEnabled: false,
+    };
+    expect(
+      isDefaultStatsForNerdsPlacements(resolveStatsForNerdsPlacements(changed), defaults),
+    ).toBe(false);
+    const reset = { ...changed, ...resetStatsForNerdsPlacements(changed, defaults) };
+    expect(reset.threadDetailsItems).toEqual({ servers: false });
+    expect(isDefaultStatsForNerdsPlacements(resolveStatsForNerdsPlacements(reset), defaults)).toBe(
+      true,
+    );
+  });
+});
diff --git a/apps/web/src/components/chat/statsForNerdsPlacement.ts b/apps/web/src/components/chat/statsForNerdsPlacement.ts
new file mode 100644
index 0000000000..f5fba7f8ae
--- /dev/null
+++ b/apps/web/src/components/chat/statsForNerdsPlacement.ts
@@ -0,0 +1,82 @@
+import type { ClientSettings } from "@t3tools/contracts";
+import { msg } from "gt-react";
+
+import {
+  resolveThreadDetailsVisibility,
+  setThreadDetailsItem,
+  THREAD_DETAILS_ITEMS,
+} from "./threadDetailsItems";
+
+/**
+ * Where Stats for nerds turn performance shows. Each place keeps its own stored setting: the two
+ * Stats for nerds switches, and the thread details "performance" item, so the card's own menu and
+ * this list can never disagree.
+ */
+export const STATS_FOR_NERDS_PLACEMENTS = [
+  { id: "perReply", label: msg("Under each reply") },
+  { id: "composer", label: msg("Under the composer") },
+  { id: "threadDetails", label: msg("In thread details") },
+] as const;
+
+export type StatsForNerdsPlacement = (typeof STATS_FOR_NERDS_PLACEMENTS)[number]["id"];
+
+type PlacementSettings = Pick<
+  ClientSettings,
+  | "statsForNerdsShowPerReply"
+  | "statsForNerdsShowInComposer"
+  | "threadDetailsItems"
+  | "threadDetailsUsageEnabled"
+>;
+
+const PERFORMANCE_ITEM = THREAD_DETAILS_ITEMS.find((item) => item.id === "performance")!;
+
+export function resolveStatsForNerdsPlacements(
+  settings: PlacementSettings,
+): Readonly<Record<StatsForNerdsPlacement, boolean>> {
+  return {
+    perReply: settings.statsForNerdsShowPerReply,
+    composer: settings.statsForNerdsShowInComposer,
+    threadDetails: resolveThreadDetailsVisibility(settings).performance,
+  };
+}
+
+export function setStatsForNerdsPlacement(
+  settings: PlacementSettings,
+  placement: StatsForNerdsPlacement,
+  visible: boolean,
+): Partial<ClientSettings> {
+  switch (placement) {
+    case "perReply":
+      return { statsForNerdsShowPerReply: visible };
+    case "composer":
+      return { statsForNerdsShowInComposer: visible };
+    case "threadDetails":
+      return { threadDetailsItems: setThreadDetailsItem(settings, PERFORMANCE_ITEM, visible) };
+  }
+}
+
+export function isDefaultStatsForNerdsPlacements(
+  placements: Readonly<Record<StatsForNerdsPlacement, boolean>>,
+  defaults: Pick<ClientSettings, "statsForNerdsShowPerReply" | "statsForNerdsShowInComposer">,
+): boolean {
+  return (
+    placements.perReply === defaults.statsForNerdsShowPerReply &&
+    placements.composer === defaults.statsForNerdsShowInComposer &&
+    placements.threadDetails === PERFORMANCE_ITEM.defaultVisible
+  );
+}
+
+export function resetStatsForNerdsPlacements(
+  settings: PlacementSettings,
+  defaults: Pick<ClientSettings, "statsForNerdsShowPerReply" | "statsForNerdsShowInComposer">,
+): Partial<ClientSettings> {
+  return {
+    statsForNerdsShowPerReply: defaults.statsForNerdsShowPerReply,
+    statsForNerdsShowInComposer: defaults.statsForNerdsShowInComposer,
+    threadDetailsItems: setThreadDetailsItem(
+      settings,
+      PERFORMANCE_ITEM,
+      PERFORMANCE_ITEM.defaultVisible,
+    ),
+  };
+}
