+import { SettingResetButton, SettingsRow, SettingsSection } from "./settingsLayout";
+import { useSearchableSetting } from "./settingsSearch";
+import { useScopedSettings, useUpdateScopedSettings } from "./useScopedSettings";
+
+/** Under each reply, under the composer, in thread details: a checkbox menu like Thread details. */
+function StatsForNerdsPlacementRow() {
+  const gt = useGT();
+  const m = useMessages();
+  const setting = useSearchableSetting();
+  const settings = useScopedSettings();
+  const updateSettings = useUpdateScopedSettings();
+  const placements = resolveStatsForNerdsPlacements(settings);
+  const enabled = STATS_FOR_NERDS_PLACEMENTS.filter((placement) => placements[placement.id]).length;
+  const isDefault = isDefaultStatsForNerdsPlacements(placements, DEFAULT_UNIFIED_SETTINGS);
+  return (
+    <SettingsRow
+      {...setting("stats-for-nerds-placement")}
+      description={gt("Under replies, below the composer, or in thread details.")}
+      resetAction={
+        isDefault ? null : (
+          <SettingResetButton
+            ariaLabel={gt("Reset where stats show to default")}
+            onClick={() =>
+              updateSettings(resetStatsForNerdsPlacements(settings, DEFAULT_UNIFIED_SETTINGS))
+            }
+          />
+        )
+      }
+      control={
+        <Menu>
+          <MenuTrigger
+            render={
+              <Button
+                variant="outline"
+                size="sm"
+                className="w-full justify-between sm:w-40"
+                aria-label={gt("Where stats show: {enabled} of {total} on", {
+                  enabled,
+                  total: STATS_FOR_NERDS_PLACEMENTS.length,
+                })}
+              />
+            }
+          >
+            <T>
+              <Var>{enabled}</Var> of <Var>{STATS_FOR_NERDS_PLACEMENTS.length}</Var> on
+            </T>
+            <ChevronDownIcon aria-hidden />
+          </MenuTrigger>
+          <MenuPopup align="end">
+            <MenuGroup>
+              <MenuGroupLabel>
+                <T>Show stats</T>
+              </MenuGroupLabel>
+              {STATS_FOR_NERDS_PLACEMENTS.map((placement) => (
+                <MenuCheckboxItem
+                  key={placement.id}
+                  checked={placements[placement.id]}
+                  onCheckedChange={(checked) =>
+                    updateSettings(setStatsForNerdsPlacement(settings, placement.id, checked))
+                  }
+                >
+                  {m(placement.label)}
+                </MenuCheckboxItem>
+              ))}
+            </MenuGroup>
+            <MenuSeparator />
+            <MenuItem
+              disabled={isDefault}
+              onClick={() =>
+                updateSettings(resetStatsForNerdsPlacements(settings, DEFAULT_UNIFIED_SETTINGS))
+              }
+            >
+              <T>Reset to default</T>
+            </MenuItem>
+          </MenuPopup>
+        </Menu>
+      }
+    />
+  );
+}
+
+/** Which turn metrics show, as one checkbox menu instead of a row per metric. */
+function StatsForNerdsMetricsRow() {
+  const gt = useGT();
+  const m = useMessages();
+  const setting = useSearchableSetting();
+  const hidden = useScopedSettings((settings) => settings.statsForNerdsHiddenMetrics);
+  const updateSettings = useUpdateScopedSettings();
+  const shown = TURN_PERFORMANCE_METRIC_IDS.filter((id) => !hidden.includes(id)).length;
+  const total = TURN_PERFORMANCE_METRIC_IDS.length;
+  const reset = () =>
+    updateSettings({
+      statsForNerdsHiddenMetrics: DEFAULT_UNIFIED_SETTINGS.statsForNerdsHiddenMetrics,
+    });
+  return (
+    <SettingsRow
+      {...setting("stats-for-nerds-metrics")}
+      description={gt("Choose which turn metrics show.")}
+      resetAction={
+        hidden.length === 0 ? null : (
+          <SettingResetButton ariaLabel={gt("Reset metrics to default")} onClick={reset} />
+        )
+      }
+      control={
+        <Menu>
+          <MenuTrigger
+            render={
+              <Button
+                variant="outline"
+                size="sm"
+                className="w-full justify-between sm:w-40"
+                aria-label={gt("Metrics: {enabled} of {total} on", { enabled: shown, total })}
+              />
+            }
+          >
+            <T>
+              <Var>{shown}</Var> of <Var>{total}</Var> on
+            </T>
+            <ChevronDownIcon aria-hidden />
+          </MenuTrigger>
+          <MenuPopup align="end">
+            <MenuGroup>
+              <MenuGroupLabel>
+                <T>Show metrics</T>
+              </MenuGroupLabel>
+              {TURN_PERFORMANCE_METRIC_IDS.map((id) => {
+                const { label, abbr } = TURN_PERFORMANCE_METRIC_LABELS[id];
+                return (
+                  <MenuCheckboxItem
+                    key={id}
+                    checked={!hidden.includes(id)}
+                    onCheckedChange={(checked) =>
+                      updateSettings({
+                        statsForNerdsHiddenMetrics: toggleHiddenMetric(hidden, id, checked),
+                      })
+                    }
+                  >
+                    {m(label)}
+                    <span className="ms-auto ps-3 text-muted-foreground">{m(abbr)}</span>
+                  </MenuCheckboxItem>
+                );
+              })}
+            </MenuGroup>
+            <MenuSeparator />
+            <MenuItem disabled={hidden.length === 0} onClick={reset}>
+              <T>Reset to default</T>
+            </MenuItem>
+          </MenuPopup>
+        </Menu>
+      }
+    />
+  );
+}
+
+export function StatsForNerdsSettingsSection() {
+  const gt = useGT();
+  const setting = useSearchableSetting();
+  const settings = useScopedSettings();
+  const updateSettings = useUpdateScopedSettings();
+
+  return (
+    <SettingsSection id="stats-for-nerds-section" title={gt("Stats for nerds")}>
+      <SettingsRow
+        {...setting("stats-for-nerds")}
+        description={gt(
+          "Turn speed, latency, tokens, context and usage limits; ≈ marks estimates.",
+        )}
+        resetAction={
+          settings.statsForNerdsEnabled !== DEFAULT_UNIFIED_SETTINGS.statsForNerdsEnabled ? (
+            <SettingResetButton
+              ariaLabel={gt("Reset stats for nerds to default")}
+              onClick={() =>
+                updateSettings({
+                  statsForNerdsEnabled: DEFAULT_UNIFIED_SETTINGS.statsForNerdsEnabled,
+                })
+              }
+            />
+          ) : null
+        }
+        control={
+          <Switch
+            checked={settings.statsForNerdsEnabled}
+            onCheckedChange={(checked) =>
+              updateSettings({ statsForNerdsEnabled: Boolean(checked) })
+            }
+            aria-label={gt("Stats for nerds")}
+          />
+        }
+      />
+      {settings.statsForNerdsEnabled && (
+        <>
+          <StatsForNerdsPlacementRow />
+          <StatsForNerdsMetricsRow />
+        </>
+      )}
+    </SettingsSection>
+  );
+}
