+  type UsagePerformanceSummary,
   type UsageSummary,
   type UsageProviderKind,
   type UsageSummaryInput,
@@ -247,3 +249,40 @@ export function useUsage(
     refresh,
   };
 }
+
+const usagePerformanceAtom = Atom.family((key: string) =>
+  Atom.make((get): ReadonlyArray<UsagePerformanceSummary | null> => {
+    const { environmentIds, input } = JSON.parse(key) as {
+      readonly environmentIds: readonly EnvironmentId[];
+      readonly input: UsagePerformanceInput;
+    };
+    return environmentIds.map((environmentId) =>
+      AsyncResult.getOrElse(
+        get(serverEnvironment.usagePerformance({ environmentId, input })),
+        () => null,
+      ),
+    );
+  }).pipe(Atom.withLabel(`web-usage:performance:${key}`)),
+);
+
+/** Measured T3 turns per model in the dashboard's window, for the environments it shows. */
+export function useUsagePerformance(
+  environments: readonly Pick<EnvironmentUsageStatus, "environmentId" | "canReadDiagnostics">[],
+  window: UsageSummaryInput,
+): ReadonlyArray<UsagePerformanceSummary | null> {
+  const input: UsagePerformanceInput = {
+    sinceDay: window.sinceDay,
+    untilDay: window.untilDay,
+    timeZone: window.timeZone,
+    // Instants bound the window only when hourly, as for the usage summary.
+    ...(window.resolution === "hour" &&
+    window.sinceTime !== undefined &&
+    window.untilTime !== undefined
+      ? { sinceTime: window.sinceTime, untilTime: window.untilTime }
+      : {}),
+  };
+  const environmentIds = environments
+    .filter((environment) => environment.canReadDiagnostics)
+    .map((environment) => environment.environmentId);
+  return useAtomValue(usagePerformanceAtom(JSON.stringify({ environmentIds, input })));
+}
