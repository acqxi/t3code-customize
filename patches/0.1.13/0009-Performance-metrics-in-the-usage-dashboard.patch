+import type { UsageModelPerformance } from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import { mergeUsagePerformance } from "./usagePerformance";
+
+const model = (overrides: Partial<UsageModelPerformance>): UsageModelPerformance => ({
+  provider: "claude",
+  model: "claude-opus-5-5",
+  turns: 1,
+  generationTurns: 1,
+  generationTokens: 1_000,
+  generationMs: 10_000,
+  generationEstimated: false,
+  firstTokenMs: [],
+  firstAnswerMs: [],
+  ...overrides,
+});
+
+describe("mergeUsagePerformance", () => {
+  it("merges environments before taking medians and token-weighted speed", () => {
+    const merged = mergeUsagePerformance([
+      { models: [model({ turns: 2, firstTokenMs: [1_000, 3_000], firstAnswerMs: [2_000] })] },
+      null,
+      {
+        models: [
+          model({
+            generationTokens: 400,
+            generationMs: 2_000,
+            generationEstimated: true,
+            firstTokenMs: [2_000],
+          }),
+          model({
+            provider: "antigravity",
+            model: "gemini-4-neon",
+            generationMs: 0,
+            generationTokens: 0,
+          }),
+        ],
+      },
+    ]);
+    expect(merged.get("claude:claude-opus-5-5")).toEqual({
+      turns: 3,
+      tokensPerSecond: 1_400 / 12,
+      estimated: true,
+      ttftMs: 2_000,
+      ttftP90Ms: 2_800,
+      ttfaMs: 2_000,
+      ttfaP90Ms: 2_000,
+    });
+    expect(merged.get("antigravity:gemini-4-neon")).toMatchObject({
+      turns: 1,
+      tokensPerSecond: null,
+      ttftMs: null,
+    });
+  });
+});
diff --git a/apps/web/src/components/usage/usagePerformance.ts b/apps/web/src/components/usage/usagePerformance.ts
new file mode 100644
index 0000000000..539a05b338
--- /dev/null
+++ b/apps/web/src/components/usage/usagePerformance.ts
@@ -0,0 +1,64 @@
+import type { UsagePerformanceSummary } from "@t3tools/contracts";
+
+import { percentile } from "../chat/TurnPerformanceScope.logic";
+
+/** One breakdown row's measured T3 turns, merged across the selected environments. */
+export interface ModelPerformance {
+  readonly turns: number;
+  /** Total generation tokens over total generation time; null without a timed turn. */
+  readonly tokensPerSecond: number | null;
+  readonly estimated: boolean;
+  readonly ttftMs: number | null;
+  readonly ttftP90Ms: number | null;
+  readonly ttfaMs: number | null;
+  readonly ttfaP90Ms: number | null;
+}
+
+/** Keyed like the breakdown's rows, `${provider}:${model}`; medians come after the merge. */
+export function mergeUsagePerformance(
+  summaries: ReadonlyArray<UsagePerformanceSummary | null>,
+): ReadonlyMap<string, ModelPerformance> {
+  const groups = new Map<
+    string,
+    {
+      turns: number;
+      tokens: number;
+      ms: number;
+      estimated: boolean;
+      ttft: number[];
+      ttfa: number[];
+    }
+  >();
+  for (const model of summaries.flatMap((summary) => summary?.models ?? [])) {
+    const key = `${model.provider}:${model.model}`;
+    const group = groups.get(key) ?? {
+      turns: 0,
+      tokens: 0,
+      ms: 0,
+      estimated: false,
+      ttft: [],
+      ttfa: [],
+    };
+    group.turns += model.turns;
+    group.tokens += model.generationTokens;
+    group.ms += model.generationMs;
+    group.estimated ||= model.generationEstimated;
+    group.ttft.push(...model.firstTokenMs);
+    group.ttfa.push(...model.firstAnswerMs);
+    groups.set(key, group);
+  }
+  return new Map(
+    [...groups].map(([key, group]) => [
+      key,
+      {
+        turns: group.turns,
+        tokensPerSecond: group.ms > 0 ? group.tokens / (group.ms / 1000) : null,
+        estimated: group.estimated,
+        ttftMs: percentile(group.ttft, 0.5),
+        ttftP90Ms: percentile(group.ttft, 0.9),
+        ttfaMs: percentile(group.ttfa, 0.5),
+        ttfaP90Ms: percentile(group.ttfa, 0.9),
+      },
+    ]),
+  );
+}
