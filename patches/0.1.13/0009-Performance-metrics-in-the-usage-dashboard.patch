+++ b/apps/server/src/usage/usagePerformance.ts
@@ -0,0 +1,152 @@
+import {
+  type OrchestrationV2ProviderTurn,
+  OrchestrationV2ProviderTurnJson,
+  UsageReadError,
+  type UsageModelPerformance,
+  type UsagePerformanceInput,
+  type UsagePerformanceSummary,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import * as SqlClient from "effect/sql/SqlClient";
+
+import { resolveModelAliases, usageTimestampFilter } from "./usageAggregation.ts";
+
+/** Average speed ignores shorter streams, as the turn grid does: network bursts set their time. */
+const MIN_GENERATION_MS = 1_000;
+const DAY_MS = 86_400_000;
+
+const decodeTurn = Schema.decodeUnknownOption(
+  Schema.fromJsonString(OrchestrationV2ProviderTurnJson),
+);
+
+export interface MeasuredTurn {
+  readonly turn: OrchestrationV2ProviderTurn;
+  readonly driver: string;
+  /** What the run requested, for turns whose provider reported no model. */
+  readonly requestedModel: string | null;
+}
+
+/** The usage dashboard names Claude Code "claude"; other drivers share their usage kind's name. */
+export function usageProviderOf(driver: string): string {
+  return driver === "claudeAgent" ? "claude" : driver;
+}
+
+/**
+ * Groups measured turns by provider and model (after aliases). Speed sums generation tokens and
+ * time over turns with at least 1 s of generation; latencies stay as samples for the client.
+ */
+export function summarizeUsagePerformance(
+  turns: ReadonlyArray<MeasuredTurn>,
+  aliases: Readonly<Record<string, string>>,
+): UsagePerformanceSummary {
+  const resolved = resolveModelAliases(aliases);
+  const groups = new Map<string, UsageModelPerformance>();
+  for (const { turn, driver, requestedModel } of turns) {
+    const performance = turn.performance;
+    const raw = turn.model ?? requestedModel;
+    if (performance === undefined || performance.live || raw === null) continue;
+    const provider = usageProviderOf(driver);
+    const model = resolved.get(raw) ?? raw;
+    const key = `${provider}\0${model}`;
+    const group = groups.get(key) ?? {
+      provider,
+      model,
+      turns: 0,
+      generationTurns: 0,
+      generationTokens: 0,
+      generationMs: 0,
+      generationEstimated: false,
+      firstTokenMs: [],
+      firstAnswerMs: [],
+    };
+    const tokens = performance.generationTokens;
+    const timed =
+      tokens !== undefined &&
+      performance.generationMs !== undefined &&
+      performance.generationMs >= MIN_GENERATION_MS;
+    groups.set(key, {
+      ...group,
+      turns: group.turns + 1,
+      generationTurns: group.generationTurns + (timed ? 1 : 0),
+      generationTokens: group.generationTokens + (timed ? tokens.value : 0),
+      generationMs: group.generationMs + (timed ? performance.generationMs! : 0),
+      generationEstimated:
+        group.generationEstimated || (timed && tokens.basis !== "provider_exact"),
+      firstTokenMs:
+        performance.firstTokenMs === undefined
+          ? group.firstTokenMs
+          : [...group.firstTokenMs, performance.firstTokenMs],
+      firstAnswerMs:
+        performance.firstAnswerMs === undefined
+          ? group.firstAnswerMs
+          : [...group.firstAnswerMs, performance.firstAnswerMs],
+    });
+  }
+  return { models: [...groups.values()] };
+}
+
+interface Row {
+  readonly turn_json: string;
+  readonly driver: string | null;
+  readonly requested_model: string | null;
+}
+
+/** Finished turns with performance that started in the dashboard's window, by model. */
+export const readUsagePerformance = Effect.fn("readUsagePerformance")(function* (
+  input: UsagePerformanceInput,
+  aliases: Readonly<Record<string, string>>,
+) {
+  const sinceTime = input.sinceTime === undefined ? Option.none() : DateTime.make(input.sinceTime);
+  const untilTime = input.untilTime === undefined ? Option.none() : DateTime.make(input.untilTime);
+  const window =
+    Option.isSome(sinceTime) && Option.isSome(untilTime)
+      ? {
+          sinceTimeMs: DateTime.toEpochMillis(sinceTime.value),
+          untilTimeMs: DateTime.toEpochMillis(untilTime.value),
+        }
+      : {};
+  const sinceMs = Date.parse(`${input.sinceDay}T00:00:00Z`);
+  const untilMs = Date.parse(`${input.untilDay}T00:00:00Z`);
+  if (!Number.isFinite(sinceMs) || !Number.isFinite(untilMs) || sinceMs > untilMs) {
+    return yield* new UsageReadError({
+      reason: "invalidWindow",
+      detail: `'${input.sinceDay}' to '${input.untilDay}' is not a valid window`,
+    });
+  }
+  const inWindow = usageTimestampFilter({ ...input, ...window });
+  // A day either side covers every time zone; the exact window is applied per turn below.
+  const from = DateTime.formatIso(DateTime.makeUnsafe(sinceMs - DAY_MS));
+  const to = DateTime.formatIso(DateTime.makeUnsafe(untilMs + 2 * DAY_MS));
+  const sql = yield* SqlClient.SqlClient;
+  const rows = yield* sql<Row>`
+    SELECT
+      turn.payload_json AS turn_json,
+      provider_thread.driver AS driver,
+      json_extract(run.payload_json, '$.modelSelection.model') AS requested_model
+    FROM orchestration_v2_projection_provider_turns AS turn
+    JOIN orchestration_v2_projection_provider_threads AS provider_thread
+      ON provider_thread.provider_thread_id = turn.provider_thread_id
+    LEFT JOIN orchestration_v2_projection_run_attempts AS attempt
+      ON attempt.attempt_id = turn.run_attempt_id
+    LEFT JOIN orchestration_v2_projection_runs AS run ON run.run_id = attempt.run_id
+    WHERE turn.started_at >= ${from}
+      AND turn.started_at < ${to}
+      AND turn.status IN ('completed', 'interrupted', 'failed', 'cancelled')
+      AND json_extract(turn.payload_json, '$.performance') IS NOT NULL
+  `.pipe(
+    Effect.mapError(
+      (cause) =>
+        new UsageReadError({ reason: "scanFailed", detail: "Turn history read failed", cause }),
+    ),
+  );
+  const turns = rows.flatMap((row): MeasuredTurn[] => {
+    const turn = Option.getOrUndefined(decodeTurn(row.turn_json));
+    if (turn === undefined || turn.startedAt === null || row.driver === null) return [];
+    if (!inWindow(DateTime.toEpochMillis(turn.startedAt))) return [];
+    return [{ turn, driver: row.driver, requestedModel: row.requested_model }];
+  });
+  return summarizeUsagePerformance(turns, aliases);
+});
