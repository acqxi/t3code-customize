@@ -0,0 +1,206 @@
+import { assert, describe, it } from "@effect/vitest";
+import type { UsageDay } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+import * as SqlClient from "effect/sql/SqlClient";
+
+import * as Sqlite from "../persistence/Sqlite.ts";
+import { readUsagePerformance } from "./usagePerformance.ts";
+
+const encodeJson = Schema.encodeSync(Schema.fromJsonString(Schema.Unknown));
+
+const performance = (overrides: Record<string, unknown> = {}) => ({
+  source: "claude_stream",
+  requestSentAt: "2026-11-20T10:00:00.000Z",
+  firstTokenMs: 800,
+  firstAnswerMs: 1_200,
+  generationMs: 10_000,
+  generationTokens: { value: 1_000, basis: "provider_exact" },
+  streamedChars: { reasoning: 0, text: 0, toolInput: 0 },
+  tools: { count: 0, wallMs: 0, longestMs: 0, open: 0 },
+  turnMs: 12_000,
+  partial: false,
+  live: false,
+  ...overrides,
+});
+
+const seedTurn = (input: {
+  readonly id: string;
+  readonly driver: string;
+  readonly startedAt: string;
+  readonly status?: string;
+  readonly model?: string;
+  readonly requestedModel?: string;
+  readonly performance?: Record<string, unknown> | null;
+}) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    yield* sql`INSERT INTO orchestration_v2_projection_provider_threads ${sql.insert({
+      provider_thread_id: `pthread-${input.id}`,
+      thread_id: `thread-${input.id}`,
+      provider: input.driver,
+      driver: input.driver,
+      provider_instance_id: input.driver,
+      status: "idle",
+      updated_at: input.startedAt,
+      payload_json: "{}",
+    })}`;
+    yield* sql`INSERT INTO orchestration_v2_projection_run_attempts ${sql.insert({
+      attempt_id: `attempt-${input.id}`,
+      thread_id: `thread-${input.id}`,
+      run_id: `run-${input.id}`,
+      attempt_ordinal: 1,
+      root_node_id: `node-${input.id}`,
+      provider: input.driver,
+      provider_thread_id: `pthread-${input.id}`,
+      status: "completed",
+      payload_json: "{}",
+    })}`;
+    yield* sql`INSERT INTO orchestration_v2_projection_runs ${sql.insert({
+      run_id: `run-${input.id}`,
+      thread_id: `thread-${input.id}`,
+      ordinal: 1,
+      provider: input.driver,
+      status: "completed",
+      requested_at: input.startedAt,
+      payload_json: encodeJson({
+        modelSelection: { instanceId: input.driver, model: input.requestedModel ?? "requested" },
+      }),
+    })}`;
+    const status = input.status ?? "completed";
+    yield* sql`INSERT INTO orchestration_v2_projection_provider_turns ${sql.insert({
+      provider_turn_id: `turn-${input.id}`,
+      thread_id: `thread-${input.id}`,
+      provider_thread_id: `pthread-${input.id}`,
+      node_id: `node-${input.id}`,
+      run_attempt_id: `attempt-${input.id}`,
+      ordinal: 1,
+      status,
+      started_at: input.startedAt,
+      completed_at: input.startedAt,
+      payload_json: encodeJson({
+        id: `turn-${input.id}`,
+        providerThreadId: `pthread-${input.id}`,
+        nodeId: `node-${input.id}`,
+        runAttemptId: `attempt-${input.id}`,
+        nativeTurnRef: null,
+        ordinal: 1,
+        status,
+        startedAt: input.startedAt,
+        completedAt: input.startedAt,
+        ...(input.model === undefined ? {} : { model: input.model }),
+        ...(input.performance === null ? {} : { performance: input.performance ?? performance() }),
+      }),
+    })}`;
+  });
+
+const day = (value: string) => value as UsageDay;
+const WINDOW = { sinceDay: day("2026-11-20"), untilDay: day("2026-11-21"), timeZone: "UTC" };
+
+describe("readUsagePerformance", () => {
+  it.effect("groups finished measured turns in the window by provider and model", () =>
+    Effect.gen(function* () {
+      yield* seedTurn({
+        id: "a",
+        driver: "claudeAgent",
+        startedAt: "2026-11-20T10:00:00.000Z",
+        model: "claude-opus-5-5",
+      });
+      yield* seedTurn({
+        id: "b",
+        driver: "claudeAgent",
+        startedAt: "2026-11-21T09:00:00.000Z",
+        model: "claude-opus-5-5",
+        performance: performance({
+          firstTokenMs: 2_000,
+          generationMs: 2_000,
+          generationTokens: { value: 400, basis: "estimated" },
+        }),
+      });
+      // Under a second of streaming counts as a turn, not as speed.
+      yield* seedTurn({
+        id: "c",
+        driver: "antigravity",
+        startedAt: "2026-11-20T11:00:00.000Z",
+        requestedModel: "gemini-4-neon",
+        performance: performance({ generationMs: 300, firstAnswerMs: undefined }),
+      });
+      yield* seedTurn({
+        id: "outside",
+        driver: "claudeAgent",
+        startedAt: "2026-11-22T00:00:00.000Z",
+        model: "claude-opus-5-5",
+      });
+      yield* seedTurn({
+        id: "running",
+        driver: "claudeAgent",
+        startedAt: "2026-11-20T12:00:00.000Z",
+        status: "running",
+        model: "claude-opus-5-5",
+      });
+      yield* seedTurn({
+        id: "unmeasured",
+        driver: "codex",
+        startedAt: "2026-11-20T12:00:00.000Z",
+        model: "gpt-6.1-sol",
+        performance: null,
+      });
+
+      const summary = yield* readUsagePerformance(WINDOW, { "claude-opus-5-5": "opus" });
+      const byModel = new Map(
+        summary.models.map((model) => [`${model.provider}:${model.model}`, model]),
+      );
+      assert.deepStrictEqual([...byModel.keys()].toSorted(), [
+        "antigravity:gemini-4-neon",
+        "claude:opus",
+      ]);
+      const opus = byModel.get("claude:opus")!;
+      assert.strictEqual(opus.turns, 2);
+      assert.strictEqual(opus.generationTurns, 2);
+      assert.strictEqual(opus.generationTokens, 1_400);
+      assert.strictEqual(opus.generationMs, 12_000);
+      assert.strictEqual(opus.generationEstimated, true);
+      assert.deepStrictEqual(opus.firstTokenMs.toSorted((a, b) => a - b), [800, 2_000]);
+      const neon = byModel.get("antigravity:gemini-4-neon")!;
+      assert.strictEqual(neon.turns, 1);
+      assert.strictEqual(neon.generationTurns, 0);
+      assert.deepStrictEqual(neon.firstAnswerMs, []);
+    }).pipe(Effect.provide(Sqlite.layerMemory)),
+  );
+
+  it.effect("reads an hourly window by instant and rejects a reversed one", () =>
+    Effect.gen(function* () {
+      yield* seedTurn({
+        id: "early",
+        driver: "codex",
+        startedAt: "2026-11-20T08:00:00.000Z",
+        model: "gpt-6.1-sol",
+      });
+      yield* seedTurn({
+        id: "late",
+        driver: "codex",
+        startedAt: "2026-11-20T10:30:00.000Z",
+        model: "gpt-6.1-sol",
+      });
+      const hourly = yield* readUsagePerformance(
+        {
+          ...WINDOW,
+          sinceTime: "2026-11-20T10:00:00.000Z",
+          untilTime: "2026-11-20T11:00:00.000Z",
+        },
+        {},
+      );
+      assert.deepStrictEqual(
+        hourly.models.map((model) => [model.provider, model.model, model.turns]),
+        [["codex", "gpt-6.1-sol", 1]],
+      );
+      const reversed = yield* Effect.flip(
+        readUsagePerformance(
+          { ...WINDOW, sinceDay: day("2026-11-22"), untilDay: day("2026-11-20") },
+          {},
+        ),
+      );
+      assert.strictEqual(reversed.reason, "invalidWindow");
+    }).pipe(Effect.provide(Sqlite.layerMemory)),
+  );
+});
