+/** Speed and latency of the row's measured T3 turns; a dash for models T3 never timed. */
+function ModelPerformanceCells({
+  performance,
+}: {
+  readonly performance: ModelPerformance | undefined;
+}) {
+  const gt = useGT();
+  const cell = "hidden py-2.5 pl-6 lg:table-cell";
+  const latency = (median: number | null, p90: number | null) =>
+    median === null ? (
+      <td className={cell}>{UNAVAILABLE_TEXT}</td>
+    ) : (
+      <td className={cn(cell, "text-foreground")}>
+        <HeadTip tip={gt("p90 {time}", { time: formatMs(p90 ?? median) })}>
+          {formatMs(median).replace(/ (ms|s)$/, "$1")}
+        </HeadTip>
+      </td>
+    );
+  const rate = performance?.tokensPerSecond ?? null;
+  return (
+    <>
+      <td className={cn(cell, rate !== null && "text-foreground")}>
+        {rate === null
+          ? UNAVAILABLE_TEXT
+          : `${performance?.estimated ? ESTIMATE_PREFIX : ""}${rate.toFixed(rate < 10 ? 1 : 0)}`}
