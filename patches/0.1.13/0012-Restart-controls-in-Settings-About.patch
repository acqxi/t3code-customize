+import { Button } from "../ui/button";
+import { SettingsRow, SettingsSection } from "./settingsLayout";
+import { useSearchableSetting } from "./settingsSearch";
+
+/** Reload the window, or relaunch the whole app (gracefully or by force) without hunting processes. */
+export function RestartSettingsSection() {
+  const gt = useGT();
+  const setting = useSearchableSetting();
+  const restartApp = window.desktopBridge?.restartApp;
+  const restart = async (mode: "graceful" | "hard") => {
+    if (restartApp === undefined) return;
+    const confirmed = await ensureLocalApi().dialogs.confirm(
+      mode === "graceful"
+        ? gt("Restart T3 Code? Running agent turns are interrupted.")
+        : gt(
+            "Force-restart T3 Code? Backends get 3 seconds to stop, then they are killed. Running agent turns are interrupted.",
+          ),
+      { variant: "destructive" },
+    );
+    if (confirmed) await restartApp(mode);
+  };
+  return (
+    <SettingsSection id="restart" title={gt("Restart")}>
+      <SettingsRow
+        {...setting("reload-window")}
+        description={gt("Reload the interface only. Backends and running turns keep going.")}
+        control={
+          <Button size="xs" variant="outline" onClick={() => window.location.reload()}>
+            {gt("Reload", { $context: "verb, reloads the app window" })}
+          </Button>
+        }
+      />
+      {restartApp === undefined ? null : (
+        <>
+          <SettingsRow
+            {...setting("restart-app")}
+            description={gt("Stop every backend the normal way, then start the app again.")}
+            control={
+              <Button size="xs" variant="outline" onClick={() => void restart("graceful")}>
+                {gt("Restart", { $context: "verb, relaunches the app" })}
+              </Button>
+            }
+          />
+          <SettingsRow
+            {...setting("hard-restart")}
+            description={gt(
+              "For a backend that stopped responding: kill every backend after 3 seconds, then start the app again.",
+            )}
+            control={
+              <Button size="xs" variant="destructive-outline" onClick={() => void restart("hard")}>
+                {gt("Hard restart", { $context: "verb, force-relaunches the app" })}
+              </Button>
+            }
+          />
+        </>
+      )}
+    </SettingsSection>
+  );
+}
