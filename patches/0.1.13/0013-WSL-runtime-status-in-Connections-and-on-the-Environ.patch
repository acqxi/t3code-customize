 });
+
+/** Read-only: how the WSL backend's runtime is coming up, polled by the settings status lines. */
+export const getWslRuntimeStatus = makeIpcMethod({
+  channel: IpcChannels.GET_WSL_RUNTIME_STATUS_CHANNEL,
+  payload: Schema.Void,
+  result: DesktopWslRuntimeStatusSchema,
+  handler: Effect.fn("desktop.ipc.wsl.getRuntimeStatus")(function* () {
+    const appSettings = yield* DesktopAppSettings.DesktopAppSettings;
+    const pool = yield* DesktopBackendPool.DesktopBackendPool;
+    const wslBackend = yield* DesktopWslBackend.DesktopWslBackend;
+    const environment = yield* DesktopEnvironment.DesktopEnvironment;
+    const settings = yield* appSettings.get;
+    const instances = yield* pool.list;
+    // The WSL backend is the instance launched into a distro: wsl:<distro>, or the primary in wsl-only mode.
+    const described = yield* Effect.forEach(instances, (instance) =>
+      Effect.all([instance.currentConfig, instance.snapshot]).pipe(
+        Effect.map(([config, snapshot]) => ({ instance, config, snapshot })),
+      ),
+    );
+    const wsl = described.find(
+      ({ instance, config }) =>
+        instance.id.startsWith("wsl:") ||
+        (Option.isSome(config) && config.value.runningDistro !== undefined),
+    );
+    const config = wsl === undefined ? Option.none() : wsl.config;
+    return resolveWslRuntimeStatus({
+      enabled: settings.localEnvironmentEnabled && settings.wslBackendEnabled,
+      start: yield* readWslRuntimeStartStatus,
+      instance:
+        wsl === undefined
+          ? null
+          : {
+              id: wsl.instance.id,
+              ready: wsl.snapshot.ready,
+              running: Option.isSome(wsl.snapshot.activePid) || wsl.snapshot.restartScheduled,
+              distro: Option.getOrUndefined(config)?.runningDistro ?? settings.wslDistro,
+              runtimeDir: Option.getOrUndefined(config)?.wslRuntimeDir ?? null,
+              runtimeId: Option.getOrUndefined(config)?.wslRuntimeId ?? null,
+            },
+      version: environment.appVersion,
+      // Reconcile retries an idle WSL backend; a wsl-only primary needs a restart instead.
+      retryable: !settings.wslOnly,
+      lastPreflightError: Option.getOrNull(yield* wslBackend.lastPreflightError),
+    });
+  }),
+});
