@@ -0,0 +1,92 @@
+import type { DesktopWslRuntimeStatus } from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  describeWslRuntimeStatus,
+  isWslRuntimeBackend,
+  shortRuntimeId,
+} from "./wslRuntimeStatus.logic";
+
+const status = (overrides: Partial<DesktopWslRuntimeStatus> = {}): DesktopWslRuntimeStatus => ({
+  phase: "idle",
+  phaseStartedAt: null,
+  instanceId: "wsl:Ubuntu",
+  distro: "Ubuntu",
+  runtimeDir: null,
+  runtimeId: null,
+  version: null,
+  lastError: null,
+  canRetry: false,
+  ...overrides,
+});
+
+describe("describeWslRuntimeStatus", () => {
+  it("hides nothing-to-say states", () => {
+    expect(describeWslRuntimeStatus(null, 0)).toEqual({ kind: "hidden" });
+    expect(describeWslRuntimeStatus(status({ phase: "idle" }), 0)).toEqual({ kind: "hidden" });
+    expect(describeWslRuntimeStatus(status({ phase: "disabled" }), 0)).toEqual({ kind: "hidden" });
+  });
+
+  it("shows each start phase with its elapsed time", () => {
+    const started = 1_000_000;
+    expect(
+      describeWslRuntimeStatus(
+        status({ phase: "installing", phaseStartedAt: started }),
+        started + 72_000,
+      ),
+    ).toEqual({ kind: "progress", phase: "installing", elapsed: "1m 12s" });
+    expect(
+      describeWslRuntimeStatus(
+        status({ phase: "waiting_ready", phaseStartedAt: started }),
+        started,
+      ),
+    ).toEqual({ kind: "progress", phase: "waiting_ready", elapsed: "0s" });
+    expect(describeWslRuntimeStatus(status({ phase: "probing" }), started)).toEqual({
+      kind: "progress",
+      phase: "probing",
+      elapsed: "0s",
+    });
+  });
+
+  it("names the runtime and version once ready", () => {
+    expect(
+      describeWslRuntimeStatus(
+        status({
+          phase: "ready",
+          runtimeId: "sha256-a95e31f0c2d94b7e",
+          version: "0.1.12",
+        }),
+        0,
+      ),
+    ).toEqual({ kind: "ready", runtime: "sha256-a95e31…", version: "0.1.12" });
+  });
+
+  it("carries the failure and whether retry is safe", () => {
+    expect(
+      describeWslRuntimeStatus(
+        status({ phase: "failed", lastError: "  install timed out ", canRetry: true }),
+        0,
+      ),
+    ).toEqual({ kind: "failed", error: "install timed out", canRetry: true });
+    expect(describeWslRuntimeStatus(status({ phase: "failed", lastError: " " }), 0)).toEqual({
+      kind: "failed",
+      error: null,
+      canRetry: false,
+    });
+  });
+});
+
+describe("runtime and backend identity", () => {
+  it("shortens a runtime id to its hash prefix", () => {
+    expect(shortRuntimeId("sha256-a95e31f0c2d9")).toBe("sha256-a95e31…");
+    expect(shortRuntimeId("sha256-a95e")).toBe("sha256-a95e");
+    expect(shortRuntimeId(null)).toBeNull();
+  });
+
+  it("matches the map's environment to the WSL backend by its backend id", () => {
+    expect(isWslRuntimeBackend("wsl:Ubuntu", { instanceId: "wsl:Ubuntu" })).toBe(true);
+    expect(isWslRuntimeBackend("primary", { instanceId: "wsl:Ubuntu" })).toBe(false);
+    expect(isWslRuntimeBackend(null, { instanceId: null })).toBe(false);
+    expect(isWslRuntimeBackend("wsl:Ubuntu", null)).toBe(false);
+  });
+});
diff --git a/apps/web/src/components/settings/wslRuntimeStatus.logic.ts b/apps/web/src/components/settings/wslRuntimeStatus.logic.ts
new file mode 100644
index 0000000000..5a33a68a50
--- /dev/null
+++ b/apps/web/src/components/settings/wslRuntimeStatus.logic.ts
@@ -0,0 +1,56 @@
+import type { DesktopWslRuntimeStatus } from "@t3tools/contracts";
+
+import { formatLimitCountdown } from "../chat/ComposerStats.logic";
+
+export type WslRuntimeStatusDisplay =
+  | { readonly kind: "hidden" }
+  | {
+      readonly kind: "progress";
+      readonly phase: "probing" | "installing" | "starting" | "waiting_ready";
+      readonly elapsed: string;
+    }
+  | { readonly kind: "ready"; readonly runtime: string | null; readonly version: string | null }
+  | { readonly kind: "failed"; readonly error: string | null; readonly canRetry: boolean };
+
+/** "sha256-a95e31…": enough of the runtime's hash to tell two builds apart. */
+export function shortRuntimeId(runtimeId: string | null): string | null {
+  if (runtimeId === null || runtimeId.trim() === "") return null;
+  return runtimeId.length > 13 ? `${runtimeId.slice(0, 13)}…` : runtimeId;
+}
+
+export function describeWslRuntimeStatus(
+  status: DesktopWslRuntimeStatus | null,
+  nowMs: number,
+): WslRuntimeStatusDisplay {
+  if (status === null) return { kind: "hidden" };
+  switch (status.phase) {
+    case "idle":
+    case "disabled":
+      return { kind: "hidden" };
+    case "ready":
+      return { kind: "ready", runtime: shortRuntimeId(status.runtimeId), version: status.version };
+    case "failed":
+      return {
+        kind: "failed",
+        error: status.lastError?.trim() || null,
+        canRetry: status.canRetry,
+      };
+    default:
+      return {
+        kind: "progress",
+        phase: status.phase,
+        elapsed:
+          status.phaseStartedAt === null
+            ? "0s"
+            : (formatLimitCountdown(nowMs - status.phaseStartedAt) ?? "0s"),
+      };
+  }
+}
+
+/** The map card's environment, when it is the desktop's WSL backend. */
+export function isWslRuntimeBackend(
+  backendId: string | null,
+  status: Pick<DesktopWslRuntimeStatus, "instanceId"> | null,
+): boolean {
+  return backendId !== null && status?.instanceId === backendId;
+}
