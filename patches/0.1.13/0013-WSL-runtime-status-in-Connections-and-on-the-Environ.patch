diff --git a/apps/desktop/src/wsl/DesktopWslRuntimeStatus.test.ts b/apps/desktop/src/wsl/DesktopWslRuntimeStatus.test.ts
new file mode 100644
index 0000000000..7976998bd6
--- /dev/null
+++ b/apps/desktop/src/wsl/DesktopWslRuntimeStatus.test.ts
@@ -0,0 +1,73 @@
+import { assert, describe, it } from "@effect/vitest";
+
+import { resolveWslRuntimeStatus, type WslRuntimeStartStatus } from "./DesktopWslRuntimeStatus.ts";
+
+const start = (overrides: Partial<WslRuntimeStartStatus> = {}): WslRuntimeStartStatus => ({
+  phase: "idle",
+  phaseStartedAt: null,
+  runtimeDir: null,
+  runtimeId: null,
+  lastError: null,
+  ...overrides,
+});
+const instance = (overrides: { ready?: boolean; running?: boolean } = {}) => ({
+  id: "wsl:Ubuntu",
+  ready: false,
+  running: false,
+  distro: "Ubuntu",
+  runtimeDir: "/home/me/.t3/wsl-runtime/sha256-a95e31",
+  runtimeId: "sha256-a95e31",
+  ...overrides,
+});
+const resolve = (input: Partial<Parameters<typeof resolveWslRuntimeStatus>[0]>) =>
+  resolveWslRuntimeStatus({
+    enabled: true,
+    start: start(),
+    instance: null,
+    version: "0.1.12",
+    retryable: true,
+    lastPreflightError: null,
+    ...input,
+  });
+
+describe("resolveWslRuntimeStatus", () => {
+  it("is disabled when the WSL backend is off", () => {
+    assert.strictEqual(resolve({ enabled: false, instance: instance() }).phase, "disabled");
+  });
+
+  it("follows the recorded phases while the runtime is probed and installed", () => {
+    assert.strictEqual(resolve({ start: start({ phase: "probing" }) }).phase, "probing");
+    const installing = resolve({
+      start: start({ phase: "installing", phaseStartedAt: 1_000, runtimeId: "sha256-a95e31" }),
+    });
+    assert.strictEqual(installing.phase, "installing");
+    assert.strictEqual(installing.phaseStartedAt, 1_000);
+    assert.strictEqual(installing.runtimeId, "sha256-a95e31");
+  });
+
+  it("waits for readiness once the server process runs, then reports ready with the version", () => {
+    const starting = start({ phase: "starting", phaseStartedAt: 5 });
+    assert.strictEqual(resolve({ start: starting, instance: instance() }).phase, "starting");
+    assert.strictEqual(
+      resolve({ start: starting, instance: instance({ running: true }) }).phase,
+      "waiting_ready",
+    );
+    const ready = resolve({ start: starting, instance: instance({ ready: true, running: true }) });
+    assert.strictEqual(ready.phase, "ready");
+    assert.strictEqual(ready.version, "0.1.12");
+    assert.strictEqual(ready.runtimeDir, "/home/me/.t3/wsl-runtime/sha256-a95e31");
+  });
+
+  it("reports a failure and offers retry only for a stopped, retryable backend", () => {
+    const failed = start({ phase: "failed", lastError: "WSL runtime installation timed out." });
+    const stopped = resolve({ start: failed, instance: instance() });
+    assert.strictEqual(stopped.phase, "failed");
+    assert.strictEqual(stopped.lastError, "WSL runtime installation timed out.");
+    assert.isTrue(stopped.canRetry);
+    assert.isFalse(resolve({ start: failed, instance: instance(), retryable: false }).canRetry);
+    assert.isFalse(resolve({ start: failed, instance: null }).canRetry);
+    const preflight = resolve({ instance: instance(), lastPreflightError: "distro is busy" });
+    assert.strictEqual(preflight.phase, "failed");
+    assert.strictEqual(preflight.lastError, "distro is busy");
+  });
+});
diff --git a/apps/desktop/src/wsl/DesktopWslRuntimeStatus.ts b/apps/desktop/src/wsl/DesktopWslRuntimeStatus.ts
new file mode 100644
index 0000000000..92aa9ca8e2
--- /dev/null
+++ b/apps/desktop/src/wsl/DesktopWslRuntimeStatus.ts
@@ -0,0 +1,94 @@
+import * as Clock from "effect/Clock";
+import type { DesktopWslRuntimeStatus } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+
+/** What the WSL backend's start is doing; readiness is read live from its backend instance. */
+export type WslRuntimeStartPhase = "idle" | "probing" | "installing" | "starting" | "failed";
+
+export interface WslRuntimeStartStatus {
+  readonly phase: WslRuntimeStartPhase;
+  readonly phaseStartedAt: number | null;
+  readonly runtimeDir: string | null;
+  readonly runtimeId: string | null;
+  readonly lastError: string | null;
+}
+
+const IDLE: WslRuntimeStartStatus = {
+  phase: "idle",
+  phaseStartedAt: null,
+  runtimeDir: null,
+  runtimeId: null,
+  lastError: null,
+};
+
+// One WSL backend starts at a time; this records its progress for the read-only status IPC.
+let current: WslRuntimeStartStatus = IDLE;
+
+export const readWslRuntimeStartStatus = Effect.sync(() => current);
+
+export const recordWslRuntimePhase = (
+  phase: WslRuntimeStartPhase,
+  details: Partial<Pick<WslRuntimeStartStatus, "runtimeDir" | "runtimeId" | "lastError">> = {},
+) =>
+  Effect.flatMap(Clock.currentTimeMillis, (now) =>
+    Effect.sync(() => {
+      current = {
+        phase,
+        phaseStartedAt: phase === "idle" ? null : now,
+        runtimeDir: details.runtimeDir ?? (phase === "probing" ? null : current.runtimeDir),
+        runtimeId: details.runtimeId ?? (phase === "probing" ? null : current.runtimeId),
+        lastError: phase === "failed" ? (details.lastError ?? null) : null,
+      };
+    }),
+  );
+
+/** Joins the recorded start phase with the live backend instance and settings. */
+export function resolveWslRuntimeStatus(input: {
+  readonly enabled: boolean;
+  readonly start: WslRuntimeStartStatus;
+  readonly instance: {
+    readonly id: string;
+    readonly ready: boolean;
+    readonly running: boolean;
+    readonly distro: string | null;
+    readonly runtimeDir: string | null;
+    readonly runtimeId: string | null;
+  } | null;
+  readonly version: string;
+  readonly retryable: boolean;
+  readonly lastPreflightError: string | null;
+}): DesktopWslRuntimeStatus {
+  const { start, instance } = input;
+  const base = {
+    instanceId: instance?.id ?? null,
+    distro: instance?.distro ?? null,
+    runtimeDir: instance?.runtimeDir ?? start.runtimeDir,
+    runtimeId: instance?.runtimeId ?? start.runtimeId,
+    version: null,
+    lastError: null,
+    canRetry: false,
+  };
+  if (!input.enabled) return { ...base, phase: "disabled", phaseStartedAt: null };
+  if (instance?.ready) {
+    return {
+      ...base,
+      phase: "ready",
+      phaseStartedAt: start.phaseStartedAt,
+      version: input.version,
+    };
+  }
+  const lastError = start.lastError ?? input.lastPreflightError;
+  if (start.phase === "failed" || (lastError !== null && !instance?.running)) {
+    return {
+      ...base,
+      phase: "failed",
+      phaseStartedAt: start.phaseStartedAt,
+      lastError: lastError ?? null,
+      canRetry: input.retryable && instance !== null && !instance.running,
+    };
+  }
+  if (start.phase === "starting" && instance?.running) {
+    return { ...base, phase: "waiting_ready", phaseStartedAt: start.phaseStartedAt };
+  }
+  return { ...base, phase: start.phase, phaseStartedAt: start.phaseStartedAt };
+}
