diff --git a/apps/web/src/state/desktopWslRuntimeStatus.ts b/apps/web/src/state/desktopWslRuntimeStatus.ts
new file mode 100644
index 0000000000..6ee542c597
--- /dev/null
+++ b/apps/web/src/state/desktopWslRuntimeStatus.ts
@@ -0,0 +1,67 @@
+import type { DesktopWslRuntimeStatus } from "@t3tools/contracts";
+import { useSyncExternalStore } from "react";
+
+// Fast while the runtime is coming up, slow once it settles.
+const TRANSIENT_POLL_MS = 1_000;
+const SETTLED_POLL_MS = 10_000;
+const TRANSIENT = new Set<DesktopWslRuntimeStatus["phase"]>([
+  "probing",
+  "installing",
+  "starting",
+  "waiting_ready",
+]);
+
+export interface DesktopWslRuntimeStatusReading {
+  readonly status: DesktopWslRuntimeStatus;
+  /** When this reading arrived; elapsed times count to it, so they advance with each poll. */
+  readonly readAt: number;
+}
+
+let snapshot: DesktopWslRuntimeStatusReading | null = null;
+let timer: ReturnType<typeof setTimeout> | null = null;
+const listeners = new Set<() => void>();
+
+const poll = () => {
+  timer = null;
+  const read =
+    typeof window === "undefined" ? undefined : window.desktopBridge?.getWslRuntimeStatus;
+  if (read === undefined || listeners.size === 0) return;
+  void read()
+    .then((next) => {
+      snapshot = { status: next, readAt: Date.now() };
+      for (const listener of listeners) listener();
+    })
+    .catch(() => {})
+    .finally(() => {
+      if (listeners.size > 0 && timer === null) {
+        const transient = snapshot !== null && TRANSIENT.has(snapshot.status.phase);
+        timer = setTimeout(poll, transient ? TRANSIENT_POLL_MS : SETTLED_POLL_MS);
+      }
+    });
+};
+
+function subscribe(listener: () => void) {
+  listeners.add(listener);
+  if (listeners.size === 1) poll();
+  return () => {
+    listeners.delete(listener);
+    if (listeners.size === 0 && timer !== null) {
+      clearTimeout(timer);
+      timer = null;
+    }
+  };
+}
+
+/** The desktop's WSL runtime status, polled only while something on screen reads it. */
+export function useDesktopWslRuntimeStatus(): DesktopWslRuntimeStatusReading | null {
+  return useSyncExternalStore(
+    subscribe,
+    () => snapshot,
+    () => null,
+  );
+}
+
+export function refreshDesktopWslRuntimeStatus(): void {
+  if (timer !== null) clearTimeout(timer);
+  poll();
+}
