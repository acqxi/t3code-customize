+  it.effect("offers updates without downloading them when check-only", () => {
+    const harness = makeHarness({
+      env: { T3CODE_DISABLE_AUTO_UPDATE: "true", T3CODE_UPDATE_CHECK_ONLY: "true" },
+    });
+
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        const desktopState = yield* DesktopState.DesktopState;
+        yield* updates.configure;
+
+        const configured = yield* updates.getState;
+        assert.isTrue(configured.enabled);
+        assert.isTrue(configured.checkOnly);
+        assert.isFalse(yield* Ref.get(desktopState.canInstallUpdates));
+
+        const checked = yield* updates.check("poll");
+        assert.isTrue(checked.checked);
+        harness.emit("update-available", { version: "1.2.4" });
+        yield* flushCallbacks;
+        const offered = yield* updates.getState;
+        assert.equal(offered.status, "available");
+        assert.equal(offered.availableVersion, "1.2.4");
+        assert.isTrue(offered.checkOnly);
+
+        const download = yield* updates.download;
+        assert.isFalse(download.accepted);
+        const install = yield* updates.install;
+        assert.isFalse(install.accepted);
+        assert.equal((yield* updates.getState).status, "available");
+      }),
+    ).pipe(Effect.provide(Layer.merge(TestClock.layer(), harness.layer)));
+  });
+
   it.effect("re-checks an offered update without announcing it again", () => {
     const harness = makeHarness();
 
