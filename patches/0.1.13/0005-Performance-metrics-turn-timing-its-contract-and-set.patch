+++ b/apps/server/src/orchestration-v2/Adapters/ClaudeTurnPerformance.test.ts
@@ -0,0 +1,172 @@
+import type { SDKMessage } from "@anthropic-ai/claude-agent-sdk";
+import { describe, expect, it } from "vite-plus/test";
+
+import { observeClaudeFrame } from "./ClaudeResponseThroughput.ts";
+import { ClaudeTurnPerformance } from "./ClaudeTurnPerformance.ts";
+
+let frameCount = 0;
+const frame = (event: unknown, at: number, parent: string | null = null, epoch?: object) => {
+  const message = {
+    type: "stream_event",
+    event,
+    parent_tool_use_id: parent,
+    session_id: "session",
+    uuid: `frame-${at}-${(frameCount += 1)}`,
+  } as unknown as SDKMessage;
+  observeClaudeFrame(message, at, epoch);
+  return message;
+};
+
+const toolResult = (toolUseId: string, at: number, parent: string | null = null) => {
+  const message = {
+    type: "user",
+    parent_tool_use_id: parent,
+    session_id: "session",
+    uuid: `result-${at}`,
+    message: { role: "user", content: [{ type: "tool_result", tool_use_id: toolUseId }] },
+  } as unknown as SDKMessage;
+  observeClaudeFrame(message, at);
+  return message;
+};
+
+function textMessage(id: string, start: number, text: string, outputTokens: number) {
+  return [
+    frame({ type: "message_start", message: { id } }, start),
+    frame(
+      { type: "content_block_start", index: 0, content_block: { type: "text", text: "" } },
+      start + 100,
+    ),
+    frame(
+      { type: "content_block_delta", index: 0, delta: { type: "text_delta", text } },
+      start + 400,
+    ),
+    frame({ type: "content_block_stop", index: 0 }, start + 410),
+    frame({ type: "message_delta", usage: { output_tokens: outputTokens } }, start + 420),
+    frame({ type: "message_stop" }, start + 430),
+  ];
+}
+
+describe("ClaudeTurnPerformance", () => {
+  it("ignores frames before the request and subagent output", () => {
+    const perf = new ClaudeTurnPerformance(() => 1000);
+    const seen = new Set<string>();
+    expect(perf.observe(frame({ type: "message_start", message: { id: "early" } }, 10), seen)).toBe(
+      false,
+    );
+    perf.requestSent(Date.UTC(2026, 0, 1), 1000);
+    const child = [
+      frame({ type: "message_start", message: { id: "child" } }, 1100, "task-tool"),
+      frame(
+        { type: "content_block_delta", index: 0, delta: { type: "text_delta", text: "child" } },
+        1200,
+        "task-tool",
+      ),
+    ];
+    for (const message of child) expect(perf.observe(message, seen)).toBe(false);
+    expect(perf.current()?.firstTokenMs).toBeUndefined();
+    const milestones = textMessage("root", 1500, "Hello", 2).map((message) =>
+      perf.observe(message, seen),
+    );
+    // content_block_start is the first token; the first text delta is the first answer.
+    expect(milestones).toEqual([false, true, true, false, false, false]);
+    const value = perf.finalize("completed", 2500);
+    expect(value?.firstTokenMs).toBe(600);
+    expect(value?.firstTokenKind).toBe("text");
+    expect(value?.firstAnswerMs).toBe(900);
+    expect(value?.generationTokens).toEqual({ value: 2, basis: "provider_exact" });
+    expect(value?.streamedChars.text).toBe(5);
+  });
+
+  it("times tools from tool_use block stop to the matching tool_result", () => {
+    const perf = new ClaudeTurnPerformance(() => 0);
+    const seen = new Set<string>();
+    perf.requestSent(Date.UTC(2026, 0, 1), 0);
+    const frames = [
+      frame({ type: "message_start", message: { id: "m1" } }, 10),
+      frame(
+        {
+          type: "content_block_start",
+          index: 0,
+          content_block: { type: "tool_use", id: "a", name: "Read", input: {} },
+        },
+        100,
+      ),
+      frame(
+        {
+          type: "content_block_delta",
+          index: 0,
+          delta: { type: "input_json_delta", partial_json: '{"p":1}' },
+        },
+        200,
+      ),
+      frame({ type: "content_block_stop", index: 0 }, 300),
+      frame(
+        {
+          type: "content_block_start",
+          index: 1,
+          content_block: { type: "tool_use", id: "b", name: "Read", input: {} },
+        },
+        400,
+      ),
+      frame({ type: "content_block_stop", index: 1 }, 500),
+      frame({ type: "message_delta", usage: { output_tokens: 9 } }, 510),
+      frame({ type: "message_stop" }, 520),
+    ];
+    for (const message of frames) perf.observe(message, seen);
+    perf.observe(toolResult("a", 1300), seen);
+    perf.observe(toolResult("b", 2500), seen);
+    // An unrelated subagent result never closes a root tool.
+    perf.observe(toolResult("a", 9000, "task"), seen);
+    const value = perf.finalize("completed", 3000);
+    expect(value?.firstTokenKind).toBe("tool_input");
+    expect(value?.tools).toEqual({ count: 2, wallMs: 2200, longestMs: 2000, open: 0 });
+    // Two windows (100 -> 200 and 400 -> 400) inside one exactly counted message.
+    expect(value?.generationMs).toBe(100);
+    expect(value?.generationWindows).toBe(2);
+    expect(value?.generationTokens).toEqual({ value: 9, basis: "provider_exact" });
+    expect(value?.streamedChars.toolInput).toBe(7);
+  });
+
+  it("marks a process replacement partial and drops the cut-short message", () => {
+    const perf = new ClaudeTurnPerformance(() => 0);
+    const seen = new Set<string>();
+    const oldProcess = {};
+    const newProcess = {};
+    perf.requestSent(Date.UTC(2026, 0, 1), 0);
+    perf.observe(
+      frame({ type: "message_start", message: { id: "cut" } }, 10, null, oldProcess),
+      seen,
+    );
+    perf.observe(
+      frame(
+        { type: "content_block_delta", index: 0, delta: { type: "text_delta", text: "abcd" } },
+        100,
+        null,
+        oldProcess,
+      ),
+      seen,
+    );
+    perf.observe(
+      frame(
+        { type: "content_block_delta", index: 0, delta: { type: "text_delta", text: "abcd" } },
+        300,
+        null,
+        oldProcess,
+      ),
+      seen,
+    );
+    for (const message of textMessage("fresh", 1000, "abcdefgh", 3)) {
+      observeClaudeFrame(message, undefined, newProcess);
+      perf.observe(message, seen, newProcess);
+    }
+    // The replayed message from before the replacement is not counted twice.
+    for (const message of textMessage("fresh", 2000, "abcdefgh", 3)) {
+      perf.observe(message, seen, newProcess);
+    }
+    const value = perf.finalize("completed", 3000);
+    expect(value?.partial).toBe(true);
+    expect(value?.generationTokens).toEqual({ value: 3, basis: "provider_exact" });
+    expect(value?.generationMs).toBe(300);
+    expect(value?.streamedChars.text).toBe(16);
+  });
+});
diff --git a/apps/server/src/orchestration-v2/Adapters/ClaudeTurnPerformance.ts b/apps/server/src/orchestration-v2/Adapters/ClaudeTurnPerformance.ts
new file mode 100644
index 0000000000..7278c13b25
--- /dev/null
+++ b/apps/server/src/orchestration-v2/Adapters/ClaudeTurnPerformance.ts
@@ -0,0 +1,184 @@
+import type { SDKMessage } from "@anthropic-ai/claude-agent-sdk";
+import {
+  TurnPerformanceTracker,
+  type GeneratedTokenKind,
+  type TurnPerformance,
+} from "@t3tools/provider-core/server/TurnPerformance";
+
+import { claudeFrameObservation } from "./ClaudeResponseThroughput.ts";
+
+type BlockKind = GeneratedTokenKind | "client_tool" | "other";
+
+interface ObservedMessage {
+  readonly ignored: boolean;
+  readonly blocks: Map<number, { readonly kind: BlockKind; readonly toolId?: string }>;
+}
+
+function blockKind(type: string): BlockKind {
+  switch (type) {
+    case "thinking":
+    case "redacted_thinking":
+      return "reasoning";
+    case "text":
+      return "text";
+    case "tool_use":
+      return "client_tool";
+    case "server_tool_use":
+    case "mcp_tool_use":
+      return "tool_input";
+    default:
+      return "other";
+  }
+}
+
+/**
+ * Stats for nerds timing for one Claude turn, fed from SDK frames of the main agent only
+ * (`parent_tool_use_id === null`). Frame times come from `observeClaudeFrame`, stamped when the
+ * adapter read the frame. Exact tokens come from each message's `message_delta` usage and count
+ * only for messages that reached `message_stop`.
+ *
+ * Tool execution runs from a `tool_use` block's `content_block_stop` to the matching
+ * `tool_result` in the next user message.
+ */
+export class ClaudeTurnPerformance {
+  readonly tracker: TurnPerformanceTracker;
+  private readonly now: () => number;
+  private epoch: object | undefined;
+  private message: ObservedMessage | undefined;
+
+  constructor(now: () => number = () => performance.now()) {
+    this.now = now;
+    this.tracker = new TurnPerformanceTracker({
+      source: "claude_stream",
+      accounting: "per_response",
+      now,
+    });
+  }
+
+  /** The user message is written to the SDK query. */
+  requestSent(wallMs: number, at: number = this.now()): void {
+    this.tracker.requestSent(wallMs, at);
+  }
+
+  /** Returns true when the frame reached a live milestone (first token or first answer). */
+  observe(message: SDKMessage, seenMessageIds: Set<string>, epoch?: object): boolean {
+    const tracker = this.tracker;
+    if (tracker.isFinalized || !tracker.hasRequest) return false;
+    if (message.type !== "stream_event" && message.type !== "user") return false;
+    if (message.parent_tool_use_id !== null) return false;
+    if (message.type === "user" && "isReplay" in message && message.isReplay === true) return false;
+    const observation = claudeFrameObservation(message);
+    const frameEpoch = observation?.epoch ?? epoch;
+    if (frameEpoch !== undefined) {
+      if (this.epoch !== undefined && this.epoch !== frameEpoch) {
+        // A replaced process cannot finish its predecessor's message or tools.
+        tracker.markPartial();
+        if (this.message !== undefined) tracker.responseEnded({ complete: false });
+        this.message = undefined;
+      }
+      this.epoch = frameEpoch;
+    }
+    const at = observation?.at ?? this.now();
+
+    if (message.type === "user") {
+      const content = message.message.content;
+      if (typeof content === "string") return false;
+      for (const block of content) {
+        if (block.type === "tool_result" && tracker.hasTool(block.tool_use_id)) {
+          tracker.toolCompleted(block.tool_use_id, at);
+        }
+      }
+      return false;
+    }
+
+    const event = message.event;
+    if (event.type === "message_start") {
+      if (this.message !== undefined && !this.message.ignored) {
+        tracker.responseEnded({ complete: false });
+      }
+      const id = event.message.id;
+      // A reconnect or wake replay can repeat a message; never count it twice.
+      const ignored = !id || seenMessageIds.has(id);
+      if (id) seenMessageIds.add(id);
+      this.message = { ignored, blocks: new Map() };
+      return false;
+    }
+    let current = this.message;
+    if (current === undefined) {
+      // Content without its message_start: only the observed suffix is timed.
+      tracker.markPartial();
+      current = { ignored: false, blocks: new Map() };
+      this.message = current;
+    }
+    if (current.ignored) {
+      if (event.type === "message_stop") this.message = undefined;
+      return false;
+    }
+    switch (event.type) {
+      case "content_block_start": {
+        const block = event.content_block as { readonly type: string; readonly id?: string };
+        const kind = blockKind(block.type);
+        current.blocks.set(event.index, {
+          kind,
+          ...(kind === "client_tool" && typeof block.id === "string" ? { toolId: block.id } : {}),
+        });
+        if (kind === "other") return false;
+        const text =
+          kind === "text" && "text" in block && typeof block.text === "string" ? block.text : 0;
+        return this.milestone(
+          tracker.generated(kind === "client_tool" ? "tool_input" : kind, text, at),
+        );
+      }
+      case "content_block_delta": {
+        const delta = event.delta as {
+          readonly type: string;
+          readonly text?: string;
+          readonly thinking?: string;
+          readonly partial_json?: string;
+        };
+        if (delta.type === "text_delta" && typeof delta.text === "string") {
+          return this.milestone(tracker.generated("text", delta.text, at));
+        }
+        if (delta.type === "thinking_delta" && typeof delta.thinking === "string") {
+          return this.milestone(tracker.generated("reasoning", delta.thinking, at));
+        }
+        if (delta.type === "input_json_delta" && typeof delta.partial_json === "string") {
+          return this.milestone(tracker.generated("tool_input", delta.partial_json, at));
+        }
+        return false;
+      }
+      case "content_block_stop": {
+        const block = current.blocks.get(event.index);
+        if (block?.kind === "client_tool" && block.toolId !== undefined) {
+          tracker.toolStarted(block.toolId, at);
+        }
+        return false;
+      }
+      case "message_delta": {
+        const tokens = event.usage?.output_tokens;
+        if (typeof tokens === "number") tracker.responseTokens(tokens);
+        return false;
+      }
+      case "message_stop": {
+        tracker.responseEnded({ complete: true });
+        this.message = undefined;
+        return false;
+      }
+      default:
+        return false;
+    }
+  }
+
+  current(): TurnPerformance | undefined {
+    return this.tracker.current();
+  }
+
+  finalize(status: string, at: number = this.now()): TurnPerformance | undefined {
+    this.message = undefined;
+    return this.tracker.finalize(status, at);
+  }
+
+  private milestone(result: { readonly firstToken: boolean; readonly firstAnswer: boolean }) {
+    return result.firstToken || result.firstAnswer;
+  }
+}
