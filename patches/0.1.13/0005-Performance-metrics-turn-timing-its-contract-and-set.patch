+import type { OrchestrationV2TurnPerformance } from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+
+/**
+ * Stats for nerds: turn timing measured where an adapter reads the provider stream.
+ *
+ * One tracker belongs to exactly one provider turn. Adapters create it with the turn's context,
+ * so nothing carries across turns, threads, sessions, compaction or resume. Metric definitions:
+ * docs/performance-metrics.md in t3code-customize.
+ */
+
+export type TurnPerformance = OrchestrationV2TurnPerformance;
+export type TurnPerformanceSource = TurnPerformance["source"];
+export type GeneratedTokenKind = NonNullable<TurnPerformance["firstTokenKind"]>;
+
+/**
+ * `per_response`: the provider reports exact output tokens per model response (Claude).
+ * `turn_total`: the provider reports one exact output total for the turn (Codex, ACP).
+ */
+export type GenerationAccounting = "per_response" | "turn_total";
+
+export const PEAK_WINDOW_MS = 2000;
+const PEAK_BUCKET_MS = 100;
+const CHARS_PER_TOKEN = 4;
+/** A ratio outside this range means the exact count covers output that was not streamed. */
+const CALIBRATION_MIN = 0.25;
+const CALIBRATION_MAX = 4;
+
+export interface TurnPerformanceOptions {
+  readonly source: TurnPerformanceSource;
+  readonly accounting: GenerationAccounting;
+  /** Monotonic milliseconds. Defaults to `performance.now()`. */
+  readonly now?: () => number;
+}
+
+/** Which live milestones a generated chunk reached; each fires at most once per turn. */
+export interface GeneratedMilestones {
+  readonly firstToken: boolean;
+  readonly firstAnswer: boolean;
+}
+
+const NO_MILESTONES: GeneratedMilestones = { firstToken: false, firstAnswer: false };
+
+interface Segment {
+  readonly start: number;
+  last: number;
+}
+
+interface Response {
+  readonly segments: Array<Segment>;
+  chars: number;
+  exactTokens: number | undefined;
+  complete: boolean;
+}
+
+interface ToolInterval {
+  readonly start: number;
+  end: number | undefined;
+}
+
+/** The provider turn status at the terminal event; anything but "completed" is cut short. */
+export type TurnTerminalStatus = string;
+
+export class TurnPerformanceTracker {
+  readonly source: TurnPerformanceSource;
+  readonly accounting: GenerationAccounting;
+  private readonly now: () => number;
+
+  private requestAt: number | undefined;
+  private requestWallMs: number | undefined;
+  private firstTokenAt: number | undefined;
+  private firstTokenKind: GeneratedTokenKind | undefined;
+  private firstAnswerAt: number | undefined;
+  private lastTokenAt: number | undefined;
+  private segment: Segment | undefined;
+  private response: Response | undefined;
+  private readonly responses: Array<Response> = [];
+  private readonly chars = { reasoning: 0, text: 0, toolInput: 0 };
+  private readonly buckets = new Map<number, number>();
+  private readonly tools = new Map<string, ToolInterval>();
+  private turnOutputTokens: number | undefined;
+  private turnReasoningTokens: number | undefined;
+  private partial = false;
+  private finalResult: TurnPerformance | undefined;
+  private finalized = false;
+
+  constructor(options: TurnPerformanceOptions) {
+    this.source = options.source;
+    this.accounting = options.accounting;
+    this.now = options.now ?? (() => performance.now());
+  }
+
+  /**
+   * The adapter handed the request to the provider at `wallMs` (epoch millis, for display) and
+   * monotonic `at`. The first call wins, so a steer keeps the turn's original request.
+   */
+  requestSent(wallMs: number, at: number = this.now()): void {
+    if (this.finalized || this.requestAt !== undefined) return;
+    if (!Number.isFinite(at) || !Number.isFinite(wallMs)) return;
+    this.requestAt = at;
+    this.requestWallMs = wallMs;
+  }
+
+  get hasRequest(): boolean {
+    return this.requestAt !== undefined;
+  }
+
+  get isFinalized(): boolean {
+    return this.finalized;
+  }
+
+  /**
+   * A generated token: streamed reasoning, answer text or tool-call argument text.
+   * `content` is the chunk text, or its character count when the text is not at hand.
+   */
+  generated(
+    kind: GeneratedTokenKind,
+    content: string | number,
+    at: number = this.now(),
+  ): GeneratedMilestones {
+    // Output observed before the request was sent cannot be its response (buffered wake output).
+    if (
+      this.finalized ||
+      this.requestAt === undefined ||
+      !Number.isFinite(at) ||
+      at < this.requestAt
+    ) {
+      return NO_MILESTONES;
+    }
+    const time = at;
+    const chars = typeof content === "string" ? content.length : Math.max(0, content);
+    let firstToken = false;
+    let firstAnswer = false;
+    if (this.firstTokenAt === undefined) {
+      this.firstTokenAt = time;
+      this.firstTokenKind = kind;
+      firstToken = true;
+    }
+    if (
+      kind === "text" &&
+      this.firstAnswerAt === undefined &&
+      typeof content === "string" &&
+      content.trim().length > 0
+    ) {
+      this.firstAnswerAt = time;
+      firstAnswer = true;
+    }
+    if (this.response === undefined) {
+      this.response = { segments: [], chars: 0, exactTokens: undefined, complete: false };
+    }
+    if (this.segment === undefined) {
+      this.segment = { start: time, last: time };
+      this.response.segments.push(this.segment);
+    } else {
+      this.segment.last = Math.max(this.segment.last, time);
+    }
+    this.lastTokenAt = Math.max(this.lastTokenAt ?? time, time);
+    this.response.chars += chars;
+    if (kind === "reasoning") this.chars.reasoning += chars;
+    else if (kind === "text") this.chars.text += chars;
+    else this.chars.toolInput += chars;
+    if (chars > 0) {
+      const bucket = Math.floor(time / PEAK_BUCKET_MS);
+      this.buckets.set(bucket, (this.buckets.get(bucket) ?? 0) + chars / CHARS_PER_TOKEN);
+    }
+    return firstToken || firstAnswer ? { firstToken, firstAnswer } : NO_MILESTONES;
+  }
+
+  /** Cumulative exact output tokens of the response being streamed (Claude message_delta). */
+  responseTokens(outputTokens: number): void {
+    if (this.finalized || this.response === undefined) return;
+    if (!Number.isSafeInteger(outputTokens) || outputTokens < 0) {
+      this.response.exactTokens = undefined;
+      this.partial = true;
+      return;
+    }
+    this.response.exactTokens = outputTokens;
+  }
+
+  /**
+   * The model response ended. `complete: false` means it was cut short or only partly observed;
+   * its tokens are left out of exact accounting and the measurement becomes partial.
+   */
+  responseEnded(options: { readonly complete?: boolean } = {}): void {
+    if (this.finalized) return;
+    this.segment = undefined;
+    const response = this.response;
+    this.response = undefined;
+    if (response === undefined) return;
+    response.complete = options.complete ?? true;
+    this.responses.push(response);
+  }
+
+  /** A boundary that ends generation without ending the response (approval wait). */
+  pause(): void {
+    if (this.finalized) return;
+    this.segment = undefined;
+  }
+
+  toolStarted(id: string, at: number = this.now()): void {
+    if (this.finalized || this.requestAt === undefined || !Number.isFinite(at)) return;
+    this.segment = undefined;
+    if (this.tools.has(id) || at < this.requestAt) return;
+    this.tools.set(id, { start: at, end: undefined });
+  }
+
+  /** Returns false when the tool was never seen starting in this turn. */
+  toolCompleted(id: string, at: number = this.now()): boolean {
+    if (this.finalized || this.requestAt === undefined || !Number.isFinite(at)) return false;
+    const tool = this.tools.get(id);
+    if (tool === undefined) {
+      this.partial = true;
+      return false;
+    }
+    if (tool.end === undefined) tool.end = Math.max(at, tool.start);
+    return true;
+  }
+
+  hasTool(id: string): boolean {
+    return this.tools.has(id);
+  }
+
+  /** The provider's exact usage for the whole turn (Codex, ACP). */
+  turnUsage(usage: { readonly outputTokens?: number; readonly reasoningTokens?: number }): void {
+    if (this.finalized) return;
+    if (usage.outputTokens !== undefined && Number.isSafeInteger(usage.outputTokens)) {
+      this.turnOutputTokens = Math.max(0, usage.outputTokens);
+    }
+    if (usage.reasoningTokens !== undefined && Number.isSafeInteger(usage.reasoningTokens)) {
+      this.turnReasoningTokens = Math.max(0, usage.reasoningTokens);
+    }
+  }
+
+  /** Missed or cut-short events: values cover only what was observed. */
+  markPartial(): void {
+    if (!this.finalized) this.partial = true;
+  }
+
+  /** A mid-turn value (`live: true`). Undefined until the request was sent. */
+  snapshot(at: number = this.now()): TurnPerformance | undefined {
+    if (this.finalized) return this.finalResult;
+    return this.compute(at, false);
+  }
+
+  /** The terminal value (`live: false`). Later calls return the same value. */
+  finalize(status: TurnTerminalStatus, at: number = this.now()): TurnPerformance | undefined {
+    if (this.finalized) return this.finalResult;
+    if (status !== "completed") this.partial = true;
+    if (this.response !== undefined) {
+      // A completed turn's streamed tail is fully observed only without per-response usage.
+      this.responseEnded({ complete: this.accounting === "turn_total" && status === "completed" });
+    }
+    this.finalResult = this.compute(at, true);
+    this.finalized = true;
+    return this.finalResult;
+  }
+
+  /** The latest value: the terminal one once finalized, else a live snapshot. */
+  current(at: number = this.now()): TurnPerformance | undefined {
+    return this.finalized ? this.finalResult : this.compute(at, false);
+  }
+
+  private compute(at: number, terminal: boolean): TurnPerformance | undefined {
+    const requestAt = this.requestAt;
+    const requestWallMs = this.requestWallMs;
+    if (requestAt === undefined || requestWallMs === undefined) return undefined;
+    const end = Number.isFinite(at) ? Math.max(at, requestAt) : requestAt;
+    const responses =
+      this.response === undefined ? this.responses : [...this.responses, this.response];
+    let partial = this.partial;
+
+    let generation:
+      | { ms: number; windows: number; tokens: number; basis: GenerationBasis }
+      | undefined;
+    let calibration: { exact: number; estimated: number } | undefined;
+    const allSegments = responses.flatMap((response) => response.segments);
+    const allChars = this.chars.reasoning + this.chars.text + this.chars.toolInput;
+    if (this.accounting === "per_response") {
+      const exact = responses.filter(
+        (response) =>
+          response !== this.response &&
+          response.complete &&
+          response.exactTokens !== undefined &&
+          response.segments.length > 0,
+      );
+      if (
+        terminal &&
+        responses.some((response) => response.segments.length > 0 && !exact.includes(response))
+      ) {
+        partial = true;
+      }
+      const exactMs = sumSegments(exact.flatMap((response) => response.segments));
+      if (exact.length > 0 && exactMs > 0) {
+        const tokens = exact.reduce((sum, response) => sum + (response.exactTokens ?? 0), 0);
+        const chars = exact.reduce((sum, response) => sum + response.chars, 0);
+        generation = {
+          ms: exactMs,
+          windows: exact.reduce((sum, response) => sum + response.segments.length, 0),
+          tokens,
+          basis: "provider_exact",
+        };
+        calibration = { exact: tokens, estimated: chars / CHARS_PER_TOKEN };
+      }
+    } else if (this.turnOutputTokens !== undefined) {
+      const ms = sumSegments(allSegments);
+      if (ms > 0) {
+        generation = {
+          ms,
+          windows: allSegments.length,
+          tokens: this.turnOutputTokens,
+          basis: "provider_total",
+        };
+        // Hidden reasoning is counted but never streamed; leave it out of the calibration.
+        const hiddenReasoning =
+          this.chars.reasoning === 0 && this.turnReasoningTokens !== undefined
+            ? this.turnReasoningTokens
+            : 0;
+        calibration = {
+          exact: Math.max(0, this.turnOutputTokens - hiddenReasoning),
+          estimated: allChars / CHARS_PER_TOKEN,
+        };
+      }
+    }
+    if (generation !== undefined && roundMs(generation.ms) <= 0) generation = undefined;
+    if (generation === undefined) {
+      const ms = sumSegments(allSegments);
+      const tokens = Math.round(allChars / CHARS_PER_TOKEN);
+      if (roundMs(ms) > 0 && tokens > 0) {
+        generation = { ms, windows: allSegments.length, tokens, basis: "estimated" };
+      }
+    }
+
+    // Peak over full sliding windows inside the streamed span.
+    let peak: TurnPerformance["peakTokensPerSecond"];
+    if (
+      generation !== undefined &&
+      generation.ms >= PEAK_WINDOW_MS &&
+      this.firstTokenAt !== undefined &&
+      this.lastTokenAt !== undefined
+    ) {
+      const ratio =
+        calibration !== undefined && calibration.estimated > 0 && calibration.exact > 0
+          ? calibration.exact / calibration.estimated
+          : undefined;
+      const calibrated =
+        ratio !== undefined && ratio >= CALIBRATION_MIN && ratio <= CALIBRATION_MAX;
+      const rate = peakRate(this.buckets, this.firstTokenAt, this.lastTokenAt);
+      if (rate !== undefined && rate > 0) {
+        peak = {
+          value: roundRate(calibrated ? rate * (ratio ?? 1) : rate),
+          windowMs: PEAK_WINDOW_MS,
+          basis: calibrated ? "calibrated_estimate" : "estimated",
+        };
+      }
+    }
+
+    // Tools: wall-clock union of start-to-completion intervals.
+    const intervals: Array<{ start: number; end: number }> = [];
+    let open = 0;
+    let longest = 0;
+    for (const tool of this.tools.values()) {
+      const toolEnd = tool.end ?? Math.max(end, tool.start);
+      if (tool.end === undefined) open += 1;
+      longest = Math.max(longest, toolEnd - tool.start);
+      intervals.push({ start: tool.start, end: toolEnd });
+    }
+    if (terminal && open > 0) partial = true;
+
+    return {
+      source: this.source,
+      requestSentAt: DateTime.makeUnsafe(requestWallMs),
+      ...(this.firstTokenAt === undefined
+        ? {}
+        : { firstTokenMs: roundMs(this.firstTokenAt - requestAt) }),
+      ...(this.firstTokenKind === undefined ? {} : { firstTokenKind: this.firstTokenKind }),
+      ...(this.firstAnswerAt === undefined
+        ? {}
+        : { firstAnswerMs: roundMs(this.firstAnswerAt - requestAt) }),
+      ...(generation === undefined
+        ? {}
+        : {
+            generationMs: roundMs(generation.ms),
+            generationWindows: generation.windows,
+            generationTokens: { value: generation.tokens, basis: generation.basis },
+          }),
+      ...(peak === undefined ? {} : { peakTokensPerSecond: peak }),
+      streamedChars: { ...this.chars },
+      tools: {
+        count: this.tools.size,
+        wallMs: roundMs(sumIntervals(intervals)),
+        longestMs: roundMs(longest),
+        open,
+      },
+      ...(terminal ? { turnMs: roundMs(end - requestAt) } : {}),
+      partial,
+      live: !terminal,
+    };
+  }
+}
+
+type GenerationBasis = NonNullable<TurnPerformance["generationTokens"]>["basis"];
+
+function sumSegments(segments: ReadonlyArray<Segment>): number {
+  return segments.reduce((sum, segment) => sum + Math.max(0, segment.last - segment.start), 0);
+}
+
+function sumIntervals(intervals: ReadonlyArray<{ start: number; end: number }>): number {
+  let total = 0;
+  let current: { start: number; end: number } | undefined;
+  for (const interval of intervals.toSorted((a, b) => a.start - b.start)) {
+    if (current !== undefined && interval.start <= current.end) {
+      current.end = Math.max(current.end, interval.end);
+    } else {
+      if (current !== undefined) total += current.end - current.start;
+      current = { ...interval };
+    }
+  }
+  if (current !== undefined) total += current.end - current.start;
+  return total;
+}
+
+/** Highest tokens/s over full PEAK_WINDOW_MS windows between the first and last token. */
+function peakRate(
+  buckets: ReadonlyMap<number, number>,
+  firstAt: number,
+  lastAt: number,
+): number | undefined {
+  const first = Math.floor(firstAt / PEAK_BUCKET_MS);
+  const last = Math.floor(lastAt / PEAK_BUCKET_MS);
+  const width = PEAK_WINDOW_MS / PEAK_BUCKET_MS;
+  if (last - first + 1 < width) return undefined;
+  let sum = 0;
+  for (let index = first; index < first + width; index += 1) sum += buckets.get(index) ?? 0;
+  let best = sum;
+  for (let start = first + 1; start + width - 1 <= last; start += 1) {
+    sum += (buckets.get(start + width - 1) ?? 0) - (buckets.get(start - 1) ?? 0);
+    if (sum > best) best = sum;
+  }
+  return best / (PEAK_WINDOW_MS / 1000);
+}
+
+function roundMs(value: number): number {
+  return Math.max(0, Math.round(value * 10) / 10);
+}
+
+function roundRate(value: number): number {
+  return Math.max(0, Math.round(value * 10) / 10);
+}
