+  describe("Claude turn performance", () => {
+    type PerformanceHarness = Effect.Success<typeof makeWakeHarness>;
+    const performanceLayer = Layer.mergeAll(
+      IdAllocator.layer,
+      McpProviderSessions.layer,
+      NodeServices.layer,
+      NodeCrypto.layer,
+    );
+    const startPerformanceTurn = Effect.fnUntraced(function* (
+      harness: PerformanceHarness,
+      attempt: string,
+      ordinal: number,
+    ) {
+      yield* harness.runtime.startTurn(
+        makeClaudeTestTurnInput({
+          threadId: harness.threadId,
+          providerThread: harness.providerThread,
+          now: yield* DateTime.now,
+          attemptId: RunAttemptId.make(attempt),
+          providerTurnOrdinal: ordinal,
+          text: `Performance ${attempt}`,
+          attachments: [],
+        }),
+      );
+      // The user message is already in the query, so frames stamped after this follow the request.
+      return performance.now();
+    });
+    let performanceFrameCount = 0;
+    const streamFrame = Effect.fnUntraced(function* (
+      harness: PerformanceHarness,
+      event: unknown,
+      at: number,
+      parent: string | null = null,
+    ) {
+      const message = claudeSdkFrame({
+        type: "stream_event",
+        event,
+        parent_tool_use_id: parent,
+        session_id: WAKE_NATIVE_SESSION,
+        uuid: `performance-${at}-${(performanceFrameCount += 1)}`,
+      });
+      observeClaudeFrame(message, at);
+      yield* harness.offerAndWait(message);
+    });
+    const turnPerformances = (harness: PerformanceHarness, providerTurnId?: ProviderTurnId) =>
+      harness.events.flatMap((event) =>
+        event.type === "provider_turn.updated" &&
+        event.providerTurn.performance !== undefined &&
