+    source: accounting === "per_response" ? "claude_stream" : "codex_stream",
+    accounting,
+    now: () => clock.now,
+  });
+  perf.requestSent(WALL, 1000);
+  return { perf, clock };
+}
+
+/** Streams `chars` characters per chunk every `stepMs` from `from` to `to` (inclusive). */
+function stream(
+  perf: TurnPerformanceTracker,
+  kind: "reasoning" | "text" | "tool_input",
+  from: number,
+  to: number,
+  stepMs: number,
+  chunk: string,
+) {
+  for (let at = from; at <= to; at += stepMs) perf.generated(kind, chunk, at);
+}
+
+describe("TurnPerformanceTracker", () => {
+  it("records nothing until the request is sent, and keeps the first request", () => {
