diff --git a/apps/web/src/components/settings/StatsForNerdsSettings.tsx b/apps/web/src/components/settings/StatsForNerdsSettings.tsx
new file mode 100644
index 0000000000..7c75d797a8
--- /dev/null
+++ b/apps/web/src/components/settings/StatsForNerdsSettings.tsx
@@ -0,0 +1,337 @@
+import { DEFAULT_UNIFIED_SETTINGS } from "@t3tools/contracts/settings";
+import { msg, T, useGT, useMessages, Var } from "gt-react";
+import { ChevronDownIcon } from "lucide-react";
+
+import type { UsageLimitsDisplay, UsageLimitsScope } from "../chat/ComposerStats.logic";
+import {
+  isDefaultStatsForNerdsPlacements,
+  resetStatsForNerdsPlacements,
+  resolveStatsForNerdsPlacements,
+  setStatsForNerdsPlacement,
+  STATS_FOR_NERDS_PLACEMENTS,
+} from "../chat/statsForNerdsPlacement";
+import { TURN_PERFORMANCE_METRIC_LABELS } from "../chat/TurnPerformance.catalog";
+import { TURN_PERFORMANCE_METRIC_IDS, toggleHiddenMetric } from "../chat/TurnPerformance.logic";
+import { Button } from "../ui/button";
+import {
+  Menu,
+  MenuCheckboxItem,
+  MenuGroup,
+  MenuGroupLabel,
+  MenuItem,
+  MenuPopup,
+  MenuSeparator,
+  MenuTrigger,
+} from "../ui/menu";
+import { Select, SelectItem, SelectPopup, SelectTrigger, SelectValue } from "../ui/select";
+import { Switch } from "../ui/switch";
+import { SettingResetButton, SettingsRow, SettingsSection } from "./settingsLayout";
+import { useSearchableSetting } from "./settingsSearch";
+import { useScopedSettings, useUpdateScopedSettings } from "./useScopedSettings";
+
+const USAGE_LIMITS_SCOPE_LABELS: Record<UsageLimitsScope, string> = {
+  all: msg("All providers", { $context: "show usage limits of every provider" }),
+  current: msg("Current provider", { $context: "show usage limits of the thread's provider only" }),
+};
+
+/** Under each reply, under the composer, in thread details: a checkbox menu like Thread details. */
+function StatsForNerdsPlacementRow() {
+  const gt = useGT();
+  const m = useMessages();
+  const setting = useSearchableSetting();
+  const settings = useScopedSettings();
+  const updateSettings = useUpdateScopedSettings();
+  const placements = resolveStatsForNerdsPlacements(settings);
+  const enabled = STATS_FOR_NERDS_PLACEMENTS.filter((placement) => placements[placement.id]).length;
+  const isDefault = isDefaultStatsForNerdsPlacements(placements, DEFAULT_UNIFIED_SETTINGS);
+  return (
+    <SettingsRow
+      {...setting("stats-for-nerds-placement")}
+      description={gt("Under replies, below the composer, or in thread details.")}
+      resetAction={
+        isDefault ? null : (
+          <SettingResetButton
+            ariaLabel={gt("Reset where stats show to default")}
+            onClick={() =>
+              updateSettings(resetStatsForNerdsPlacements(settings, DEFAULT_UNIFIED_SETTINGS))
+            }
+          />
+        )
+      }
+      control={
+        <Menu>
+          <MenuTrigger
+            render={
+              <Button
+                variant="outline"
+                size="sm"
+                className="w-full justify-between sm:w-40"
+                aria-label={gt("Where stats show: {enabled} of {total} on", {
+                  enabled,
+                  total: STATS_FOR_NERDS_PLACEMENTS.length,
+                })}
+              />
+            }
+          >
+            <T>
+              <Var>{enabled}</Var> of <Var>{STATS_FOR_NERDS_PLACEMENTS.length}</Var> on
+            </T>
+            <ChevronDownIcon aria-hidden />
+          </MenuTrigger>
+          <MenuPopup align="end">
+            <MenuGroup>
+              <MenuGroupLabel>
+                <T>Show stats</T>
+              </MenuGroupLabel>
+              {STATS_FOR_NERDS_PLACEMENTS.map((placement) => (
+                <MenuCheckboxItem
+                  key={placement.id}
+                  checked={placements[placement.id]}
+                  onCheckedChange={(checked) =>
+                    updateSettings(setStatsForNerdsPlacement(settings, placement.id, checked))
+                  }
+                >
+                  {m(placement.label)}
+                </MenuCheckboxItem>
+              ))}
+            </MenuGroup>
+            <MenuSeparator />
+            <MenuItem
+              disabled={isDefault}
+              onClick={() =>
+                updateSettings(resetStatsForNerdsPlacements(settings, DEFAULT_UNIFIED_SETTINGS))
+              }
+            >
+              <T>Reset to default</T>
+            </MenuItem>
+          </MenuPopup>
+        </Menu>
+      }
+    />
+  );
+}
+
+function StatsForNerdsUsageLimitsRow() {
+  const gt = useGT();
+  const m = useMessages();
+  const setting = useSearchableSetting();
+  const scope = useScopedSettings((settings) => settings.statsForNerdsUsageLimitsScope);
+  const updateSettings = useUpdateScopedSettings();
+  return (
+    <SettingsRow
+      {...setting("stats-for-nerds-usage-limits")}
+      description={gt("The thread's provider only, or every provider that reports limits.")}
+      resetAction={
+        scope !== DEFAULT_UNIFIED_SETTINGS.statsForNerdsUsageLimitsScope ? (
+          <SettingResetButton
+            ariaLabel={gt("Reset usage limits to show to default")}
+            onClick={() =>
+              updateSettings({
+                statsForNerdsUsageLimitsScope:
+                  DEFAULT_UNIFIED_SETTINGS.statsForNerdsUsageLimitsScope,
+              })
+            }
+          />
+        ) : null
+      }
+      control={
+        <Select
+          value={scope}
+          onValueChange={(value) => {
+            if (value === "all" || value === "current") {
+              updateSettings({ statsForNerdsUsageLimitsScope: value });
+            }
+          }}
+        >
+          <SelectTrigger
+            size="sm"
+            className="w-full sm:w-40"
+            aria-label={gt("Usage limits to show")}
+          >
+            <SelectValue>{m(USAGE_LIMITS_SCOPE_LABELS[scope])}</SelectValue>
+          </SelectTrigger>
+          <SelectPopup align="end" alignItemWithTrigger={false}>
+            {(["all", "current"] as const).map((value) => (
+              <SelectItem hideIndicator key={value} value={value}>
+                {m(USAGE_LIMITS_SCOPE_LABELS[value])}
+              </SelectItem>
+            ))}
+          </SelectPopup>
+        </Select>
+      }
+    />
+  );
+}
+
+const USAGE_LIMITS_DISPLAY_LABELS: Record<UsageLimitsDisplay, string> = {
+  left: msg("Left", { $context: "usage limit shown as the share remaining" }),
+  used: msg("Used", { $context: "usage limit shown as the share consumed" }),
+};
+
+function StatsForNerdsUsageLimitsDisplayRow() {
+  const gt = useGT();
+  const m = useMessages();
+  const setting = useSearchableSetting();
+  const display = useScopedSettings((settings) => settings.statsForNerdsUsageLimitsDisplay);
+  const updateSettings = useUpdateScopedSettings();
+  return (
+    <SettingsRow
+      {...setting("stats-for-nerds-usage-limits-display")}
+      description={gt("The share of each limit left, or the share used.")}
+      resetAction={
+        display !== DEFAULT_UNIFIED_SETTINGS.statsForNerdsUsageLimitsDisplay ? (
+          <SettingResetButton
+            ariaLabel={gt("Reset show limits as to default")}
+            onClick={() =>
+              updateSettings({
+                statsForNerdsUsageLimitsDisplay:
+                  DEFAULT_UNIFIED_SETTINGS.statsForNerdsUsageLimitsDisplay,
+              })
+            }
+          />
+        ) : null
+      }
+      control={
+        <Select
+          value={display}
+          onValueChange={(value) => {
+            if (value === "left" || value === "used") {
+              updateSettings({ statsForNerdsUsageLimitsDisplay: value });
+            }
+          }}
+        >
+          <SelectTrigger size="sm" className="w-full sm:w-40" aria-label={gt("Show limits as")}>
+            <SelectValue>{m(USAGE_LIMITS_DISPLAY_LABELS[display])}</SelectValue>
+          </SelectTrigger>
+          <SelectPopup align="end" alignItemWithTrigger={false}>
+            {(["left", "used"] as const).map((value) => (
+              <SelectItem hideIndicator key={value} value={value}>
+                {m(USAGE_LIMITS_DISPLAY_LABELS[value])}
+              </SelectItem>
+            ))}
+          </SelectPopup>
+        </Select>
+      }
+    />
+  );
+}
+
+/** Which turn metrics show, as one checkbox menu instead of a row per metric. */
+function StatsForNerdsMetricsRow() {
+  const gt = useGT();
+  const m = useMessages();
+  const setting = useSearchableSetting();
+  const hidden = useScopedSettings((settings) => settings.statsForNerdsHiddenMetrics);
+  const updateSettings = useUpdateScopedSettings();
+  const shown = TURN_PERFORMANCE_METRIC_IDS.filter((id) => !hidden.includes(id)).length;
+  const total = TURN_PERFORMANCE_METRIC_IDS.length;
+  const reset = () =>
+    updateSettings({
+      statsForNerdsHiddenMetrics: DEFAULT_UNIFIED_SETTINGS.statsForNerdsHiddenMetrics,
+    });
+  return (
+    <SettingsRow
+      {...setting("stats-for-nerds-metrics")}
+      description={gt("Choose which turn metrics show.")}
+      resetAction={
+        hidden.length === 0 ? null : (
+          <SettingResetButton ariaLabel={gt("Reset metrics to default")} onClick={reset} />
+        )
+      }
+      control={
+        <Menu>
+          <MenuTrigger
+            render={
+              <Button
+                variant="outline"
+                size="sm"
+                className="w-full justify-between sm:w-40"
+                aria-label={gt("Metrics: {enabled} of {total} on", { enabled: shown, total })}
+              />
+            }
+          >
+            <T>
+              <Var>{shown}</Var> of <Var>{total}</Var> on
+            </T>
+            <ChevronDownIcon aria-hidden />
+          </MenuTrigger>
+          <MenuPopup align="end">
+            <MenuGroup>
+              <MenuGroupLabel>
+                <T>Show metrics</T>
+              </MenuGroupLabel>
+              {TURN_PERFORMANCE_METRIC_IDS.map((id) => {
+                const { label, abbr } = TURN_PERFORMANCE_METRIC_LABELS[id];
+                return (
+                  <MenuCheckboxItem
+                    key={id}
+                    checked={!hidden.includes(id)}
+                    onCheckedChange={(checked) =>
+                      updateSettings({
+                        statsForNerdsHiddenMetrics: toggleHiddenMetric(hidden, id, checked),
+                      })
+                    }
+                  >
+                    {m(label)}
+                    <span className="ms-auto ps-3 text-muted-foreground">{m(abbr)}</span>
+                  </MenuCheckboxItem>
+                );
+              })}
+            </MenuGroup>
+            <MenuSeparator />
+            <MenuItem disabled={hidden.length === 0} onClick={reset}>
+              <T>Reset to default</T>
+            </MenuItem>
+          </MenuPopup>
+        </Menu>
+      }
+    />
+  );
+}
+
+export function StatsForNerdsSettingsSection() {
+  const gt = useGT();
+  const setting = useSearchableSetting();
+  const settings = useScopedSettings();
+  const updateSettings = useUpdateScopedSettings();
+
+  return (
+    <SettingsSection id="stats-for-nerds-section" title={gt("Stats for nerds")}>
+      <SettingsRow
+        {...setting("stats-for-nerds")}
+        description={gt(
+          "Turn speed, latency, tokens, context and usage limits; ≈ marks estimates.",
+        )}
+        resetAction={
+          settings.statsForNerdsEnabled !== DEFAULT_UNIFIED_SETTINGS.statsForNerdsEnabled ? (
+            <SettingResetButton
+              ariaLabel={gt("Reset stats for nerds to default")}
+              onClick={() =>
+                updateSettings({
+                  statsForNerdsEnabled: DEFAULT_UNIFIED_SETTINGS.statsForNerdsEnabled,
+                })
+              }
+            />
+          ) : null
+        }
+        control={
+          <Switch
+            checked={settings.statsForNerdsEnabled}
+            onCheckedChange={(checked) =>
+              updateSettings({ statsForNerdsEnabled: Boolean(checked) })
+            }
+            aria-label={gt("Stats for nerds")}
+          />
+        }
+      />
+      {settings.statsForNerdsEnabled && (
+        <>
+          <StatsForNerdsPlacementRow />
+          <StatsForNerdsUsageLimitsRow />
+          <StatsForNerdsUsageLimitsDisplayRow />
+          <StatsForNerdsMetricsRow />
+        </>
+      )}
+    </SettingsSection>
+  );
+}
