+export type UsageLimitsScope = "current" | "all";
+
+export interface UsageLimitProviderEntry {
+  readonly provider: ServerProvider;
+  readonly limits: ServerProviderUsageLimits;
+  readonly current: boolean;
+}
+
+/**
+ * Providers whose limits Stats for nerds shows: the thread's provider first, then every other
+ * enabled provider that reports limit windows, in the configured order.
+ */
+export function selectUsageLimitProviders(
+  providers: ReadonlyArray<ServerProvider>,
+  currentInstanceId: ProviderInstanceId | null,
+  scope: UsageLimitsScope,
+): ReadonlyArray<UsageLimitProviderEntry> {
+  const current = providers.find((provider) => provider.instanceId === currentInstanceId);
+  const entries: UsageLimitProviderEntry[] =
+    current?.usageLimits !== undefined
+      ? [{ provider: current, limits: current.usageLimits, current: true }]
+      : [];
+  if (scope === "current") return entries;
+  for (const provider of providers) {
+    if (
+      provider === current ||
+      !provider.enabled ||
+      !provider.installed ||
+      provider.availability === "unavailable" ||
+      selectComposerLimitWindows(provider.usageLimits).length === 0
+    )
+      continue;
+    entries.push({ provider, limits: provider.usageLimits!, current: false });
+  }
+  return entries;
+}
+
+/**
+ * The account-wide window closest to running out. Readable windows beat dimmed ones (stale,
+ * expired or awaiting a reset reading), so an old high reading never hides a live one.
+ */
+export function selectTightestLimitWindow(
+  limits: ServerProviderUsageLimits | undefined,
+  nowMs: number,
+): { readonly window: ServerProviderUsageWindow; readonly shortLabel: string } | null {
+  const ranked = selectComposerLimitWindows(limits).map((chip) => {
+    const display = composerLimitDisplay(chip.window, limits?.checkedAt, nowMs);
+    return { chip, readable: !display.dimmed, percent: display.displayPercent ?? -1 };
+  });
+  const best = ranked.reduce<(typeof ranked)[number] | null>(
+    (top, entry) =>
+      top === null ||
+      (entry.readable && !top.readable) ||
+      (entry.readable === top.readable && entry.percent > top.percent)
+        ? entry
+        : top,
+    null,
+  );
+  return best?.chip ?? null;
+}
+
+/** One provider keeps every account-wide window; several show only each one's tightest. */
+export function composerLimitChips(
+  entries: ReadonlyArray<UsageLimitProviderEntry>,
+  nowMs: number,
+): ReadonlyArray<{
+  readonly entry: UsageLimitProviderEntry;
+  readonly chips: ReadonlyArray<{
+    readonly window: ServerProviderUsageWindow;
+    readonly shortLabel: string;
+  }>;
+}> {
+  return entries.flatMap((entry) => {
+    const chips =
+      entries.length === 1
+        ? selectComposerLimitWindows(entry.limits)
+        : [selectTightestLimitWindow(entry.limits, nowMs)].filter((chip) => chip !== null);
+    return chips.length === 0 ? [] : [{ entry, chips }];
+  });
+}
+
 export const COMPOSER_STATS_CLOCK_MS = 30_000;
 
 /** Age of the newest valid fetch among the displayed windows. */
