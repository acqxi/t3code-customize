+    const single = selectUsageLimitProviders([both], ProviderInstanceId.make("both"), "all");
+    expect(
+      composerLimitChips(single, now).map(({ chips }) => chips.map(({ shortLabel }) => shortLabel)),
+    ).toEqual([["5h", "Week"]]);
+
+    const several = selectUsageLimitProviders(
+      [both, codex],
+      ProviderInstanceId.make("both"),
+      "all",
+    );
+    expect(
+      composerLimitChips(several, now).map(({ entry, chips }) => [
