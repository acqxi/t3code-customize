+describe("usage limits across providers", () => {
+  const now = Date.parse("2026-10-04T16:00:00.000Z");
+  const checkedAt = new Date(now - 60_000).toISOString();
+  const limitWindow = (
+    id: string,
+    kind: "session" | "weekly",
+    usedPercent: number,
+    overrides: Partial<ServerProviderUsageWindow> = {},
+  ): ServerProviderUsageWindow => ({
+    id,
+    kind,
+    label: id,
+    usedPercent,
+    windowDurationMins: kind === "session" ? 300 : 10_080,
+    ...overrides,
+  });
+  const provider = (
+    instanceId: string,
+    windows: ReadonlyArray<ServerProviderUsageWindow> | null,
+    overrides: Partial<ServerProvider> = {},
+  ) =>
+    ({
+      instanceId: ProviderInstanceId.make(instanceId),
+      driver: "codex",
+      enabled: true,
+      installed: true,
+      ...(windows === null ? {} : { usageLimits: { checkedAt, windows: [...windows] } }),
+      ...overrides,
+    }) as ServerProvider;
+  const ids = (entries: ReadonlyArray<{ provider: ServerProvider }>) =>
+    entries.map((entry) => entry.provider.instanceId);
+
+  const codex = provider("codex", [limitWindow("five_hour", "session", 10)]);
+  const claude = provider("claude", [limitWindow("seven_day", "weekly", 40)]);
+  const antigravity = provider("antigravity", [limitWindow("five_hour", "session", 70)]);
+
+  it("lists the thread's provider first, then the others in their order", () => {
+    const entries = selectUsageLimitProviders(
+      [codex, claude, antigravity],
+      ProviderInstanceId.make("claude"),
+      "all",
+    );
+    expect(ids(entries)).toEqual(["claude", "codex", "antigravity"]);
+    expect(entries.map((entry) => entry.current)).toEqual([true, false, false]);
+  });
+
+  it("keeps only the thread's provider when scoped to it", () => {
+    expect(
+      ids(selectUsageLimitProviders([codex, claude], ProviderInstanceId.make("codex"), "current")),
+    ).toEqual(["codex"]);
+    expect(selectUsageLimitProviders([codex, claude], null, "current")).toEqual([]);
+  });
+
+  it("skips other providers that are off, missing or report no windows", () => {
+    const entries = selectUsageLimitProviders(
+      [
+        codex,
+        provider("disabled", [limitWindow("five_hour", "session", 5)], { enabled: false }),
+        provider("missing", [limitWindow("five_hour", "session", 5)], { installed: false }),
+        provider("offline", [limitWindow("five_hour", "session", 5)], {
+          availability: "unavailable",
+        }),
+        provider("none", null),
+        provider("empty", []),
+        claude,
+      ],
+      null,
+      "all",
+    );
+    expect(ids(entries)).toEqual(["codex", "claude"]);
+  });
+
+  it("picks the readable window closest to running out", () => {
+    const limits = {
+      checkedAt,
+      windows: [limitWindow("five_hour", "session", 30), limitWindow("seven_day", "weekly", 80)],
+    };
+    expect(selectTightestLimitWindow(limits, now)?.window.id).toBe("seven_day");
+  });
+
+  it("prefers a fresh window over a stale, higher one", () => {
+    const limits = {
+      checkedAt,
+      windows: [
+        limitWindow("five_hour", "session", 30),
+        limitWindow("seven_day", "weekly", 95, {
+          checkedAt: new Date(now - 10 * 60_000).toISOString(),
+        }),
+      ],
+    };
+    expect(selectTightestLimitWindow(limits, now)?.window.id).toBe("five_hour");
+  });
+
+  it("treats a window past its reset as empty", () => {
+    const limits = {
+      checkedAt,
+      windows: [
+        limitWindow("five_hour", "session", 99, {
+          resetsAt: new Date(now - 60_000).toISOString(),
+        }),
+        limitWindow("seven_day", "weekly", 20),
+      ],
+    };
+    expect(selectTightestLimitWindow(limits, now)?.window.id).toBe("seven_day");
+    expect(selectTightestLimitWindow(undefined, now)).toBeNull();
+  });
+
+  it("keeps every window for one provider and the tightest for several", () => {
+    const both = provider("both", [
+      limitWindow("five_hour", "session", 30),
+      limitWindow("seven_day", "weekly", 60),
+    ]);
+    const single = selectUsageLimitProviders([both], ProviderInstanceId.make("both"), "all");
+    expect(
+      composerLimitChips(single, now).map(({ chips }) => chips.map(({ shortLabel }) => shortLabel)),
+    ).toEqual([["5h", "Week"]]);
+
+    const several = selectUsageLimitProviders(
+      [both, codex],
+      ProviderInstanceId.make("both"),
+      "all",
+    );
+    expect(
+      composerLimitChips(several, now).map(({ entry, chips }) => [
+        entry.provider.instanceId,
+        chips.map(({ window }) => window.id),
+      ]),
+    ).toEqual([
+      ["both", ["seven_day"]],
+      ["codex", ["five_hour"]],
+    ]);
+  });
+});
+
+describe("usage limits for the thread's models", () => {
+  const now = Date.parse("2026-11-27T12:00:00.000Z");
+  const checkedAt = new Date(now - 60_000).toISOString();
+  const longAgo = new Date(now - 2 * 60 * 60_000).toISOString();
+  const window = (
+    id: string,
+    kind: ServerProviderUsageWindow["kind"],
+    label: string,
+    usedPercent: number,
+    overrides: Partial<ServerProviderUsageWindow> = {},
+  ): ServerProviderUsageWindow => ({
+    id,
+    kind,
+    label,
+    usedPercent,
+    windowDurationMins: kind === "session" ? 300 : 10_080,
+    ...overrides,
+  });
+  const provider = (
+    instanceId: string,
+    driver: string,
+    windows: ReadonlyArray<ServerProviderUsageWindow>,
+  ) =>
+    ({
+      instanceId: ProviderInstanceId.make(instanceId),
+      driver: ProviderDriverKind.make(driver),
+      enabled: true,
+      installed: true,
+      usageLimits: { checkedAt, windows: [...windows] },
+    }) as unknown as ServerProvider;
+  // The reported case: Claude's Fable pool has no reading, and of Antigravity's pools only the
+  // Gemini ones cover gemini-4-neon.
+  const claude = provider("claude", "claudeAgent", [
+    window("seven_day", "weekly", "Weekly", 49),
+    window("seven_day_fable", "weekly", "Weekly · Fable", 0, { checkedAt: longAgo }),
+  ]);
+  const codex = provider("codex", "codex", [window("seven_day", "weekly", "Weekly", 51)]);
+  const antigravity = provider("antigravity", "antigravity", [
+    window("3p-5h", "session", "Claude & GPT (shared) · 5-hour", 20),
+    window("gemini-5h", "session", "Gemini · 5-hour", 10, { checkedAt: longAgo }),
+    window("3p-weekly", "weekly", "Claude & GPT (shared) · Weekly", 30),
+    window("gemini-weekly", "weekly", "Gemini · Weekly", 40),
+    window("gemini-argon-weekly", "weekly", "Gemini Argon · Weekly", 95),
+  ]);
+  const shown = (entries: ReadonlyArray<{ entry: UsageLimitProviderEntry }>) =>
+    entries.map(({ entry }) => [entry.provider.instanceId, entry.limits.windows.map((w) => w.id)]);
+  const antigravityThread = new Map([[ProviderInstanceId.make("antigravity"), "gemini-4-neon"]]);
+
+  it("shows only the pools covering the thread's model, with a reading", () => {
+    const entries = selectUsageLimitProviders(
+      [claude, codex, antigravity],
+      ProviderInstanceId.make("antigravity"),
+      "all",
+      antigravityThread,
+    );
+    expect(shown(composerLimitChips(entries, now))).toEqual([
+      ["antigravity", ["gemini-weekly"]],
+      ["claude", ["seven_day"]],
+      ["codex", ["seven_day"]],
+    ]);
+  });
+
+  it("picks the tightest chip from the same pools", () => {
+    const entries = selectUsageLimitProviders(
+      [antigravity, codex],
+      ProviderInstanceId.make("antigravity"),
+      "all",
+      antigravityThread,
+    );
+    // Argon's 95% does not meter gemini-4-neon, so it never becomes the chip.
+    expect(
+      composerLimitChips(entries, now).map(({ chips }) => chips.map((chip) => chip.window.id)),
+    ).toEqual([["gemini-weekly"], ["seven_day"]]);
+  });
+
+  it("drops a provider whose windows have no reading, heading and all", () => {
+    const stale = provider("antigravity", "antigravity", [
+      window("3p-5h", "session", "Claude & GPT (shared) · 5-hour", 0, { checkedAt: longAgo }),
+      window("gemini-5h", "session", "Gemini · 5-hour", 0, { checkedAt: longAgo }),
+      window("3p-weekly", "weekly", "Claude & GPT (shared) · Weekly", 0, { checkedAt: longAgo }),
+      window("gemini-weekly", "weekly", "Gemini · Weekly", 0, { checkedAt: longAgo }),
+    ]);
+    const entries = selectUsageLimitProviders(
+      [claude, codex, stale],
+      ProviderInstanceId.make("antigravity"),
+      "all",
+      antigravityThread,
+    );
+    expect(shown(composerLimitChips(entries, now))).toEqual([
+      ["claude", ["seven_day"]],
+      ["codex", ["seven_day"]],
+    ]);
+  });
+
+  it("keeps a model's pool when the thread ran that model", () => {
+    const fresh = provider("claude", "claudeAgent", [
+      window("seven_day", "weekly", "Weekly", 49),
+      window("seven_day_fable", "weekly", "Weekly · Fable", 12),
+    ]);
+    const ids = (model: string | null) =>
+      selectUsageLimitProviders(
+        [fresh],
+        ProviderInstanceId.make("claude"),
+        "all",
+        model === null ? new Map() : new Map([[ProviderInstanceId.make("claude"), model]]),
+      )[0]!.limits.windows.map((w) => w.id);
+    expect(ids("claude-fable-5-2")).toEqual(["seven_day", "seven_day_fable"]);
+    expect(ids("claude-opus-5-5")).toEqual(["seven_day"]);
+    expect(ids(null)).toEqual(["seven_day"]);
+  });
+
+  it("reads pool membership from model ids, Claude's names and Antigravity's buckets", () => {
+    const covers = (driver: string, w: ServerProviderUsageWindow, model: string) =>
+      limitWindowModelScope(ProviderDriverKind.make(driver), w)?.(model) ?? "general";
+    const listed = window("pool", "weekly", "Pool", 1, { modelIds: ["gpt-5.5"] });
+    expect(covers("codex", listed, "gpt-5.5")).toBe(true);
+    expect(covers("codex", listed, "hub/gpt-5.5")).toBe(true);
+    expect(covers("codex", listed, "gpt-5.5-mini")).toBe(false);
+    expect(covers("antigravity", window("3p-weekly", "weekly", "", 1), "claude-opus-5")).toBe(true);
+    expect(covers("antigravity", window("3p-weekly", "weekly", "", 1), "gemini-4-neon")).toBe(
+      false,
+    );
+    expect(
+      covers("antigravity", window("gemini-argon-weekly", "weekly", "", 1), "gemini-4-argon"),
+    ).toBe(true);
+    // Unknown membership counts as general.
+    expect(covers("antigravity", window("credits", "other", "", 1), "gemini-4-neon")).toBe(
+      "general",
+    );
+    expect(covers("codex", window("seven_day", "weekly", "", 1), "gpt-5.5")).toBe("general");
+  });
+
+  it("remembers the model each provider last ran in the thread", () => {
+    const at = (iso: string) => DateTime.makeUnsafe(iso);
+    const models = lastModelsByProviderInstance({
+      providerThreads: [
+        { id: ProviderThreadId.make("a"), providerInstanceId: ProviderInstanceId.make("claude") },
+        { id: ProviderThreadId.make("b"), providerInstanceId: ProviderInstanceId.make("codex") },
+      ],
+      providerTurns: [
+        {
+          providerThreadId: ProviderThreadId.make("a"),
+          ordinal: 2,
+          startedAt: at("2026-11-27T10:05:00Z"),
+          model: "claude-fable-5-2",
+        },
+        {
+          providerThreadId: ProviderThreadId.make("a"),
+          ordinal: 1,
+          startedAt: at("2026-11-27T10:00:00Z"),
+          model: "claude-opus-5-5",
+        },
+        { providerThreadId: ProviderThreadId.make("b"), ordinal: 1, startedAt: null },
+      ],
+    });
+    expect([...models]).toEqual([["claude", "claude-fable-5-2"]]);
+  });
+
+  it.each([
+    ["Claude & GPT (shared) · 5-hour", "Claude & GPT · 5h"],
+    ["Gemini · Weekly", "Gemini · Week"],
+    ["Weekly · Fable", "Week · Fable"],
+    ["Session", "Session"],
+    ["Monthly spend", "Monthly spend"],
+    ["Gemini Argon · 7-day", "Gemini Argon · 7d"],
+  ])("shortens %s to %s", (label, short) => {
+    expect(shortLimitLabel(label)).toBe(short);
+  });
+});
+
+describe("limit countdown", () => {
+  const s = 1_000;
+  const m = 60 * s;
+  const h = 60 * m;
+  const d = 24 * h;
+  it.each([
+    [3 * d + 8 * h + 5 * m, "3d 8h"],
+    [2 * h + 4 * m + 30 * s, "2h 4m"],
+    [45 * m + 12 * s + 900, "45m 12s"],
+    [9 * s, "9s"],
+    [1 * d + 6 * h, "1d 6h"],
+    [2 * h + 30 * s, "2h"],
+    [5 * d, "5d"],
+    [99 * d + 23 * h, "99d 23h"],
+    [120 * d + 5 * h, "120d"],
+    [400, "0s"],
+  ])("%d ms reads %s", (ms, text) => {
+    expect(formatLimitCountdown(ms)).toBe(text);
+  });
+
+  it("has nothing to count down once the reset has passed", () => {
+    expect(formatLimitCountdown(0)).toBeNull();
+    expect(formatLimitCountdown(-5_000)).toBeNull();
+    expect(formatLimitCountdown(Number.NaN)).toBeNull();
+  });
+});
+
+describe("reading age", () => {
+  it.each([
+    [0, "0s"],
+    [59_999, "59s"],
+    [60_000, "1m"],
+    [99 * 60_000, "99m"],
