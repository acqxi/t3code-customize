diff --git a/apps/web/src/components/settings/LocalHostBridge.logic.test.ts b/apps/web/src/components/settings/LocalHostBridge.logic.test.ts
new file mode 100644
index 0000000000..44863df710
--- /dev/null
+++ b/apps/web/src/components/settings/LocalHostBridge.logic.test.ts
@@ -0,0 +1,153 @@
+import {
+  type DesktopHostBridgeState,
+  EnvironmentId,
+  type PeerLinkSummary,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import { describe, expect, it } from "vite-plus/test";
+
+import { bridgePorts, localHostBridgeView } from "./LocalHostBridge.logic";
+
+const now = DateTime.makeUnsafe("2026-01-10T00:00:00.000Z");
+const windowsId = EnvironmentId.make("env-windows");
+const wslId = EnvironmentId.make("env-wsl");
+const urls = ["http://127.0.0.1:13773", "http://127.0.0.1:13774", "http://127.0.0.1:13775"];
+
+const desktop: DesktopHostBridgeState = {
+  enabled: true,
+  phase: "running",
+  detail: null,
+  urls,
+  url: urls[0]!,
+  windowsEnvironmentId: windowsId,
+  windowsLabel: "Same Name",
+  windowsPort: 3773,
+  pairedEnvironmentId: windowsId,
+  wslInstanceId: "wsl:TestDistro",
+  wslDistro: "TestDistro",
+  wslRuntimeId: "sha256-abc",
+  wslNetworking: "nat",
+  helperPid: 42,
+  restarts: 0,
+  nextRetryAt: null,
+  lastError: null,
+  streams: { open: 0, total: 3, refused: 0 },
+  since: "2026-01-09T00:00:00.000Z",
+};
+
+const link = (overrides: Partial<PeerLinkSummary> = {}): PeerLinkSummary => ({
+  environmentId: windowsId,
+  // Both environments share a hostname: only the ID and the bridge addresses count.
+  label: "Same Name",
+  urls,
+  access: "approval-required",
+  linkedAt: DateTime.makeUnsafe("2026-01-01T00:00:00.000Z"),
+  expiresAt: DateTime.makeUnsafe("2026-02-01T00:00:00.000Z"),
+  lastReachedAt: null,
+  lastError: null,
+  status: "reachable",
+  ...overrides,
+});
+
+const viewOf = (
+  input: Partial<Parameters<typeof localHostBridgeView>[0]> = {},
+): ReturnType<typeof localHostBridgeView> =>
+  localHostBridgeView({
+    desktop,
+    wslEnvironmentId: wslId,
+    wslSupportsBridge: true,
+    links: [link()],
+    now,
+    ...input,
+  });
+
+describe("localHostBridgeView", () => {
+  it("is connected only when the WSL backend's native link answers", () => {
+    expect(viewOf().status).toBe("connected");
+    expect(viewOf().link?.environmentId).toBe(windowsId);
+  });
+
+  it("asks for pairing when no native link exists, even with the helper up", () => {
+    expect(viewOf({ links: [] })).toMatchObject({
+      status: "pairing-required",
+      pairingReason: "unlinked",
+    });
+  });
+
+  it("asks for pairing again once the link expired, never pairing on its own", () => {
+    expect(viewOf({ links: [link({ status: "expired" })] })).toMatchObject({
+      status: "pairing-required",
+      pairingReason: "expired",
+    });
+  });
+
+  it("reports a link the Windows side revoked as permission denied", () => {
+    expect(
+      viewOf({
+        links: [
+          link({
+            lastError:
+              "The linked environment no longer accepts this link. It may have been revoked there; link it again.",
+          }),
+        ],
+      }).status,
+    ).toBe("permission-denied");
+    expect(viewOf({ links: [link({ lastError: "timed out" })] }).status).toBe("recovering");
+    expect(viewOf({ links: [link({ status: "unreachable" })] }).status).toBe("recovering");
+  });
+
+  it("never counts a link to the same name elsewhere, or at other addresses, as the bridge", () => {
+    const elsewhere = link({
+      environmentId: EnvironmentId.make("env-other-machine"),
+      urls: ["https://other.example.ts.net"],
+    });
+    const directToWindows = link({ urls: ["https://windows.example.ts.net"] });
+    expect(viewOf({ links: [elsewhere, directToWindows] })).toMatchObject({
+      status: "pairing-required",
+      link: null,
+      staleLink: null,
+    });
+  });
+
+  it("flags a bridge link to an earlier Windows environment as an identity mismatch", () => {
+    const old = link({ environmentId: EnvironmentId.make("env-windows-before") });
+    expect(viewOf({ links: [old] })).toMatchObject({
+      status: "identity-mismatch",
+      staleLink: { environmentId: "env-windows-before" },
+    });
+    expect(viewOf({ desktop: { ...desktop, phase: "identity-mismatch" } }).status).toBe(
+      "identity-mismatch",
+    );
+  });
+
+  it("follows the Desktop helper while it waits, starts or recovers", () => {
+    expect(viewOf({ desktop: { ...desktop, enabled: false, phase: "disabled" } }).status).toBe(
+      "disabled",
+    );
+    expect(viewOf({ desktop: { ...desktop, phase: "waiting-windows" } }).status).toBe(
+      "waiting-windows",
+    );
+    expect(viewOf({ desktop: { ...desktop, phase: "waiting-wsl" } }).status).toBe("waiting-wsl");
+    expect(viewOf({ desktop: { ...desktop, phase: "starting" } }).status).toBe("starting");
+    expect(viewOf({ desktop: { ...desktop, phase: "recovering" } }).status).toBe("recovering");
+  });
+
+  it("waits for both identities and the link list before deciding", () => {
+    expect(viewOf({ links: null }).status).toBe("discovering");
+    expect(viewOf({ wslEnvironmentId: null }).status).toBe("discovering");
+    expect(viewOf({ desktop: { ...desktop, windowsEnvironmentId: null } }).status).toBe(
+      "discovering",
+    );
+  });
+
+  it("says when the Desktop or the WSL runtime has no bridge", () => {
+    expect(viewOf({ desktop: null }).status).toBe("unsupported");
+    expect(viewOf({ wslSupportsBridge: false }).status).toBe("unsupported");
+  });
+});
+
+describe("bridgePorts", () => {
+  it("reads the ports from the Desktop's addresses", () => {
+    expect(bridgePorts(desktop)).toEqual([13773, 13774, 13775]);
+  });
+});
diff --git a/apps/web/src/components/settings/LocalHostBridge.logic.ts b/apps/web/src/components/settings/LocalHostBridge.logic.ts
new file mode 100644
index 0000000000..211e79c4b9
--- /dev/null
+++ b/apps/web/src/components/settings/LocalHostBridge.logic.ts
@@ -0,0 +1,128 @@
+import type { DesktopHostBridgeState, EnvironmentId, PeerLinkSummary } from "@t3tools/contracts";
+import { peerLinkHealth } from "@t3tools/client-runtime/state/peerLinks";
+import { isHostBridgeUrl } from "@t3tools/shared/hostBridgeMux";
+import type * as DateTime from "effect/DateTime";
+
+export type LocalHostBridgeStatus =
+  | "unsupported"
+  | "disabled"
+  | "discovering"
+  | "waiting-windows"
+  | "waiting-wsl"
+  | "starting"
+  | "pairing-required"
+  | "connected"
+  | "recovering"
+  | "permission-denied"
+  | "identity-mismatch";
+
+export interface LocalHostBridgeView {
+  readonly status: LocalHostBridgeStatus;
+  /** The native link from WSL to this machine's Windows backend through the bridge, if any. */
+  readonly link: PeerLinkSummary | null;
+  /** A bridge link to a Windows environment that is no longer the one this Desktop runs. */
+  readonly staleLink: PeerLinkSummary | null;
+  /** Why pairing is needed: never linked, or the link ran out. */
+  readonly pairingReason: "unlinked" | "expired" | null;
+  readonly detail: string | null;
+  /** The WSL backend runs a server without the bridge's link path, such as a stock runtime. */
+  readonly runtimeLacksBridge: boolean;
+}
+
+/** What PeerMcpClient records when the peer refuses the link's token: revoked or ended there. */
+const REJECTED_LINK = "no longer accepts this link";
+
+const urlsAreBridge = (link: PeerLinkSummary, ports: ReadonlyArray<number>) =>
+  link.urls.length > 0 && link.urls.every((url) => isHostBridgeUrl(url, ports));
+
+export const bridgePorts = (state: DesktopHostBridgeState): ReadonlyArray<number> =>
+  state.urls.flatMap((url) => {
+    const port = Number(URL.parse(url)?.port);
+    return Number.isInteger(port) && port > 0 ? [port] : [];
+  });
+
+/**
+ * The card's state, from the Desktop's helper and the WSL backend's own link
+ * list. A port that answers is never enough: Connected needs the native link.
+ */
+export function localHostBridgeView(input: {
+  readonly desktop: DesktopHostBridgeState | null;
+  readonly wslEnvironmentId: EnvironmentId | null;
+  /** Whether the WSL backend's server can link through the bridge; null while unknown. */
+  readonly wslSupportsBridge: boolean | null;
+  /** The WSL backend's links; null while loading. */
+  readonly links: ReadonlyArray<PeerLinkSummary> | null;
+  readonly now: DateTime.Utc;
+}): LocalHostBridgeView {
+  const view = (
+    status: LocalHostBridgeStatus,
+    rest: Partial<Omit<LocalHostBridgeView, "status">> = {},
+  ): LocalHostBridgeView => ({
+    status,
+    link: null,
+    staleLink: null,
+    pairingReason: null,
+    detail: null,
+    runtimeLacksBridge: false,
+    ...rest,
+  });
+  const { desktop } = input;
+  if (desktop === null) return view("unsupported");
+  const ports = bridgePorts(desktop);
+  const windowsId = desktop.windowsEnvironmentId;
+  const link =
+    windowsId === null || input.links === null
+      ? null
+      : (input.links.find(
+          (candidate) => candidate.environmentId === windowsId && urlsAreBridge(candidate, ports),
+        ) ?? null);
+  const staleLink =
+    input.links === null
+      ? null
+      : (input.links.find(
+          (candidate) =>
+            urlsAreBridge(candidate, ports) &&
+            (windowsId === null
+              ? desktop.pairedEnvironmentId !== null &&
+                candidate.environmentId !== desktop.pairedEnvironmentId
+              : candidate.environmentId !== windowsId),
+        ) ?? null);
+  const known = { link, staleLink, detail: desktop.detail };
+  if (!desktop.enabled) return view("disabled", known);
+  switch (desktop.phase) {
+    case "disabled":
+    case "unsupported":
+    case "waiting-windows":
+    case "waiting-wsl":
+    case "identity-mismatch":
+      return view(desktop.phase, known);
+    default:
+      break;
+  }
+  if (input.wslSupportsBridge === false) {
+    return view("unsupported", { ...known, detail: null, runtimeLacksBridge: true });
+  }
+  if (input.wslEnvironmentId === null || windowsId === null || input.links === null) {
+    return view("discovering", known);
+  }
+  if (link === null) {
+    return staleLink !== null
+      ? view("identity-mismatch", known)
+      : view("pairing-required", { ...known, pairingReason: "unlinked" });
+  }
+  if (desktop.phase === "starting") return view("starting", known);
+  if (desktop.phase === "recovering") return view("recovering", known);
+  const health = peerLinkHealth(link, input.now);
+  switch (health.kind) {
+    case "expired":
+      return view("pairing-required", { ...known, pairingReason: "expired" });
+    case "failing":
+      return health.detail.includes(REJECTED_LINK)
+        ? view("permission-denied", { ...known, detail: health.detail })
+        : view("recovering", { ...known, detail: health.detail });
+    case "unreachable":
+      return view("recovering", { ...known, detail: health.detail });
+    case "reachable":
+      return view("connected", known);
+  }
+}
diff --git a/apps/web/src/components/settings/LocalHostBridgeSettings.tsx b/apps/web/src/components/settings/LocalHostBridgeSettings.tsx
new file mode 100644
index 0000000000..bde5553d36
--- /dev/null
+++ b/apps/web/src/components/settings/LocalHostBridgeSettings.tsx
@@ -0,0 +1,528 @@
+import type {
+  AuthMcpClientAccess,
+  DesktopBridge,
+  DesktopHostBridgeSetInput,
+  DesktopHostBridgeState,
+  EnvironmentId,
+} from "@t3tools/contracts";
+import { linkRequestFailureMessage } from "@t3tools/client-runtime/link-request";
+import { squashAtomCommandFailure } from "@t3tools/client-runtime/state/runtime";
+import * as DateTime from "effect/DateTime";
+import * as Result from "effect/Result";
+import { useGT } from "gt-react";
+import { useEffect, useRef, useState } from "react";
+
+import { requestConfirmDialog } from "~/confirmDialog";
+import { desktopLocalBackendId } from "~/connection/desktopLocal";
+import { isWindowsPlatform } from "~/lib/utils";
+import { useServerConfigs } from "~/state/entities";
+import { useEnvironments } from "~/state/environments";
+import { peerLinkEnvironment } from "~/state/peerLinks";
+import { mintPairingCodeOn } from "~/state/peerPairingCode";
+import { useEnvironmentQuery } from "~/state/query";
+import { useAtomCommand } from "~/state/use-atom-command";
+import { useLiveRefresh } from "../../hooks/useLiveRefresh";
+import { useNowMinute } from "../../hooks/useNowMinute";
+import { m as resolveMessage } from "../../i18n/messages";
+import { Button } from "../ui/button";
+import { toastManager } from "../ui/toast";
+import { LinkAccessPicker } from "./LinkAccessPicker";
+import { localHostBridgeView, type LocalHostBridgeStatus } from "./LocalHostBridge.logic";
+import { SettingsRow, SettingsSection } from "./settingsLayout";
+import { useSearchableSetting } from "./settingsSearch";
+
+type HostBridgeDesktop = Required<Pick<DesktopBridge, "getHostBridgeState" | "setHostBridge">>;
+
+const POLL_MS = 2_000;
+const NONE = "-";
+const LINKS_REFRESH_MS = 15_000;
+/** How long Enable waits for the helper to listen before giving up on pairing. */
+const HELPER_START_TIMEOUT_MS = 30_000;
+
+function hostBridgeDesktop(): HostBridgeDesktop | null {
+  if (typeof window === "undefined") return null;
+  const bridge = window.desktopBridge;
+  if (bridge?.getHostBridgeState === undefined || bridge.setHostBridge === undefined) return null;
+  return { getHostBridgeState: bridge.getHostBridgeState, setHostBridge: bridge.setHostBridge };
+}
+
+/** The card for linking this computer's WSL backend to its own Windows backend. */
+export function LocalHostBridgeSettings() {
+  const desktop = hostBridgeDesktop();
+  if (desktop === null || !isWindowsPlatform(navigator.platform)) return null;
+  return <LocalHostBridgeCard desktop={desktop} />;
+}
+
+function useHostBridgeState(desktop: HostBridgeDesktop) {
+  const [state, setState] = useState<DesktopHostBridgeState | null>(null);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- polls the Desktop's bridge supervisor over IPC while the card is mounted; it has no change event.
+  useEffect(() => {
+    let cancelled = false;
+    const read = () =>
+      desktop.getHostBridgeState().then(
+        (next) => {
+          if (!cancelled) setState(next);
+        },
+        () => undefined,
+      );
+    void read();
+    const timer = window.setInterval(() => void read(), POLL_MS);
+    return () => {
+      cancelled = true;
+      window.clearInterval(timer);
+    };
+  }, [desktop]);
+  return [state, setState] as const;
+}
+
+function LocalHostBridgeCard({ desktop }: { readonly desktop: HostBridgeDesktop }) {
+  const gt = useGT();
+  const searchableSetting = useSearchableSetting();
+  const search = searchableSetting("local-host-bridge");
+  const [state, setState] = useHostBridgeState(desktop);
+  const { environments } = useEnvironments();
+  const wsl =
+    environments.find(
+      (environment) => desktopLocalBackendId(environment.entry.target)?.startsWith("wsl:") === true,
+    ) ?? null;
+  const wslId = wsl?.environmentId ?? null;
+  const serverConfigs = useServerConfigs();
+  const wslConfig = wslId === null ? undefined : serverConfigs.get(wslId);
+  const wslSupportsBridge =
+    wslConfig === undefined ? null : wslConfig.environment.capabilities.hostBridgeLinks === true;
+  const links = useEnvironmentQuery(
+    wslId === null ? null : peerLinkEnvironment.list({ environmentId: wslId, input: {} }),
+  );
+  // Listing asks the Windows backend through the bridge, so it runs only while the card shows.
+  useLiveRefresh(
+    () => {
+      if (!links.isPending) links.refresh();
+    },
+    {
+      key: `local-host-bridge:${wslId ?? "none"}`,
+      intervalMs: LINKS_REFRESH_MS,
+      refreshOnShow: true,
+    },
+  );
+  const nowMinute = useNowMinute();
+  const view = localHostBridgeView({
+    desktop: state,
+    wslEnvironmentId: wslId,
+    wslSupportsBridge,
+    links: links.data?.links ?? null,
+    now: DateTime.makeUnsafe(nowMinute),
+  });
+  // The link's own level until the user picks another.
+  const [accessChoice, setAccess] = useState<AuthMcpClientAccess | null>(null);
+  const access = accessChoice ?? view.link?.access ?? "approval-required";
+  const [busy, setBusy] = useState(false);
+  const inFlight = useRef(false);
+  const link = useAtomCommand(peerLinkEnvironment.link, {
+    label: "link through the local host bridge",
+    // The failure cause holds the request, and with it the pairing code.
+    reportFailure: false,
+    reportDefect: false,
+  });
+  const unlink = useAtomCommand(peerLinkEnvironment.unlink, {
+    label: "forget the local host bridge link",
+  });
+
+  if (state === null) return null;
+  const windowsLabel = state.windowsLabel ?? gt("Windows");
+  const wslLabel = wsl?.label ?? gt("WSL");
+
+  const failed = (title: string, description: string) =>
+    toastManager.add({ type: "error", title, description });
+
+  const set = async (input: DesktopHostBridgeSetInput) => {
+    const next = await desktop.setHostBridge(input);
+    setState(next);
+    return next;
+  };
+
+  /** Waits for the helper to listen, so the pairing code only goes out through the bridge. */
+  const helperListening = async () => {
+    const deadline = Date.now() + HELPER_START_TIMEOUT_MS;
+    while (Date.now() < deadline) {
+      const next = await desktop.getHostBridgeState();
+      setState(next);
+      if (next.url !== null && next.windowsEnvironmentId !== null) return next;
+      if (next.phase === "unsupported" || next.phase === "identity-mismatch") return null;
+      await new Promise((resolve) => window.setTimeout(resolve, 500));
+    }
+    return null;
+  };
+
+  const run = async (task: () => Promise<void>) => {
+    if (inFlight.current) return;
+    inFlight.current = true;
+    setBusy(true);
+    try {
+      await task();
+    } finally {
+      inFlight.current = false;
+      setBusy(false);
+      links.refresh();
+    }
+  };
+
+  /** The user's click is the approval: a code is minted on Windows and spent on this link only. */
+  const pair = (chosen: AuthMcpClientAccess) =>
+    run(async () => {
+      if (wslId === null) return;
+      const ready = await helperListening();
+      if (ready === null || ready.windowsEnvironmentId === null) {
+        failed(
+          gt("The local host bridge did not start"),
+          ready?.detail ?? state.lastError ?? gt("Open the diagnostics for details."),
+        );
+        return;
+      }
+      const windowsId = ready.windowsEnvironmentId as EnvironmentId;
+      const code = await mintPairingCodeOn(windowsId, chosen);
+      if (Result.isFailure(code)) {
+        failed(
+          gt("Could not get a pairing code from {windows}", { windows: windowsLabel }),
+          linkRequestFailureMessage(code.failure, resolveMessage),
+        );
+        return;
+      }
+      const [url, ...alternateUrls] = ready.urls;
+      if (url === undefined) return;
+      const result = await link({
+        environmentId: wslId,
+        input: {
+          url,
+          ...(alternateUrls.length > 0 ? { alternateUrls } : {}),
+          pairingCode: code.success,
+          access: chosen,
+          expectedEnvironmentId: windowsId,
+          expectedLabel: ready.windowsLabel ?? windowsLabel,
+          sameHostBridge: true,
+        },
+      });
+      if (result._tag !== "Success") {
+        failed(
+          gt("Could not link through the local host bridge"),
+          String(squashAtomCommandFailure(result)),
+        );
+        return;
+      }
+      await set({ enabled: true, environmentId: windowsId });
+      toastManager.add({
+        type: "success",
+        title: gt("{wsl} can now delegate work to {windows}", {
+          wsl: wslLabel,
+          windows: result.value.label,
+        }),
+      });
+    });
+
+  const confirmPair = async (chosen: AuthMcpClientAccess) => {
+    const confirmed = await requestConfirmDialog(
+      gt(
+        "Link {wsl} to {windows} on this computer? Agents in WSL can then start work on Windows, up to the access you picked. Windows keeps its own sign-ins, sandbox and approvals.",
+        { wsl: wslLabel, windows: windowsLabel },
+      ),
+    );
+    if (confirmed === true) await pair(chosen);
+  };
+
+  const enable = () =>
+    run(async () => {
+      await set({ enabled: true });
+    });
+
+  const disable = () =>
+    run(async () => {
+      await set({ enabled: false });
+    });
+
+  const revoke = async () => {
+    const target = view.link ?? view.staleLink;
+    const confirmed = await requestConfirmDialog(
+      gt(
+        "Revoke the link from {wsl} to {windows}? Agents in WSL can no longer start work on Windows, and the bridge turns off. It is not paired again until you pair it.",
+        { wsl: wslLabel, windows: target?.label ?? windowsLabel },
+      ),
+      { variant: "destructive" },
+    );
+    if (confirmed !== true) return;
+    await run(async () => {
+      if (wslId !== null && target !== null) {
+        const result = await unlink({
+          environmentId: wslId,
+          input: { environmentId: target.environmentId },
+        });
+        if (result._tag !== "Success") {
+          failed(gt("Could not revoke the link"), String(squashAtomCommandFailure(result)));
+          return;
+        }
+      }
+      await set({ enabled: false, environmentId: null });
+    });
+  };
+
+  /** A new Windows identity is used only after the user says so; the old link goes first. */
+  const repairIdentity = async () => {
+    const confirmed = await requestConfirmDialog(
+      gt(
+        "The Windows backend now answers as a different environment than the one this bridge was paired with. Forget the old link and pair with {windows}?",
+        { windows: windowsLabel },
+      ),
+    );
+    if (confirmed !== true) return;
+    await run(async () => {
+      if (wslId !== null && view.staleLink !== null) {
+        await unlink({
+          environmentId: wslId,
+          input: { environmentId: view.staleLink.environmentId },
+        });
+      }
+      await set({ enabled: true, environmentId: null });
+    });
+    await pair(access);
+  };
+
+  const statusText = statusLabel(view.status, gt);
+  const description = statusDescription(view, state, gt, { wsl: wslLabel, windows: windowsLabel });
+  const control = (() => {
+    switch (view.status) {
+      case "unsupported":
+        return null;
+      case "disabled":
+        return view.link === null ? (
+          <Button
+            size="sm"
+            disabled={busy || wslId === null}
+            onClick={() => void confirmPair(access)}
+          >
+            {gt("Enable and pair")}
+          </Button>
+        ) : (
+          <Button size="sm" disabled={busy} onClick={() => void enable()}>
+            {gt("Enable")}
+          </Button>
+        );
+      case "pairing-required":
+      case "permission-denied":
+        return (
+          <Button size="sm" disabled={busy} onClick={() => void confirmPair(access)}>
+            {view.pairingReason === "unlinked" ? gt("Pair") : gt("Pair again")}
+          </Button>
+        );
+      case "identity-mismatch":
+        return (
+          <Button size="sm" disabled={busy} onClick={() => void repairIdentity()}>
+            {gt("Review and pair")}
+          </Button>
+        );
+      default:
+        return null;
+    }
+  })();
+
+  return (
+    <SettingsSection id={search.id} title={search.title}>
+      <SettingsRow
+        title={
+          <span className="flex items-center gap-2">
+            <StatusDot status={view.status} />
+            {statusText}
+          </span>
+        }
+        description={description}
+        control={control}
+      />
+      {view.status !== "unsupported" ? (
+        <SettingsRow
+          title={gt("Access for WSL agents on Windows")}
+          description={
+            view.link !== null && view.link.access !== access
+              ? gt("Changing it pairs again at the new level.")
+              : gt("The most a WSL agent may do there. Windows still asks for its own approvals.")
+          }
+          control={
+            <div className="flex items-center gap-2">
+              <LinkAccessPicker value={access} onChange={setAccess} disabled={busy} />
+              {view.link !== null && view.link.access !== access ? (
+                <Button
+                  size="sm"
+                  variant="outline"
+                  disabled={busy}
+                  onClick={() => void confirmPair(access)}
+                >
+                  {gt("Apply")}
+                </Button>
+              ) : null}
+            </div>
+          }
+        />
+      ) : null}
+      {state.enabled || view.link !== null || view.staleLink !== null ? (
+        <SettingsRow
+          title={gt("Turn off or revoke")}
+          description={gt(
+            "Turning it off keeps the link for later. Revoking ends the link on both sides.",
+          )}
+          control={
+            <div className="flex items-center gap-2">
+              {state.enabled ? (
+                <Button size="sm" variant="outline" disabled={busy} onClick={() => void disable()}>
+                  {gt("Disable")}
+                </Button>
+              ) : null}
+              {view.link !== null || view.staleLink !== null ? (
+                <Button
+                  size="sm"
+                  variant="destructive-outline"
+                  disabled={busy}
+                  onClick={() => void revoke()}
+                >
+                  {gt("Revoke")}
+                </Button>
+              ) : null}
+            </div>
+          }
+        />
+      ) : null}
+      <SettingsRow title={gt("Diagnostics")}>
+        <Diagnostics state={state} linkUrl={view.link?.urls ?? null} />
+      </SettingsRow>
+    </SettingsSection>
+  );
+}
+
+type Gt = ReturnType<typeof useGT>;
+
+function statusLabel(status: LocalHostBridgeStatus, gt: Gt): string {
+  switch (status) {
+    case "unsupported":
+      return gt("Not available");
+    case "disabled":
+      return gt("Disabled");
+    case "discovering":
+      return gt("Discovering");
+    case "waiting-windows":
+      return gt("Waiting for Windows backend");
+    case "waiting-wsl":
+      return gt("Waiting for WSL backend");
+    case "starting":
+      return gt("Bridge starting");
+    case "pairing-required":
+      return gt("Pairing required");
+    case "connected":
+      return gt("Connected");
+    case "recovering":
+      return gt("Recovering");
+    case "permission-denied":
+      return gt("Permission denied");
+    case "identity-mismatch":
+      return gt("Identity mismatch");
+  }
+}
+
+function statusDescription(
+  view: ReturnType<typeof localHostBridgeView>,
+  state: DesktopHostBridgeState,
+  gt: Gt,
+  names: { readonly wsl: string; readonly windows: string },
+): string {
+  switch (view.status) {
+    case "connected":
+      return gt(
+        "Agents in {wsl} can delegate work that needs Windows to {windows}, through T3's own linked environments.",
+        names,
+      );
+    case "disabled":
+      return view.link === null
+        ? gt(
+            "Lets agents in {wsl} hand work that needs Windows, such as a browser or PowerShell, to {windows} on this computer. Nothing leaves this computer.",
+            names,
+          )
+        : gt("The link to {windows} is kept; enabling the bridge needs no pairing.", names);
+    case "pairing-required":
+      return view.pairingReason === "expired"
+        ? gt("The link expired after a month unused. Pair again to keep using it.")
+        : gt("The bridge is up, but {wsl} is not linked to {windows} yet.", names);
+    case "permission-denied":
+      return gt(
+        "{windows} no longer accepts this link: it was revoked there. It is not paired again until you pair it.",
+        names,
+      );
+    case "identity-mismatch":
+      return gt(
+        "The Windows backend answers as a different environment than the one paired. The bridge is paused until you confirm.",
+      );
+    case "unsupported":
+      return view.runtimeLacksBridge
+        ? gt(
+            "The WSL backend runs a T3 Code runtime without the host bridge. Rebuild the customized app.",
+          )
+        : (state.detail ?? gt("Needs T3 Code for Windows with its WSL backend turned on."));
+    default:
+      return view.detail ?? state.detail ?? state.lastError ?? "";
+  }
+}
+
+function StatusDot({ status }: { readonly status: LocalHostBridgeStatus }) {
+  const color =
+    status === "connected"
+      ? "bg-success"
+      : status === "permission-denied" || status === "identity-mismatch"
+        ? "bg-destructive"
+        : status === "disabled" || status === "unsupported"
+          ? "bg-muted-foreground/40"
+          : "bg-warning";
+  return <span aria-hidden className={`inline-block size-2 shrink-0 rounded-full ${color}`} />;
+}
+
+function Diagnostics({
+  state,
+  linkUrl,
+}: {
+  readonly state: DesktopHostBridgeState;
+  readonly linkUrl: ReadonlyArray<string> | null;
+}) {
+  const gt = useGT();
+  const rows: Array<readonly [string, string]> = [
+    [gt("Helper"), state.phase],
+    [gt("Listening on (WSL loopback)"), state.url ?? NONE],
+    [gt("Link addresses"), (linkUrl ?? state.urls).join(", ")],
+    [
+      gt("Windows environment"),
+      state.windowsEnvironmentId === null
+        ? NONE
+        : `${state.windowsLabel ?? ""} ${state.windowsEnvironmentId}`.trim(),
+    ],
+    [
+      gt("Windows backend port (Windows loopback)"),
+      state.windowsPort === null ? NONE : String(state.windowsPort),
+    ],
+    [gt("WSL distro"), state.wslDistro ?? NONE],
+    [gt("WSL runtime"), state.wslRuntimeId ?? NONE],
+    [gt("WSL networking"), state.wslNetworking ?? NONE],
+    [gt("Helper process"), state.helperPid === null ? NONE : String(state.helperPid)],
+    [gt("Restarts"), String(state.restarts)],
+    [
+      gt("Streams open / total / refused"),
+      `${state.streams.open} / ${state.streams.total} / ${state.streams.refused}`,
+    ],
+    [gt("Next retry"), state.nextRetryAt ?? NONE],
+    [gt("Last error"), state.lastError ?? NONE],
+    [gt("Since"), state.since],
+  ];
+  return (
+    <details className="mt-1 text-xs">
+      <summary className="cursor-pointer text-muted-foreground">{gt("Show details")}</summary>
+      <dl className="mt-2 grid grid-cols-[minmax(0,14rem)_minmax(0,1fr)] gap-x-3 gap-y-1">
+        {rows.map(([label, value]) => (
+          <div key={label} className="contents">
+            <dt className="text-muted-foreground">{label}</dt>
+            <dd className="break-all font-mono">{value}</dd>
+          </div>
+        ))}
+      </dl>
+    </details>
+  );
+}
