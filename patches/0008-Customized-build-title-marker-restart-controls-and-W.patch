index 0000000000..358283626a
--- /dev/null
+++ b/apps/desktop/src/app/DesktopRestart.test.ts
@@ -0,0 +1,91 @@
+import { assert, describe, it } from "@effect/vitest";
+
+import {
+  buildWslRuntimeKillCommand,
+  CUSTOMIZE_RELAUNCH_ENV,
+  resolveRelaunchCommand,
+  WSL_RUNTIME_KILL_SCRIPT,
+} from "./DesktopRestart.ts";
+
+const script = "C:\\Users\\me\\t3code-customize\\launch.ps1";
+const resolve = (overrides: Partial<Parameters<typeof resolveRelaunchCommand>[0]> = {}) =>
+  resolveRelaunchCommand({
+    platform: "win32",
+    env: { [CUSTOMIZE_RELAUNCH_ENV]: script },
+    pid: 4242,
+    fileExists: (path) => path === script,
+    ...overrides,
+  });
+
+describe("resolveRelaunchCommand", () => {
+  it("relaunches through the customization launcher, which waits for this process", () => {
+    assert.deepStrictEqual(resolve(), {
+      kind: "launcher",
+      command: "powershell.exe",
+      args: [
+        "-NoProfile",
+        "-NonInteractive",
+        "-WindowStyle",
+        "Hidden",
+        "-ExecutionPolicy",
+        "Bypass",
+        "-File",
+        script,
+        "-WaitPid",
+        "4242",
+      ],
+    });
+  });
+
+  it("falls back to Electron's relaunch without the launcher variable", () => {
+    assert.deepStrictEqual(resolve({ env: {} }), { kind: "electron" });
+    assert.deepStrictEqual(resolve({ env: { [CUSTOMIZE_RELAUNCH_ENV]: "  " } }), {
+      kind: "electron",
+    });
+  });
+
+  it("falls back off Windows", () => {
+    assert.deepStrictEqual(resolve({ platform: "linux" }), { kind: "electron" });
+    assert.deepStrictEqual(resolve({ platform: "darwin" }), { kind: "electron" });
+  });
+
+  it("falls back when the launcher script is missing", () => {
+    assert.deepStrictEqual(resolve({ fileExists: () => false }), { kind: "electron" });
+  });
+});
+
+describe("buildWslRuntimeKillCommand", () => {
+  const runtimeDir = "/home/me/.t3/wsl-runtime/sha256-0123abcd";
+
+  it("passes the runtime directory as a positional argument, never inside the script", () => {
+    const command = buildWslRuntimeKillCommand({
+      runningDistro: "Ubuntu",
+      wslRuntimeDir: runtimeDir,
+    });
+    assert.deepStrictEqual(command, {
+      command: "wsl.exe",
+      args: ["-d", "Ubuntu", "-e", "sh", "-c", WSL_RUNTIME_KILL_SCRIPT, "sh", runtimeDir],
+    });
+    assert.isFalse(WSL_RUNTIME_KILL_SCRIPT.includes("sha256-"));
+    assert.isTrue(WSL_RUNTIME_KILL_SCRIPT.includes('"$dir"/*'));
+  });
+
+  it("keeps an odd path as one argument", () => {
+    const odd = "/home/me/it's $(here)/sha256-1";
+    assert.strictEqual(
+      buildWslRuntimeKillCommand({ runningDistro: "Ubuntu", wslRuntimeDir: odd })?.args.at(-1),
+      odd,
+    );
+  });
+
+  it("skips backends that are not WSL or whose runtime is unknown", () => {
+    assert.isNull(buildWslRuntimeKillCommand({}));
+    assert.isNull(buildWslRuntimeKillCommand({ wslRuntimeDir: runtimeDir }));
+    assert.isNull(buildWslRuntimeKillCommand({ runningDistro: " ", wslRuntimeDir: runtimeDir }));
+    assert.isNull(buildWslRuntimeKillCommand({ runningDistro: "Ubuntu" }));
+    assert.isNull(
+      buildWslRuntimeKillCommand({ runningDistro: "Ubuntu", wslRuntimeDir: "relative" }),
+    );
+    assert.isNull(buildWslRuntimeKillCommand({ runningDistro: "Ubuntu", wslRuntimeDir: "/" }));
+  });
+});
diff --git a/apps/desktop/src/app/DesktopRestart.ts b/apps/desktop/src/app/DesktopRestart.ts
new file mode 100644
index 0000000000..2111b93472
--- /dev/null
+++ b/apps/desktop/src/app/DesktopRestart.ts
@@ -0,0 +1,149 @@
+// @effect-diagnostics nodeBuiltinImport:off - Detached launcher spawn and synchronous tree kills on the way out.
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFS from "node:fs";
+
+/** Set by the customization launcher to its `launch.ps1`, which opens whichever build is current. */
+export const CUSTOMIZE_RELAUNCH_ENV = "T3CODE_CUSTOMIZE_RELAUNCH";
+
+export type RelaunchCommand =
+  | { readonly kind: "electron" }
+  | { readonly kind: "launcher"; readonly command: string; readonly args: ReadonlyArray<string> };
+
+/** Electron's relaunch reuses this build's executable; the launcher picks up a rebuilt one. */
+export function resolveRelaunchCommand(input: {
+  readonly platform: NodeJS.Platform;
+  readonly env: Readonly<Record<string, string | undefined>>;
+  readonly pid: number;
+  readonly fileExists: (path: string) => boolean;
+}): RelaunchCommand {
+  const script = input.env[CUSTOMIZE_RELAUNCH_ENV]?.trim();
+  if (input.platform !== "win32" || !script || !input.fileExists(script)) {
+    return { kind: "electron" };
+  }
+  return {
+    kind: "launcher",
+    command: "powershell.exe",
+    args: [
+      "-NoProfile",
+      "-NonInteractive",
+      "-WindowStyle",
+      "Hidden",
+      "-ExecutionPolicy",
+      "Bypass",
+      "-File",
+      script,
+      "-WaitPid",
+      String(input.pid),
+    ],
+  };
+}
+
+export const currentRelaunchCommand = (platform: NodeJS.Platform): RelaunchCommand =>
+  resolveRelaunchCommand({
+    platform,
+    env: process.env,
+    pid: process.pid,
+    fileExists: (path) => NodeFS.existsSync(path),
+  });
+
+/** The launcher waits for this process to exit, so it must outlive it. */
+export function spawnLauncher(command: Extract<RelaunchCommand, { kind: "launcher" }>): void {
+  NodeChildProcess.spawn(command.command, [...command.args], {
+    detached: true,
+    stdio: "ignore",
+    windowsHide: true,
+  }).unref();
+}
+
+const isAlive = (pid: number): boolean => {
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (error) {
+    return error instanceof Error && "code" in error && error.code === "EPERM";
+  }
+};
+
+/**
+ * Kills backend processes that are still running, with their children on Windows (taskkill /T
+ * walks the tree of a live root, so it must run before the root exits). For the WSL backend the
+ * root is wsl.exe; the server inside the distro stops itself once its launcher is gone.
+ */
+export function forceStopProcessTrees(
+  pids: ReadonlyArray<number>,
+  platform: NodeJS.Platform,
+): ReadonlyArray<number> {
+  const killed = pids.filter((pid) => Number.isInteger(pid) && pid > 0 && isAlive(pid));
+  for (const pid of killed) {
+    if (platform === "win32") {
+      NodeChildProcess.spawnSync("taskkill", ["/PID", String(pid), "/T", "/F"], {
+        windowsHide: true,
+        stdio: "ignore",
+        timeout: 5_000,
+      });
+    } else {
+      try {
+        process.kill(pid, "SIGKILL");
+      } catch {}
+    }
+  }
+  return killed;
+}
+
+/**
+ * Runs in the distro with the runtime directory as $1: SIGKILLs every process whose executable (or
+ * argv[0]) lies inside that directory, descendants first. The directory is per runtime archive
+ * hash, so a stock install's runtime never matches.
+ */
+export const WSL_RUNTIME_KILL_SCRIPT = [
+  'dir="${1%/}"',
+  'case "$dir" in /?*) ;; *) exit 0 ;; esac',
+  '[ -d "$dir" ] || exit 0',
+  "children() {",
+  "  for stat in /proc/[0-9]*/stat; do",
+  '    line=$(cat "$stat" 2>/dev/null) || continue',
+  "    set -- ${line##*) }",
+  '    [ "$2" = "$target" ] && { p=${stat#/proc/}; printf "%s\\n" "${p%/stat}"; }',
+  "  done",
+  "}",
+  "kill_tree() {",
+  '  for child in $(target=$1; children); do kill_tree "$child"; done',
+  '  kill -9 "$1" 2>/dev/null',
+  "}",
+  "for proc in /proc/[0-9]*; do",
+  "  pid=${proc#/proc/}",
+  '  [ "$pid" = "$$" ] && continue',
+  '  exe=$(readlink "$proc/exe" 2>/dev/null) ||',
+  "    exe=$(tr '\\0' '\\n' 2>/dev/null < \"$proc/cmdline\" | head -n 1)",
+  '  case "$exe" in "$dir"/*) kill_tree "$pid" ;; esac',
+  "done",
+].join("\n");
+
+/** The in-distro kill for a WSL backend, or null when it is not one or its runtime is unknown. */
+export function buildWslRuntimeKillCommand(config: {
+  readonly runningDistro?: string | undefined;
+  readonly wslRuntimeDir?: string | undefined;
+}): { readonly command: string; readonly args: ReadonlyArray<string> } | null {
+  const distro = config.runningDistro?.trim();
+  const runtimeDir = config.wslRuntimeDir;
+  if (!distro || runtimeDir === undefined || !runtimeDir.startsWith("/") || runtimeDir === "/") {
+    return null;
+  }
+  // The path travels as a positional argument; it is never spliced into the script.
+  return {
+    command: "wsl.exe",
+    args: ["-d", distro, "-e", "sh", "-c", WSL_RUNTIME_KILL_SCRIPT, "sh", runtimeDir],
+  };
+}
+
+/** Best effort: a stuck distro must not hold the restart. */
+export function runWslRuntimeKill(command: {
+  readonly command: string;
+  readonly args: ReadonlyArray<string>;
+}): void {
+  NodeChildProcess.spawnSync(command.command, [...command.args], {
+    windowsHide: true,
+    stdio: "ignore",
+    timeout: 5_000,
+  });
+}
