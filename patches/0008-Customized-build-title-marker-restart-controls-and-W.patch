diff --git a/apps/web/src/components/settings/WslRuntimeStatus.tsx b/apps/web/src/components/settings/WslRuntimeStatus.tsx
new file mode 100644
index 0000000000..0c62471597
--- /dev/null
+++ b/apps/web/src/components/settings/WslRuntimeStatus.tsx
@@ -0,0 +1,147 @@
+import { T, useGT, Var } from "gt-react";
+import { useState } from "react";
+
+import {
+  refreshDesktopWslRuntimeStatus,
+  useDesktopWslRuntimeStatus,
+} from "../../state/desktopWslRuntimeStatus";
+import { refreshDesktopWslState } from "../../state/desktopWslState";
+import { cn } from "../../lib/utils";
+import { Button } from "../ui/button";
+import { describeWslRuntimeStatus, type WslRuntimeStatusDisplay } from "./wslRuntimeStatus.logic";
+
+function useWslRuntimeDisplay(): WslRuntimeStatusDisplay {
+  const reading = useDesktopWslRuntimeStatus();
+  return describeWslRuntimeStatus(reading?.status ?? null, reading?.readAt ?? 0);
+}
+
+/** "Installing runtime · 1m 12s", "Running · runtime sha256-a95e31… · v0.1.12", or the failure. */
+function useWslRuntimeText() {
+  const gt = useGT();
+  return (display: WslRuntimeStatusDisplay): string | null => {
+    switch (display.kind) {
+      case "hidden":
+        return null;
+      case "ready":
+        return [
+          gt("Running", { $context: "WSL backend status" }),
+          ...(display.runtime ? [gt("runtime {runtime}", { runtime: display.runtime })] : []),
+          ...(display.version ? [`v${display.version}`] : []),
+        ].join(" · ");
+      case "failed":
+        return gt("WSL backend couldn't start");
+      case "progress": {
+        const phase = {
+          probing: gt("Checking the WSL runtime"),
+          installing: gt("Installing runtime"),
+          starting: gt("Starting server"),
+          waiting_ready: gt("Waiting for server to be ready"),
+        }[display.phase];
+        return `${phase} · ${display.elapsed}`;
+      }
+    }
+  };
+}
+
+function ProgressBar() {
+  // The install reports no byte counts, so the bar shows activity rather than a fraction.
+  return (
+    <span
+      aria-hidden
+      className="mt-1 block h-[3px] w-full max-w-64 overflow-hidden rounded-full bg-foreground/10"
+    >
+      <span className="block h-full w-1/3 animate-pulse rounded-full bg-primary/70" />
+    </span>
+  );
+}
+
+/** The WSL backend's runtime status under its Settings row and in the map's detail panel. */
+export function WslRuntimeStatusLine({
+  legacyError = null,
+  className,
+}: {
+  /** Shown as before when the desktop cannot report runtime status. */
+  legacyError?: string | null;
+  className?: string;
+}) {
+  const gt = useGT();
+  const display = useWslRuntimeDisplay();
+  const text = useWslRuntimeText()(display);
+  const [retrying, setRetrying] = useState(false);
+  if (display.kind === "hidden") {
+    return legacyError ? (
+      <span className={cn("block text-destructive", className)}>
+        <T>
+          WSL backend couldn't start: <Var>{legacyError}</Var>
+        </T>
+      </span>
+    ) : null;
+  }
+  if (display.kind === "failed") {
+    const setEnabled = window.desktopBridge?.setWslBackendEnabled;
+    return (
+      <span role="status" className={cn("block space-y-1", className)}>
+        <span className="block text-destructive">
+          {display.error ? `${text}: ${display.error}` : text}
+        </span>
+        {display.canRetry && setEnabled ? (
+          <Button
+            size="xs"
+            variant="outline"
+            disabled={retrying}
+            onClick={() => {
+              setRetrying(true);
+              // Already on: this only re-runs the reconcile, which retries a stopped WSL backend.
+              void setEnabled(true)
+                .catch(() => {})
+                .finally(() => {
+                  setRetrying(false);
+                  refreshDesktopWslState();
+                  refreshDesktopWslRuntimeStatus();
+                });
+            }}
+          >
+            {gt("Retry", { $context: "retry starting the WSL backend" })}
+          </Button>
+        ) : (
+          <span className="block text-muted-foreground">
+            {gt("Fix the cause, then use Restart in Settings > About to try again.")}
+          </span>
+        )}
+      </span>
+    );
+  }
+  return (
+    <span
+      role="status"
+      className={cn(
+        "block tabular-nums",
+        display.kind === "ready" ? "text-muted-foreground" : "text-foreground/80",
+        className,
+      )}
+    >
+      {text}
+      {display.kind === "progress" ? <ProgressBar /> : null}
+    </span>
+  );
+}
+
+/**
+ * For the environments map: which backend is the WSL one, and the card subtitle while it comes up
+ * (null once it settles). Called once per map, not per card.
+ */
+export function useWslRuntimeCardStatus(): {
+  readonly instanceId: string | null;
+  readonly text: string | null;
+  readonly inProgress: boolean;
+} {
+  const reading = useDesktopWslRuntimeStatus();
+  const display = describeWslRuntimeStatus(reading?.status ?? null, reading?.readAt ?? 0);
+  const text = useWslRuntimeText()(display);
+  const shown = display.kind === "progress" || display.kind === "failed";
+  return {
+    instanceId: reading?.status.instanceId ?? null,
+    text: shown ? text : null,
+    inProgress: display.kind === "progress",
+  };
+}
