new file mode 100644
index 0000000000..47f0652f9a
--- /dev/null
+++ b/apps/desktop/src/ipc/methods/restart.ts
@@ -0,0 +1,66 @@
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+
+import * as DesktopEnvironment from "../../app/DesktopEnvironment.ts";
+import * as DesktopLifecycle from "../../app/DesktopLifecycle.ts";
+import {
+  buildWslRuntimeKillCommand,
+  forceStopProcessTrees,
+  runWslRuntimeKill,
+} from "../../app/DesktopRestart.ts";
+import * as DesktopBackendPool from "../../backend/DesktopBackendPool.ts";
+import * as IpcChannels from "../channels.ts";
+import { makeIpcMethod } from "../DesktopIpc.ts";
+
+// A hung backend gets this long to stop on its own before its process tree is killed.
+const HARD_RESTART_GRACE = Duration.seconds(3);
+
+export const restartApp = makeIpcMethod({
+  channel: IpcChannels.RESTART_APP_CHANNEL,
+  payload: Schema.Literals(["graceful", "hard"]),
+  result: Schema.Void,
+  handler: Effect.fn("desktop.ipc.restart.restartApp")(function* (mode) {
+    const lifecycle = yield* DesktopLifecycle.DesktopLifecycle;
+    if (mode === "graceful") {
+      yield* lifecycle.relaunch("restart requested");
+      return;
+    }
+    const { platform } = yield* DesktopEnvironment.DesktopEnvironment;
+    // Read before shutdown starts: a stopping backend forgets its process.
+    const pool = yield* DesktopBackendPool.DesktopBackendPool;
+    const instances = yield* pool.list;
+    const pids = yield* Effect.forEach(instances, (instance) =>
+      instance.snapshot.pipe(Effect.map((snapshot) => Option.getOrNull(snapshot.activePid))),
+    );
+    const roots = pids.filter((pid) => pid !== null);
+    // WSL servers live in the distro, out of taskkill's reach; each is keyed by its own runtime dir.
+    const wslKills = yield* Effect.forEach(instances, (instance) =>
+      instance.currentConfig.pipe(
+        Effect.map((config) =>
+          Option.isSome(config) ? buildWslRuntimeKillCommand(config.value) : null,
+        ),
+      ),
+    );
+    yield* lifecycle.relaunch("hard restart requested", {
+      forceStop: {
+        after: HARD_RESTART_GRACE,
+        run: Effect.sync(() => {
+          const killed = forceStopProcessTrees(roots, platform);
+          for (const command of wslKills) if (command !== null) runWslRuntimeKill(command);
+          return killed;
+        }).pipe(
+          Effect.flatMap((killed) =>
+            Effect.logInfo("force-stopped backend processes", {
+              pids: killed,
+              wslRuntimes: wslKills.flatMap((command) =>
+                command === null ? [] : [command.args.at(-1)],
+              ),
+            }),
+          ),
+        ),
+      },
+    });
+  }),
+});
