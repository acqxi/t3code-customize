From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: acqxi <kacqxi@gmail.com>
Date: Fri, 27 Nov 2026 01:27:43 +0800
Subject: [PATCH 8/8] Mark the customized build in window titles and About

Window titles end with " (Customized)" and Settings > About shows
"(Customized)" next to the version, so this build is never mistaken for
a stock install. Titles only: productName, appId, AppUserModelId, the
userData path and updates keep the stock names.
---
 apps/desktop/src/window/DesktopWindow.ts              | 11 ++++++++---
 apps/web/src/appInit.tsx                              |  6 +++---
 apps/web/src/branding.ts                              |  3 +++
 .../web/src/components/settings/AboutVersionTitle.tsx |  3 ++-
 4 files changed, 16 insertions(+), 7 deletions(-)

diff --git a/apps/desktop/src/window/DesktopWindow.ts b/apps/desktop/src/window/DesktopWindow.ts
index 2b2401f42d..73dca0031f 100644
--- a/apps/desktop/src/window/DesktopWindow.ts
+++ b/apps/desktop/src/window/DesktopWindow.ts
@@ -236,6 +236,11 @@ function normalBoundsOnWindowDisplay(
   };
 }
 
+// Window titles only: the app name, app id and data paths stay stock.
+function customizedWindowTitle(displayName: string): string {
+  return `${displayName} (Customized)`;
+}
+
 function readDisplayBoundsOrEmpty(): readonly DisplayBounds[] {
   try {
     return Electron.screen.getAllDisplays().map((display) => display.bounds);
@@ -498,7 +503,7 @@ export const make = Effect.gen(function* () {
       ...(environment.platform === "darwin" ? { disableAutoHideCursor: true } : {}),
       backgroundColor: getInitialWindowBackgroundColor(shouldUseDarkColors),
       ...iconOption,
-      title: environment.displayName,
+      title: customizedWindowTitle(environment.displayName),
       ...getWindowTitleBarOptions(shouldUseDarkColors, environment.platform),
       webPreferences: {
         preload: environment.preloadPath,
@@ -872,7 +877,7 @@ export const make = Effect.gen(function* () {
     window.on("page-title-updated", (event, title) => {
       if (title.trim() !== "") return;
       event.preventDefault();
-      window.setTitle(environment.displayName);
+      window.setTitle(customizedWindowTitle(environment.displayName));
     });
     window.on("resize", scheduleBoundsPersist);
     window.on("move", scheduleBoundsPersist);
@@ -1151,7 +1156,7 @@ export const make = Effect.gen(function* () {
       show: false,
       skipTaskbar: false,
       backgroundColor: getInitialWindowBackgroundColor(shouldUseDarkColors),
-      title: environment.displayName,
+      title: customizedWindowTitle(environment.displayName),
       webPreferences: {
         contextIsolation: true,
         nodeIntegration: false,
diff --git a/apps/web/src/appInit.tsx b/apps/web/src/appInit.tsx
index df7cd77df4..6715b9ea72 100644
--- a/apps/web/src/appInit.tsx
+++ b/apps/web/src/appInit.tsx
@@ -28,7 +28,7 @@ import { startDesktopUpdateLaunchNotice } from "./components/sidebar/updateEvery
 import { startSlowRpcRequestToasts } from "./components/SlowRpcRequestToastCoordinator";
 import { startThreadNotifications } from "./components/ThreadNotificationCoordinator";
 import { startGuideRunNotifications } from "./components/pullRequest/guide/PullRequestGuideRunCoordinator";
-import { APP_BASE_NAME, APP_DISPLAY_NAME, APP_STAGE_LABEL } from "./branding";
+import { APP_BASE_NAME, APP_DISPLAY_NAME, APP_STAGE_LABEL, CUSTOM_BUILD_LABEL } from "./branding";
 import { resolveServerBackedAppDisplayName, resolveWindowTitle } from "./branding.logic";
 import { isElectron } from "./env";
 import {
@@ -170,7 +170,7 @@ function startDocumentTitle(router: AppRouter): void {
               scopeProjectRef(thread.environmentId, thread.projectId),
             ),
           );
-    const title = resolveWindowTitle({
+    const title = `${resolveWindowTitle({
       appDisplayName: resolveServerBackedAppDisplayName({
         baseName: APP_BASE_NAME,
         fallbackDisplayName: APP_DISPLAY_NAME,
@@ -186,7 +186,7 @@ function startDocumentTitle(router: AppRouter): void {
         },
       }),
       desktop: isElectron,
-    });
+    })} (${CUSTOM_BUILD_LABEL})`;
     // Projects change whenever any project does; most changes leave the title alone.
     if (document.title !== title) document.title = title;
   };
diff --git a/apps/web/src/branding.ts b/apps/web/src/branding.ts
index bf5b76f0dd..0e767494a6 100644
--- a/apps/web/src/branding.ts
+++ b/apps/web/src/branding.ts
@@ -30,6 +30,9 @@ export const APP_DISPLAY_NAME =
   injectedDesktopAppBranding?.displayName ??
   formatAppDisplayName({ baseName: APP_BASE_NAME, stageLabel: APP_STAGE_LABEL });
 export const APP_VERSION = import.meta.env.APP_VERSION || "0.0.0";
+// Marks this patched build, so it is never mistaken for a stock install. Identity only: data
+// paths, app ids and updates still use the stock names.
+export const CUSTOM_BUILD_LABEL = "Customized";
 export const DESKTOP_DOWNLOAD_URL = "https://t3.codes/download";
 // Redirects to the App Store or Google Play to match the phone that opens it.
 export const MOBILE_APP_URL = "https://t3.codes/mobile";
diff --git a/apps/web/src/components/settings/AboutVersionTitle.tsx b/apps/web/src/components/settings/AboutVersionTitle.tsx
index e8e3fd654e..245222f39a 100644
