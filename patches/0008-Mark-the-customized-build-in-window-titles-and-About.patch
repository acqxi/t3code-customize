 import { useCopyToClipboard } from "../../hooks/useCopyToClipboard";
 import { InlineButton } from "../ui/button";
 import { stackedThreadToast, toastManager } from "../ui/toast";
@@ -48,6 +48,7 @@ export function AboutVersionTitle() {
           </TooltipPopup>
         </Tooltip>
       </code>
+      <span className="text-2xs font-medium text-muted-foreground">({CUSTOM_BUILD_LABEL})</span>
     </span>
   );
 }
