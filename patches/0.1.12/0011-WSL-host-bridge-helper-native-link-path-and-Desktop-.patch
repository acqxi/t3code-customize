+/**
+ * WSL host bridge framing: WSL loopback connections ride the helper's stdio to the Desktop.
+ * Frames carry streams, never addresses, so the helper cannot choose where one goes.
+ * Frame: type (u8), stream id (u32), payload length (u32), payload.
+ */
+
+export const HOST_BRIDGE_PROTOCOL_VERSION = 1;
+
+export const FrameType = {
+  /** Helper → Desktop, once: JSON `HostBridgeHello`. */
+  hello: 0,
+  /** Helper → Desktop: a connection was accepted on loopback. */
+  open: 1,
+  data: 2,
+  /** The sender will write no more on this stream (TCP half-close). */
+  end: 3,
+  /** The stream is gone on the sender's side. */
+  close: 4,
+  /** u32: bytes the receiver has written out, which the sender may send again. */
+  credit: 5,
+} as const;
+export type FrameType = (typeof FrameType)[keyof typeof FrameType];
+
+export const FRAME_HEADER_BYTES = 9;
+/** A data frame never exceeds this; larger payloads are split. */
+export const MAX_DATA_PAYLOAD = 64 * 1024;
+/** Anything longer is a protocol error, not a slow stream. */
+export const MAX_FRAME_PAYLOAD = 1024 * 1024;
+/** Bytes in flight per stream and direction before the sender pauses its socket. */
+export const STREAM_WINDOW_BYTES = 256 * 1024;
+/** Caps memory at STREAM_WINDOW_BYTES per stream; more connections are refused. */
+export const MAX_STREAMS = 128;
+
+export type HostBridgeHello =
+  | {
+      readonly ok: true;
+      readonly version: number;
+      readonly port: number;
+      readonly pid: number;
+    }
+  | {
+      readonly ok: false;
+      readonly version: number;
+      readonly code: "ports_in_use" | "bad_arguments" | "listen_failed";
+      readonly message: string;
+    };
+
+export interface Frame {
+  readonly type: FrameType;
+  readonly stream: number;
+  readonly payload: Uint8Array;
+}
+
+const EMPTY = new Uint8Array(0);
+
+export const encodeFrame = (type: FrameType, stream: number, payload: Uint8Array = EMPTY) => {
+  const frame = new Uint8Array(FRAME_HEADER_BYTES + payload.byteLength);
+  const view = new DataView(frame.buffer);
+  view.setUint8(0, type);
+  view.setUint32(1, stream);
+  view.setUint32(5, payload.byteLength);
+  frame.set(payload, FRAME_HEADER_BYTES);
+  return frame;
+};
+
+export const encodeCredit = (stream: number, bytes: number) => {
+  const payload = new Uint8Array(4);
+  new DataView(payload.buffer).setUint32(0, bytes);
+  return encodeFrame(FrameType.credit, stream, payload);
+};
+
+export const encodeHello = (hello: HostBridgeHello) =>
+  encodeFrame(FrameType.hello, 0, new TextEncoder().encode(JSON.stringify(hello)));
+
+export const decodeHello = (payload: Uint8Array): HostBridgeHello | undefined => {
+  try {
+    const value: unknown = JSON.parse(new TextDecoder().decode(payload));
+    if (typeof value !== "object" || value === null || !("ok" in value)) return undefined;
+    return value as HostBridgeHello;
+  } catch {
+    return undefined;
+  }
+};
+
+/** A peer that sends something this protocol cannot read is broken, not slow. */
+const protocolError = (message: string) =>
+  Object.assign(new globalThis.Error(message), { name: "HostBridgeProtocolError" });
+
+/** Splits a byte stream into frames, whatever the chunking. */
+export class FrameDecoder {
+  private buffered: Uint8Array = EMPTY;
+
+  push(chunk: Uint8Array): Array<Frame> {
+    let bytes = this.buffered.byteLength === 0 ? chunk : concat(this.buffered, chunk);
+    const frames: Array<Frame> = [];
+    while (bytes.byteLength >= FRAME_HEADER_BYTES) {
+      const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+      const type = view.getUint8(0);
+      const length = view.getUint32(5);
+      if (type > FrameType.credit) throw protocolError(`unknown frame type ${type}`);
+      if (length > MAX_FRAME_PAYLOAD) throw protocolError("frame too large");
+      if (bytes.byteLength < FRAME_HEADER_BYTES + length) break;
+      frames.push({
+        type: type as FrameType,
+        stream: view.getUint32(1),
+        // Copied: the socket write keeps the buffer after this chunk is reused.
+        payload: bytes.slice(FRAME_HEADER_BYTES, FRAME_HEADER_BYTES + length),
+      });
+      bytes = bytes.subarray(FRAME_HEADER_BYTES + length);
+    }
+    this.buffered = bytes.byteLength === 0 ? EMPTY : bytes.slice();
+    return frames;
+  }
+}
+
+const concat = (left: Uint8Array, right: Uint8Array) => {
+  const joined = new Uint8Array(left.byteLength + right.byteLength);
+  joined.set(left, 0);
+  joined.set(right, left.byteLength);
+  return joined;
+};
+
+/** The part of a Node socket a stream needs; tests pass fakes. */
+export interface StreamSocket {
+  write(data: Uint8Array, callback: (error?: Error | null) => void): unknown;
+  end(): unknown;
+  destroy(): unknown;
+  pause(): unknown;
+  resume(): unknown;
+  on(event: "data", listener: (chunk: Uint8Array) => void): unknown;
+  on(event: "end", listener: () => void): unknown;
+  on(event: "close", listener: () => void): unknown;
+  on(event: "error", listener: (error: Error) => void): unknown;
+}
+
+interface StreamState {
+  readonly socket: StreamSocket;
+  /** Sent and not yet credited by the other side. */
+  inFlight: number;
+  paused: boolean;
+  closed: boolean;
+}
+
+export interface MuxStats {
+  readonly open: number;
+  readonly total: number;
+  readonly refused: number;
+}
+
+export interface HostBridgeMuxHandlers {
+  /** Desktop side: the helper accepted a connection; return its socket, or undefined to refuse. */
+  readonly onOpen?: (stream: number) => StreamSocket | undefined;
+  readonly onHello?: (hello: HostBridgeHello) => void;
+  readonly onProtocolError?: (error: Error) => void;
+}
+
+/**
+ * One end of the bridge. `write` sends bytes to the other end; `receive`
+ * takes the other end's bytes. Each attached socket is one stream.
+ */
+export class HostBridgeMux {
+  private readonly decoder = new FrameDecoder();
+  private readonly streams = new Map<number, StreamState>();
+  private nextStream = 1;
+  private total = 0;
+  private refused = 0;
+  private stopped = false;
+  private readonly write: (bytes: Uint8Array) => void;
+  private readonly handlers: HostBridgeMuxHandlers;
+
+  constructor(write: (bytes: Uint8Array) => void, handlers: HostBridgeMuxHandlers = {}) {
+    this.write = write;
+    this.handlers = handlers;
+  }
+
+  get stats(): MuxStats {
+    return { open: this.streams.size, total: this.total, refused: this.refused };
+  }
+
+  /** Helper side: carry a newly accepted connection to the other end. */
+  accept(socket: StreamSocket): number | undefined {
+    if (this.stopped || this.streams.size >= MAX_STREAMS) {
+      this.refused += 1;
+      socket.destroy();
+      return undefined;
+    }
+    const stream = this.nextStream;
+    this.nextStream = this.nextStream >= 0xffff_ffff ? 1 : this.nextStream + 1;
+    this.write(encodeFrame(FrameType.open, stream));
+    this.attach(stream, socket);
+    return stream;
+  }
+
+  receive(chunk: Uint8Array): void {
+    if (this.stopped) return;
+    let frames: Array<Frame>;
+    try {
+      frames = this.decoder.push(chunk);
+    } catch (error) {
+      this.stop();
+      this.handlers.onProtocolError?.(error as Error);
+      return;
+    }
+    for (const frame of frames) this.handle(frame);
+  }
+
+  /** Ends every stream; later frames are ignored. */
+  stop(): void {
+    this.stopped = true;
+    for (const [stream, state] of this.streams) {
+      state.closed = true;
+      state.socket.destroy();
+      this.streams.delete(stream);
+    }
+  }
+
+  private handle(frame: Frame): void {
+    switch (frame.type) {
+      case FrameType.hello: {
+        const hello = decodeHello(frame.payload);
+        if (hello === undefined) {
+          this.handlers.onProtocolError?.(protocolError("unreadable hello"));
+          return;
+        }
+        this.handlers.onHello?.(hello);
+        return;
+      }
+      case FrameType.open: {
+        if (this.streams.has(frame.stream)) return;
+        const socket =
+          this.streams.size < MAX_STREAMS ? this.handlers.onOpen?.(frame.stream) : undefined;
+        if (socket === undefined) {
+          this.refused += 1;
+          this.write(encodeFrame(FrameType.close, frame.stream));
+          return;
+        }
+        this.attach(frame.stream, socket);
+        return;
+      }
+      case FrameType.data: {
+        const state = this.streams.get(frame.stream);
+        if (state === undefined || state.closed) return;
+        const length = frame.payload.byteLength;
+        state.socket.write(frame.payload, (error) => {
+          if (error === undefined || error === null) {
+            this.write(encodeCredit(frame.stream, length));
+          }
+        });
+        return;
+      }
+      case FrameType.end: {
+        this.streams.get(frame.stream)?.socket.end();
+        return;
+      }
+      case FrameType.close: {
+        const state = this.streams.get(frame.stream);
+        if (state === undefined) return;
+        // The other side is gone: nothing is sent back for this stream.
+        state.closed = true;
+        this.streams.delete(frame.stream);
+        state.socket.destroy();
+        return;
+      }
+      case FrameType.credit: {
+        const state = this.streams.get(frame.stream);
+        if (state === undefined || frame.payload.byteLength !== 4) return;
+        const bytes = new DataView(frame.payload.buffer, frame.payload.byteOffset).getUint32(0);
+        state.inFlight = Math.max(0, state.inFlight - bytes);
+        if (state.paused && state.inFlight < STREAM_WINDOW_BYTES) {
+          state.paused = false;
+          state.socket.resume();
+        }
+        return;
+      }
+    }
+  }
+
+  private attach(stream: number, socket: StreamSocket): void {
+    const state: StreamState = { socket, inFlight: 0, paused: false, closed: false };
+    this.streams.set(stream, state);
+    this.total += 1;
+    socket.on("data", (chunk) => {
+      if (state.closed) return;
+      for (let offset = 0; offset < chunk.byteLength; offset += MAX_DATA_PAYLOAD) {
+        const part = chunk.subarray(offset, offset + MAX_DATA_PAYLOAD);
+        this.write(encodeFrame(FrameType.data, stream, part));
+        state.inFlight += part.byteLength;
+      }
+      if (!state.paused && state.inFlight >= STREAM_WINDOW_BYTES) {
+        state.paused = true;
+        socket.pause();
+      }
+    });
+    socket.on("end", () => {
+      if (!state.closed) this.write(encodeFrame(FrameType.end, stream));
+    });
+    socket.on("error", () => {
+      // "close" follows and reports the stream gone.
+    });
+    socket.on("close", () => {
+      if (state.closed) return;
+      state.closed = true;
+      this.streams.delete(stream);
+      if (!this.stopped) this.write(encodeFrame(FrameType.close, stream));
+    });
+  }
+}
+
+/** The loopback ports a bridge may listen on, in order: a squatted first port moves it, never the link. */
+export const HOST_BRIDGE_DEFAULT_PORTS: ReadonlyArray<number> = [13773, 13774, 13775];
+
+export const hostBridgeUrls = (ports: ReadonlyArray<number> = HOST_BRIDGE_DEFAULT_PORTS) =>
+  ports.map((port) => `http://127.0.0.1:${port}`);
+
+/** Whether a link address is one of this bridge's loopback addresses. */
+export const isHostBridgeUrl = (
+  url: string,
+  ports: ReadonlyArray<number> = HOST_BRIDGE_DEFAULT_PORTS,
+) => {
+  const parsed = URL.parse(url);
+  return (
+    parsed !== null &&
+    parsed.protocol === "http:" &&
+    parsed.hostname === "127.0.0.1" &&
+    ports.includes(Number(parsed.port))
+  );
+};
