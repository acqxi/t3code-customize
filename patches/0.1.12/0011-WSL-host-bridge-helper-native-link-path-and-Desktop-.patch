+++ b/apps/desktop/src/hostBridge/hostBridgePlan.test.ts
@@ -0,0 +1,207 @@
+import { describe, expect, it } from "@effect/vitest";
+
+import {
+  backoffDelayMs,
+  BACKOFF_MAX_MS,
+  helperLaunchFromBackend,
+  launchKey,
+  planBridge,
+  wslNetworkingOf,
+  type BridgeObservation,
+  type HelperStatus,
+} from "./hostBridgePlan.ts";
+
+const backendArgs = [
+  "-d",
+  "TestDistro",
+  "--cd",
+  "~",
+  "--exec",
+  "env",
+  "PATH=/usr/bin:/bin",
+  "T3CODE_HOME=/home/tester/.t3",
+  "/home/tester/.t3/wsl-runtime/sha256-abc/t3",
+  "--bootstrap-fd",
+  "0",
+];
+const launch = helperLaunchFromBackend({
+  args: backendArgs,
+  env: { WSLENV: "T3CODE_DESKTOP_HOST_SCOPE/u" },
+  extendEnv: false,
+})!;
+
+const ready: BridgeObservation = {
+  enabled: true,
+  platform: "win32",
+  wslOnly: false,
+  pairedEnvironmentId: null,
+  windows: { ready: true, port: 3773, environmentId: "env-windows", error: null },
+  wsl: { ready: true, launch },
+};
+const idle: HelperStatus = {
+  runningKey: null,
+  listening: false,
+  nextRetryAt: null,
+  lastError: null,
+};
+
+describe("helperLaunchFromBackend", () => {
+  it("runs the helper exactly where the WSL backend runs, in place of its bootstrap", () => {
+    expect(launch.args).toEqual([
+      "-d",
+      "TestDistro",
+      "--cd",
+      "~",
+      "--exec",
+      "env",
+      "PATH=/usr/bin:/bin",
+      "T3CODE_HOME=/home/tester/.t3",
+      "/home/tester/.t3/wsl-runtime/sha256-abc/t3",
+      "__host-bridge",
+      "--ports",
+      "13773,13774,13775",
+    ]);
+    expect(launch.extendEnv).toBe(false);
+  });
+
+  it("works for a mounted server tree started with node, and the dev URL is dropped", () => {
+    const dev = helperLaunchFromBackend({
+      args: [
+        "--cd",
+        "~",
+        "--exec",
+        "env",
+        "PATH=/x",
+        "/n/node",
+        "/m/bin.mjs",
+        "--bootstrap-fd",
+        "0",
+        "--dev-url",
+        "http://localhost:5173/",
+      ],
+      env: {},
+      extendEnv: false,
+    });
+    expect(dev?.args.slice(-5)).toEqual([
+      "/n/node",
+      "/m/bin.mjs",
+      "__host-bridge",
+      "--ports",
+      "13773,13774,13775",
+    ]);
+  });
+
+  it("has nothing to run for a failed preflight", () => {
+    expect(
+      helperLaunchFromBackend({
+        args: ["-d", "X", "--", "node", "--version"],
+        env: {},
+        extendEnv: false,
+      }),
+    ).toBeUndefined();
+  });
+});
+
+describe("planBridge", () => {
+  it("does nothing until the user turns it on", () => {
+    expect(planBridge({ ...ready, enabled: false }, idle, 0)).toEqual({
+      action: "stop",
+      phase: "disabled",
+      detail: null,
+    });
+  });
+
+  it("is unsupported off Windows and in WSL-only mode", () => {
+    expect(planBridge({ ...ready, platform: "linux" }, idle, 0)).toMatchObject({
+      action: "stop",
+      phase: "unsupported",
+    });
+    expect(planBridge({ ...ready, wslOnly: true }, idle, 0)).toMatchObject({
+      action: "stop",
+      phase: "unsupported",
+    });
+  });
+
+  it("waits for the Windows backend and its identity, then for WSL", () => {
+    expect(
+      planBridge({ ...ready, windows: { ...ready.windows, ready: false } }, idle, 0),
+    ).toMatchObject({ phase: "waiting-windows" });
+    expect(
+      planBridge(
+        { ...ready, windows: { ...ready.windows, environmentId: null, error: "no answer" } },
+        idle,
+        0,
+      ),
+    ).toEqual({ action: "stop", phase: "waiting-windows", detail: "no answer" });
+    expect(planBridge({ ...ready, wsl: null }, idle, 0)).toMatchObject({ phase: "waiting-wsl" });
+    expect(planBridge({ ...ready, wsl: { ready: false, launch } }, idle, 0)).toMatchObject({
+      phase: "waiting-wsl",
+    });
+    expect(
+      planBridge({ ...ready, wsl: { ready: true, launch: undefined } }, idle, 0),
+    ).toMatchObject({ phase: "waiting-wsl" });
+  });
+
+  it("pauses when Windows answers as an environment other than the one paired", () => {
+    expect(planBridge({ ...ready, pairedEnvironmentId: "env-old" }, idle, 0)).toMatchObject({
+      action: "stop",
+      phase: "identity-mismatch",
+    });
+    expect(planBridge({ ...ready, pairedEnvironmentId: "env-windows" }, idle, 0)).toMatchObject({
+      action: "start",
+    });
+  });
+
+  it("starts once, keeps a running helper and restarts it when the WSL runtime changes", () => {
+    const started = planBridge(ready, idle, 0);
+    expect(started).toEqual({ action: "start", launch, key: launchKey(launch) });
+    const running = { ...idle, runningKey: launchKey(launch) };
+    expect(planBridge(ready, running, 0)).toEqual({
+      action: "keep",
+      phase: "starting",
+      detail: null,
+    });
+    expect(planBridge(ready, { ...running, listening: true }, 0)).toMatchObject({
+      action: "keep",
+      phase: "running",
+    });
+    const moved = helperLaunchFromBackend({
+      args: backendArgs.map((arg) => arg.replace("sha256-abc", "sha256-def")),
+      env: {},
+      extendEnv: false,
+    })!;
+    expect(planBridge({ ...ready, wsl: { ready: true, launch: moved } }, running, 0)).toMatchObject(
+      { action: "start", key: launchKey(moved) },
+    );
+  });
+
+  it("backs off after a failure instead of restarting in a loop", () => {
+    const failed = { ...idle, nextRetryAt: 5_000, lastError: "exit 1" };
+    expect(planBridge(ready, failed, 4_999)).toEqual({
+      action: "wait",
+      phase: "recovering",
+      detail: "exit 1",
+    });
+    expect(planBridge(ready, failed, 5_000)).toMatchObject({ action: "start" });
+  });
+});
+
+describe("backoffDelayMs", () => {
+  it("doubles from a second up to a minute", () => {
+    expect([0, 1, 2, 3, 10].map(backoffDelayMs)).toEqual([
+      1_000,
+      2_000,
+      4_000,
+      8_000,
+      BACKOFF_MAX_MS,
+    ]);
+    expect(backoffDelayMs(-1)).toBe(1_000);
+  });
+});
+
+describe("wslNetworkingOf", () => {
+  it("reads mirrored networking from a loopback WSL address", () => {
+    expect(wslNetworkingOf(new URL("http://127.0.0.1:3774"))).toBe("mirrored");
+    expect(wslNetworkingOf(new URL("http://192.0.2.10:3774"))).toBe("nat");
+  });
+});
