+// @effect-diagnostics nodeBuiltinImport:off -- Streams are checked end to end over real loopback sockets.
+import * as NodeCrypto from "node:crypto";
+import * as NodeNet from "node:net";
+
+import { afterEach, describe, expect, it } from "vite-plus/test";
+
+import {
+  encodeFrame,
+  encodeHello,
+  FrameDecoder,
+  FrameType,
+  HostBridgeMux,
+  hostBridgeUrls,
+  isHostBridgeUrl,
+  MAX_DATA_PAYLOAD,
+  MAX_STREAMS,
+  STREAM_WINDOW_BYTES,
+  type HostBridgeHello,
+  type StreamSocket,
+} from "./hostBridgeMux.ts";
+
+describe("FrameDecoder", () => {
+  it("reassembles frames split at any byte", () => {
+    const bytes = new Uint8Array([
+      ...encodeFrame(FrameType.open, 7),
+      ...encodeFrame(FrameType.data, 7, new Uint8Array([1, 2, 3])),
+      ...encodeFrame(FrameType.end, 7),
+    ]);
+    const decoder = new FrameDecoder();
+    const frames = [];
+    for (const byte of bytes) frames.push(...decoder.push(new Uint8Array([byte])));
+    expect(frames.map((frame) => [frame.type, frame.stream, [...frame.payload]])).toEqual([
+      [FrameType.open, 7, []],
+      [FrameType.data, 7, [1, 2, 3]],
+      [FrameType.end, 7, []],
+    ]);
+  });
+
+  it("refuses unknown types and oversized frames", () => {
+    const unknown = encodeFrame(FrameType.data, 1);
+    unknown[0] = 99;
+    expect(() => new FrameDecoder().push(unknown)).toThrow(/unknown frame type/);
+    const huge = encodeFrame(FrameType.data, 1);
+    new DataView(huge.buffer).setUint32(5, 2 * 1024 * 1024);
+    expect(() => new FrameDecoder().push(huge)).toThrow(/too large/);
+  });
+});
+
+describe("host bridge urls", () => {
+  it("only counts the bridge's own loopback ports", () => {
+    expect(hostBridgeUrls([13773, 13774])).toEqual([
+      "http://127.0.0.1:13773",
+      "http://127.0.0.1:13774",
+    ]);
+    expect(isHostBridgeUrl("http://127.0.0.1:13774")).toBe(true);
+    expect(isHostBridgeUrl("http://127.0.0.1:3773")).toBe(false);
+    expect(isHostBridgeUrl("https://127.0.0.1:13773")).toBe(false);
+    expect(isHostBridgeUrl("http://192.0.2.1:13773")).toBe(false);
+    expect(isHostBridgeUrl("http://localhost:13773")).toBe(false);
+    expect(isHostBridgeUrl("not a url")).toBe(false);
+  });
+});
+
+/** A helper mux and a Desktop mux wired back to back, as stdio would carry them. */
+const cleanups: Array<() => void> = [];
+afterEach(() => {
+  for (const cleanup of cleanups.splice(0)) cleanup();
+});
+
+const listen = (server: NodeNet.Server) =>
+  new Promise<number>((resolve) =>
+    server.listen(0, "127.0.0.1", () => resolve((server.address() as NodeNet.AddressInfo).port)),
+  );
+
+const bridge = async (target: NodeNet.Server) => {
+  const targetPort = await listen(target);
+  let helper!: HostBridgeMux;
+  let hello: HostBridgeHello | undefined;
+  // Delivery is asynchronous, like a pipe, so one side never re-enters the other.
+  const desktop = new HostBridgeMux((bytes) => setImmediate(() => helper.receive(bytes)), {
+    onOpen: () => NodeNet.connect({ host: "127.0.0.1", port: targetPort, allowHalfOpen: true }),
+    onHello: (value) => {
+      hello = value;
+    },
+  });
+  helper = new HostBridgeMux((bytes) => setImmediate(() => desktop.receive(bytes)));
+  const front = NodeNet.createServer({ allowHalfOpen: true }, (socket) => helper.accept(socket));
+  const port = await listen(front);
+  cleanups.push(() => {
+    helper.stop();
+    desktop.stop();
+    front.close();
+    target.close();
+  });
+  return { port, helper, desktop, hello: () => hello };
+};
+
+const exchange = (port: number, request: Uint8Array) =>
+  new Promise<Uint8Array>((resolve, reject) => {
+    const socket = NodeNet.connect({ host: "127.0.0.1", port, allowHalfOpen: true });
+    const chunks: Array<Buffer> = [];
+    socket.on("data", (chunk: Buffer) => chunks.push(chunk));
+    socket.on("end", () => {
+      socket.end();
+      resolve(new Uint8Array(Buffer.concat(chunks)));
+    });
+    socket.on("error", reject);
+    socket.end(request);
+  });
+
+const echoServer = () =>
+  NodeNet.createServer({ allowHalfOpen: true }, (socket) => {
+    socket.pipe(socket);
+  });
+
+describe("HostBridgeMux", () => {
+  it("carries bytes both ways, intact, with half-close", async () => {
+    const { port } = await bridge(echoServer());
+    const payload = new Uint8Array(NodeCrypto.randomBytes(3 * STREAM_WINDOW_BYTES + 17));
+    const echoed = await exchange(port, payload);
+    expect(echoed.byteLength).toBe(payload.byteLength);
+    expect(Buffer.compare(Buffer.from(echoed), Buffer.from(payload))).toBe(0);
+  });
+
+  it("keeps concurrent streams apart", async () => {
+    const { port, helper } = await bridge(echoServer());
+    const payloads = Array.from(
+      { length: 12 },
+      (_, index) => new Uint8Array(NodeCrypto.randomBytes(MAX_DATA_PAYLOAD + index * 1000)),
+    );
+    const echoed = await Promise.all(payloads.map((payload) => exchange(port, payload)));
+    echoed.forEach((bytes, index) =>
+      expect(Buffer.compare(Buffer.from(bytes), Buffer.from(payloads[index]!))).toBe(0),
+    );
+    expect(helper.stats.total).toBe(12);
+  });
+
+  it("closes the client when the Desktop cannot reach the target", async () => {
+    const target = NodeNet.createServer();
+    const { port } = await bridge(target);
+    await new Promise((resolve) => target.close(resolve));
+    const result = await new Promise<string>((resolve) => {
+      const socket = NodeNet.connect({ host: "127.0.0.1", port });
+      socket.on("close", () => resolve("closed"));
+      socket.on("error", () => undefined);
+      socket.resume();
+    });
+    expect(result).toBe("closed");
+  });
+
+  it("pauses a sender that outruns its window until credit returns", () => {
+    const written: Array<Uint8Array> = [];
+    const mux = new HostBridgeMux((bytes) => written.push(bytes));
+    const listeners = new Map<string, (value?: unknown) => void>();
+    let paused = 0;
+    let resumed = 0;
+    const socket = {
+      write: () => true,
+      end: () => undefined,
+      destroy: () => undefined,
+      pause: () => {
+        paused += 1;
+      },
+      resume: () => {
+        resumed += 1;
+      },
+      on: (event: string, listener: (value?: unknown) => void) => listeners.set(event, listener),
+    };
+    const stream = mux.accept(socket as unknown as StreamSocket)!;
+    listeners.get("data")!(new Uint8Array(STREAM_WINDOW_BYTES));
+    expect(paused).toBe(1);
+    const credit = new Uint8Array(4);
+    new DataView(credit.buffer).setUint32(0, STREAM_WINDOW_BYTES);
+    mux.receive(encodeFrame(FrameType.credit, stream, credit));
+    expect(resumed).toBe(1);
+  });
+
+  it("refuses streams past the cap and when the Desktop declines", () => {
+    const written: Array<Uint8Array> = [];
+    const desktop = new HostBridgeMux((bytes) => written.push(bytes), {
+      onOpen: () => undefined,
+    });
+    desktop.receive(encodeFrame(FrameType.open, 5));
+    const [close] = new FrameDecoder().push(written[0]!);
+    expect(close).toMatchObject({ type: FrameType.close, stream: 5 });
+    expect(desktop.stats.refused).toBe(1);
+
+    const helper = new HostBridgeMux(() => undefined);
+    const fake = () => ({
+      write: () => true,
+      end: () => undefined,
+      destroy: () => undefined,
+      pause: () => undefined,
+      resume: () => undefined,
+      on: () => undefined,
+    });
+    for (let index = 0; index < MAX_STREAMS; index++) helper.accept(fake());
+    expect(helper.accept(fake())).toBeUndefined();
+    expect(helper.stats).toMatchObject({ open: MAX_STREAMS, refused: 1 });
+  });
+
+  it("reports the helper's hello and stops on garbage", () => {
+    const hellos: Array<HostBridgeHello> = [];
+    const errors: Array<Error> = [];
+    const mux = new HostBridgeMux(() => undefined, {
+      onHello: (hello) => hellos.push(hello),
+      onProtocolError: (error) => errors.push(error),
+    });
+    mux.receive(encodeHello({ ok: true, version: 1, port: 13774, pid: 42 }));
+    expect(hellos).toEqual([{ ok: true, version: 1, port: 13774, pid: 42 }]);
+    mux.receive(new Uint8Array([200, 0, 0, 0, 0, 0, 0, 0, 0]));
+    expect(errors).toHaveLength(1);
+  });
+});
