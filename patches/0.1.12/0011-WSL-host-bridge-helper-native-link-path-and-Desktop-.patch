--- /dev/null
+++ b/apps/desktop/src/hostBridge/DesktopHostBridge.test.ts
@@ -0,0 +1,331 @@
+import { assert, describe, it } from "@effect/vitest";
+import { encodeHello } from "@t3tools/shared/hostBridgeMux";
+import * as Deferred from "effect/Deferred";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Sink from "effect/Sink";
+import * as Stream from "effect/Stream";
+import * as TestClock from "effect/testing/TestClock";
+import { HttpClient, HttpClientResponse } from "effect/http";
+import { ChildProcessSpawner } from "effect/process";
+
+import * as DesktopEnvironment from "../app/DesktopEnvironment.ts";
+import * as DesktopBackendPool from "../backend/DesktopBackendPool.ts";
+import * as ElectronPowerMonitor from "../electron/ElectronPowerMonitor.ts";
+import * as DesktopAppSettings from "../settings/DesktopAppSettings.ts";
+import * as DesktopHostBridge from "./DesktopHostBridge.ts";
+
+const wslArgs = [
+  "-d",
+  "TestDistro",
+  "--cd",
+  "~",
+  "--exec",
+  "env",
+  "PATH=/usr/bin",
+  "/home/tester/.t3/wsl-runtime/sha256-abc/t3",
+  "--bootstrap-fd",
+  "0",
+];
+
+interface Fixture {
+  primaryReady: boolean;
+  wslReady: boolean;
+  windowsEnvironmentId: string;
+  /** Each spawn's args, and a way to end that helper with an exit code. */
+  readonly spawns: Array<{
+    readonly args: ReadonlyArray<string>;
+    readonly exit: Deferred.Deferred<number>;
+  }>;
+}
+
+const instance = (
+  id: string,
+  ready: () => boolean,
+  config: Record<string, unknown>,
+): DesktopBackendPool.DesktopBackendInstance =>
+  ({
+    id,
+    currentConfig: Effect.sync(() => Option.some(config)),
+    snapshot: Effect.sync(() => ({
+      desiredRunning: true,
+      ready: ready(),
+      activePid: Option.none(),
+      restartAttempt: 0,
+      restartScheduled: false,
+    })),
+  }) as unknown as DesktopBackendPool.DesktopBackendInstance;
+
+const layerFor = (
+  fixture: Fixture,
+  settings: Partial<DesktopAppSettings.DesktopSettings>,
+  platform: NodeJS.Platform = "win32",
+) =>
+  DesktopHostBridge.layer.pipe(
+    Layer.provide(
+      Layer.mergeAll(
+        DesktopAppSettings.layerTest({
+          ...DesktopAppSettings.DEFAULT_DESKTOP_SETTINGS,
+          ...settings,
+        }),
+        Layer.succeed(DesktopBackendPool.DesktopBackendPool, {
+          list: Effect.sync(() => [
+            instance(DesktopBackendPool.PRIMARY_INSTANCE_ID, () => fixture.primaryReady, {
+              httpBaseUrl: new URL("http://127.0.0.1:3773"),
+              args: [],
+              env: {},
+              extendEnv: true,
+              preflightFailure: Option.none(),
+            }),
+            instance("wsl:TestDistro", () => fixture.wslReady, {
+              httpBaseUrl: new URL("http://192.0.2.10:3774"),
+              args: wslArgs,
+              env: {},
+              extendEnv: false,
+              preflightFailure: Option.none(),
+              runningDistro: "TestDistro",
+              wslRuntimeId: "sha256-abc",
+            }),
+          ]),
+        } as unknown as DesktopBackendPool.DesktopBackendPool["Service"]),
+        Layer.succeed(DesktopEnvironment.DesktopEnvironment, {
+          platform,
+        } as unknown as DesktopEnvironment.DesktopEnvironment["Service"]),
+        Layer.succeed(ElectronPowerMonitor.ElectronPowerMonitor, {
+          onSimpleEvent: () => Effect.void,
+        } as unknown as ElectronPowerMonitor.ElectronPowerMonitor["Service"]),
+        Layer.succeed(
+          HttpClient.HttpClient,
+          HttpClient.make((request) =>
+            Effect.sync(() =>
+              HttpClientResponse.fromWeb(
+                request,
+                Response.json({
+                  environmentId: fixture.windowsEnvironmentId,
+                  label: "Same Name",
+                  platform: { os: "windows", arch: "x64" },
+                  serverVersion: "0.0.0-test",
+                  capabilities: { repositoryIdentity: true },
+                }),
+              ),
+            ),
+          ),
+        ),
+        Layer.succeed(
+          ChildProcessSpawner.ChildProcessSpawner,
+          ChildProcessSpawner.make((command) =>
+            Effect.gen(function* () {
+              const exit = yield* Deferred.make<number>();
+              const args =
+                command._tag === "StandardCommand" ? command.args.map((word) => String(word)) : [];
+              fixture.spawns.push({ args, exit });
+              return ChildProcessSpawner.makeHandle({
+                pid: ChildProcessSpawner.ProcessId(77),
+                // Says where it listens, then stays up until its exit is decided.
+                stdout: Stream.concat(
+                  Stream.make(encodeHello({ ok: true, version: 1, port: 13773, pid: 77 })),
+                  Stream.never,
+                ),
+                stderr: Stream.make(new TextEncoder().encode("helper log line\n")),
+                all: Stream.empty,
+                exitCode: Deferred.await(exit).pipe(Effect.map(ChildProcessSpawner.ExitCode)),
+                isRunning: Effect.succeed(true),
+                kill: () => Effect.void,
+                stdin: Sink.drain,
+                getInputFd: () => Sink.drain,
+                getOutputFd: () => Stream.empty,
+                unref: Effect.succeed(Effect.void),
+              });
+            }),
+          ),
+        ),
+      ),
+    ),
+  );
+
+const fixture = (): Fixture => ({
+  primaryReady: true,
+  wslReady: true,
+  windowsEnvironmentId: "env-windows",
+  spawns: [],
+});
+
+/** Lets the supervisor's fibers run, then advances the test clock. */
+const settle = (duration: Duration.Input = Duration.millis(10)) =>
+  Effect.gen(function* () {
+    for (let round = 0; round < 20; round++) yield* Effect.yieldNow;
+    yield* TestClock.adjust(duration);
+    for (let round = 0; round < 20; round++) yield* Effect.yieldNow;
+  });
+
+describe("DesktopHostBridge", () => {
+  it.effect("stays off until the user turns it on", () => {
+    const fx = fixture();
+    return Effect.gen(function* () {
+      const bridge = yield* DesktopHostBridge.DesktopHostBridge;
+      yield* Effect.forkScoped(bridge.run);
+      yield* settle(Duration.seconds(10));
+      assert.strictEqual((yield* bridge.state).phase, "disabled");
+      assert.strictEqual(fx.spawns.length, 0);
+    }).pipe(Effect.scoped, Effect.provide(layerFor(fx, {})));
+  });
+
+  it.effect("starts the helper where the WSL backend runs once both backends are ready", () => {
+    const fx = { ...fixture(), primaryReady: false };
+    return Effect.gen(function* () {
+      const bridge = yield* DesktopHostBridge.DesktopHostBridge;
+      yield* Effect.forkScoped(bridge.run);
+      yield* settle();
+      assert.strictEqual((yield* bridge.state).phase, "waiting-windows");
+      assert.strictEqual(fx.spawns.length, 0);
+
+      fx.primaryReady = true;
+      yield* settle(Duration.seconds(3));
+      yield* settle(Duration.seconds(3));
+      const state = yield* bridge.state;
+      assert.strictEqual(fx.spawns.length, 1);
+      assert.deepStrictEqual(fx.spawns[0]!.args.slice(-3), [
+        "__host-bridge",
+        "--ports",
+        "13773,13774,13775",
+      ]);
+      assert.deepStrictEqual(fx.spawns[0]!.args.slice(0, 2), ["-d", "TestDistro"]);
+      assert.strictEqual(state.phase, "running");
+      assert.strictEqual(state.url, "http://127.0.0.1:13773");
+      assert.strictEqual(state.windowsEnvironmentId, "env-windows");
+      assert.strictEqual(state.windowsPort, 3773);
+      assert.strictEqual(state.wslNetworking, "nat");
+      assert.strictEqual(state.helperPid, 77);
+    }).pipe(Effect.scoped, Effect.provide(layerFor(fx, { hostBridgeEnabled: true })));
+  });
+
+  it.effect("backs off after the helper stops, then starts it again", () => {
+    const fx = fixture();
+    return Effect.gen(function* () {
+      const bridge = yield* DesktopHostBridge.DesktopHostBridge;
+      yield* Effect.forkScoped(bridge.run);
+      yield* settle();
+      assert.strictEqual(fx.spawns.length, 1);
+
+      yield* Deferred.succeed(fx.spawns[0]!.exit, 1);
+      yield* settle();
+      const failed = yield* bridge.state;
+      assert.strictEqual(failed.phase, "recovering");
+      assert.strictEqual(failed.restarts, 1);
+      assert.include(failed.lastError ?? "", "exit 1");
+      assert.include(failed.lastError ?? "", "helper log line");
+      assert.isNotNull(failed.nextRetryAt);
+      assert.strictEqual(fx.spawns.length, 1);
+
+      yield* settle(Duration.seconds(3));
+      assert.strictEqual(fx.spawns.length, 2);
+      // A second failure waits longer than the first.
+      yield* Deferred.succeed(fx.spawns[1]!.exit, 1);
+      yield* settle(Duration.millis(1_500));
+      assert.strictEqual(fx.spawns.length, 2);
+      yield* settle(Duration.seconds(3));
+      assert.strictEqual(fx.spawns.length, 3);
+    }).pipe(Effect.scoped, Effect.provide(layerFor(fx, { hostBridgeEnabled: true })));
+  });
+
+  it.effect("a helper started by turning it on outlives the call that turned it on", () => {
+    const fx = fixture();
+    return Effect.gen(function* () {
+      const bridge = yield* DesktopHostBridge.DesktopHostBridge;
+      yield* Effect.forkScoped(bridge.run);
+      yield* settle();
+      assert.strictEqual(fx.spawns.length, 0);
+      // The IPC handler's own fiber runs this and ends right after.
+      yield* Effect.forkChild(bridge.set({ enabled: true })).pipe(Effect.flatMap(Fiber.join));
+      yield* settle(Duration.seconds(3));
+      yield* settle(Duration.seconds(3));
+      assert.strictEqual(fx.spawns.length, 1);
+      assert.strictEqual((yield* bridge.state).phase, "running");
+    }).pipe(Effect.scoped, Effect.provide(layerFor(fx, {})));
+  });
+
+  it.effect("keeps a pairing failure the app reports as the last error, even once off", () => {
+    const fx = fixture();
+    return Effect.gen(function* () {
+      const bridge = yield* DesktopHostBridge.DesktopHostBridge;
+      yield* Effect.forkScoped(bridge.run);
+      const failed = yield* bridge.set({ enabled: true, failure: "Pairing: refused" });
+      assert.strictEqual(failed.lastError, "Pairing: refused");
+      const off = yield* bridge.set({ enabled: false });
+      assert.strictEqual(off.lastError, "Pairing: refused");
+      const cleared = yield* bridge.set({ enabled: true, failure: null });
+      assert.isNull(cleared.lastError);
+    }).pipe(Effect.scoped, Effect.provide(layerFor(fx, {})));
+  });
+
+  it.effect("turning it off stops the helper and starts nothing more", () => {
+    const fx = fixture();
+    return Effect.gen(function* () {
+      const bridge = yield* DesktopHostBridge.DesktopHostBridge;
+      yield* Effect.forkScoped(bridge.run);
+      yield* settle();
+      assert.strictEqual(fx.spawns.length, 1);
+      const off = yield* bridge.set({ enabled: false });
+      assert.strictEqual(off.phase, "disabled");
+      assert.isNull(off.helperPid);
+      yield* settle(Duration.minutes(5));
+      assert.strictEqual(fx.spawns.length, 1);
+    }).pipe(Effect.scoped, Effect.provide(layerFor(fx, { hostBridgeEnabled: true })));
+  });
+
+  it.effect("pauses when Windows answers as another environment than the one paired", () => {
+    const fx = fixture();
+    return Effect.gen(function* () {
+      const bridge = yield* DesktopHostBridge.DesktopHostBridge;
+      yield* Effect.forkScoped(bridge.run);
+      yield* settle();
+      assert.strictEqual(fx.spawns.length, 1);
+
+      // The Windows backend was reset and came back with a new identity.
+      fx.windowsEnvironmentId = "env-windows-new";
+      yield* settle(Duration.seconds(3));
+      const paused = yield* bridge.state;
+      assert.strictEqual(paused.phase, "identity-mismatch");
+      assert.isNull(paused.helperPid);
+      yield* settle(Duration.minutes(2));
+      assert.strictEqual(fx.spawns.length, 1);
+    }).pipe(
+      Effect.scoped,
+      Effect.provide(
+        layerFor(fx, { hostBridgeEnabled: true, hostBridgeEnvironmentId: "env-windows" }),
+      ),
+    );
+  });
+
+  it.effect("restarts the helper when the WSL backend goes away and comes back", () => {
+    const fx = fixture();
+    return Effect.gen(function* () {
+      const bridge = yield* DesktopHostBridge.DesktopHostBridge;
+      yield* Effect.forkScoped(bridge.run);
+      yield* settle();
+      assert.strictEqual(fx.spawns.length, 1);
+      // `wsl --shutdown`: the WSL backend stops being ready.
+      fx.wslReady = false;
+      yield* settle(Duration.seconds(3));
+      assert.strictEqual((yield* bridge.state).phase, "waiting-wsl");
+      fx.wslReady = true;
+      yield* settle(Duration.seconds(3));
+      assert.strictEqual(fx.spawns.length, 2);
+      assert.strictEqual((yield* bridge.state).phase, "running");
+    }).pipe(Effect.scoped, Effect.provide(layerFor(fx, { hostBridgeEnabled: true })));
+  });
+
+  it.effect("is unsupported off Windows", () => {
+    const fx = fixture();
+    return Effect.gen(function* () {
+      const bridge = yield* DesktopHostBridge.DesktopHostBridge;
+      yield* Effect.forkScoped(bridge.run);
+      yield* settle();
+      assert.strictEqual((yield* bridge.state).phase, "unsupported");
+      assert.strictEqual(fx.spawns.length, 0);
+    }).pipe(Effect.scoped, Effect.provide(layerFor(fx, { hostBridgeEnabled: true }, "linux")));
+  });
+});
