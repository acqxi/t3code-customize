index 0000000000..94bed81f52
--- /dev/null
+++ b/apps/desktop/src/hostBridge/hostBridgePlan.ts
@@ -0,0 +1,157 @@
+import type { DesktopHostBridgePhase } from "@t3tools/contracts";
+import { HOST_BRIDGE_DEFAULT_PORTS } from "@t3tools/shared/hostBridgeMux";
+
+/** The hidden `t3` subcommand that listens in WSL; the server's bin dispatches it. */
+export const HOST_BRIDGE_HELPER_COMMAND = "__host-bridge";
+export const HOST_BRIDGE_PORTS = HOST_BRIDGE_DEFAULT_PORTS;
+
+export const BACKOFF_INITIAL_MS = 1_000;
+export const BACKOFF_MAX_MS = 60_000;
+/** A helper up this long has recovered; its next failure starts the backoff over. */
+export const BACKOFF_STABLE_MS = 120_000;
+/** A helper that has not said where it listens by then is stuck, not slow. */
+export const HELLO_TIMEOUT_MS = 30_000;
+
+export const backoffDelayMs = (attempt: number) =>
+  Math.min(BACKOFF_MAX_MS, BACKOFF_INITIAL_MS * 2 ** Math.max(0, attempt));
+
+export interface HelperLaunch {
+  readonly args: ReadonlyArray<string>;
+  readonly env: Record<string, string | undefined>;
+  readonly extendEnv: boolean;
+}
+
+/**
+ * The helper runs exactly like the WSL backend (same distro, user, PATH,
+ * T3 home and runtime), with the helper subcommand in place of the server's
+ * bootstrap. A launch that is not a runtime start, such as a failed preflight,
+ * has nothing to run.
+ */
+export const helperLaunchFromBackend = (
+  config: {
+    readonly args: ReadonlyArray<string>;
+    readonly env: Record<string, string | undefined>;
+    readonly extendEnv: boolean;
+  },
+  ports: ReadonlyArray<number> = HOST_BRIDGE_PORTS,
+): HelperLaunch | undefined => {
+  const exec = config.args.indexOf("--exec");
+  const bootstrap = config.args.indexOf("--bootstrap-fd");
+  if (exec < 0 || bootstrap <= exec + 1) return undefined;
+  return {
+    args: [
+      ...config.args.slice(0, bootstrap),
+      HOST_BRIDGE_HELPER_COMMAND,
+      "--ports",
+      ports.join(","),
+    ],
+    env: config.env,
+    extendEnv: config.extendEnv,
+  };
+};
+
+/** Mirrored networking shares loopback with Windows; Desktop then reaches WSL at 127.0.0.1. */
+export const wslNetworkingOf = (httpBaseUrl: URL): "nat" | "mirrored" =>
+  httpBaseUrl.hostname === "127.0.0.1" ? "mirrored" : "nat";
+
+export interface BridgeObservation {
+  readonly enabled: boolean;
+  readonly platform: NodeJS.Platform;
+  readonly wslOnly: boolean;
+  readonly pairedEnvironmentId: string | null;
+  readonly windows: {
+    readonly ready: boolean;
+    readonly port: number | null;
+    readonly environmentId: string | null;
+    readonly error: string | null;
+  };
+  readonly wsl: {
+    readonly ready: boolean;
+    readonly launch: HelperLaunch | undefined;
+  } | null;
+}
+
+export interface HelperStatus {
+  /** The launch the running helper was started with, if one runs. */
+  readonly runningKey: string | null;
+  readonly listening: boolean;
+  readonly nextRetryAt: number | null;
+  readonly lastError: string | null;
+}
+
+export type BridgePlan =
+  | {
+      readonly action: "stop";
+      readonly phase: DesktopHostBridgePhase;
+      readonly detail: string | null;
+    }
+  | {
+      readonly action: "keep";
+      readonly phase: DesktopHostBridgePhase;
+      readonly detail: string | null;
+    }
+  | {
+      readonly action: "start";
+      readonly launch: HelperLaunch;
+      readonly key: string;
+    }
+  | {
+      readonly action: "wait";
+      readonly phase: DesktopHostBridgePhase;
+      readonly detail: string | null;
+    };
+
+export const launchKey = (launch: HelperLaunch) => JSON.stringify(launch.args);
+
+/** What the supervisor should do now. Pure, so every branch is tested without processes. */
+export const planBridge = (
+  observation: BridgeObservation,
+  helper: HelperStatus,
+  now: number,
+): BridgePlan => {
+  const stop = (phase: DesktopHostBridgePhase, detail: string | null): BridgePlan => ({
+    action: "stop",
+    phase,
+    detail,
+  });
+  if (!observation.enabled) return stop("disabled", null);
+  if (observation.platform !== "win32") {
+    return stop("unsupported", "The WSL host bridge runs in T3 Code for Windows.");
+  }
+  if (observation.wslOnly) {
+    return stop(
+      "unsupported",
+      "WSL-only mode runs no Windows backend. Turn it off to use the host bridge.",
+    );
+  }
+  const { windows, wsl } = observation;
+  if (!windows.ready || windows.port === null || windows.environmentId === null) {
+    return stop("waiting-windows", windows.error);
+  }
+  if (
+    observation.pairedEnvironmentId !== null &&
+    observation.pairedEnvironmentId !== windows.environmentId
+  ) {
+    return stop(
+      "identity-mismatch",
+      "The Windows backend answers as a different environment than the one paired. The bridge is paused until you confirm.",
+    );
+  }
+  if (wsl === null) return stop("waiting-wsl", "Turn on the WSL backend to use the host bridge.");
+  if (!wsl.ready) return stop("waiting-wsl", null);
+  if (wsl.launch === undefined) {
+    return stop("waiting-wsl", "The WSL backend did not start from a runtime the bridge can use.");
+  }
+  const key = launchKey(wsl.launch);
+  if (helper.runningKey === key) {
+    return {
+      action: "keep",
+      phase: helper.listening ? "running" : "starting",
+      detail: null,
+    };
+  }
+  if (helper.runningKey === null && helper.nextRetryAt !== null && now < helper.nextRetryAt) {
+    return { action: "wait", phase: "recovering", detail: helper.lastError };
+  }
+  return { action: "start", launch: wsl.launch, key };
+};
