diff --git a/apps/server/src/hostBridge/hostBridgeHelper.test.ts b/apps/server/src/hostBridge/hostBridgeHelper.test.ts
new file mode 100644
index 0000000000..c81abcf79a
--- /dev/null
+++ b/apps/server/src/hostBridge/hostBridgeHelper.test.ts
@@ -0,0 +1,162 @@
+// @effect-diagnostics nodeBuiltinImport:off -- The helper is plain Node; it is tested over real loopback sockets.
+import * as NodeNet from "node:net";
+import * as NodeStream from "node:stream";
+
+import { afterEach, describe, expect, it } from "vite-plus/test";
+
+import {
+  FrameDecoder,
+  FrameType,
+  decodeHello,
+  encodeFrame,
+  type Frame,
+} from "@t3tools/shared/hostBridgeMux";
+
+import {
+  listenOnFirstFree,
+  parseHostBridgeHelperArgs,
+  runHostBridgeHelper,
+} from "./hostBridgeHelper.ts";
+
+const closers: Array<() => void> = [];
+afterEach(() => {
+  for (const close of closers.splice(0)) close();
+});
+
+const freePort = () =>
+  new Promise<number>((resolve) => {
+    const server = NodeNet.createServer();
+    server.listen(0, "127.0.0.1", () => {
+      const { port } = server.address() as NodeNet.AddressInfo;
+      server.close(() => resolve(port));
+    });
+  });
+
+const occupy = (port: number) =>
+  new Promise<NodeNet.Server>((resolve) => {
+    const server = NodeNet.createServer();
+    server.listen(port, "127.0.0.1", () => resolve(server));
+    closers.push(() => server.close());
+  });
+
+const startHelper = async (argv: ReadonlyArray<string>) => {
+  const input = new NodeStream.PassThrough();
+  const frames: Array<Frame> = [];
+  const decoder = new FrameDecoder();
+  const exits: Array<number> = [];
+  // Woken by each frame and exit, so a test awaits the milestone itself.
+  const waiters: Array<() => void> = [];
+  const notify = () => {
+    for (const waiter of waiters.splice(0)) waiter();
+  };
+  const when = (check: () => boolean) =>
+    new Promise<void>((resolve) => {
+      const attempt = () => (check() ? resolve() : waiters.push(attempt));
+      attempt();
+    });
+  const result = await runHostBridgeHelper(argv, {
+    input,
+    output: {
+      write: (bytes) => {
+        frames.push(...decoder.push(bytes));
+        notify();
+      },
+    },
+    exit: (code) => {
+      exits.push(code);
+      notify();
+    },
+    pid: 4242,
+  });
+  if (result !== undefined) closers.push(result.stop);
+  return { input, frames, exits, result, when };
+};
+
+describe("parseHostBridgeHelperArgs", () => {
+  it("accepts only a port list", () => {
+    expect(parseHostBridgeHelperArgs(["--ports", "13773,13774"])).toEqual({
+      ok: true,
+      ports: [13773, 13774],
+    });
+    expect(parseHostBridgeHelperArgs(["--ports", "80"]).ok).toBe(false);
+    expect(parseHostBridgeHelperArgs(["--ports", "13773", "--to", "192.0.2.1:3773"]).ok).toBe(
+      false,
+    );
+    expect(parseHostBridgeHelperArgs(["--target", "192.0.2.1"]).ok).toBe(false);
+    expect(parseHostBridgeHelperArgs(["--ports", "x"]).ok).toBe(false);
+  });
+});
+
+describe("listenOnFirstFree", () => {
+  it("skips ports something else holds", async () => {
+    const taken = await freePort();
+    await occupy(taken);
+    const next = await freePort();
+    const server = NodeNet.createServer();
+    closers.push(() => server.close());
+    expect(await listenOnFirstFree(server, [taken, next])).toEqual({ port: next });
+    expect((server.address() as NodeNet.AddressInfo).address).toBe("127.0.0.1");
+  });
+
+  it("reports when every port is taken", async () => {
+    const taken = await freePort();
+    await occupy(taken);
+    const server = NodeNet.createServer();
+    expect(await listenOnFirstFree(server, [taken])).toEqual({ error: "ports_in_use" });
+  });
+});
+
+describe("runHostBridgeHelper", () => {
+  it("says hello with its port, frames connections and exits when stdin ends", async () => {
+    const port = await freePort();
+    const helper = await startHelper(["--ports", String(port)]);
+    expect(helper.frames[0]?.type).toBe(FrameType.hello);
+    expect(decodeHello(helper.frames[0]!.payload)).toEqual({
+      ok: true,
+      version: 1,
+      port,
+      pid: 4242,
+    });
+
+    const client = NodeNet.connect({ host: "127.0.0.1", port });
+    closers.push(() => client.destroy());
+    await new Promise((resolve) => client.once("connect", resolve));
+    client.write("GET / HTTP/1.1\r\n\r\n");
+    await helper.when(() => helper.frames.some((frame) => frame.type === FrameType.data));
+    const open = helper.frames.find((frame) => frame.type === FrameType.open)!;
+    const data = helper.frames.find((frame) => frame.type === FrameType.data)!;
+    expect(data.stream).toBe(open.stream);
+    expect(new TextDecoder().decode(data.payload)).toBe("GET / HTTP/1.1\r\n\r\n");
+
+    const received = new Promise<string>((resolve) =>
+      client.once("data", (chunk: Buffer) => resolve(chunk.toString())),
+    );
+    helper.input.write(
+      encodeFrame(FrameType.data, open.stream, new TextEncoder().encode("HTTP/1.1 200 OK\r\n")),
+    );
+    expect(await received).toBe("HTTP/1.1 200 OK\r\n");
+
+    helper.input.end();
+    await helper.when(() => helper.exits.includes(0));
+  });
+
+  it("refuses to start with anything but ports", async () => {
+    const helper = await startHelper(["--ports", "13773", "--to", "192.0.2.1"]);
+    expect(decodeHello(helper.frames[0]!.payload)).toMatchObject({
+      ok: false,
+      code: "bad_arguments",
+    });
+    expect(helper.exits).toEqual([2]);
+  });
+
+  it("reports ports in use instead of listening elsewhere", async () => {
+    const port = await freePort();
+    await occupy(port);
+    const helper = await startHelper(["--ports", String(port)]);
+    expect(decodeHello(helper.frames[0]!.payload)).toMatchObject({
+      ok: false,
+      code: "ports_in_use",
+    });
+    expect(helper.exits).toEqual([4]);
