+// @effect-diagnostics nodeBuiltinImport:off -- Bridged streams connect to the Windows backend over Windows loopback sockets.
+import * as NodeNet from "node:net";
+
+import {
+  ExecutionEnvironmentDescriptor,
+  type DesktopHostBridgeSetInput,
+  type DesktopHostBridgeState,
+} from "@t3tools/contracts";
+import { HostBridgeMux, hostBridgeUrls, type MuxStats } from "@t3tools/shared/hostBridgeMux";
+import * as Cause from "effect/Cause";
+import * as Clock from "effect/Clock";
+import * as Context from "effect/Context";
+import * as DateTime from "effect/DateTime";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Queue from "effect/Queue";
+import * as Ref from "effect/Ref";
+import * as Semaphore from "effect/Semaphore";
+import type * as Scope from "effect/Scope";
+import * as Stream from "effect/Stream";
+import { HttpClient, HttpClientResponse } from "effect/http";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+
+import * as DesktopEnvironment from "../app/DesktopEnvironment.ts";
+import * as DesktopObservability from "../app/DesktopObservability.ts";
+import * as DesktopBackendPool from "../backend/DesktopBackendPool.ts";
+import * as ElectronPowerMonitor from "../electron/ElectronPowerMonitor.ts";
+import * as DesktopAppSettings from "../settings/DesktopAppSettings.ts";
+import { WSL_INSTANCE_ID_PREFIX } from "../wsl/DesktopWslBackend.ts";
+import {
+  backoffDelayMs,
+  BACKOFF_STABLE_MS,
+  HELLO_TIMEOUT_MS,
+  helperLaunchFromBackend,
+  HOST_BRIDGE_PORTS,
+  planBridge,
+  wslNetworkingOf,
+  type BridgeObservation,
+  type HelperLaunch,
+} from "./hostBridgePlan.ts";
+
+const TICK = Duration.seconds(3);
+const DESCRIPTOR_TIMEOUT = Duration.seconds(2);
+const STDERR_TAIL_CHARS = 1_000;
+
+const DISABLED_STATE: DesktopHostBridgeState = {
+  enabled: false,
+  phase: "disabled",
+  detail: null,
+  urls: hostBridgeUrls(HOST_BRIDGE_PORTS),
+  url: null,
+  windowsEnvironmentId: null,
+  windowsLabel: null,
+  windowsPort: null,
+  pairedEnvironmentId: null,
+  wslInstanceId: null,
+  wslDistro: null,
+  wslRuntimeId: null,
+  wslNetworking: null,
+  helperPid: null,
+  restarts: 0,
+  nextRetryAt: null,
+  lastError: null,
+  streams: { open: 0, total: 0, refused: 0 },
+  since: "1970-01-01T00:00:00.000Z",
+};
+
+const { logInfo, logWarning } = DesktopObservability.makeComponentLogger("desktop-host-bridge");
+
+export class DesktopHostBridge extends Context.Service<
+  DesktopHostBridge,
+  {
+    readonly state: Effect.Effect<DesktopHostBridgeState>;
+    readonly set: (
+      input: DesktopHostBridgeSetInput,
+    ) => Effect.Effect<DesktopHostBridgeState, DesktopAppSettings.DesktopSettingsWriteError>;
+    /** Supervises the helper until interrupted; the app forks it once. */
+    readonly run: Effect.Effect<never, never, Scope.Scope>;
+  }
+>()("@t3tools/desktop/hostBridge/DesktopHostBridge") {}
+
+/** Everything the supervisor tracks between ticks; read and written only on its fibers and socket callbacks. */
+interface Runtime {
+  windowsPort: number | null;
+  windowsEnvironmentId: string | null;
+  windowsLabel: string | null;
+  windowsDescriptorPort: number | null;
+  helperKey: string | null;
+  helperFiber: Fiber.Fiber<void> | null;
+  helperStartedAt: number | null;
+  helperPid: number | null;
+  listeningUrl: string | null;
+  mux: HostBridgeMux | null;
+  attempt: number;
+  restarts: number;
+  nextRetryAt: number | null;
+  lastError: string | null;
+  resumed: boolean;
+  streams: MuxStats;
+}
+
+const decodeUtf8 = (bytes: Uint8Array) => new TextDecoder().decode(bytes);
+
+const make = Effect.gen(function* () {
+  const pool = yield* DesktopBackendPool.DesktopBackendPool;
+  const appSettings = yield* DesktopAppSettings.DesktopAppSettings;
+  const environment = yield* DesktopEnvironment.DesktopEnvironment;
+  const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
+  const httpClient = yield* HttpClient.HttpClient;
+  const powerMonitor = yield* ElectronPowerMonitor.ElectronPowerMonitor;
+  // Helpers live in the service's scope: a tick run for an IPC call must not take its helper along.
+  const helperScope = yield* Effect.scope;
+  const wake = yield* Queue.sliding<void>(1);
+  // The loop and IPC both tick; one at a time, so a helper is never started twice.
+  const tickLock = yield* Semaphore.make(1);
+  const wakeUnsafe = () => {
+    Queue.offerUnsafe(wake, undefined);
+  };
+
+  const runtime: Runtime = {
+    windowsPort: null,
+    windowsEnvironmentId: null,
+    windowsLabel: null,
+    windowsDescriptorPort: null,
+    helperKey: null,
+    helperFiber: null,
+    helperStartedAt: null,
+    helperPid: null,
+    listeningUrl: null,
+    mux: null,
+    attempt: 0,
+    restarts: 0,
+    nextRetryAt: null,
+    lastError: null,
+    resumed: false,
+    streams: { open: 0, total: 0, refused: 0 },
+  };
+
+  const initial: DesktopHostBridgeState = {
+    ...DISABLED_STATE,
+    since: DateTime.formatIso(yield* DateTime.now),
+  };
+  const stateRef = yield* Ref.make(initial);
+
+  /** The Windows backend's own descriptor: the only source of the identity the bridge reaches. */
+  const readWindowsDescriptor = (port: number) =>
+    httpClient
+      .get(`http://127.0.0.1:${port}/.well-known/t3/environment`)
+      .pipe(
+        Effect.flatMap(HttpClientResponse.filterStatusOk),
+        Effect.flatMap(HttpClientResponse.schemaBodyJson(ExecutionEnvironmentDescriptor)),
+        Effect.timeout(DESCRIPTOR_TIMEOUT),
+        Effect.option,
+      );
+
+  const observe = Effect.gen(function* () {
+    const settings = yield* appSettings.get;
+    const instances = yield* pool.list;
+    const primary = instances.find(
+      (instance) => instance.id === DesktopBackendPool.PRIMARY_INSTANCE_ID,
+    );
+    const primaryConfig = primary === undefined ? Option.none() : yield* primary.currentConfig;
+    const primaryReady = primary === undefined ? false : (yield* primary.snapshot).ready;
+    const port = Option.match(primaryConfig, {
+      onNone: () => null,
+      onSome: (config) => Number(config.httpBaseUrl.port) || null,
+    });
+    let windowsError: string | null = null;
+    if (settings.hostBridgeEnabled && primaryReady && port !== null) {
+      const descriptor = yield* readWindowsDescriptor(port);
+      if (Option.isSome(descriptor)) {
+        runtime.windowsEnvironmentId = descriptor.value.environmentId;
+        runtime.windowsLabel = descriptor.value.label;
+        runtime.windowsDescriptorPort = port;
+      } else {
+        // A port that changed is a different backend until it answers.
+        if (runtime.windowsDescriptorPort !== port) runtime.windowsEnvironmentId = null;
+        windowsError = "The Windows backend did not answer on this machine's loopback.";
+      }
+    }
+    runtime.windowsPort = primaryReady ? port : null;
+    const wslInstance = instances.find((instance) =>
+      instance.id.startsWith(WSL_INSTANCE_ID_PREFIX),
+    );
+    const wslConfig = wslInstance === undefined ? Option.none() : yield* wslInstance.currentConfig;
+    const wslReady = wslInstance === undefined ? false : (yield* wslInstance.snapshot).ready;
+    const launch = Option.match(wslConfig, {
+      onNone: () => undefined,
+      onSome: (config) =>
+        Option.isNone(config.preflightFailure) ? helperLaunchFromBackend(config) : undefined,
+    });
+    const observation: BridgeObservation = {
+      enabled: settings.hostBridgeEnabled,
+      platform: environment.platform,
+      wslOnly: settings.wslOnly && settings.wslBackendEnabled,
+      pairedEnvironmentId: settings.hostBridgeEnvironmentId,
+      windows: {
+        ready: primaryReady,
+        port,
+        environmentId: primaryReady ? runtime.windowsEnvironmentId : null,
+        error: windowsError,
+      },
+      wsl: wslInstance === undefined ? null : { ready: wslReady, launch },
+    };
+    return {
+      observation,
+      wsl: {
+        instanceId: wslInstance?.id ?? null,
+        distro: Option.match(wslConfig, {
+          onNone: () => null,
+          onSome: (config) => config.runningDistro ?? null,
+        }),
+        runtimeId: Option.match(wslConfig, {
+          onNone: () => null,
+          onSome: (config) => config.wslRuntimeId ?? null,
+        }),
+        networking: Option.match(wslConfig, {
+          onNone: () => null,
+          onSome: (config) => wslNetworkingOf(config.httpBaseUrl),
+        }),
+      },
+    };
+  });
+
+  /** Connects one stream from WSL to the Windows backend's current port; nowhere else. */
+  const openStream = () => {
+    const port = runtime.windowsPort;
+    if (port === null) return undefined;
+    const socket = NodeNet.connect({ host: "127.0.0.1", port, allowHalfOpen: true });
+    socket.setNoDelay(true);
+    return socket;
+  };
+
+  const runHelper = Effect.fn("desktop.hostBridge.runHelper")(function* (launch: HelperLaunch) {
+    const input = yield* Queue.unbounded<Uint8Array>();
+    const seen = { stderrTail: "", failure: null as string | null, listening: false };
+    const mux = new HostBridgeMux(
+      (bytes) => {
+        Queue.offerUnsafe(input, bytes);
+      },
+      {
+        onOpen: openStream,
+        onHello: (hello) => {
+          if (hello.ok) {
+            seen.listening = true;
+            runtime.listeningUrl = `http://127.0.0.1:${hello.port}`;
+            runtime.helperPid = hello.pid;
+          } else {
+            seen.failure = hello.message;
+          }
+          wakeUnsafe();
+        },
+        onProtocolError: (error) => {
+          seen.failure = `The bridge helper sent something unreadable (${error.message}).`;
+        },
+      },
+    );
+    runtime.mux = mux;
+    const command = ChildProcess.make("wsl.exe", launch.args, {
+      env: launch.env,
+      extendEnv: launch.extendEnv,
+      stdin: Stream.fromQueue(input),
+      stdout: "pipe",
+      stderr: "pipe",
+      killSignal: "SIGTERM",
+      forceKillAfter: Duration.seconds(3),
+    });
+    const exitCode = yield* Effect.scoped(
+      Effect.gen(function* () {
+        const handle = yield* spawner.spawn(command);
+        yield* Stream.runForEach(handle.stderr, (chunk) =>
+          Effect.sync(() => {
+            seen.stderrTail = (seen.stderrTail + decodeUtf8(chunk)).slice(-STDERR_TAIL_CHARS);
+          }),
+        ).pipe(Effect.ignore, Effect.forkChild);
+        yield* Stream.runForEach(handle.stdout, (chunk) =>
+          Effect.sync(() => mux.receive(chunk)),
+        ).pipe(Effect.ignore, Effect.forkChild);
+        const helloTimeout = Effect.sleep(Duration.millis(HELLO_TIMEOUT_MS)).pipe(
+          Effect.andThen(
+            Effect.suspend(() =>
+              seen.listening ? Effect.never : Effect.succeed("no answer" as const),
+            ),
+          ),
+        );
+        return yield* Effect.raceFirst(handle.exitCode.pipe(Effect.map(Number)), helloTimeout);
+      }),
+    ).pipe(
+      Effect.catchCause((cause) =>
+        Effect.succeed(`could not start wsl.exe: ${Cause.pretty(cause).split("\n")[0]}`),
+      ),
+    );
+    mux.stop();
+    runtime.mux = null;
+    const tail = seen.stderrTail.trim().split("\n").at(-1) ?? "";
+    return (
+      seen.failure ??
+      (typeof exitCode === "string"
+        ? exitCode === "no answer"
+          ? "The bridge helper did not start listening in time."
+          : exitCode
+        : `The bridge helper stopped (exit ${exitCode})${tail.length > 0 ? `: ${tail}` : "."}`)
+    );
+  });
+
+  const forgetHelper = () => {
+    runtime.helperKey = null;
+    runtime.helperFiber = null;
+    runtime.helperPid = null;
+    runtime.listeningUrl = null;
+    if (runtime.mux !== null) runtime.streams = runtime.mux.stats;
+  };
+
+  const stopHelper = Effect.gen(function* () {
+    const fiber = runtime.helperFiber;
+    if (fiber === null) return;
+    forgetHelper();
+    yield* Fiber.interrupt(fiber);
+  });
+
+  const startHelper = Effect.fn("desktop.hostBridge.startHelper")(function* (
+    launch: HelperLaunch,
+    key: string,
+  ) {
+    yield* stopHelper;
+    const startedAt = yield* Clock.currentTimeMillis;
+    yield* logInfo("starting WSL host bridge helper", { restarts: runtime.restarts });
+    const supervised = runHelper(launch).pipe(
+      Effect.flatMap((reason) =>
+        Effect.gen(function* () {
+          const now = yield* Clock.currentTimeMillis;
+          // Only the helper this fiber started is forgotten; a newer one may already run.
+          if (runtime.helperKey === key) forgetHelper();
+          runtime.attempt = now - startedAt >= BACKOFF_STABLE_MS ? 0 : runtime.attempt + 1;
+          runtime.restarts += 1;
+          runtime.lastError = reason;
+          runtime.nextRetryAt = now + backoffDelayMs(runtime.attempt - 1);
+          yield* logWarning("WSL host bridge helper stopped", {
+            reason,
+            retryInMs: runtime.nextRetryAt - now,
+          });
+          wakeUnsafe();
+        }),
+      ),
+    );
+    const fiber = yield* Effect.forkIn(supervised, helperScope);
+    runtime.helperKey = key;
+    runtime.helperFiber = fiber;
+    runtime.helperStartedAt = startedAt;
+    runtime.nextRetryAt = null;
+  });
+
+  const tickUnlocked = Effect.gen(function* () {
+    if (runtime.resumed) {
+      // After sleep the helper's pipes and WSL itself may be stale; start over without waiting.
+      runtime.resumed = false;
+      runtime.attempt = 0;
+      runtime.nextRetryAt = null;
+      yield* stopHelper;
+    }
+    const { observation, wsl } = yield* observe;
+    const now = yield* Clock.currentTimeMillis;
+    const plan = planBridge(
+      observation,
+      {
+        runningKey: runtime.helperKey,
+        listening: runtime.listeningUrl !== null,
+        nextRetryAt: runtime.nextRetryAt,
+        lastError: runtime.lastError,
+      },
+      now,
+    );
+    let phase: DesktopHostBridgeState["phase"];
+    let detail: string | null;
+    if (plan.action === "start") {
+      yield* startHelper(plan.launch, plan.key);
+      phase = runtime.restarts > 0 ? "recovering" : "starting";
+      detail = runtime.restarts > 0 ? runtime.lastError : null;
+    } else {
+      if (plan.action === "stop") yield* stopHelper;
+      phase = plan.phase;
+      detail = plan.detail;
+      // A helper that stays up has recovered; its earlier failure is history.
+      if (
+        plan.action === "keep" &&
+        runtime.listeningUrl !== null &&
+        runtime.helperStartedAt !== null &&
+        now - runtime.helperStartedAt >= BACKOFF_STABLE_MS
+      ) {
+        runtime.attempt = 0;
+      }
+    }
+    // Turning it off resets the backoff but keeps the last error for the diagnostics.
+    if (!observation.enabled) {
+      runtime.restarts = 0;
+      runtime.attempt = 0;
+      runtime.nextRetryAt = null;
+    }
+    if (runtime.mux !== null) runtime.streams = runtime.mux.stats;
+    const previous = yield* Ref.get(stateRef);
+    const next: DesktopHostBridgeState = {
+      enabled: observation.enabled,
+      phase,
+      detail,
+      urls: hostBridgeUrls(HOST_BRIDGE_PORTS),
+      url: runtime.listeningUrl,
+      windowsEnvironmentId: observation.windows.environmentId,
+      windowsLabel: observation.windows.environmentId === null ? null : runtime.windowsLabel,
+      windowsPort: observation.windows.ready ? observation.windows.port : null,
+      pairedEnvironmentId: observation.pairedEnvironmentId,
+      wslInstanceId: wsl.instanceId,
+      wslDistro: wsl.distro,
+      wslRuntimeId: wsl.runtimeId,
+      wslNetworking: wsl.networking,
+      helperPid: runtime.helperPid,
+      restarts: runtime.restarts,
+      nextRetryAt:
+        runtime.nextRetryAt === null
+          ? null
+          : DateTime.formatIso(DateTime.makeUnsafe(runtime.nextRetryAt)),
+      lastError: runtime.lastError,
+      streams: runtime.streams,
+      since:
+        previous.phase === phase && previous.enabled === observation.enabled
+          ? previous.since
+          : DateTime.formatIso(yield* DateTime.now),
+    };
+    yield* Ref.set(stateRef, next);
+    return next;
+  });
+  const tick = tickLock.withPermits(1)(tickUnlocked);
+
+  const run: DesktopHostBridge["Service"]["run"] = Effect.gen(function* () {
+    yield* powerMonitor.onSimpleEvent("resume", () => {
+      runtime.resumed = true;
+      wakeUnsafe();
+    });
+    // The helper ends with this scope, and by itself when its stdin closes.
+    yield* Effect.addFinalizer(() => stopHelper);
+    return yield* tick.pipe(
+      Effect.catchCause((cause) =>
+        logWarning("WSL host bridge tick failed", { cause: Cause.pretty(cause) }),
+      ),
+      Effect.andThen(Queue.take(wake).pipe(Effect.timeoutOption(TICK))),
+      Effect.forever,
+    );
+  });
+
+  return DesktopHostBridge.of({
+    state: Ref.get(stateRef),
+    set: Effect.fn("desktop.hostBridge.set")(function* (input) {
+      yield* appSettings.setHostBridge({
+        enabled: input.enabled,
+        ...(input.environmentId === undefined ? {} : { environmentId: input.environmentId }),
+      });
+      // Pairing runs in the app; its failures belong in the same diagnostics as the helper's.
+      if (input.failure !== undefined) runtime.lastError = input.failure;
+      // Answer with the state the change leads to, not the one before it.
+      return yield* tick.pipe(
+        Effect.catchCause(() => Ref.get(stateRef)),
+        Effect.tap(() => Effect.sync(wakeUnsafe)),
+      );
+    }),
+    run,
+  });
+});
+
+export const layer = Layer.effect(DesktopHostBridge, make);
+
+/** A bridge that stays off, for tests of everything around it. */
+export const layerTest = (state: Partial<DesktopHostBridgeState> = {}) =>
+  Layer.succeed(
+    DesktopHostBridge,
+    DesktopHostBridge.of({
+      state: Effect.succeed({ ...DISABLED_STATE, ...state }),
+      set: Effect.fn("DesktopHostBridge.set")(function* () {
+        return yield* Effect.succeed({ ...DISABLED_STATE, ...state });
+      }),
+      run: Effect.never,
+    }),
+  );
