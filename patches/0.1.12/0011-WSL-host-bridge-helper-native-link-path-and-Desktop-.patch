+// @effect-diagnostics nodeBuiltinImport:off -- A tiny stdio helper the Desktop starts in WSL; it runs before any CLI runtime.
+import * as NodeNet from "node:net";
+
+import {
+  encodeHello,
+  HOST_BRIDGE_PROTOCOL_VERSION,
+  HostBridgeMux,
+  type HostBridgeHello,
+} from "@t3tools/shared/hostBridgeMux";
+
+export const HOST_BRIDGE_HELPER_COMMAND = "__host-bridge";
+
+export type HostBridgeHelperArgs =
+  | { readonly ok: true; readonly ports: ReadonlyArray<number> }
+  | { readonly ok: false; readonly message: string };
+
+/** `--ports 13773,13774,13775`: where to listen, first free wins. Nothing else is accepted. */
+export const parseHostBridgeHelperArgs = (argv: ReadonlyArray<string>): HostBridgeHelperArgs => {
+  if (argv.length !== 2 || argv[0] !== "--ports") {
+    return { ok: false, message: "usage: t3 __host-bridge --ports <port>[,<port>…]" };
+  }
+  const ports = argv[1]!.split(",").map((value) => Number(value));
+  if (
+    ports.length === 0 ||
+    ports.length > 8 ||
+    ports.some((port) => !Number.isInteger(port) || port < 1024 || port > 65_535)
+  ) {
+    return { ok: false, message: "ports must be 1–8 integers between 1024 and 65535" };
+  }
+  return { ok: true, ports };
+};
+
+/** Binds the first port that is free on IPv4 loopback; never any other interface. */
+export const listenOnFirstFree = async (
+  server: NodeNet.Server,
+  ports: ReadonlyArray<number>,
+): Promise<{ readonly port: number } | { readonly error: "ports_in_use" | "listen_failed" }> => {
+  for (const port of ports) {
+    const result = await new Promise<"listening" | "in_use" | "failed">((resolve) => {
+      const onError = (error: NodeJS.ErrnoException) => {
+        server.off("listening", onListening);
+        resolve(error.code === "EADDRINUSE" || error.code === "EACCES" ? "in_use" : "failed");
+      };
+      const onListening = () => {
+        server.off("error", onError);
+        resolve("listening");
+      };
+      server.once("error", onError);
+      server.once("listening", onListening);
+      server.listen({ port, host: "127.0.0.1", exclusive: true });
+    });
+    if (result === "listening") return { port };
+    if (result === "failed") return { error: "listen_failed" };
+  }
+  return { error: "ports_in_use" };
+};
+
+interface HelperIo {
+  readonly input: NodeJS.ReadableStream;
+  readonly output: { write(bytes: Uint8Array): unknown };
+  readonly exit: (code: number) => void;
+  readonly pid: number;
+}
+
+/**
+ * Listens on WSL loopback and carries each connection over stdio to the
+ * Desktop, which alone decides where it goes. Ends when stdin ends, so it
+ * never outlives the Desktop that started it.
+ */
+export const runHostBridgeHelper = async (
+  argv: ReadonlyArray<string>,
+  io: HelperIo = {
+    input: process.stdin,
+    output: process.stdout,
+    exit: (code) => process.exit(code),
+    pid: process.pid,
+  },
+) => {
+  const send = (hello: HostBridgeHello) => io.output.write(encodeHello(hello));
+  const args = parseHostBridgeHelperArgs(argv);
+  if (!args.ok) {
+    send({
+      ok: false,
+      version: HOST_BRIDGE_PROTOCOL_VERSION,
+      code: "bad_arguments",
+      message: args.message,
+    });
+    io.exit(2);
+    return;
+  }
+  const mux = new HostBridgeMux((bytes) => io.output.write(bytes), {
+    onProtocolError: () => io.exit(3),
+  });
+  const server = NodeNet.createServer({ allowHalfOpen: true, pauseOnConnect: false }, (socket) => {
+    socket.setNoDelay(true);
+    mux.accept(socket);
+  });
+  const bound = await listenOnFirstFree(server, args.ports);
+  if ("error" in bound) {
+    send({
+      ok: false,
+      version: HOST_BRIDGE_PROTOCOL_VERSION,
+      code: bound.error,
+      message:
+        bound.error === "ports_in_use"
+          ? args.ports.length === 1
+            ? `127.0.0.1:${args.ports[0]} is in use`
+            : `127.0.0.1 ports ${args.ports.join(", ")} are all in use`
+          : "could not listen on 127.0.0.1",
+    });
+    io.exit(4);
+    return;
+  }
+  send({ ok: true, version: HOST_BRIDGE_PROTOCOL_VERSION, port: bound.port, pid: io.pid });
+  const stop = () => {
+    mux.stop();
+    server.close();
+    io.exit(0);
+  };
+  io.input.on("data", (chunk: Uint8Array) => mux.receive(chunk));
+  io.input.on("end", stop);
+  io.input.on("close", stop);
+  io.input.on("error", stop);
+  return { port: bound.port, stop };
+};
