+import {
+  NodeId,
+  ProviderInstanceId,
+  ProviderThreadId,
+  ProviderTurnId,
+  type OrchestrationV2ProviderTurn,
+  type OrchestrationV2TurnPerformance,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import { describe, expect, it } from "vite-plus/test";
+
+import type { TurnPerformanceSource } from "./TurnPerformance.logic";
+import {
+  aggregateTurnPerformance,
+  percentile,
+  resolveTurnPerformanceScope,
+  selectScopeSources,
+  selectThreadPerformanceTurns,
+  serializeTurnPerformanceScope,
+  threadModels,
+  tokenWeightedRate,
+} from "./TurnPerformanceScope.logic";
+
+const start = DateTime.makeUnsafe("2026-11-27T10:00:00Z");
+
+function perf(
+  overrides: Partial<OrchestrationV2TurnPerformance> = {},
+): OrchestrationV2TurnPerformance {
+  return {
+    source: "claude_stream",
+    requestSentAt: start,
+    streamedChars: { reasoning: 0, text: 0, toolInput: 0 },
+    tools: { count: 0, wallMs: 0, longestMs: 0, open: 0 },
+    partial: false,
+    live: false,
+    ...overrides,
+  };
+}
+
+let ordinal = 0;
+function source(
+  model: string,
+  turn: Partial<OrchestrationV2ProviderTurn> = {},
+  providerName = "Claude",
+): TurnPerformanceSource {
+  ordinal += 1;
+  return {
+    turn: {
+      id: ProviderTurnId.make(`turn-${ordinal}`),
+      providerThreadId: ProviderThreadId.make("pthread"),
+      nodeId: NodeId.make("main"),
+      runAttemptId: null,
+      nativeTurnRef: null,
+      ordinal,
+      status: "completed",
+      startedAt: start,
+      completedAt: DateTime.makeUnsafe("2026-11-27T10:00:30Z"),
+      model,
+      ...turn,
+    },
+    driver: "claudeAgent",
+    providerName,
+    modelSelection: { instanceId: ProviderInstanceId.make("claude"), model, options: [] },
+  };
+}
+
+const usage = (inputTokens: number, outputTokens: number, cachedInputTokens: number) => ({
+  usageStatus: "complete" as const,
+  usageScope: "main_agent" as const,
+  inputTokens,
+  outputTokens,
+  cachedInputTokens,
+  hasSubagents: false,
+});
+
+const row = (rows: ReturnType<typeof aggregateTurnPerformance>, id: string) =>
+  rows.find((candidate) => candidate.id === id);
+
+describe("turn performance scope", () => {
+  it("round-trips the stored scope and falls back to the last turn for unknown models", () => {
+    const models = ["claude-opus-5-5", "gemini-4-neon"];
+    expect(resolveTurnPerformanceScope(undefined, models)).toEqual({ kind: "last" });
+    expect(resolveTurnPerformanceScope("thread", models)).toEqual({ kind: "thread" });
+    const model = resolveTurnPerformanceScope("model:gemini-4-neon", models);
+    expect(model).toEqual({ kind: "model", model: "gemini-4-neon" });
+    expect(serializeTurnPerformanceScope(model)).toBe("model:gemini-4-neon");
+    expect(resolveTurnPerformanceScope("model:gpt-6.1-sol", models)).toEqual({ kind: "last" });
+  });
+
+  it("lists models in first-use order and filters a model scope to its turns", () => {
+    const turns = [source("claude-opus-5-5"), source("gemini-4-neon"), source("claude-opus-5-5")];
+    expect(threadModels(turns)).toEqual(["claude-opus-5-5", "gemini-4-neon"]);
+    expect(selectScopeSources(turns, { kind: "model", model: "claude-opus-5-5" })).toHaveLength(2);
+    expect(selectScopeSources(turns, { kind: "thread" })).toHaveLength(3);
+  });
+
+  it("keeps finished main-agent turns of every provider session", () => {
+    const base = source("m").turn;
+    const turns = selectThreadPerformanceTurns({
+      nodes: [
+        { id: NodeId.make("main"), kind: "root_turn", parentNodeId: null },
+        { id: NodeId.make("child"), kind: "root_turn", parentNodeId: NodeId.make("main") },
+      ] as never,
+      providerTurns: [
+        {
+          ...base,
+          id: ProviderTurnId.make("b"),
+          startedAt: DateTime.makeUnsafe("2026-11-27T11:00:00Z"),
+        },
+        { ...base, id: ProviderTurnId.make("a"), providerThreadId: ProviderThreadId.make("old") },
+        { ...base, id: ProviderTurnId.make("running"), status: "running" },
+        { ...base, id: ProviderTurnId.make("child"), nodeId: NodeId.make("child") },
+        { ...base, id: ProviderTurnId.make("dropped"), promptDropped: true },
+      ],
+    });
+    expect(turns.map((turn) => turn.id)).toEqual(["a", "b"]);
+  });
+});
+
+describe("aggregate turn performance", () => {
+  it("takes the median latency with p90 in the tooltip", () => {
+    const rows = aggregateTurnPerformance(
+      [1_000, 2_000, 3_000, 10_000].map((ms) =>
+        source("m", { performance: perf({ firstTokenMs: ms, firstAnswerMs: ms + 500 }) }),
+      ),
+    );
+    expect(row(rows, "ttft")).toMatchObject({ precision: "exact", value: 2_500 });
+    expect(row(rows, "ttft")?.reason).toContain("p90 7.9 s");
+    expect(row(rows, "ttfa")?.value).toBe(3_000);
+  });
+
+  it("weights speed by tokens and skips turns under a second of streaming", () => {
+    const rows = aggregateTurnPerformance([
+      source("m", {
+        performance: perf({
+          generationMs: 10_000,
+          generationTokens: { value: 1_000, basis: "provider_exact" },
+        }),
+      }),
+      source("m", {
+        performance: perf({
+          generationMs: 2_000,
+          generationTokens: { value: 400, basis: "provider_exact" },
+        }),
+      }),
+      // 500 tokens in 0.2 s would read 2,500 tok/s.
+      source("m", {
+        performance: perf({
+          generationMs: 200,
+          generationTokens: { value: 500, basis: "provider_exact" },
+        }),
+      }),
+    ]);
+    // (1000 + 400) / 12 s, not the mean of 100 and 200 tok/s.
+    expect(row(rows, "avgTps")).toMatchObject({ precision: "exact", value: 1_400 / 12 });
+    expect(tokenWeightedRate([{ tokens: 10, ms: 500 }])).toBeNull();
+  });
+
+  it("marks speed estimated once any turn's count is estimated", () => {
+    const rows = aggregateTurnPerformance([
+      source("m", {
+        performance: perf({
+          generationMs: 4_000,
+          generationTokens: { value: 400, basis: "provider_exact" },
+        }),
+      }),
+      source("m", {
+        performance: perf({
+          generationMs: 4_000,
+          generationTokens: { value: 200, basis: "estimated" },
+        }),
+      }),
+    ]);
+    expect(row(rows, "avgTps")).toMatchObject({ precision: "estimated", display: "≈75 tok/s" });
+  });
+
+  it("sums tokens, tool and turn time and computes cache hit over the scope", () => {
+    const rows = aggregateTurnPerformance([
+      source("m", {
+        turnTokenUsage: usage(1_000, 100, 900),
+        performance: perf({
+          turnMs: 20_000,
+          tools: { count: 1, wallMs: 3_000, longestMs: 3_000, open: 0 },
+        }),
+      }),
+      source("m", {
+        turnTokenUsage: usage(3_000, 50, 1_500),
+        performance: perf({ turnMs: 5_000, tools: { count: 0, wallMs: 0, longestMs: 0, open: 0 } }),
+      }),
+    ]);
+    expect(row(rows, "inputTokens")?.value).toBe(4_000);
+    expect(row(rows, "outputTokens")?.value).toBe(150);
+    expect(row(rows, "cachedTokens")?.value).toBe(2_400);
+    expect(row(rows, "cacheHitRate")?.value).toBe(60);
+    expect(row(rows, "toolTime")?.value).toBe(3_000);
+    expect(row(rows, "turnTime")).toMatchObject({ value: 25_000, partial: false });
+    expect(row(rows, "peakTps")?.precision).toBe("unavailable");
+    expect(row(rows, "context")).toBeUndefined();
+  });
+
+  it("flags a sum some turns did not report as partial and takes the highest peak", () => {
+    const rows = aggregateTurnPerformance([
+      source("m", {
+        turnTokenUsage: usage(1_000, 100, 0),
+        performance: perf({
+          peakTokensPerSecond: { value: 120, windowMs: 2_000, basis: "estimated" },
+        }),
+      }),
+      source("m", {
+        performance: perf({
+          peakTokensPerSecond: { value: 258, windowMs: 2_000, basis: "estimated" },
+        }),
+      }),
+    ]);
+    expect(row(rows, "inputTokens")).toMatchObject({ value: 1_000, partial: true });
+    expect(row(rows, "inputTokens")?.reason).toContain("1 of 2 turns");
+    expect(row(rows, "peakTps")).toMatchObject({ precision: "estimated", value: 258 });
+  });
+
+  it("names one model and provider, or counts several", () => {
+    const one = aggregateTurnPerformance([source("claude-opus-5-5"), source("claude-opus-5-5")]);
+    expect(row(one, "model")?.text).toBe("claude-opus-5-5");
+    expect(row(one, "provider")?.text).toBe("Claude");
+    const mixed = aggregateTurnPerformance([
+      source("claude-opus-5-5"),
+      source("gemini-4-neon", {}, "Antigravity"),
+    ]);
+    expect(row(mixed, "model")?.text).toBe("2 models");
+    expect(row(mixed, "provider")?.text).toBe("2 providers");
+  });
+
+  it("computes percentiles by interpolation", () => {
+    expect(percentile([], 0.5)).toBeNull();
+    expect(percentile([5], 0.9)).toBe(5);
+    expect(percentile([4, 1, 3, 2], 0.5)).toBe(2.5);
+  });
+});
diff --git a/apps/web/src/components/chat/TurnPerformanceScope.logic.ts b/apps/web/src/components/chat/TurnPerformanceScope.logic.ts
new file mode 100644
index 0000000000..36145747c2
--- /dev/null
+++ b/apps/web/src/components/chat/TurnPerformanceScope.logic.ts
@@ -0,0 +1,377 @@
+import type {
+  OrchestrationV2ProviderTurn,
+  OrchestrationV2ThreadProjection,
+} from "@t3tools/contracts";
+
+import * as DateTime from "effect/DateTime";
+
+import {
+  deriveTurnCachePercentage,
+  deriveTurnElapsedMs,
+  formatCachePercentage,
+} from "./ComposerStats.logic";
+import {
+  deriveReasoningEffort,
+  deriveSpeedMode,
+  ESTIMATE_PREFIX,
+  formatMs,
+  formatTokenCount,
+  formatTokensPerSecond,
+  isTurnSettled,
+  MIN_EXACT_GENERATION_MS,
+  TURN_PERFORMANCE_METRIC_IDS,
+  UNAVAILABLE_TEXT,
+  type MetricPrecision,
+  type TurnPerformanceMetric,
+  type TurnPerformanceMetricId,
+  type TurnPerformanceSource,
+} from "./TurnPerformance.logic";
+
+/**
+ * Which turns the performance grid covers: the last turn, every finished turn of the thread, or
+ * the finished turns of one model. Stored per place as "last", "thread" or "model:<model id>".
+ */
+export type TurnPerformanceScope =
+  | { readonly kind: "last" }
+  | { readonly kind: "thread" }
+  | { readonly kind: "model"; readonly model: string };
+
+export type TurnPerformancePlace = "composer" | "threadDetails";
+
+export function serializeTurnPerformanceScope(scope: TurnPerformanceScope): string {
+  return scope.kind === "model" ? `model:${scope.model}` : scope.kind;
+}
+
+/** The stored scope, or the last turn when it names a model this thread never ran. */
+export function resolveTurnPerformanceScope(
+  stored: string | undefined,
+  models: ReadonlyArray<string>,
+): TurnPerformanceScope {
+  if (stored === "thread") return { kind: "thread" };
+  if (stored?.startsWith("model:")) {
+    const model = stored.slice("model:".length);
+    if (models.includes(model)) return { kind: "model", model };
+  }
+  return { kind: "last" };
+}
+
+/** The model a turn ran: what the provider reported, else what the run requested. */
+export function turnModelOf(source: TurnPerformanceSource): string | null {
+  return source.turn.model ?? source.modelSelection?.model ?? null;
+}
+
+/** Finished main-agent turns of every provider session in the thread, oldest first. */
+export function selectThreadPerformanceTurns(
+  projection: Pick<OrchestrationV2ThreadProjection, "nodes" | "providerTurns">,
+): ReadonlyArray<OrchestrationV2ProviderTurn> {
+  const mainNodes = new Set(
+    projection.nodes
+      .filter((node) => node.kind === "root_turn" && node.parentNodeId === null)
+      .map((node) => node.id),
+  );
+  const startOf = (turn: OrchestrationV2ProviderTurn) =>
+    turn.startedAt === null ? 0 : DateTime.toEpochMillis(turn.startedAt);
+  return projection.providerTurns
+    .filter(
+      (turn) =>
+        mainNodes.has(turn.nodeId) &&
+        isTurnSettled(turn) &&
+        turn.startedAt !== null &&
+        turn.promptDropped !== true,
+    )
+    .toSorted((a, b) => startOf(a) - startOf(b));
+}
+
+/** Models in first-use order; the selector offers one scope per model once there are two. */
+export function threadModels(sources: ReadonlyArray<TurnPerformanceSource>): ReadonlyArray<string> {
+  const models: string[] = [];
+  for (const source of sources) {
+    const model = turnModelOf(source);
+    if (model !== null && !models.includes(model)) models.push(model);
+  }
+  return models;
+}
+
+export function selectScopeSources(
+  sources: ReadonlyArray<TurnPerformanceSource>,
+  scope: Exclude<TurnPerformanceScope, { kind: "last" }>,
+): ReadonlyArray<TurnPerformanceSource> {
+  return scope.kind === "thread"
+    ? sources
+    : sources.filter((source) => turnModelOf(source) === scope.model);
+}
+
+/** Linear-interpolated percentile of unsorted values; null when there are none. */
+export function percentile(values: ReadonlyArray<number>, fraction: number): number | null {
+  if (values.length === 0) return null;
+  const sorted = values.toSorted((a, b) => a - b);
+  const position = (sorted.length - 1) * Math.max(0, Math.min(1, fraction));
+  const below = Math.floor(position);
+  const above = Math.ceil(position);
+  return sorted[below]! + (sorted[above]! - sorted[below]!) * (position - below);
+}
+
+/** Token-weighted speed: total generation tokens over total generation time. */
+export function tokenWeightedRate(
+  windows: ReadonlyArray<{ readonly tokens: number; readonly ms: number }>,
+): number | null {
+  const counted = windows.filter((window) => window.ms >= MIN_EXACT_GENERATION_MS);
+  const ms = counted.reduce((sum, window) => sum + window.ms, 0);
+  if (ms <= 0) return null;
+  return counted.reduce((sum, window) => sum + window.tokens, 0) / (ms / 1000);
+}
+
+const finite = (value: number | undefined | null): value is number =>
+  typeof value === "number" && Number.isFinite(value);
+
+function aggregate(
+  id: TurnPerformanceMetricId,
+  precision: MetricPrecision,
+  value: number | string | null,
+  text: string,
+  reason: string,
+  partial = false,
+): TurnPerformanceMetric {
+  if (precision === "unavailable") {
+    return { id, precision, value: null, text: "", display: UNAVAILABLE_TEXT, reason, partial };
+  }
+  return {
+    id,
+    precision,
+    value,
+    text,
+    display: precision === "estimated" ? `${ESTIMATE_PREFIX}${text}` : text,
+    reason,
+    partial,
+  };
+}
+
+const none = (id: TurnPerformanceMetricId, reason: string) =>
+  aggregate(id, "unavailable", null, "", reason);
+
+const ofTurns = (count: number, total: number) =>
+  count === total ? `${total} turn${total === 1 ? "" : "s"}` : `${count} of ${total} turns`;
+
+/** Median with p90 for a latency: how long a typical turn waited, and a slow one. */
+function latency(
+  id: "ttft" | "ttfa",
+  sources: ReadonlyArray<TurnPerformanceSource>,
+  pick: (source: TurnPerformanceSource) => number | undefined,
+  what: string,
+): TurnPerformanceMetric {
+  const measured = sources.filter((source) => finite(pick(source)));
+  const values = measured.map((source) => pick(source)!);
+  const median = percentile(values, 0.5);
+  if (median === null) return none(id, `No turn in this scope measured ${what}.`);
+  const p90 = percentile(values, 0.9)!;
+  return aggregate(
+    id,
+    "exact",
+    median,
+    formatMs(median),
+    `Median ${what} over ${ofTurns(measured.length, sources.length)}; p90 ${formatMs(p90)}.`,
+    measured.some((source) => source.turn.performance?.partial === true),
+  );
+}
+
+function sum(
+  id: TurnPerformanceMetricId,
+  sources: ReadonlyArray<TurnPerformanceSource>,
+  pick: (source: TurnPerformanceSource) => number | undefined,
+  format: (value: number) => string,
+  what: string,
+): TurnPerformanceMetric {
+  const reported = sources.filter((source) => finite(pick(source)));
+  if (reported.length === 0) return none(id, `No turn in this scope reported ${what}.`);
+  const total = reported.reduce((acc, source) => acc + pick(source)!, 0);
+  return aggregate(
+    id,
+    "exact",
+    total,
+    format(total),
+    `Sum of ${what} over ${ofTurns(reported.length, sources.length)}.`,
+    reported.length < sources.length ||
+      reported.some((source) => source.turn.turnTokenUsage?.usageStatus === "partial"),
+  );
+}
+
+const usageOf = (source: TurnPerformanceSource) => {
+  const usage = source.turn.turnTokenUsage;
+  return usage === undefined || usage.usageStatus === "unavailable" ? undefined : usage;
+};
+
+const turnTimeOf = (source: TurnPerformanceSource) =>
+  source.turn.performance?.turnMs ?? deriveTurnElapsedMs(source.turn, 0) ?? undefined;
+
+/** One value shared by every turn, or null when they differ or none has one. */
+function shared<T>(values: ReadonlyArray<T | null>): T | null {
+  const first = values[0] ?? null;
+  return first !== null && values.every((value) => value === first) ? first : null;
+}
+
+/**
+ * The grid's metrics over several finished turns, in catalog order. Latencies are medians, speed
+ * is token-weighted, peak is the maximum, counts and times are sums. Context and live speed
+ * describe one moment, so they are left out.
+ */
+export function aggregateTurnPerformance(
+  sources: ReadonlyArray<TurnPerformanceSource>,
+): ReadonlyArray<TurnPerformanceMetric> {
+  const rows: TurnPerformanceMetric[] = [];
+  rows.push(
+    latency(
+      "ttft",
+      sources,
+      (source) => source.turn.performance?.firstTokenMs,
+      "time to first token",
+    ),
+    latency(
+      "ttfa",
+      sources,
+      (source) => source.turn.performance?.firstAnswerMs,
+      "time to first answer",
+    ),
+  );
+
+  // Total tokens over total time, so long replies weigh more; estimated if any count was.
+  const generation = sources.flatMap((source) => {
+    const performance = source.turn.performance;
+    const tokens = performance?.generationTokens;
+    return performance !== undefined && tokens !== undefined && finite(performance.generationMs)
+      ? [{ tokens: tokens.value, ms: performance.generationMs, basis: tokens.basis, source }]
+      : [];
+  });
+  const timed = generation.filter((window) => window.ms >= MIN_EXACT_GENERATION_MS);
+  const rate = tokenWeightedRate(timed);
+  rows.push(
+    rate === null
+      ? none("avgTps", "No turn in this scope streamed for at least 1 s with a token count.")
+      : aggregate(
+          "avgTps",
+          timed.every((window) => window.basis === "provider_exact") ? "exact" : "estimated",
+          rate,
+          formatTokensPerSecond(rate),
+          `${formatTokenCount(timed.reduce((acc, window) => acc + window.tokens, 0))} tokens over ${formatMs(timed.reduce((acc, window) => acc + window.ms, 0))} of generation, ${ofTurns(timed.length, sources.length)}; turns under 1 s of streaming are left out.`,
+          timed.some((window) => window.source.turn.performance?.partial === true),
+        ),
+  );
+
+  const peaks = sources.flatMap((source) => {
+    const peak = source.turn.performance?.peakTokensPerSecond?.value;
+    return finite(peak) ? [peak] : [];
+  });
+  rows.push(
+    peaks.length === 0
+      ? none("peakTps", "No turn in this scope streamed long enough for a peak.")
+      : aggregate(
+          "peakTps",
+          "estimated",
+          Math.max(...peaks),
+          formatTokensPerSecond(Math.max(...peaks)),
+          `Highest turn peak over ${ofTurns(peaks.length, sources.length)}.`,
+        ),
+  );
+
+  // A sum over turns where some did not report is partial.
+  rows.push(
+    sum("inputTokens", sources, (s) => usageOf(s)?.inputTokens, formatTokenCount, "input tokens"),
+    sum(
+      "outputTokens",
+      sources,
+      (s) => usageOf(s)?.outputTokens,
+      formatTokenCount,
+      "output tokens",
+    ),
+    sum(
+      "reasoningTokens",
+      sources,
+      (s) => usageOf(s)?.reasoningTokens,
+      formatTokenCount,
+      "reasoning tokens",
+    ),
+    sum(
+      "cachedTokens",
+      sources,
+      (s) => usageOf(s)?.cachedInputTokens,
+      formatTokenCount,
+      "cached input tokens",
+    ),
+  );
+
+  // Cached over input of the turns that report both, not a mean of per-turn rates.
+  const cacheTurns = sources.filter(
+    (source) => deriveTurnCachePercentage(usageOf(source)) !== null,
+  );
+  const input = cacheTurns.reduce((acc, source) => acc + usageOf(source)!.inputTokens!, 0);
+  const cached = cacheTurns.reduce((acc, source) => acc + usageOf(source)!.cachedInputTokens!, 0);
+  const hit = input > 0 ? (cached / input) * 100 : null;
+  rows.push(
+    hit === null
+      ? none("cacheHitRate", "No turn in this scope reported cached and total input.")
+      : aggregate(
+          "cacheHitRate",
+          "exact",
+          hit,
+          formatCachePercentage(hit),
+          `Cached ÷ total input over ${ofTurns(cacheTurns.length, sources.length)}: ${formatTokenCount(cached)} of ${formatTokenCount(input)} tokens.`,
+          cacheTurns.length < sources.length,
+        ),
+  );
+
+  const toolTime = sum(
+    "toolTime",
+    sources,
+    (source) => source.turn.performance?.tools.wallMs,
+    formatMs,
+    "tool wall time",
+  );
+  rows.push(
+    sources.some((source) => (source.turn.performance?.tools.open ?? 0) > 0)
+      ? { ...toolTime, partial: true }
+      : toolTime,
+    sum("turnTime", sources, turnTimeOf, formatMs, "turn time"),
+  );
+
+  const providers = [...new Set(sources.map((source) => source.providerName))];
+  rows.push(
+    providers.length === 1
+      ? aggregate(
+          "provider",
+          "exact",
+          providers[0]!,
+          providers[0]!,
+          "Provider that ran these turns.",
+        )
+      : aggregate(
+          "provider",
+          "exact",
+          providers.length,
+          `${providers.length} providers`,
+          providers.join(", "),
+        ),
+  );
+  const models = threadModels(sources);
+  rows.push(
+    models.length === 0
+      ? none("model", "No turn in this scope reported a model.")
+      : models.length === 1
+        ? aggregate("model", "exact", models[0]!, models[0]!, "Model that ran these turns.")
+        : aggregate("model", "exact", models.length, `${models.length} models`, models.join(", ")),
+  );
+  const effort = shared(sources.map((source) => deriveReasoningEffort(source.modelSelection)));
+  if (effort !== null) {
+    rows.push(aggregate("reasoningEffort", "exact", effort, effort, "Effort of every turn here."));
+  }
+  const speed = shared(
+    sources.map((source) => deriveSpeedMode(source.modelSelection, source.driver)),
+  );
+  if (speed !== null) {
+    rows.push(aggregate("speedMode", "exact", speed, speed, "Speed mode of every turn here."));
+  }
+
+  const byId = new Map(rows.map((row) => [row.id, row]));
+  return TURN_PERFORMANCE_METRIC_IDS.flatMap((id) => {
+    const row = byId.get(id);
+    return row === undefined ? [] : [row];
+  });
+}
