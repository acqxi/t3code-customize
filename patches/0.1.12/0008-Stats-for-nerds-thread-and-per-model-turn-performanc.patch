+type ScopedPerformance = ReturnType<typeof useTurnPerformanceScope>;
+
+/** The scope chosen for one place, kept in client settings; model scopes need two models. */
+function useTurnPerformanceScope(
+  place: TurnPerformancePlace,
+  history: ReadonlyArray<TurnPerformanceSource>,
+) {
+  const stored = useClientSettings((settings) => settings.statsForNerdsPerformanceScopes[place]);
+  const all = threadModels(history);
+  const models = all.length > 1 ? all : [];
+  const scope = resolveTurnPerformanceScope(stored, models);
+  const setScope = (next: TurnPerformanceScope) => {
+    void updateClientSettings({
+      statsForNerdsPerformanceScopes: {
+        ...getClientSettings().statsForNerdsPerformanceScopes,
+        [place]: serializeTurnPerformanceScope(next),
+      },
+    });
+  };
+  // A thread scope needs turns to sum; with one finished turn it equals the last turn.
+  return { scope, models, setScope, available: history.length > 1 };
+}
+
+function scopedMetrics(
+  scope: Exclude<TurnPerformanceScope, { kind: "last" }>,
+  history: ReadonlyArray<TurnPerformanceSource>,
+  hidden: ReadonlySet<string>,
+) {
+  const sources = selectScopeSources(history, scope);
+  const latest = sources.at(-1);
+  if (latest === undefined) return null;
+  const providers = new Set(sources.map((entry) => entry.providerName));
+  return {
+    count: sources.length,
+    metrics: filterVisibleMetrics(aggregateTurnPerformance(sources), hidden),
+    // The header names the provider only when one ran every turn.
+    source:
+      providers.size === 1
+        ? latest
+        : { ...latest, driver: undefined, providerName: `${providers.size} providers` },
+  };
+}
+
+/** Last turn, this thread, or one model of it; compact enough to sit beside the title. */
+function TurnPerformanceScopeSelector({
+  scoped,
+  lastLabel,
+}: {
+  scoped: ScopedPerformance;
+  lastLabel?: string | undefined;
+}) {
+  const gt = useGT();
+  if (!scoped.available) return null;
+  const value = serializeTurnPerformanceScope(scoped.scope);
+  const options: ReadonlyArray<{ value: string; label: string; scope: TurnPerformanceScope }> = [
+    {
+      value: "last",
+      label: lastLabel ?? gt("Last", { $context: "the last agent turn" }),
+      scope: { kind: "last" },
+    },
+    {
+      value: "thread",
+      label: gt("Thread", { $context: "every turn of this thread" }),
+      scope: { kind: "thread" },
+    },
+    ...scoped.models.map((model) => ({
+      value: `model:${model}`,
+      label: model,
+      scope: { kind: "model", model } as const,
+    })),
+  ];
+  return (
+    <ToggleGroup
+      aria-label={gt("Turns to show")}
+      size="micro"
+      className="flex-wrap"
+      value={[value]}
+      onValueChange={(next) => {
+        const option = options.find((candidate) => candidate.value === next[0]);
+        if (option) scoped.setScope(option.scope);
+      }}
+    >
+      {options.map((option) => (
+        <Toggle key={option.value} value={option.value} title={option.label}>
+          {option.label}
+        </Toggle>
+      ))}
+    </ToggleGroup>
+  );
+}
+
+/** The composer's last-turn popover, switchable to the whole thread or one model. */
+function ScopedBreakdown({
+  place,
+  title,
+  source,
+  metrics,
+  history,
+  hidden,
+}: {
+  place: TurnPerformancePlace;
+  title: string;
+  source: TurnPerformanceSource;
+  metrics: ReadonlyArray<TurnPerformanceMetric>;
+  history: ReadonlyArray<TurnPerformanceSource>;
+  hidden: ReadonlySet<string>;
+}) {
+  const gt = useGT();
+  const scoped = useTurnPerformanceScope(place, history);
+  const selector = <TurnPerformanceScopeSelector scoped={scoped} />;
+  const aggregated =
+    scoped.scope.kind === "last" ? null : scopedMetrics(scoped.scope, history, hidden);
+  if (aggregated === null || scoped.scope.kind === "last") {
+    return (
+      <TurnPerformanceBreakdown
+        title={title}
+        source={source}
+        metrics={metrics}
+        titleAside={selector}
+      />
+    );
+  }
+  return (
+    <TurnPerformanceBreakdown
+      title={scoped.scope.kind === "model" ? scoped.scope.model : gt("This thread")}
+      source={aggregated.source}
+      metrics={aggregated.metrics}
+      titleAside={selector}
+      turnCount={aggregated.count}
+    />
+  );
+}
