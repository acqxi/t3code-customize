@@ -0,0 +1,795 @@
+import {
+  NodeId,
+  ProviderInstanceId,
+  ProviderThreadId,
+  ProviderTurnId,
+  type ModelSelection,
+  type OrchestrationV2ProviderTurn,
+  type OrchestrationV2TurnPerformance,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import { describe, expect, it } from "vite-plus/test";
+
+import { decodeMsg } from "gt-react";
+
+import { TURN_PERFORMANCE_METRIC_LABELS } from "./TurnPerformance.catalog";
+import {
+  COMPOSER_INLINE_PRIORITY,
+  compactMetricText,
+  formatCompactContext,
+  formatCompactCount,
+  TURN_PERFORMANCE_LAYOUT,
+  TURN_PERFORMANCE_METRIC_IDS,
+  countTurnStreamedChars,
+  createLiveRateSampler,
+  deriveAverageTps,
+  deriveReasoningEffort,
+  deriveSpeedMode,
+  deriveTurnPerformanceMetrics,
+  filterVisibleMetrics,
+  hiddenMetricSet,
+  liveRateKey,
+  pickInlineMetrics,
+  resolveTurnPerformanceSource,
+  selectComposerPerformanceTurns,
+  toggleHiddenMetric,
+  type TurnPerformanceInput,
+  type TurnPerformanceMetric,
+  type TurnPerformanceMetricId,
+} from "./TurnPerformance.logic";
+
+const start = DateTime.makeUnsafe("2026-10-03T10:00:00Z");
+const end = DateTime.makeUnsafe("2026-10-03T10:00:30Z");
+const nowMs = DateTime.toEpochMillis(end);
+
+function perf(
+  overrides: Partial<OrchestrationV2TurnPerformance> = {},
+): OrchestrationV2TurnPerformance {
+  return {
+    source: "claude_stream",
+    requestSentAt: start,
+    streamedChars: { reasoning: 0, text: 0, toolInput: 0 },
+    tools: { count: 0, wallMs: 0, longestMs: 0, open: 0 },
+    partial: false,
+    live: false,
+    ...overrides,
+  };
+}
+
+function turn(overrides: Partial<OrchestrationV2ProviderTurn> = {}): OrchestrationV2ProviderTurn {
+  return {
+    id: ProviderTurnId.make("turn-1"),
+    providerThreadId: ProviderThreadId.make("pthread-1"),
+    nodeId: NodeId.make("node-1"),
+    runAttemptId: null,
+    nativeTurnRef: null,
+    ordinal: 1,
+    status: "completed",
+    startedAt: start,
+    completedAt: end,
+    ...overrides,
+  };
+}
+
+function selection(model: string, options: ModelSelection["options"] = []): ModelSelection {
+  return { instanceId: ProviderInstanceId.make("claude"), model, options };
+}
+
+function metrics(input: Partial<TurnPerformanceInput> & { turn: OrchestrationV2ProviderTurn }) {
+  return deriveTurnPerformanceMetrics({
+    driver: "claudeAgent",
+    providerName: "Claude",
+    modelSelection: null,
+    context: null,
+    liveTokensPerSecond: null,
+    nowMs,
+    ...input,
+  });
+}
+
+function byId(
+  rows: ReadonlyArray<TurnPerformanceMetric>,
+  id: TurnPerformanceMetricId,
+): TurnPerformanceMetric {
+  const row = rows.find((candidate) => candidate.id === id);
+  if (!row) throw new Error(`missing metric ${id}`);
+  return row;
+}
+
+describe("time to first token / answer", () => {
+  it("is exact when the adapter timed it, and names the first token kind", () => {
+    const rows = metrics({
+      turn: turn({ performance: perf({ firstTokenMs: 820, firstTokenKind: "reasoning" }) }),
+    });
+    const ttft = byId(rows, "ttft");
+    expect(ttft.precision).toBe("exact");
+    expect(ttft.value).toBe(820);
+    expect(ttft.display).toBe("820 ms");
+    expect(ttft.reason).toContain("reasoning");
+  });
+
+  it("is unavailable, naming the provider, without stream timing", () => {
+    const rows = metrics({ turn: turn(), providerName: "OpenCode", driver: "opencode" });
+    for (const id of ["ttft", "ttfa", "peakTps", "toolTime"] as const) {
+      const row = byId(rows, id);
+      expect(row.precision).toBe("unavailable");
+      expect(row.display).toBe("—");
+      expect(row.value).toBeNull();
+      expect(row.reason).toContain("OpenCode");
+    }
+  });
+
+  it("TTFA is unavailable when a settled turn produced no answer text", () => {
+    const rows = metrics({ turn: turn({ performance: perf({ firstTokenMs: 400 }) }) });
+    expect(byId(rows, "ttfa").precision).toBe("unavailable");
+    expect(byId(rows, "ttfa").reason).toContain("no answer text");
+  });
+
+  it("formats seconds with one decimal and marks partial measurements", () => {
+    const rows = metrics({
+      turn: turn({ performance: perf({ firstAnswerMs: 1_430, partial: true }) }),
+    });
+    expect(byId(rows, "ttfa").display).toBe("1.4 s");
+    expect(byId(rows, "ttfa").partial).toBe(true);
+    expect(byId(rows, "ttfa").reason).toContain("Partial");
+  });
+});
+
+describe("average tokens/s", () => {
+  it("is exact only for provider_exact generation tokens", () => {
+    const exact = deriveAverageTps(
+      turn({
+        performance: perf({
+          generationMs: 4_000,
+          generationWindows: 2,
+          generationTokens: { value: 400, basis: "provider_exact" },
+        }),
+      }),
+      "Claude",
+    );
+    expect(exact.precision).toBe("exact");
+    expect(exact.value).toBe(100);
+    expect(exact.display).toBe("100 tok/s");
+
+    for (const basis of ["provider_total", "estimated"] as const) {
+      const estimated = deriveAverageTps(
+        turn({
+          performance: perf({ generationMs: 4_000, generationTokens: { value: 400, basis } }),
+        }),
+        "Codex",
+      );
+      expect(estimated.precision).toBe("estimated");
+      expect(estimated.value).toBe(100);
+      expect(estimated.display).toBe("≈100 tok/s");
+    }
+  });
+
+  it("is unavailable under a second of streaming, even with exact tokens", () => {
+    // Sub-second replies arrive in a few network bursts, so no rate is reliable.
+    const burst = deriveAverageTps(
+      turn({
+        performance: perf({
+          generationMs: 266.6,
+          generationWindows: 2,
+          generationTokens: { value: 164, basis: "provider_exact" },
+        }),
+      }),
+      "Claude",
+    );
+    expect(burst.precision).toBe("unavailable");
+    expect(burst.display).toBe("—");
+    expect(burst.reason).toContain("too short to time");
+    const steady = deriveAverageTps(
+      turn({
+        performance: perf({
+          generationMs: 9_666.3,
+          generationTokens: { value: 1_420, basis: "provider_exact" },
+        }),
+      }),
+      "Claude",
+    );
+    expect(steady.precision).toBe("exact");
+    expect(Math.round(Number(steady.value))).toBe(147);
+  });
+
+  it("never divides by turn duration", () => {
+    // 30 s turn, 3 s of generation: the rate must use the 3 s.
+    const row = deriveAverageTps(
+      turn({
+        performance: perf({
+          turnMs: 30_000,
+          generationMs: 3_000,
+          generationTokens: { value: 300, basis: "provider_exact" },
+        }),
+        turnTokenUsage: {
+          usageScope: "main_agent",
+          usageStatus: "complete",
+          inputTokens: 10,
+          outputTokens: 300,
+          hasSubagents: false,
+        },
+      }),
+      "Claude",
+    );
+    expect(row.value).toBe(100);
+
+    // Turn duration and output tokens alone never produce a rate.
+    const noWindows = deriveAverageTps(
+      turn({
+        performance: perf({ turnMs: 30_000 }),
+        turnTokenUsage: {
+          usageScope: "main_agent",
+          usageStatus: "complete",
+          inputTokens: 10,
+          outputTokens: 300,
+          hasSubagents: false,
+        },
+      }),
+      "Claude",
+    );
+    expect(noWindows.precision).toBe("unavailable");
+    expect(noWindows.value).toBeNull();
+  });
+
+  it("falls back to legacy response throughput only under its own label", () => {
+    const legacy = deriveAverageTps(
+      turn({
+        nativeTurnRef: { driver: "claudeAgent", nativeId: "x", strength: "strong" } as never,
+        responseThroughput: {
+          outputTokens: 500,
+          elapsedMs: 5_000,
+          responseCount: 1,
+          partial: false,
+        },
+      }),
+      "Claude",
+    );
+    expect(legacy.variant).toBe("legacyResponseRate");
+    expect(legacy.value).toBe(100);
+
+    const codexLegacy = deriveAverageTps(
+      turn({
+        nativeTurnRef: { driver: "codex", nativeId: "x", strength: "strong" } as never,
+        responseThroughput: {
+          basis: "codex_active_windows_estimate",
+          outputTokens: 500,
+          elapsedMs: 5_000,
+          responseCount: 1,
+          partial: false,
+        },
+      }),
+      "Codex",
+    );
+    expect(codexLegacy.variant).toBe("legacyResponseRate");
+    expect(codexLegacy.precision).toBe("estimated");
+
+    // With performance present, the legacy value is never used.
+    const withPerformance = deriveAverageTps(
+      turn({
+        nativeTurnRef: { driver: "claudeAgent", nativeId: "x", strength: "strong" } as never,
+        responseThroughput: {
+          outputTokens: 500,
+          elapsedMs: 5_000,
+          responseCount: 1,
+          partial: false,
+        },
+        performance: perf(),
+      }),
+      "Claude",
+    );
+    expect(withPerformance.precision).toBe("unavailable");
+    expect(withPerformance.variant).toBeUndefined();
+  });
+
+  it("is unavailable without performance or legacy throughput", () => {
+    expect(deriveAverageTps(turn(), "Pi").precision).toBe("unavailable");
+    expect(deriveAverageTps(turn(), "Pi").reason).toContain("Pi");
+  });
+});
+
+describe("peak tokens/s", () => {
+  it("is always estimated and shows its window", () => {
+    for (const basis of ["calibrated_estimate", "estimated"] as const) {
+      const row = byId(
+        metrics({
+          turn: turn({
+            performance: perf({ peakTokensPerSecond: { value: 152.4, windowMs: 2_000, basis } }),
+          }),
+        }),
+        "peakTps",
+      );
+      expect(row.precision).toBe("estimated");
+      expect(row.display).toBe("≈152 tok/s");
+      expect(row.reason).toContain("2000 ms");
+    }
+  });
+
+  it("is unavailable for short turns", () => {
+    const row = byId(metrics({ turn: turn({ performance: perf() }) }), "peakTps");
+    expect(row.precision).toBe("unavailable");
+  });
+});
+
+describe("live tokens/s", () => {
+  it("appears only while the turn runs, always estimated", () => {
+    const running = metrics({
+      turn: turn({ status: "running", completedAt: null }),
+      liveTokensPerSecond: 42,
+    });
+    expect(byId(running, "liveTps").precision).toBe("estimated");
+    expect(byId(running, "liveTps").display).toBe("≈42 tok/s");
+
+    const done = metrics({ turn: turn(), liveTokensPerSecond: 42 });
+    expect(done.some((row) => row.id === "liveTps")).toBe(false);
+  });
+
+  it("is unavailable while measuring", () => {
+    const rows = metrics({ turn: turn({ status: "running", completedAt: null }) });
+    expect(byId(rows, "liveTps").precision).toBe("unavailable");
+  });
+});
+
+describe("live rate sampler", () => {
+  const key = liveRateKey("env:thread-a", "turn-1");
+
+  it("measures growth over the last 2 seconds at 4 characters per token", () => {
+    const sampler = createLiveRateSampler();
+    expect(sampler.sample(key, 0, 0)).toBeNull();
+    expect(sampler.sample(key, 400, 1_000)).toBe(100);
+    expect(sampler.sample(key, 800, 2_000)).toBe(100);
+    // Only the last 2 s count: 400 → 800 chars between 1 s and 3 s is 400 chars over 2 s.
+    expect(sampler.sample(key, 800, 3_000)).toBe(50);
+    // Nothing streamed for 2 s (tools running): the live rate drops to zero.
+    expect(sampler.sample(key, 800, 5_000)).toBe(0);
+    expect(sampler.sample(key, 1_600, 6_000)).toBe(100);
+  });
+
+  it("needs half a second of samples before reporting", () => {
+    const sampler = createLiveRateSampler();
+    sampler.sample(key, 0, 0);
+    expect(sampler.sample(key, 100, 200)).toBeNull();
+    expect(sampler.sample(key, 200, 500)).toBe(100);
+  });
+
+  it("starts over for a new turn and never mixes threads", () => {
+    const sampler = createLiveRateSampler();
+    sampler.sample(key, 0, 0);
+    sampler.sample(key, 4_000, 1_000);
+    // Thread B's turn with the same provider turn id begins with its own baseline.
+    const otherThread = liveRateKey("env:thread-b", "turn-1");
+    expect(sampler.sample(otherThread, 9_000, 1_500)).toBeNull();
+    expect(sampler.sample(otherThread, 9_400, 2_500)).toBe(100);
+    // Next turn on thread A: earlier characters never inflate the rate.
+    const nextTurn = liveRateKey("env:thread-a", "turn-2");
+    expect(sampler.sample(nextTurn, 0, 3_000)).toBeNull();
+    expect(sampler.sample(nextTurn, 200, 4_000)).toBe(50);
+  });
+
+  it("resets when text shrinks or on reset()", () => {
+    const sampler = createLiveRateSampler();
+    sampler.sample(key, 1_000, 0);
+    sampler.sample(key, 1_400, 1_000);
+    expect(sampler.sample(key, 100, 1_500)).toBeNull();
+    sampler.reset();
+    expect(sampler.sample(key, 500, 2_000)).toBeNull();
+  });
+
+  it("counts answer and reasoning text of the one provider turn only", () => {
+    const turnId = ProviderTurnId.make("turn-1");
+    const other = ProviderTurnId.make("turn-2");
+    expect(
+      countTurnStreamedChars(
+        [
+          { type: "assistant_message", providerTurnId: turnId, text: "hello" },
+          { type: "reasoning", providerTurnId: turnId, text: "think" },
+          { type: "tool_call", providerTurnId: turnId, text: "ignored" },
+          { type: "assistant_message", providerTurnId: other, text: "other turn" },
+          { type: "assistant_message", providerTurnId: null, text: "runless" },
+        ],
+        turnId,
+      ),
+    ).toBe(10);
+  });
+});
+
+describe("tokens and cache", () => {
+  const usage = {
+    usageScope: "main_agent",
+    usageStatus: "complete",
+    inputTokens: 10_000,
+    outputTokens: 1_200,
+    cachedInputTokens: 9_996,
+    cacheCreationTokens: 4,
+    hasSubagents: false,
+  } as const;
+
+  it("reports provider counts as exact", () => {
+    const rows = metrics({ turn: turn({ turnTokenUsage: usage }) });
+    expect(byId(rows, "inputTokens")).toMatchObject({ precision: "exact", display: "10,000" });
+    expect(byId(rows, "outputTokens")).toMatchObject({ precision: "exact", display: "1,200" });
+    expect(byId(rows, "cachedTokens")).toMatchObject({ precision: "exact", display: "9,996" });
+  });
+
+  it("computes cache hit rate from cached ÷ total input, one decimal, never rounding to 100%", () => {
+    const rows = metrics({ turn: turn({ turnTokenUsage: usage }) });
+    expect(byId(rows, "cacheHitRate").display).toBe("99.9%");
+    const full = metrics({
+      turn: turn({ turnTokenUsage: { ...usage, cachedInputTokens: 10_000 } }),
+    });
+    expect(byId(full, "cacheHitRate").display).toBe("100%");
+    const none = metrics({ turn: turn({ turnTokenUsage: { ...usage, cachedInputTokens: 0 } }) });
+    expect(byId(none, "cacheHitRate").display).toBe("0%");
+    const tenth = metrics({
+      turn: turn({ turnTokenUsage: { ...usage, inputTokens: 1_000, cachedInputTokens: 998 } }),
+    });
+    expect(byId(tenth, "cacheHitRate").display).toBe("99.8%");
+  });
+
+  it("cache hit rate is unavailable with zero input, missing cache counts or impossible counts", () => {
+    const zero = metrics({
+      turn: turn({ turnTokenUsage: { ...usage, inputTokens: 0, cachedInputTokens: 0 } }),
+    });
+    expect(byId(zero, "cacheHitRate").precision).toBe("unavailable");
+    const { cachedInputTokens: _omit, ...withoutCache } = usage;
