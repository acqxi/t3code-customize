+  formatCompactContext,
+  isTurnRunning,
+  liveRateKey,
+  pickInlineMetrics,
+  TURN_PERFORMANCE_LAYOUT,
+  type TurnPerformanceInput,
+  type TurnPerformanceMetric,
+  type TurnPerformanceMetricId,
+  type TurnPerformanceSource,
+} from "./TurnPerformance.logic";
+
+const LIVE_SAMPLE_MS = 500;
+
+/** Ticks while `active`, so running turns show elapsed time. */
+function useNow(active: boolean, intervalMs: number): number {
+  const [now, setNow] = useState(Date.now);
+  useEffect(() => {
+    if (!active) return;
+    setNow(Date.now());
+    const timer = window.setInterval(() => setNow(Date.now()), intervalMs);
+    return () => window.clearInterval(timer);
+  }, [active, intervalMs]);
+  return now;
+}
+
+/**
+ * Live tokens/s for one running provider turn of one thread. Samples that turn's streamed answer
+ * and reasoning text; a different thread or turn starts a fresh sampler.
+ */
+function useLiveTokensPerSecond(
+  threadRef: ScopedThreadRef | null,
+  providerTurnId: ProviderTurnId | null,
+): number | null {
+  const [rate, setRate] = useState<{ key: string; value: number | null } | null>(null);
+  const samplerRef = useRef(createLiveRateSampler());
+  const environmentId = threadRef?.environmentId ?? null;
+  const threadId = threadRef?.threadId ?? null;
+  const key =
+    environmentId === null || threadId === null || providerTurnId === null
+      ? null
+      : liveRateKey(`${environmentId}\u0000${threadId}`, providerTurnId);
+  // Restarts only when the thread or turn changes, not when the ref object is rebuilt.
+  useEffect(() => {
+    const sampler = samplerRef.current;
+    sampler.reset();
+    if (environmentId === null || threadId === null || providerTurnId === null || key === null)
+      return;
+    const ref: ScopedThreadRef = { environmentId, threadId };
+    const sample = () => {
+      const chars = countTurnStreamedChars(readThreadStreamedTurnItems(ref), providerTurnId);
+      setRate({ key, value: sampler.sample(key, chars, performance.now()) });
+    };
+    sample();
+    const timer = window.setInterval(sample, LIVE_SAMPLE_MS);
+    return () => {
+      window.clearInterval(timer);
+      sampler.reset();
+    };
+  }, [key, environmentId, threadId, providerTurnId]);
+  return rate !== null && rate.key === key ? rate.value : null;
+}
+
+function useMetricLabel() {
+  const m = useMessages();
+  return (metric: TurnPerformanceMetric, form: "label" | "short") =>
+    metric.variant === "legacyResponseRate"
+      ? m(LEGACY_RESPONSE_RATE_LABEL)
+      : m(TURN_PERFORMANCE_METRIC_LABELS[metric.id][form]);
+}
+
+/** Metrics whose short label reads before the value ("TTFT 820 ms"); the rest read after. */
+const LABEL_FIRST = new Set<TurnPerformanceMetricId>(["ttft", "ttfa", "model"]);
+/** Self-describing values that need no label inline. */
+const NO_INLINE_LABEL = new Set<TurnPerformanceMetricId>([
+  "turnTime",
+  "provider",
+  "reasoningEffort",
+  "speedMode",
+]);
+
+function InlineMetric({ metric }: { metric: TurnPerformanceMetric }) {
+  const labelOf = useMetricLabel();
+  const label = NO_INLINE_LABEL.has(metric.id) ? null : labelOf(metric, "short");
+  const value = (
+    <span
+      data-precision={metric.precision}
+      className={metric.precision === "estimated" ? "text-foreground/70" : "text-foreground/80"}
+    >
+      {metric.display}
+    </span>
+  );
+  return (
+    <span className="inline-flex items-baseline gap-1 whitespace-nowrap">
+      {label !== null && LABEL_FIRST.has(metric.id) && (
+        <span className="text-muted-foreground/70">{label}</span>
+      )}
+      {value}
+      {label !== null && !LABEL_FIRST.has(metric.id) && (
+        <span className="text-muted-foreground/70">{label}</span>
+      )}
+    </span>
+  );
+}
+
+/** Each separator travels with its metric, so a metric that wraps out of a clipped line takes it along. */
+function InlineMetrics({ metrics }: { metrics: ReadonlyArray<TurnPerformanceMetric> }) {
+  return metrics.map((metric, index) => (
+    <span key={metric.id} className="inline-flex items-baseline gap-x-1.5 whitespace-nowrap">
+      {index > 0 && (
+        <span aria-hidden="true" className="text-muted-foreground/40">
+          ·
+        </span>
+      )}
+      <InlineMetric metric={metric} />
+    </span>
+  ));
+}
+
+const PRECISION_TEXT = {
+  exact: msg("Exact", { $context: "a measured value, not an estimate" }),
+  estimated: msg("Estimate"),
+  unavailable: msg("Not reported by this provider"),
+} as const;
+
+/** One metric as a short label and a compact value; hover, click, tap or Enter shows the details. */
+function MetricCell({
+  metric,
+  badge = false,
+}: {
+  metric: TurnPerformanceMetric;
+  /** A header badge shows only its value, such as the model. */
+  badge?: boolean;
+}) {
+  const gt = useGT();
+  const m = useMessages();
+  const labelOf = useMetricLabel();
+  const label = labelOf(metric, "label");
+  const abbr =
+    metric.variant === "legacyResponseRate"
+      ? gt("Rate", { $context: "short label of the legacy response rate" })
+      : m(TURN_PERFORMANCE_METRIC_LABELS[metric.id].abbr);
+  const unavailable = metric.precision === "unavailable";
+  return (
+    <Popover>
+      <PopoverTrigger
+        openOnHover
+        delay={300}
+        closeDelay={100}
+        render={
+          <button
+            type="button"
+            data-metric={metric.id}
+            data-precision={metric.precision}
+            aria-label={gt("{label}: {value}", { label, value: metric.display })}
+            className={
+              badge
+                ? "max-w-40 truncate rounded-sm border border-border/70 px-1.5 text-2xs leading-4 text-foreground/80 -outline-offset-2"
+                : `flex min-w-0 items-baseline justify-between gap-1.5 rounded-sm text-left -outline-offset-2 ${unavailable ? "opacity-50" : ""}`
+            }
+          />
+        }
+      >
+        {badge ? (
+          metric.display
+        ) : (
+          <>
+            <span className="shrink-0 text-muted-foreground">{abbr}</span>
+            <span
+              className={`truncate tabular-nums ${metric.precision === "estimated" ? "text-foreground/70" : "text-foreground/85"}`}
+            >
+              {compactMetricText(metric)}
+              {metric.partial && !unavailable ? (
+                <span aria-hidden="true" className="text-muted-foreground">
+                  *
+                </span>
+              ) : null}
+            </span>
+          </>
+        )}
+      </PopoverTrigger>
+      <PopoverPopup {...composerFloatingLayerProps} side="top" className="max-w-72">
+        <div className="flex flex-col gap-0.5 text-xs">
+          <span className="font-medium">{label}</span>
+          {unavailable ? null : <span className="tabular-nums">{metric.display}</span>}
+          <span className="text-muted-foreground">{m(PRECISION_TEXT[metric.precision])}</span>
+          <span className="text-muted-foreground">{metric.reason}</span>
+          {metric.partial && !unavailable ? (
+            <span className="text-muted-foreground">
+              {gt("Partial: measured from incomplete data.")}
+            </span>
+          ) : null}
+        </div>
+      </PopoverPopup>
+    </Popover>
+  );
+}
+
+/**
+ * One turn's metrics, compact: a header of provider, model, effort and speed, grouped cells of
+ * short labels (timing, speed, tokens), and context as one bar.
+ */
+export function TurnPerformanceGrid({
+  source,
+  metrics,
+  live,
+}: {
+  source: TurnPerformanceSource;
+  metrics: ReadonlyArray<TurnPerformanceMetric>;
+  live: boolean;
+}) {
+  const byId = new Map(metrics.map((metric) => [metric.id, metric]));
+  const badges = TURN_PERFORMANCE_LAYOUT.header.flatMap((id) => {
+    const metric = byId.get(id);
+    return metric === undefined || id === "provider" || metric.precision === "unavailable"
+      ? []
+      : [metric];
+  });
+  const context = byId.get(TURN_PERFORMANCE_LAYOUT.context);
+  const usage = contextOf(source);
+  const contextPercent =
+    usage !== null && usage.maxTokens != null && usage.maxTokens > 0
+      ? Math.max(0, Math.min(100, (usage.usedTokens / usage.maxTokens) * 100))
+      : null;
+  return (
+    <div className="flex flex-col gap-2 text-xs">
+      <div className="flex min-w-0 flex-wrap items-center gap-1.5">
+        {live && (
+          <span aria-hidden="true" className="size-1.5 animate-pulse rounded-full bg-success" />
+        )}
+        {byId.has("provider") ? (
+          <span className="inline-flex min-w-0 items-center gap-1 text-muted-foreground">
+            {source.driver !== undefined ? (
+              <ProviderInstanceIcon
+                driverKind={ProviderDriverKind.make(source.driver)}
+                displayName={source.providerName}
+                accentColor={source.accentColor}
+                className="z-auto"
+                iconClassName="size-3.5"
+              />
+            ) : null}
+            <span className="max-w-32 truncate">{source.providerName}</span>
+          </span>
+        ) : null}
+        {badges.map((metric) => (
+          <MetricCell key={metric.id} metric={metric} badge />
+        ))}
+      </div>
+      {TURN_PERFORMANCE_LAYOUT.groups.map((group) => {
+        const cells = group.metrics.flatMap((id) => {
+          const metric = byId.get(id);
+          return metric === undefined ? [] : [metric];
+        });
+        return cells.length === 0 ? null : (
+          <div
+            key={group.id}
+            data-metric-group={group.id}
+            className="grid grid-cols-3 gap-x-3 gap-y-0.5"
+          >
+            {cells.map((metric) => (
+              <MetricCell key={metric.id} metric={metric} />
+            ))}
+          </div>
+        );
+      })}
+      {context !== undefined ? (
+        <div className="flex min-w-0 items-center gap-2">
+          <span className="min-w-0 flex-1">
+            <MetricCell
+              metric={
+                usage === null || context.precision === "unavailable"
+                  ? context
+                  : {
+                      ...context,
+                      text: formatCompactContext(usage.usedTokens, usage.maxTokens ?? null),
+                    }
+              }
+            />
+          </span>
+          {contextPercent !== null ? (
+            <span
+              aria-hidden="true"
+              className="block h-[3px] w-16 shrink-0 overflow-hidden rounded-full bg-foreground/10"
+            >
+              <span
+                className="block h-full bg-muted-foreground/70"
+                style={{ width: `${contextPercent}%` }}
+              />
+            </span>
+          ) : null}
+        </div>
+      ) : null}
+    </div>
+  );
+}
+
+/** A turn's metrics in a popover: its title, then the compact grid. */
+export function TurnPerformanceBreakdown({
+  title,
+  source,
+  metrics,
+  live = false,
+}: {
+  title: string;
+  source: TurnPerformanceSource;
+  metrics: ReadonlyArray<TurnPerformanceMetric>;
+  live?: boolean;
+}) {
+  const gt = useGT();
+  return (
+    <div className="flex flex-col gap-2.5 text-xs">
+      <h3 className="font-medium">{title}</h3>
+      <TurnPerformanceGrid source={source} metrics={metrics} live={live} />
+      <p className="text-2xs text-muted-foreground">
+        {gt(
+          "≈ marks an estimate; a dimmed value is not reported. Hover, click or tap a value for its full name and how it was measured.",
+        )}
+      </p>
+    </div>
+  );
+}
+
+function TurnPerformanceSummary({
+  label,
+  live,
+  metrics,
+  inline,
+  title,
+  source,
+  ariaLabel,
+  className,
+}: {
+  label: ReactNode;
+  live: boolean;
+  metrics: ReadonlyArray<TurnPerformanceMetric>;
+  inline: ReadonlyArray<TurnPerformanceMetric>;
+  title: string;
+  source: TurnPerformanceSource;
+  ariaLabel: string;
+  className?: string;
+}) {
+  return (
+    <Popover>
+      <PopoverTrigger
+        openOnHover
+        delay={150}
+        closeDelay={150}
+        render={
+          // One clipped line: metrics that do not fit wrap out of view, lowest priority first.
+          <button
+            type="button"
+            aria-label={ariaLabel}
+            className={`flex h-4 min-w-0 flex-wrap items-baseline gap-x-1.5 overflow-hidden rounded-sm text-left -outline-offset-2 ${className ?? ""}`}
+          />
+        }
+      >
+        <span className="inline-flex shrink-0 items-center gap-1 text-muted-foreground/70">
+          {live && (
+            <span aria-hidden="true" className="size-1.5 animate-pulse rounded-full bg-success" />
+          )}
+          {label}
+        </span>
+        <InlineMetrics metrics={inline} />
+      </PopoverTrigger>
+      <PopoverPopup {...composerFloatingLayerProps} side="top" align="start" width="md">
+        <TurnPerformanceBreakdown title={title} source={source} metrics={metrics} live={live} />
+      </PopoverPopup>
+    </Popover>
+  );
+}
+
+function contextOf(source: TurnPerformanceSource): TurnPerformanceInput["context"] {
+  const usage = source.turn.tokenUsage;
+  return usage === undefined ? null : { usedTokens: usage.usedTokens, maxTokens: usage.maxTokens };
+}
+
+/** A running turn's metrics, ticking and sampling live tokens/s while it runs. */
+function useTurnMetrics(
+  threadRef: ScopedThreadRef | null,
+  source: TurnPerformanceSource,
+  hidden: ReadonlySet<string>,
+): ReadonlyArray<TurnPerformanceMetric> {
+  const running = isTurnRunning(source.turn);
+  const now = useNow(running, 1000);
+  const liveRate = useLiveTokensPerSecond(running ? threadRef : null, source.turn.id);
+  return filterVisibleMetrics(
+    deriveTurnPerformanceMetrics({
+      ...source,
+      context: contextOf(source),
+      liveTokensPerSecond: running ? liveRate : null,
+      nowMs: now,
+    }),
+    hidden,
+  );
+}
+
+function CurrentTurnSummary({
+  threadRef,
+  source,
+  hidden,
+}: {
+  threadRef: ScopedThreadRef | null;
+  source: TurnPerformanceSource;
+  hidden: ReadonlySet<string>;
+}) {
+  const running = isTurnRunning(source.turn);
+  const metrics = useTurnMetrics(threadRef, source, hidden);
+  const inline = pickInlineMetrics(metrics, COMPOSER_INLINE_PRIORITY.current);
+  return (
+    <TurnPerformanceSummary
+      label="Now"
+      live={running}
+      metrics={metrics}
+      inline={inline}
+      title="Current turn"
+      source={source}
+      ariaLabel="Current turn performance details"
+      className="shrink"
+    />
+  );
+}
+
+function PreviousTurnSummary({
+  source,
+  hidden,
+}: {
+  source: TurnPerformanceSource;
+  hidden: ReadonlySet<string>;
+}) {
+  const metrics = filterVisibleMetrics(
+    deriveTurnPerformanceMetrics({
+      ...source,
+      context: contextOf(source),
+      liveTokensPerSecond: null,
+      nowMs: Date.now(),
+    }),
+    hidden,
+  );
+  const inline = pickInlineMetrics(metrics, COMPOSER_INLINE_PRIORITY.previous);
+  if (inline.length === 0 && metrics.length === 0) return null;
+  return (
+    <TurnPerformanceSummary
+      label="Last"
+      live={false}
+      metrics={metrics}
+      inline={inline}
+      title={`Previous turn · ${source.turn.status}`}
+      source={source}
+      ariaLabel="Previous turn performance details"
+      className="shrink-[8]"
+    />
+  );
+}
+
+/**
+ * The composer footer's turn performance: the running turn (live) and the last completed turn of
+ * this thread, inline so they share one line with the limits and context. The last turn gives up
+ * room first.
+ */
+export function ComposerTurnPerformance({
+  threadRef,
+  current,
+  previous,
+  hiddenMetrics,
+}: {
+  threadRef: ScopedThreadRef | null;
+  current: TurnPerformanceSource | null;
+  previous: TurnPerformanceSource | null;
+  hiddenMetrics: ReadonlySet<string>;
+}) {
+  if (current === null && previous === null) return null;
+  const threadKey = threadRef === null ? "" : `${threadRef.environmentId}:${threadRef.threadId}`;
+  return (
+    <span
+      data-composer-turn-performance="true"
+      aria-label="Turn performance"
+      className="flex min-w-0 flex-1 items-center justify-end gap-x-4"
+    >
+      {current !== null && (
+        <CurrentTurnSummary
+          key={`${threadKey}:${current.turn.id}`}
+          threadRef={threadRef}
+          source={current}
+          hidden={hiddenMetrics}
+        />
+      )}
+      {previous !== null && (
+        <PreviousTurnSummary
+          key={`${threadKey}:${previous.turn.id}`}
+          source={previous}
+          hidden={hiddenMetrics}
+        />
+      )}
+    </span>
+  );
+}
+
+export interface TurnPerformanceTimelineValue {
+  readonly threadId: ThreadId;
+  /** This thread's own provider turns; items from other threads never resolve. */
+  readonly sources: ReadonlyMap<ProviderTurnId, TurnPerformanceSource>;
+  readonly hiddenMetrics: ReadonlySet<string>;
+}
+
+export const TurnPerformanceTimelineCtx = createContext<TurnPerformanceTimelineValue | null>(null);
+
+/** One line under an assistant reply: the provider turn that produced it, kept as history. */
+export function ReplyTurnPerformance({
+  sourceThreadId,
+  providerTurnId,
+}: {
+  sourceThreadId: ThreadId | undefined;
+  providerTurnId: ProviderTurnId | null | undefined;
+}) {
+  const ctx = use(TurnPerformanceTimelineCtx);
+  if (
+    ctx === null ||
+    providerTurnId == null ||
+    sourceThreadId === undefined ||
+    sourceThreadId !== ctx.threadId
+  )
+    return null;
+  const source = ctx.sources.get(providerTurnId);
+  if (source === undefined || isTurnRunning(source.turn)) return null;
+  return <ReplyTurnPerformanceLine source={source} hidden={ctx.hiddenMetrics} />;
+}
+
+function ReplyTurnPerformanceLine({
+  source,
+  hidden,
+}: {
+  source: TurnPerformanceSource;
+  hidden: ReadonlySet<string>;
+}) {
+  const metrics = filterVisibleMetrics(
+    deriveTurnPerformanceMetrics({
+      ...source,
+      context: contextOf(source),
+      liveTokensPerSecond: null,
+      nowMs: Date.now(),
+    }),
+    hidden,
+  );
+  const inline = pickInlineMetrics(metrics, COMPOSER_INLINE_PRIORITY.reply);
+  if (metrics.length === 0) return null;
+  return (
+    // Right of the reply's actions, on their row: one clipped line that drops its lowest-priority
+    // metrics when narrow, so it never wraps or pushes the actions.
+    <span
+      data-reply-turn-performance={source.turn.id}
+      className="flex min-w-0 flex-1 justify-end overflow-hidden text-2xs leading-4 text-muted-foreground tabular-nums"
+    >
+      <Popover>
+        <PopoverTrigger
+          openOnHover
+          delay={150}
+          closeDelay={150}
+          render={
+            <button
+              type="button"
+              aria-label="Turn performance details"
+              className="flex h-4 min-w-0 flex-wrap items-baseline justify-end gap-x-1.5 overflow-hidden rounded-sm text-left -outline-offset-2"
+            />
+          }
+        >
+          {inline.length > 0 ? (
+            <InlineMetrics metrics={inline} />
+          ) : (
+            <span className="text-muted-foreground/70">Stats</span>
+          )}
+        </PopoverTrigger>
+        <PopoverPopup side="top" align="end" width="md">
+          <TurnPerformanceBreakdown
+            title={`Turn ${source.turn.ordinal} · ${source.turn.status}`}
+            source={source}
+            metrics={metrics}
+          />
+        </PopoverPopup>
+      </Popover>
+    </span>
+  );
+}
